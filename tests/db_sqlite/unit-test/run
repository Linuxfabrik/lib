"""Unit tests for lib.db_sqlite.

Fixture-based, no container required. Every database is created in a
throwaway directory (`path=` argument to connect/get_db_path), so the
tests never touch the real per-user temp directory and can run in
parallel. Covers the public API, the documented docstring examples, and
the security-relevant edge cases of the per-user database directory
(GHSA-r35r-fpx2-jgr4).
"""

import os
import sqlite3
import stat
import sys
import tempfile
import unittest

# Run from the test's `unit-test/` directory; `..` holds a `lib` symlink to the
# repo root (the `lib` package), so `import lib.<module>` exercises the local
# source independently of any other repo. Mirrors the monitoring-plugins layout.
sys.path.insert(0, '..')

import lib.db_sqlite as db

HAS_GETEUID = hasattr(os, 'geteuid')

SQLITE_VERSION = tuple(int(part) for part in sqlite3.sqlite_version.split('.'))

# Generated columns need SQLite 3.31.0. RHEL 8 ships 3.26.0, where the CREATE TABLE below is a
# syntax error, so the test would report a library defect that is really a missing feature.
HAS_GENERATED_COLUMNS = SQLITE_VERSION >= (3, 31, 0)


class TestGetDbDir(unittest.TestCase):
    """get_db_dir(): the secured per-user database directory."""

    def setUp(self):
        self.base = tempfile.mkdtemp(prefix='lftest-dbdir-')

    @unittest.skipUnless(HAS_GETEUID, 'POSIX-only hardening')
    def test_creates_private_0700_directory_owned_by_user(self):
        ok, db_dir = db.get_db_dir(self.base)
        self.assertTrue(ok, db_dir)
        self.assertTrue(
            db_dir.endswith(f'linuxfabrik-monitoring-plugins-uid{os.geteuid()}')
        )
        st = os.lstat(db_dir)
        self.assertTrue(stat.S_ISDIR(st.st_mode))
        self.assertEqual(st.st_uid, os.geteuid())
        self.assertEqual(st.st_mode & 0o077, 0, oct(st.st_mode))

    @unittest.skipUnless(HAS_GETEUID, 'POSIX-only hardening')
    def test_reuses_existing_directory(self):
        ok1, d1 = db.get_db_dir(self.base)
        ok2, d2 = db.get_db_dir(self.base)
        self.assertTrue(ok1 and ok2)
        self.assertEqual(d1, d2)

    @unittest.skipUnless(HAS_GETEUID, 'POSIX-only hardening')
    def test_rejects_symlink(self):
        link = os.path.join(
            self.base, f'linuxfabrik-monitoring-plugins-uid{os.geteuid()}'
        )
        os.symlink('/nonexistent/attacker/target', link)
        ok, msg = db.get_db_dir(self.base)
        self.assertFalse(ok)
        self.assertIn('symlink', msg)

    @unittest.skipUnless(HAS_GETEUID, 'POSIX-only hardening')
    def test_rejects_group_or_world_accessible_directory(self):
        db_dir = os.path.join(
            self.base, f'linuxfabrik-monitoring-plugins-uid{os.geteuid()}'
        )
        os.mkdir(db_dir, 0o755)
        ok, msg = db.get_db_dir(self.base)
        self.assertFalse(ok)
        self.assertIn('too permissive', msg)

    def test_windows_returns_base_unchanged(self):
        # Simulate Windows (no os.geteuid): the base path is returned as-is.
        saved = getattr(os, 'geteuid', None)
        if saved is not None:
            del os.geteuid
        try:
            ok, result = db.get_db_dir(self.base)
        finally:
            if saved is not None:
                os.geteuid = saved
        self.assertTrue(ok)
        self.assertEqual(result, self.base)


class TestGetDbPath(unittest.TestCase):
    """get_db_path(): single source of truth for a database's location."""

    def setUp(self):
        self.base = tempfile.mkdtemp(prefix='lftest-dbpath-')

    def test_resolves_inside_secured_dir(self):
        ok, path = db.get_db_path(path=self.base, filename='example.db')
        self.assertTrue(ok, path)
        self.assertTrue(path.endswith('example.db'))
        self.assertEqual(os.path.dirname(os.path.dirname(path)), self.base.rstrip('/'))

    def test_default_filename(self):
        ok, path = db.get_db_path(path=self.base)
        self.assertTrue(ok)
        self.assertTrue(path.endswith('linuxfabrik-monitoring-plugins-sqlite.db'))


class TestConnect(unittest.TestCase):
    """connect()/close()."""

    def setUp(self):
        self.base = tempfile.mkdtemp(prefix='lftest-connect-')

    def test_connect_and_close(self):
        ok, conn = db.connect(path=self.base, filename='t.db')
        self.assertTrue(ok, conn)
        _, path = db.get_db_path(path=self.base, filename='t.db')
        self.assertTrue(os.path.isfile(path))
        self.assertTrue(db.close(conn))

    @unittest.skipUnless(HAS_GETEUID, 'POSIX-only hardening')
    def test_connect_refuses_symlinked_dir(self):
        link = os.path.join(
            self.base, f'linuxfabrik-monitoring-plugins-uid{os.geteuid()}'
        )
        os.symlink('/nonexistent', link)
        ok, msg = db.connect(path=self.base, filename='t.db')
        self.assertFalse(ok)
        self.assertIn('symlink', msg)

    def test_connect_in_memory_writes_no_file(self):
        ok, conn = db.connect(path=self.base, filename='t.db', in_memory=True)
        self.assertTrue(ok, conn)
        self.assertTrue(db.create_table(conn, 'package TEXT', table='t')[0])
        self.assertTrue(db.insert(conn, {'package': 'linuxfabrik'}, table='t')[0])
        self.assertTrue(db.commit(conn)[0])
        self.assertEqual(
            db.select(conn, 'SELECT * FROM t')[1], [{'package': 'linuxfabrik'}]
        )
        # `path` and `filename` are ignored, so nothing reaches the disk.
        _, path = db.get_db_path(path=self.base, filename='t.db')
        self.assertFalse(os.path.exists(path))
        self.assertTrue(db.close(conn))

    def test_connect_in_memory_registers_regexp(self):
        ok, conn = db.connect(in_memory=True)
        self.assertTrue(ok, conn)
        db.create_table(conn, 'package TEXT', table='t')
        db.insert(conn, {'package': 'linuxfabrik'}, table='t')
        db.commit(conn)
        self.assertEqual(
            db.select(conn, "SELECT * FROM t WHERE package REGEXP 'linux'")[1],
            [{'package': 'linuxfabrik'}],
        )
        self.assertTrue(db.close(conn))

    def test_connect_in_memory_is_private_per_connection(self):
        # Two concurrent runs of the same consumer must not see each other's rows.
        ok_a, conn_a = db.connect(in_memory=True)
        ok_b, conn_b = db.connect(in_memory=True)
        self.assertTrue(ok_a and ok_b)
        for conn in (conn_a, conn_b):
            db.create_table(conn, 'package TEXT', table='t', drop_table_first=True)
        db.insert(conn_a, {'package': 'linuxfabrik'}, table='t')
        db.commit(conn_a)
        self.assertEqual(db.select(conn_b, 'SELECT * FROM t')[1], [])
        db.close(conn_a)
        db.close(conn_b)

    def test_rm_db_on_in_memory_deletes_nothing(self):
        ok, conn = db.connect(in_memory=True)
        self.assertTrue(ok, conn)
        # No file to remove, but the connection still has to be closed.
        self.assertTrue(db.rm_db(conn))
        with self.assertRaises(sqlite3.ProgrammingError):
            conn.execute('SELECT 1')


class TestCrud(unittest.TestCase):
    """create_table / insert / select / replace / delete / cut / indexes."""

    def setUp(self):
        self.base = tempfile.mkdtemp(prefix='lftest-crud-')
        ok, self.conn = db.connect(path=self.base, filename='crud.db')
        self.assertTrue(ok, self.conn)

    def tearDown(self):
        db.close(self.conn)

    def test_create_insert_select(self):
        self.assertEqual(
            db.create_table(self.conn, 'a TEXT, b INTEGER NOT NULL', table='t'),
            (True, True),
        )
        self.assertEqual(
            db.insert(self.conn, {'a': 'x', 'b': 1}, table='t'), (True, True)
        )
        db.commit(self.conn)
        ok, rows = db.select(self.conn, 'SELECT a, b FROM t')
        self.assertTrue(ok)
        self.assertEqual(rows, [{'a': 'x', 'b': 1}])

    def test_select_fetchone_empty(self):
        db.create_table(self.conn, 'a TEXT', table='t')
        ok, row = db.select(self.conn, 'SELECT a FROM t', fetchone=True)
        self.assertTrue(ok)
        self.assertEqual(row, [])

    def test_replace_overwrites_on_unique(self):
        db.create_table(self.conn, 'k TEXT, v TEXT', table='t')
        db.create_index(self.conn, 'k', table='t', unique=True)
        db.replace(self.conn, {'k': 'h', 'v': 'one'}, table='t')
        db.replace(self.conn, {'k': 'h', 'v': 'two'}, table='t')
        db.commit(self.conn)
        _, rows = db.select(self.conn, 'SELECT v FROM t WHERE k = :k', {'k': 'h'})
        self.assertEqual(rows, [{'v': 'two'}])

    def test_replace_fills_in_the_default_of_a_not_null_column(self):
        # REPLACE sets the conflict resolution for every constraint of the statement, so a NULL
        # for a NOT NULL column that has a DEFAULT is silently replaced by that default instead
        # of raising. Only a NOT NULL column without a DEFAULT aborts.
        db.create_table(
            self.conn,
            "k INTEGER PRIMARY KEY, v TEXT NOT NULL DEFAULT 'linuxfabrik'",
            table='withdefault',
        )
        ok, _ = db.replace(self.conn, {'k': 1, 'v': None}, table='withdefault')
        self.assertTrue(ok)
        db.commit(self.conn)
        _, rows = db.select(self.conn, 'SELECT v FROM withdefault')
        self.assertEqual(rows, [{'v': 'linuxfabrik'}])

        db.create_table(
            self.conn, 'k INTEGER PRIMARY KEY, v TEXT NOT NULL', table='nodefault'
        )
        ok, msg = db.replace(
            self.conn,
            {'k': 1, 'v': None},
            table='nodefault',
            delete_db_on_operational_error=False,
        )
        self.assertFalse(ok)
        self.assertIn('NOT NULL constraint failed', msg)

    def test_delete_returns_rowcount(self):
        db.create_table(self.conn, 'n INTEGER NOT NULL', table='t')
        for n in range(3):
            db.insert(self.conn, {'n': n}, table='t')
        db.commit(self.conn)
        ok, count = db.delete(self.conn, 'DELETE FROM t WHERE n < :x', {'x': 2})
        self.assertTrue(ok)
        self.assertEqual(count, 2)

    def test_cut_keeps_latest(self):
        db.create_table(self.conn, 'n INTEGER NOT NULL', table='perfdata')
        for n in range(10):
            db.insert(self.conn, {'n': n}, table='perfdata')
        db.commit(self.conn)
        db.cut(self.conn, _max=3)
        db.commit(self.conn)
        _, rows = db.select(self.conn, 'SELECT n FROM perfdata ORDER BY n')
        self.assertEqual([r['n'] for r in rows], [7, 8, 9])

    def test_get_tables_and_drop(self):
        db.create_table(self.conn, 'a TEXT', table='keep')
        db.create_table(self.conn, 'a TEXT', table='gone')
        ok, tables = db.get_tables(self.conn)
        self.assertTrue(ok)
        self.assertEqual(sorted(tables), ['gone', 'keep'])
        db.drop_table(self.conn, table='gone')
        ok, tables = db.get_tables(self.conn)
        self.assertEqual(tables, ['keep'])

    def test_regexp_null_row_is_not_selected_when_negated(self):
        # A NULL value must behave like it does in SQLite's own regexp(): the comparison is NULL,
        # so the row drops out of a negated WHERE instead of being selected by `NOT False`.
        db.create_table(self.conn, 'v TEXT', table='t')
        db.insert(self.conn, {'v': 'abc'}, table='t')
        db.insert(self.conn, {'v': None}, table='t')
        db.commit(self.conn)
        ok, rows = db.select(self.conn, "SELECT v FROM t WHERE NOT (v REGEXP '^z')")
        self.assertTrue(ok, rows)
        self.assertEqual(rows, [{'v': 'abc'}])

    def test_get_tables_only_hides_real_sqlite_internals(self):
        # `_` is a LIKE wildcard, so a plain 'sqlite_%' filter also swallowed user tables whose
        # seventh character is not an underscore.
        db.create_table(self.conn, 'a TEXT', table='sqliteXfoo')
        db.create_table(self.conn, 'a TEXT', table='sqlite_lookalike')
        db.create_table(self.conn, 'a TEXT', table='normal')
        ok, tables = db.get_tables(self.conn)
        self.assertTrue(ok)
        self.assertEqual(sorted(tables), ['normal', 'sqliteXfoo'])

    def test_insert_and_replace_without_columns(self):
        # An empty dict has no column list; '() VALUES ()' is a syntax error, DEFAULT VALUES is
        # SQLite's spelling for a row of column defaults.
        db.create_table(self.conn, 'a INTEGER DEFAULT 7', table='t')
        self.assertEqual(db.insert(self.conn, {}, table='t'), (True, True))
        self.assertEqual(db.replace(self.conn, {}, table='t'), (True, True))
        db.commit(self.conn)
        _, rows = db.select(self.conn, 'SELECT a FROM t')
        self.assertEqual([r['a'] for r in rows], [7, 7])

    def test_table_name_with_punctuation_is_not_mangled(self):
        # Identifiers are quoted, so the name reaches the database as given instead of being
        # silently rewritten to 'perfdata'.
        self.assertEqual(
            db.create_table(self.conn, 'a INTEGER', table='perf-data'), (True, True)
        )
        self.assertEqual(
            db.insert(self.conn, {'a': 1}, table='perf-data'), (True, True)
        )
        db.commit(self.conn)
        _, tables = db.get_tables(self.conn)
        self.assertEqual(tables, ['perf-data'])
        self.assertEqual(
            db.create_index(self.conn, 'a', table='perf-data'), (True, True)
        )
        self.assertEqual(db.cut(self.conn, table='perf-data', _max=1), (True, True))
        self.assertEqual(db.drop_table(self.conn, table='perf-data'), (True, True))


class TestDbDiscardPolicy(unittest.TestCase):
    """Only an unusable database file gets deleted, never a healthy one."""

    def setUp(self):
        self.base = tempfile.mkdtemp(prefix='lftest-discard-')
        ok, self.conn = db.connect(path=self.base, filename='d.db')
        self.assertTrue(ok, self.conn)
        _, self.path = db.get_db_path(path=self.base, filename='d.db')
        db.create_table(self.conn, 'n INTEGER NOT NULL', table='perfdata')
        db.insert(self.conn, {'n': 1})
        db.commit(self.conn)

    def tearDown(self):
        db.close(self.conn)

    def test_lock_held_by_other_process_keeps_database(self):
        # A concurrent plugin run holding a write lock must not cost us the cache.
        other = sqlite3.connect(self.path, timeout=0)
        other.execute('BEGIN EXCLUSIVE')
        try:
            ok, msg = db.insert(self.conn, {'n': 2})
        finally:
            other.close()
        self.assertFalse(ok)
        self.assertIn('database is locked', msg)
        self.assertTrue(os.path.isfile(self.path), 'database was deleted on a lock')

    def test_syntax_error_keeps_database(self):
        ok, msg = db.select(self.conn, 'this is not sql')
        self.assertFalse(ok)
        self.assertIn('Operational Error:', msg)
        self.assertTrue(
            os.path.isfile(self.path), 'database was deleted on a bad query'
        )

    def test_failing_user_function_keeps_database(self):
        # A REGEXP against a non-TEXT column used to raise inside the function, which surfaced
        # as an OperationalError and took the database with it.
        ok, rows = db.select(self.conn, "SELECT n FROM perfdata WHERE n REGEXP '^1$'")
        self.assertTrue(ok, rows)
        self.assertEqual(rows, [{'n': 1}])
        self.assertTrue(os.path.isfile(self.path))

    def test_schema_mismatch_deletes_database(self):
        # A column the current release writes but the on-disk table does not have.
        ok, msg = db.insert(self.conn, {'n': 2, 'newcol': 3})
        self.assertFalse(ok)
        self.assertIn('has no column named', msg)
        self.assertFalse(os.path.isfile(self.path), 'stale schema was not discarded')

    def test_corrupt_file_deletes_database(self):
        db.close(self.conn)
        with open(self.path, 'wb') as f:
            f.write(b'this is not a database' * 50)
        ok, self.conn = db.connect(path=self.base, filename='d.db')
        self.assertTrue(ok, self.conn)
        ok, msg = db.select(self.conn, 'SELECT n FROM perfdata')
        self.assertFalse(ok)
        self.assertIn('file is not a database', msg)
        self.assertFalse(os.path.isfile(self.path), 'corrupt file was not discarded')

    def test_corrupt_file_deletes_database_on_create_table(self):
        # create_table() is the first statement the documented usage pattern runs, so this is
        # where an unusable file shows up. It used to report the error and leave the file in
        # place, and every following run failed the same way.
        db.close(self.conn)
        with open(self.path, 'wb') as f:
            f.write(b'this is not a database' * 50)
        ok, self.conn = db.connect(path=self.base, filename='d.db')
        self.assertTrue(ok, self.conn)
        ok, msg = db.create_table(self.conn, 'n INTEGER')
        self.assertFalse(ok)
        self.assertIn('file is not a database', msg)
        self.assertFalse(os.path.isfile(self.path), 'corrupt file was not discarded')

    def test_corrupt_file_deletes_database_on_drop_table(self):
        db.close(self.conn)
        with open(self.path, 'wb') as f:
            f.write(b'this is not a database' * 50)
        ok, self.conn = db.connect(path=self.base, filename='d.db')
        self.assertTrue(ok, self.conn)
        ok, msg = db.drop_table(self.conn)
        self.assertFalse(ok)
        self.assertIn('file is not a database', msg)
        self.assertFalse(os.path.isfile(self.path), 'corrupt file was not discarded')

    def test_create_table_honours_delete_db_on_operational_error_false(self):
        db.close(self.conn)
        with open(self.path, 'wb') as f:
            f.write(b'this is not a database' * 50)
        ok, self.conn = db.connect(path=self.base, filename='d.db')
        self.assertTrue(ok, self.conn)
        ok, _ = db.create_table(
            self.conn, 'n INTEGER', delete_db_on_operational_error=False
        )
        self.assertFalse(ok)
        self.assertTrue(os.path.isfile(self.path))

    def test_delete_db_on_operational_error_false_is_honoured(self):
        ok, _ = db.insert(
            self.conn, {'n': 2, 'newcol': 3}, delete_db_on_operational_error=False
        )
        self.assertFalse(ok)
        self.assertTrue(os.path.isfile(self.path))

    def test_unique_violation_keeps_database(self):
        # A duplicate key is an ordinary data condition on a healthy cache, and replace() exists
        # to resolve it. It used to take the whole database with it.
        db.create_table(self.conn, 'k TEXT, v TEXT', table='u')
        db.create_index(self.conn, 'k', table='u', unique=True)
        db.insert(self.conn, {'k': 'a', 'v': '1'}, table='u')
        db.commit(self.conn)
        ok, msg = db.insert(self.conn, {'k': 'a', 'v': '2'}, table='u')
        self.assertFalse(ok)
        self.assertIn('UNIQUE constraint failed', msg)
        self.assertTrue(
            os.path.isfile(self.path), 'database was deleted on a duplicate key'
        )

    def test_not_null_violation_deletes_database(self):
        # A NOT NULL column the current release no longer fills does mean a schema mismatch.
        ok, msg = db.insert(self.conn, {})
        self.assertFalse(ok)
        self.assertIn('NOT NULL constraint failed', msg)
        self.assertFalse(os.path.isfile(self.path), 'stale schema was not discarded')

    def test_missing_table_keeps_database(self):
        # The default database file is shared by every plugin that does not pass a filename. A
        # table that does not exist yet is the normal first-run state and must not wipe it.
        ok, msg = db.select(self.conn, 'SELECT * FROM not_created_yet')
        self.assertFalse(ok)
        self.assertIn('no such table', msg)
        self.assertTrue(
            os.path.isfile(self.path), 'database was deleted on a missing table'
        )

    def test_cut_on_without_rowid_table_keeps_database(self):
        # A WITHOUT ROWID table has no rowid, so cut() fails with "no such column: rowid". That
        # is the schema the caller asked for, not a mismatch between releases.
        self.conn.execute('CREATE TABLE wr (k TEXT PRIMARY KEY, v INT) WITHOUT ROWID')
        db.commit(self.conn)
        ok, msg = db.cut(self.conn, table='wr', _max=2)
        self.assertFalse(ok)
        self.assertIn('no such column: rowid', msg)
        self.assertTrue(
            os.path.isfile(self.path), 'database was deleted on a WITHOUT ROWID table'
        )

    def test_rowid_aliases_on_without_rowid_table_keep_database(self):
        # SQLite accepts oid and _rowid_ for the same column and qualifies the name when the
        # query does ("no such column: x.rowid"). Every spelling is the schema the caller asked
        # for, not a mismatch between releases.
        self.conn.execute('CREATE TABLE wr (k TEXT PRIMARY KEY, v INT) WITHOUT ROWID')
        db.commit(self.conn)
        for sql in (
            'SELECT oid FROM wr',
            'SELECT _rowid_ FROM wr',
            'SELECT x.rowid FROM wr x',
        ):
            ok, _ = db.select(self.conn, sql)
            self.assertFalse(ok, sql)
            self.assertTrue(
                os.path.isfile(self.path), f'database was deleted by: {sql}'
            )

    def test_misspelled_column_still_deletes_database(self):
        # The rowid exception must not swallow a real schema mismatch whose column name merely
        # ends in one of the rowid spellings.
        ok, _ = db.select(self.conn, 'SELECT user_rowid FROM perfdata')
        self.assertFalse(ok)
        self.assertFalse(os.path.isfile(self.path))

    def test_cut_refuses_anything_but_a_non_negative_int(self):
        # SQLite skips no row for a non-positive OFFSET, so a negative _max used to delete every
        # row and report success. A string is just as dangerous: numeric affinity turns '-3' into
        # the integer -3 before OP_MustBeInt ever sees it, so the type check has to be strict.
        for i in range(5):
            db.insert(self.conn, {'n': i})
        db.commit(self.conn)
        _, before = db.select(self.conn, 'SELECT count(*) AS c FROM perfdata')
        for bad in (-3, '-3', '3', True, 2.5, 3.0, None, b'3'):
            ok, msg = db.cut(self.conn, _max=bad)
            self.assertFalse(ok, f'{bad!r} was accepted')
            self.assertIn('invalid size', msg)
            _, after = db.select(self.conn, 'SELECT count(*) AS c FROM perfdata')
            self.assertEqual(after[0]['c'], before[0]['c'], f'rows lost to {bad!r}')
        self.assertTrue(os.path.isfile(self.path))

    def test_cut_accepts_zero(self):
        # Zero is a legitimate request to empty the table, unlike the values rejected above.
        for i in range(5):
            db.insert(self.conn, {'n': i})
        db.commit(self.conn)
        self.assertEqual(db.cut(self.conn, _max=0), (True, True))
        _, after = db.select(self.conn, 'SELECT count(*) AS c FROM perfdata')
        self.assertEqual(after[0]['c'], 0)

    def test_unsupported_file_format_deletes_database(self):
        # A schema format number this SQLite cannot read arrives as SQLITE_ERROR, so it surfaces
        # as an OperationalError rather than a DatabaseError like the other corruption cases. It
        # used to match no pattern at all, and the unusable file stayed behind forever.
        db.close(self.conn)
        with open(self.path, 'r+b') as f:
            f.seek(44)  # schema format number, valid values are 1 to 4
            f.write(b'\x00\x00\x00\x05')
        ok, self.conn = db.connect(path=self.base, filename='d.db')
        self.assertTrue(ok, self.conn)
        ok, msg = db.create_table(self.conn, 'n INTEGER NOT NULL', table='perfdata')
        self.assertFalse(ok)
        self.assertIn('unsupported file format', msg)
        self.assertFalse(
            os.path.isfile(self.path), 'unreadable file format was not discarded'
        )

    def test_is_unusable_db_classification(self):
        # sqlite3.DataError is raised for SQLITE_TOOBIG only, which is a value the caller may not
        # store rather than a broken file. Asserted directly: provoking it needs a 1 GB value.
        is_unusable = getattr(db, '__is_unusable_db')
        for exc, expected in [
            (sqlite3.OperationalError('no such column: foo'), True),
            (sqlite3.OperationalError('table t has no column named foo'), True),
            (
                sqlite3.OperationalError(
                    'table t has 2 columns but 3 values were supplied'
                ),
                True,
            ),
            (sqlite3.OperationalError('no such column: rowid'), False),
            (sqlite3.OperationalError('no such column: main.t.rowid'), False),
            (sqlite3.OperationalError('no such column: "rowid"'), False),
            (sqlite3.OperationalError('no such column: user_rowid'), True),
            (sqlite3.OperationalError('no such table: foo'), False),
            (sqlite3.OperationalError('database is locked'), False),
            (sqlite3.OperationalError('database table is locked'), False),
            (sqlite3.OperationalError('attempt to write a readonly database'), False),
            (sqlite3.OperationalError('disk I/O error'), False),
            # SQLITE_ERROR, so an OperationalError rather than a DatabaseError, but it describes
            # the file and not the statement.
            (sqlite3.OperationalError('unsupported file format'), True),
            (sqlite3.IntegrityError('NOT NULL constraint failed: t.a'), True),
            (sqlite3.IntegrityError('UNIQUE constraint failed: t.a'), False),
            (sqlite3.IntegrityError('CHECK constraint failed: t'), False),
            (sqlite3.IntegrityError('FOREIGN KEY constraint failed'), False),
            (sqlite3.IntegrityError('datatype mismatch'), False),
            (sqlite3.DataError('string or blob too big'), False),
            (sqlite3.DatabaseError('file is not a database'), True),
            (sqlite3.DatabaseError('database disk image is malformed'), True),
            (sqlite3.DatabaseError('malformed database schema (t)'), True),
            (sqlite3.DatabaseError('not authorized'), False),
        ]:
            with self.subTest(error=str(exc)):
                self.assertIs(is_unusable(exc), expected)


class TestIdentifierQuoting(unittest.TestCase):
    """Identifiers are quoted, so they cannot carry SQL into a statement."""

    def setUp(self):
        self.base = tempfile.mkdtemp(prefix='lftest-quote-')
        ok, self.conn = db.connect(path=self.base, filename='q.db')
        self.assertTrue(ok, self.conn)

    def tearDown(self):
        db.close(self.conn)

    def test_insert_column_name_cannot_inject_sql(self):
        db.create_table(self.conn, 'a INTEGER', table='t')
        ok, _ = db.insert(
            self.conn,
            {'a) VALUES (99); --': 1},
            table='t',
            delete_db_on_operational_error=False,
        )
        self.assertFalse(ok, 'a column name carrying SQL was executed')
        db.commit(self.conn)
        _, rows = db.select(self.conn, 'SELECT a FROM t')
        self.assertEqual(rows, [])

    def test_replace_column_name_cannot_inject_sql(self):
        db.create_table(self.conn, 'a INTEGER', table='t')
        ok, _ = db.replace(
            self.conn,
            {'a) VALUES (99); --': 1},
            table='t',
            delete_db_on_operational_error=False,
        )
        self.assertFalse(ok)

    def test_keyword_table_name_works_everywhere(self):
        # 'select' is an SQL keyword and has to survive every statement this library builds.
        self.assertEqual(
            db.create_table(self.conn, 'n INTEGER', table='select'), (True, True)
        )
        self.assertEqual(db.create_index(self.conn, 'n', table='select'), (True, True))
        for n in range(5):
            self.assertEqual(
                db.insert(self.conn, {'n': n}, table='select'), (True, True)
            )
        db.commit(self.conn)
        self.assertEqual(db.cut(self.conn, table='select', _max=2), (True, True))
        db.commit(self.conn)
        _, rows = db.select(self.conn, 'SELECT n FROM "select" ORDER BY n')
        self.assertEqual([r['n'] for r in rows], [3, 4])
        self.assertEqual(db.drop_table(self.conn, table='select'), (True, True))

    def test_create_index_rejects_unknown_column(self):
        # SQLite would resolve the quoted, unknown name to a string literal and happily build an
        # index over a constant instead of reporting the typo.
        db.create_table(self.conn, 'a INTEGER', table='t')
        ok, msg = db.create_index(self.conn, 'typo', table='t')
        self.assertFalse(ok)
        self.assertIn('typo', msg)
        _, rows = db.select(
            self.conn, "SELECT name FROM sqlite_master WHERE type = 'index'"
        )
        self.assertEqual(rows, [])

    def test_compute_load_rejects_unknown_sensorcol(self):
        db.create_table(self.conn, 'a INTEGER, timestamp INT', table='t')
        ok, msg = db.compute_load(self.conn, 'typo', ['a'], 2, table='t')
        self.assertFalse(ok)
        self.assertIn('typo', msg)

    def test_compute_load_skips_a_counter_that_started_over(self):
        # A machine rebooted between two runs, so its counter is lower than it was.
        # Dividing across that gives a negative rate, and a check comparing it with a
        # threshold reports a machine that had simply restarted as critical.
        db.create_table(self.conn, 'name TEXT, a INTEGER, timestamp INT', table='t')
        for timestamp, value in ((1, 100), (2, 200), (3, 5)):
            db.insert(
                self.conn,
                {'name': 'vm', 'a': value, 'timestamp': timestamp},
                table='t',
            )
        db.commit(self.conn)
        self.assertEqual(
            db.compute_load(self.conn, 'name', ['a'], 3, table='t'), (True, False)
        )

    def test_compute_load_returns_once_the_restart_has_aged_out(self):
        # And it comes back of its own accord as soon as the samples from before the
        # restart have left the window.
        db.create_table(self.conn, 'name TEXT, a INTEGER, timestamp INT', table='t')
        for timestamp, value in ((1, 100), (2, 5), (3, 10), (4, 20)):
            db.insert(
                self.conn,
                {'name': 'vm', 'a': value, 'timestamp': timestamp},
                table='t',
            )
        db.commit(self.conn)
        ok, load = db.compute_load(self.conn, 'name', ['a'], 3, table='t')
        self.assertTrue(ok)
        self.assertEqual(load[0]['a1'], 10)
        self.assertEqual(load[0]['an'], 7.5)

    @unittest.skipUnless(HAS_GENERATED_COLUMNS, 'needs SQLite 3.31.0')
    def test_create_index_accepts_generated_column(self):
        # PRAGMA table_info omits generated columns, so validating against it rejected a column
        # SQLite indexes just fine. PRAGMA table_xinfo lists them.
        db.create_table(
            self.conn,
            'a INTEGER, b INTEGER GENERATED ALWAYS AS (a * 2) VIRTUAL',
            table='g',
        )
        self.assertEqual(db.create_index(self.conn, 'b', table='g'), (True, True))

    def test_create_index_unique_is_part_of_the_index_name(self):
        # `IF NOT EXISTS` makes a second CREATE INDEX with the same name a no-op. With the
        # uniqueness left out of the generated name, a UNIQUE index requested after a plain one
        # was reported as created while the constraint never existed.
        db.create_table(self.conn, 'a INTEGER', table='t')
        self.assertEqual(db.create_index(self.conn, 'a', table='t'), (True, True))
        self.assertEqual(
            db.create_index(self.conn, 'a', table='t', unique=True), (True, True)
        )
        _, rows = db.select(
            self.conn, "SELECT sql FROM sqlite_master WHERE type = 'index'"
        )
        statements = sorted(row['sql'] for row in rows)
        self.assertEqual(len(statements), 2, statements)
        self.assertIn('CREATE UNIQUE INDEX', statements[1])
        # The constraint is real, not just declared.
        db.insert(self.conn, {'a': 1}, table='t')
        db.commit(self.conn)
        ok, _ = db.insert(self.conn, {'a': 1}, table='t')
        self.assertFalse(ok, 'the unique index does not constrain anything')

    def test_create_index_normalizes_column_list(self):
        # 'a, b' and 'a,b' describe the same index and must not create two.
        db.create_table(self.conn, 'a INTEGER, b INTEGER', table='t')
        db.create_index(self.conn, 'a, b', table='t')
        db.create_index(self.conn, 'a,b', table='t')
        _, rows = db.select(
            self.conn, "SELECT name FROM sqlite_master WHERE type = 'index'"
        )
        self.assertEqual(len(rows), 1, rows)


class TestPureHelpers(unittest.TestCase):
    """Pure functions and the documented docstring examples."""

    def test_get_colnames_docstring_example(self):
        self.assertEqual(
            db.get_colnames('date TEXT PRIMARY KEY, count FLOAT, name TEXT'),
            ['date', 'count', 'name'],
        )

    def test_get_colnames_ignores_commas_inside_types(self):
        self.assertEqual(
            db.get_colnames('id INT, price DECIMAL(10,2), name TEXT'),
            ['id', 'price', 'name'],
        )

    def test_get_colnames_skips_table_constraints(self):
        self.assertEqual(
            db.get_colnames(
                'a INT, b INT, PRIMARY KEY (a, b), '
                'CONSTRAINT c CHECK (a > 0), '
                'FOREIGN KEY (b) REFERENCES other(id), '
                'UNIQUE (a)'
            ),
            ['a', 'b'],
        )

    def test_get_colnames_unquotes_names(self):
        self.assertEqual(
            db.get_colnames('"my col" TEXT, [other] INT'), ['my col', 'other']
        )

    def test_regexp_docstring_examples(self):
        self.assertTrue(db.regexp('^abc', 'abcdef'))
        self.assertFalse(db.regexp('xyz$', 'abcdef'))

    def test_regexp_returns_null_for_null_arguments(self):
        # SQLite's own regexp() leaves its result unset for a NULL argument, which surfaces as
        # SQL NULL. Returning False instead made a negated comparison select the NULL rows.
        self.assertIsNone(db.regexp('^abc', None))
        self.assertIsNone(db.regexp(None, 'abcdef'))

    def test_regexp_coerces_non_text_values(self):
        # SQLite hands the function whatever the column holds; its own implementation applies
        # sqlite3_value_text() first, so ours has to accept INTEGER, REAL and BLOB too.
        self.assertTrue(db.regexp('^9', 9000))
        self.assertTrue(db.regexp(r'^1\.5$', 1.5))
        self.assertTrue(db.regexp('^ab', b'abc'))

    def test_regexp_coerces_non_text_patterns(self):
        # sqlite3_value_text() is applied to both arguments, not just to the value, so a pattern
        # taken from a non-TEXT column has to work as well instead of raising inside the function
        # and failing the whole query.
        self.assertTrue(db.regexp(9, 9000))
        self.assertTrue(db.regexp(b'^ab', 'abc'))
        self.assertFalse(db.regexp(7, 9000))

    def test_sha1sum_docstring_example(self):
        sha1sum = getattr(db, '__sha1sum')
        self.assertEqual(
            sha1sum('linuxfabrik'), '74301e766db4a4006ec1fbd6e031760e7e322223'
        )

    def test_filter_str_strips_unsafe_chars(self):
        filter_str = getattr(db, '__filter_str')
        self.assertEqual(filter_str('user@example.ch'), 'userexamplech')
        self.assertEqual(filter_str('project-123', charclass='a-zA-Z0-9'), 'project123')


class TestImportCsv(unittest.TestCase):
    """import_csv() against a fixture."""

    def setUp(self):
        self.base = tempfile.mkdtemp(prefix='lftest-csv-')
        ok, self.conn = db.connect(path=self.base, filename='csv.db')
        self.assertTrue(ok, self.conn)
        self.csv = os.path.join(os.path.dirname(__file__), 'fixtures', 'EXAMPLE01.csv')

    def tearDown(self):
        db.close(self.conn)

    def test_import_csv_docstring_example(self):
        ok, _ = db.import_csv(
            self.conn,
            self.csv,
            table='data',
            fieldnames='date TEXT PRIMARY KEY, count FLOAT, name TEXT',
            skip_header=True,
        )
        self.assertTrue(ok)
        ok, rows = db.select(self.conn, 'SELECT date, name FROM data ORDER BY date')
        self.assertEqual([r['name'] for r in rows], ['alpha', 'beta', 'gamma'])

    def test_bad_row_aborts_with_line_number_and_keeps_database(self):
        # A duplicate primary key used to delete the database mid-import, after which every
        # remaining row failed against a closed connection.
        broken = os.path.join(self.base, 'broken.csv')
        with open(broken, 'w', encoding='utf-8') as f:
            f.write('1,ok\n2,ok\n2,duplicate\n3,ok\n')
        _, path = db.get_db_path(path=self.base, filename='csv.db')
        ok, msg = db.import_csv(
            self.conn, broken, table='data', fieldnames='id INT PRIMARY KEY, v TEXT'
        )
        self.assertFalse(ok)
        self.assertIn('line 3', msg)
        self.assertIn('UNIQUE constraint failed', msg)
        self.assertTrue(os.path.isfile(path), 'database was deleted on a bad CSV row')
        ok, rows = db.select(self.conn, 'SELECT id FROM data ORDER BY id')
        self.assertTrue(ok, rows)
        self.assertEqual([r['id'] for r in rows], [1, 2])

    def test_table_constraint_in_fieldnames_maps_columns_correctly(self):
        good = os.path.join(self.base, 'good.csv')
        with open(good, 'w', encoding='utf-8') as f:
            f.write('1,a\n2,b\n')
        ok, msg = db.import_csv(
            self.conn,
            good,
            table='data',
            fieldnames='id INT, v TEXT, PRIMARY KEY (id, v)',
        )
        self.assertTrue(ok, msg)
        _, rows = db.select(self.conn, 'SELECT id, v FROM data ORDER BY id')
        self.assertEqual(rows, [{'id': 1, 'v': 'a'}, {'id': 2, 'v': 'b'}])


class TestRmDb(unittest.TestCase):
    """rm_db(): closes the connection and removes the main database file."""

    def setUp(self):
        self.base = tempfile.mkdtemp(prefix='lftest-rmdb-')

    def test_removes_file_and_closes_connection(self):
        _, conn = db.connect(path=self.base, filename='r.db')
        _, path = db.get_db_path(path=self.base, filename='r.db')
        self.assertTrue(os.path.isfile(path))
        self.assertTrue(db.rm_db(conn))
        self.assertFalse(os.path.isfile(path))
        with self.assertRaises(sqlite3.ProgrammingError):
            conn.execute('SELECT 1')

    def test_removes_journal_wal_and_shm(self):
        # A rollback journal, a write-ahead log or its shared-memory index describes a database
        # that is being thrown away. They used to be left behind in the per-user temp directory.
        ok, conn = db.connect(path=self.base, filename='s.db')
        self.assertTrue(ok, conn)
        _, path = db.get_db_path(path=self.base, filename='s.db')
        siblings = [path + suffix for suffix in ('-journal', '-shm', '-wal')]
        for sibling in siblings:
            with open(sibling, 'wb') as f:
                f.write(b'')
        self.assertTrue(db.rm_db(conn))
        for leftover in [path, *siblings]:
            self.assertFalse(os.path.isfile(leftover), leftover)

    def test_in_memory_database_is_closed(self):
        # An in-memory database has no filename; the connection still has to be closed.
        conn = sqlite3.connect(':memory:')
        self.assertTrue(db.rm_db(conn))
        with self.assertRaises(sqlite3.ProgrammingError):
            conn.execute('SELECT 1')


class TestPerSecondDeltas(unittest.TestCase):
    """per_second_deltas(): None until two samples, then per-second rates."""

    def setUp(self):
        # per_second_deltas() has no path= argument and resolves the temp dir via
        # tempfile.gettempdir(), which caches on first use. Override the cache so
        # each test gets an isolated, empty database directory.
        self.tmp = tempfile.mkdtemp(prefix='lftest-psd-')
        self.saved_tempdir = tempfile.tempdir
        tempfile.tempdir = self.tmp

    def tearDown(self):
        tempfile.tempdir = self.saved_tempdir

    def test_first_run_returns_none(self):
        result = db.per_second_deltas('lftest-psd.db', 'eth0', {'rx_bytes': 100})
        self.assertIsNone(result)

    def test_second_run_returns_per_second_rates(self):
        # Pin time so the two samples are exactly 10 seconds apart.
        saved_now = db.time.now
        ticks = iter([1000, 1010])
        db.time.now = lambda: next(ticks)
        try:
            first = db.per_second_deltas(
                'lftest-psd-rate.db', 'eth0', {'rx_bytes': 100}
            )
            rates = db.per_second_deltas(
                'lftest-psd-rate.db', 'eth0', {'rx_bytes': 300}
            )
        finally:
            db.time.now = saved_now
        self.assertIsNone(first)
        self.assertIsNotNone(rates)
        self.assertAlmostEqual(rates['rx_bytes'], 20.0)  # (300-100) / (1010-1000)

    def test_two_names_can_share_one_cache_file(self):
        # The table used to be capped at two rows in total, so with two names each was left
        # with a single sample and neither ever produced a rate.
        saved_now = db.time.now
        ticks = iter([1000, 1000, 1010, 1010])
        db.time.now = lambda: next(ticks)
        try:
            for name, value in (('eth0', 100), ('eth1', 500)):
                self.assertIsNone(
                    db.per_second_deltas('lftest-psd-share.db', name, {'rx': value})
                )
            rates = {
                name: db.per_second_deltas('lftest-psd-share.db', name, {'rx': value})
                for name, value in (('eth0', 300), ('eth1', 1500))
            }
        finally:
            db.time.now = saved_now
        self.assertIsNotNone(rates['eth0'], 'eth1 pruned the baseline of eth0')
        self.assertIsNotNone(rates['eth1'], 'eth0 pruned the baseline of eth1')
        self.assertAlmostEqual(rates['eth0']['rx'], 20.0)  # (300-100) / 10
        self.assertAlmostEqual(rates['eth1']['rx'], 100.0)  # (1500-500) / 10

    def test_counter_name_needing_sanitizing_still_works(self):
        # The column name was sanitized for the CREATE but not for the INSERT, so a counter like
        # 'rx-bytes' created a column 'rxbytes' and then inserted into 'rx-bytes' forever.
        saved_now = db.time.now
        ticks = iter([1000, 1010])
        db.time.now = lambda: next(ticks)
        try:
            first = db.per_second_deltas(
                'lftest-psd-dash.db', 'eth0', {'rx-bytes': 100}
            )
            rates = db.per_second_deltas(
                'lftest-psd-dash.db', 'eth0', {'rx-bytes': 300}
            )
        finally:
            db.time.now = saved_now
        self.assertIsNone(first)
        self.assertIsNotNone(rates)
        # The caller reads the result back with the key it passed in, not with the column name.
        self.assertAlmostEqual(rates['rx-bytes'], 20.0)


class TestFirstSeen(unittest.TestCase):
    """first_seen(): ages an observed set, forgets what disappeared."""

    def setUp(self):
        # first_seen() has no path= argument and resolves the temp dir via
        # tempfile.gettempdir(), which caches on first use. Override the cache so
        # each test gets an isolated, empty database directory.
        self.tmp = tempfile.mkdtemp(prefix='lftest-fs-')
        self.saved_tempdir = tempfile.tempdir
        tempfile.tempdir = self.tmp

    def tearDown(self):
        tempfile.tempdir = self.saved_tempdir

    def test_first_run_ages_everything_zero(self):
        ages = db.first_seen('lftest-fs.db', 'demo', ['a', 'b'])
        self.assertEqual(ages, {'a': 0, 'b': 0})

    def test_age_grows_with_the_clock(self):
        saved_now = db.time.now
        ticks = iter([1000, 1000 + 777600])
        db.time.now = lambda: next(ticks)
        try:
            db.first_seen('lftest-fs-age.db', 'demo', ['a'])
            ages = db.first_seen('lftest-fs-age.db', 'demo', ['a'])
        finally:
            db.time.now = saved_now
        self.assertEqual(ages['a'], 777600)  # 9 days

    def test_a_key_that_returns_starts_over(self):
        # Otherwise a package that was installed and later needs an update again
        # would immediately be past a grace period it never actually spent.
        saved_now = db.time.now
        ticks = iter([1000, 2000, 3000])
        db.time.now = lambda: next(ticks)
        try:
            db.first_seen('lftest-fs-back.db', 'demo', ['a'])
            db.first_seen('lftest-fs-back.db', 'demo', [])
            ages = db.first_seen('lftest-fs-back.db', 'demo', ['a'])
        finally:
            db.time.now = saved_now
        self.assertEqual(ages['a'], 0)

    def test_two_names_do_not_forget_each_other(self):
        saved_now = db.time.now
        ticks = iter([1000, 1000, 2000])
        db.time.now = lambda: next(ticks)
        try:
            db.first_seen('lftest-fs-share.db', 'one', ['a'])
            db.first_seen('lftest-fs-share.db', 'two', ['b'])
            ages = db.first_seen('lftest-fs-share.db', 'one', ['a'])
        finally:
            db.time.now = saved_now
        self.assertEqual(ages['a'], 1000)

    def test_only_the_keys_asked_for_come_back(self):
        db.first_seen('lftest-fs-subset.db', 'demo', ['a', 'b', 'c'])
        ages = db.first_seen('lftest-fs-subset.db', 'demo', ['a', 'b', 'c'])
        self.assertEqual(sorted(ages), ['a', 'b', 'c'])

    def test_a_clock_that_went_backwards_yields_no_negative_age(self):
        # An NTP step or a cache restored from a backup would otherwise hand out
        # a negative age and let a grace period pass that never elapsed.
        saved_now = db.time.now
        ticks = iter([2000, 1000])
        db.time.now = lambda: next(ticks)
        try:
            db.first_seen('lftest-fs-back-clock.db', 'demo', ['a'])
            ages = db.first_seen('lftest-fs-back-clock.db', 'demo', ['a'])
        finally:
            db.time.now = saved_now
        self.assertEqual(ages['a'], 0)


if __name__ == '__main__':
    unittest.main()
