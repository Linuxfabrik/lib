"""Unit tests for lib.huawei_dorado.

Every public function of the module is covered hermetically. The module talks
to a Huawei storage appliance only through lib.url.fetch_json (HTTP), and it
persists tokens through lib.cache and reads the clock through lib.time /
time.sleep. All of those seams are mocked, so no network call, no real cache
file, and no real sleep ever happens.

Public functions under test:

- assert_ok()                -> abort unless the appliance reported success
- as_code()                  -> API status code -> int or None
- as_temperature()           -> reported temperature -> int or None (placeholders dropped)
- field()                    -> field lookup across the spellings a firmware may use
- get_controller_model()     -> code -> text mapping
- get_controller_role()      -> code -> text mapping
- get_cp_type()              -> code -> text mapping
- get_creds()                -> login + session caching (HTTP via fetch_json)
- get_all_data()             -> paged walk over a list endpoint (HTTP)
- get_data()                 -> authenticated GET, re-login on a rejected request (HTTP)
- get_error_code()           -> status code out of a response envelope
- get_enclosure_logic_type() -> code -> text mapping
- get_enclosure_model()      -> code -> text mapping
- get_health_status()        -> code -> text mapping
- get_health_status_state()  -> code -> STATE_* mapping
- get_host_access_state()    -> code -> text mapping
- get_hypermetro_domain_running_status_state()
                             -> code -> STATE_* mapping, domain-scoped
- get_interface_model()      -> code -> text mapping
- get_interface_runmode()    -> code -> text mapping
- get_led_status()           -> code -> text mapping
- get_os()                   -> code -> text mapping
- get_performance()          -> current counters, endpoint-spelling fallback (HTTP)
- get_performance_perfdata() -> counters -> performance data, in dashboard units
- get_product_mode()         -> code -> text mapping
- get_runlevel()             -> code -> text mapping
- get_running_status()       -> code -> text mapping
- get_running_status_state() -> code -> STATE_* mapping, healthy set per object
- get_switch_status()        -> code -> text mapping
- get_uuid()                 -> '{TYPE}:{ID}' builder
- sectors2bytes()            -> sector count -> bytes, sentinels dropped

The mapping helpers all share the same contract (int/str coercion, known
codes, 'Unknown' fallback, ValueError on non-numeric input), so they are
exercised through a single data-driven harness plus targeted edge-case tests.
The two HTTP functions are pinned end-to-end on the request they craft (URI,
headers, auth, body, encoding, insecure/no_proxy/timeout forwarding) and on
how they parse responses and behave under error / missing-key / empty-body
conditions.
"""

import contextlib
import io
import json
import sys
import typing
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.huawei_dorado as huawei
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# ---------------------------------------------------------------------------
# Test double for the args object passed to get_creds / get_data.
# ---------------------------------------------------------------------------


class Args:
    """Plain attribute bag mirroring the argparse namespace the module reads."""

    def __init__(self, **kw):
        defaults = {
            'URL': 'https://storage.example.com',
            'DEVICE_ID': 'DEV0001',
            'USERNAME': 'linuxfabrik',
            'PASSWORD': 'linuxfabrik',
            'SCOPE': '0',
            'INSECURE': False,
            'NO_PROXY': False,
            'TIMEOUT': 8,
            'CACHE_EXPIRE': 15,
        }
        defaults.update(kw)
        for key, value in defaults.items():
            setattr(self, key, value)


# Realistic captured-style login response as returned by url.fetch_json with
# extended=True: a (success, dict) tuple whose dict carries response_json and
# response_header.
LOGIN_OK = (
    True,
    {
        'response_json': {
            'data': {
                'iBaseToken': '1234567890123456789012345678901234567890',
                'deviceid': 'DEV0001',
                'username': 'linuxfabrik',
            },
            'error': {'code': 0, 'description': '0'},
        },
        # lib.url lower-cases all response header names (RFC 9110, section 5.1),
        # so the mock mirrors that canonical form.
        'response_header': {
            'set-cookie': 'session=abc123def456; Path=/deviceManager; HttpOnly',
            'content-type': 'application/json',
        },
    },
)

# Realistic captured-style data response for an authenticated GET.
DATA_OK = (
    True,
    {
        'data': [
            {'ID': '0', 'TYPE': '209', 'HEALTHSTATUS': '1', 'RUNNINGSTATUS': '27'},
            {'ID': '1', 'TYPE': '209', 'HEALTHSTATUS': '1', 'RUNNINGSTATUS': '27'},
        ],
        'error': {'code': 0, 'description': '0'},
    },
)


# ---------------------------------------------------------------------------
# Mapping helpers (data-driven).
# ---------------------------------------------------------------------------


class TestMappingHelpers(unittest.TestCase):
    """One representative known-code assertion per mapping function, run for
    both int and str input, plus the 'Unknown' fallback and ValueError path.

    The expected strings are taken verbatim from the module's own docstring
    examples / mapping tables, so they pin the public contract.
    """

    # (function, sample_code, expected_text)
    KNOWN: typing.ClassVar = [
        (huawei.get_controller_model, 4127, '2U2C PALM control board'),
        (huawei.get_controller_model, 4144, '2U2C NVMe control board'),
        (huawei.get_controller_model, 4174, '4U4C4P control board'),
        (huawei.get_controller_role, 0, 'Member'),
        (huawei.get_controller_role, 1, 'Primary'),
        (huawei.get_controller_role, 2, 'Secondary'),
        (huawei.get_cp_type, 1, 'Quorum Server'),
        (huawei.get_cp_type, 2, 'Quorum Disk'),
        (huawei.get_cp_type, 3, 'None'),
        (huawei.get_enclosure_logic_type, 1, 'Controller Enclosure'),
        (huawei.get_enclosure_logic_type, 3, 'Management Switch'),
        (
            huawei.get_enclosure_model,
            39,
            '4 U 75-slot 3.5-inch 12 Gbit/s SAS disk enclosure',
        ),
        (
            huawei.get_enclosure_model,
            122,
            '2 U 2-controller 25-slot 2.5-inch NVMe controller enclosure',
        ),
        (huawei.get_alarm_severity, 2, 'Informational (2)'),
        (huawei.get_alarm_severity, 6, 'Critical (6)'),
        (huawei.get_health_status, 1, 'Normal (1)'),
        (huawei.get_health_status, 5, 'Degraded (5)'),
        # Code 17 is worded per object: a disk reports 'single link', a host
        # 'no redundant link'. Nothing in the response says which applies, so
        # the label has to hold for both.
        (huawei.get_health_status, 17, 'Single link / No redundant link (17)'),
        (huawei.get_host_access_state, 2, 'Read-only'),
        (huawei.get_host_access_state, 3, 'Read/write'),
        (
            huawei.get_interface_model,
            2306,
            '4 ports FE 32 Gbit/s Fibre Channel I/O module',
        ),
        # 2330 is 100 Gbit/s in both documented firmware revisions; it was
        # transcribed as 10 Gbit/s when this mapping was first written.
        (huawei.get_interface_model, 2330, '2 ports FE 100 Gbit/s RoCE I/O module'),
        (huawei.get_interface_model, 4133, 'management module'),
        (huawei.get_interface_runmode, 1, 'FC'),
        # Code 5 means RoCE on 6.1.0 and RDMA on V700, and the response carries
        # no firmware marker, so the label has to hold under both.
        (huawei.get_interface_runmode, 5, 'RDMA/RoCE'),
        (huawei.get_interface_runmode, 10, 'RoCE'),
        (huawei.get_led_status, 0, 'Off'),
        (huawei.get_led_status, 1, 'On'),
        (huawei.get_os, 0, 'Linux'),
        (huawei.get_os, 7, 'VMware ESX'),
        # Not an operating system: the appliance substitutes 255 when the host
        # never reported one, so it must not fall through to 'Unknown'.
        (huawei.get_os, 255, 'not specified (255)'),
        (huawei.get_product_mode, 812, 'Dorado 5000 V6 (NVMe) (812)'),
        (huawei.get_product_mode, 818, 'Dorado 18000 V6 (NVMe) (818)'),
        (huawei.get_runlevel, 0, 'low (0)'),
        (huawei.get_runlevel, 1, 'normal (1)'),
        (huawei.get_runlevel, 2, 'high (2)'),
        (huawei.get_running_status, 1, 'Normal (1)'),
        (huawei.get_running_status, 11, 'Link down (11)'),
        (huawei.get_running_status, 47, 'Powering off (47)'),
        (huawei.get_running_status, 48, 'Charging (48)'),
        (huawei.get_running_status, 49, 'Charging completed (49)'),
        # 94 is 'error' on 6.1.0 and 'faulty' on V700, with no firmware marker
        # in the response, so the label has to hold under both.
        (huawei.get_running_status, 94, 'Error/Faulty (94)'),
        # V700 words 112 as a failed rollback throughout. 6.1.0 also calls it
        # 'faulty restoration', which reads as the opposite of what it means.
        (huawei.get_running_status, 112, 'Rollback failure (112)'),
        (huawei.get_switch_status, 1, 'On'),
        (huawei.get_switch_status, 2, 'Off'),
    ]

    # Functions that fall back to a literal 'Unknown' string for unknown codes.
    UNKNOWN_FALLBACK: typing.ClassVar = [
        huawei.get_controller_model,
        huawei.get_controller_role,
        huawei.get_cp_type,
        huawei.get_enclosure_logic_type,
        huawei.get_enclosure_model,
        huawei.get_health_status,
        huawei.get_host_access_state,
        huawei.get_interface_model,
        huawei.get_interface_runmode,
        huawei.get_led_status,
        huawei.get_os,
        huawei.get_product_mode,
        huawei.get_runlevel,
        huawei.get_running_status,
        huawei.get_switch_status,
    ]

    def test_known_codes_as_int(self):
        for func, code, expected in self.KNOWN:
            with self.subTest(func=func.__name__, code=code):
                self.assertEqual(func(code), expected)

    def test_known_codes_as_str(self):
        # Every helper coerces with int(), so the string form must match.
        for func, code, expected in self.KNOWN:
            with self.subTest(func=func.__name__, code=str(code)):
                self.assertEqual(func(str(code)), expected)

    def test_unknown_code_returns_unknown(self):
        for func in self.UNKNOWN_FALLBACK:
            with self.subTest(func=func.__name__):
                self.assertEqual(func(999999), 'Unknown')

    def test_non_numeric_input_returns_unknown(self):
        for func in self.UNKNOWN_FALLBACK:
            with self.subTest(func=func.__name__):
                self.assertEqual(func('not-a-number'), 'Unknown')

    def test_none_input_returns_unknown(self):
        # A field the appliance did not report reaches the helper as None,
        # because the callers read it with a plain .get(). That has to render
        # as 'Unknown' and let the check report a status; raising here would
        # take down the whole check over a single missing field.
        for func in self.UNKNOWN_FALLBACK:
            with self.subTest(func=func.__name__):
                self.assertEqual(func(None), 'Unknown')

    def test_unusable_input_types_return_unknown(self):
        for func in self.UNKNOWN_FALLBACK:
            for value in ('', '  ', [], {}, None):
                with self.subTest(func=func.__name__, value=value):
                    self.assertEqual(func(value), 'Unknown')


# ---------------------------------------------------------------------------
# get_health_status / get_running_status include the raw code in brackets.
# Pin that formatting explicitly because plugin output relies on it.
# ---------------------------------------------------------------------------


class TestStatusFormatting(unittest.TestCase):
    def test_health_status_appends_code_in_brackets(self):
        self.assertEqual(huawei.get_health_status(2), 'Faulty (2)')
        self.assertEqual(huawei.get_health_status('18'), 'Offline (18)')

    def test_running_status_appends_code_in_brackets(self):
        self.assertEqual(huawei.get_running_status(2), 'Running (2)')
        self.assertEqual(huawei.get_running_status('115'), 'Verifying (115)')

    def test_runlevel_appends_code_in_brackets(self):
        self.assertEqual(huawei.get_runlevel('2'), 'high (2)')

    def test_product_mode_appends_code_in_brackets(self):
        self.assertEqual(huawei.get_product_mode(813), 'Dorado 6000 V6 (SAS) (813)')


# ---------------------------------------------------------------------------
# The severity mappers. Unlike the text mappers these decide what a check
# reports, so every branch is pinned, including the fallback that must never
# silently pass as OK.
# ---------------------------------------------------------------------------


class TestAlarmSeverityState(unittest.TestCase):
    def test_informational_is_ok(self):
        # A note, not a fault. The 2017-era external check crashed on it.
        self.assertEqual(huawei.get_alarm_severity_state(2), STATE_OK)

    def test_critical_is_critical(self):
        self.assertEqual(huawei.get_alarm_severity_state(6), STATE_CRIT)

    def test_warning_and_major_warn(self):
        # Major degrades the array without stopping it.
        for code in (3, 5):
            with self.subTest(code=code):
                self.assertEqual(huawei.get_alarm_severity_state(code), STATE_WARN)

    def test_accepts_string_codes(self):
        self.assertEqual(huawei.get_alarm_severity_state('6'), STATE_CRIT)

    def test_unmapped_code_warns(self):
        # Minor (4) exists on other Huawei product lines but not on Dorado.
        self.assertEqual(huawei.get_alarm_severity_state(4), STATE_WARN)

    def test_missing_value_warns(self):
        self.assertEqual(huawei.get_alarm_severity_state(None), STATE_WARN)


class TestHealthStatusState(unittest.TestCase):
    def test_normal_is_ok(self):
        self.assertEqual(huawei.get_health_status_state(1), STATE_OK)

    def test_failed_codes_are_critical(self):
        for code in (2, 11, 14, 18):
            self.assertEqual(huawei.get_health_status_state(code), STATE_CRIT)

    def test_no_input_is_critical(self):
        # 'No Input' is what a power module answers when its feed is dead. That
        # is not a reduced state the array keeps serving in, so it must not be
        # a warning an operator can leave sitting.
        self.assertEqual(huawei.get_health_status_state(11), STATE_CRIT)

    def test_degradations_warn(self):
        for code in (3, 4, 5, 7, 9, 12, 15, 17):
            self.assertEqual(huawei.get_health_status_state(code), STATE_WARN)

    def test_accepts_string_codes(self):
        self.assertEqual(huawei.get_health_status_state('2'), STATE_CRIT)
        self.assertEqual(huawei.get_health_status_state('1'), STATE_OK)

    def test_unmapped_code_warns(self):
        # A code this firmware invented is not evidence that everything is
        # fine, so it must not fall through to OK.
        self.assertEqual(huawei.get_health_status_state(99), STATE_WARN)

    def test_missing_value_warns(self):
        self.assertEqual(huawei.get_health_status_state(None), STATE_WARN)
        self.assertEqual(huawei.get_health_status_state(''), STATE_WARN)


class TestRunningStatusState(unittest.TestCase):
    def test_caller_supplied_ok_codes(self):
        self.assertEqual(huawei.get_running_status_state(27, (1, 27)), STATE_OK)
        self.assertEqual(huawei.get_running_status_state(1, (1, 27)), STATE_OK)

    def test_same_code_differs_per_object(self):
        # Charging is the resting state of a backup power module and nonsense
        # anywhere else, which is the whole reason ok_codes is a parameter.
        self.assertEqual(huawei.get_running_status_state(48, (1, 2, 27, 48, 49)), STATE_OK)
        self.assertEqual(huawei.get_running_status_state(48, (1, 27)), STATE_WARN)

    def test_failed_codes_are_critical(self):
        for code in (3, 5, 28, 35, 74, 94, 100, 103, 105, 112):
            self.assertEqual(huawei.get_running_status_state(code, (1, 27)), STATE_CRIT)

    def test_out_of_service_codes_are_critical(self):
        # Not running, a disk parked because it got too hot, and a replication
        # relationship that is not mirroring all describe a component that has
        # stopped doing its job rather than one working in a reduced state.
        for code in (3, 5, 100):
            self.assertEqual(huawei.get_running_status_state(code, (1, 27)), STATE_CRIT)

    def test_ok_codes_win_over_the_failed_set(self):
        # The healthy set is the caller's to state, so an object for which one
        # of the failed codes really is healthy can still declare it as such.
        self.assertEqual(huawei.get_running_status_state(3, (1, 3)), STATE_OK)

    def test_transitional_codes_warn(self):
        for code in (12, 23, 47, 51):
            self.assertEqual(huawei.get_running_status_state(code, (1, 27)), STATE_WARN)

    def test_accepts_string_codes(self):
        self.assertEqual(huawei.get_running_status_state('27', (1, 27)), STATE_OK)
        self.assertEqual(huawei.get_running_status_state('94', (1, 27)), STATE_CRIT)

    def test_unmapped_code_warns(self):
        self.assertEqual(huawei.get_running_status_state(200, (1, 27)), STATE_WARN)

    def test_missing_value_warns(self):
        # None must not match an ok_codes entry through some coercion path.
        self.assertEqual(huawei.get_running_status_state(None, (1, 27)), STATE_WARN)


class TestHypermetroDomainRunningStatusState(unittest.TestCase):
    def test_normal_is_ok(self):
        # The domain renumbers from 0 up, so 0 is its normal, not 1.
        self.assertEqual(huawei.get_hypermetro_domain_running_status_state(0), STATE_OK)

    def test_faulty_and_invalid_are_critical(self):
        for code in (2, 5):
            self.assertEqual(
                huawei.get_hypermetro_domain_running_status_state(code), STATE_CRIT
            )

    def test_recovering_split_and_forced_warn(self):
        for code in (1, 3, 4):
            self.assertEqual(
                huawei.get_hypermetro_domain_running_status_state(code), STATE_WARN
            )

    def test_does_not_share_the_general_enumeration(self):
        # Read through the shared mapper code 1 would be 'Normal' and come out
        # OK; on a domain it means the mirror is still recovering.
        self.assertEqual(huawei.get_running_status_state(1, (1,)), STATE_OK)
        self.assertEqual(huawei.get_hypermetro_domain_running_status_state(1), STATE_WARN)

    def test_missing_value_warns(self):
        self.assertEqual(huawei.get_hypermetro_domain_running_status_state(None), STATE_WARN)


# ---------------------------------------------------------------------------
# get_host_access_state special case: code 5 maps to the literal 'Unknown',
# which is indistinguishable from the fallback. Pin both paths.
# ---------------------------------------------------------------------------


class TestHostAccessState(unittest.TestCase):
    def test_access_denied(self):
        self.assertEqual(huawei.get_host_access_state(1), 'Access denied')

    def test_code_5_falls_back_to_unknown(self):
        # Code 5 used to be an explicit entry with the value 'Unknown'. Neither
        # documented revision defines it, so it goes through the fallback now.
        self.assertEqual(huawei.get_host_access_state(5), 'Unknown')

    def test_unmapped_code_falls_back_to_unknown(self):
        self.assertEqual(huawei.get_host_access_state(42), 'Unknown')


# ---------------------------------------------------------------------------
# get_uuid()
# ---------------------------------------------------------------------------


class TestGetUuid(unittest.TestCase):
    def test_builds_type_colon_id(self):
        self.assertEqual(huawei.get_uuid({'TYPE': '207', 'ID': '0A'}), '207:0A')

    def test_accepts_integer_fields(self):
        # str.format() stringifies non-string values.
        self.assertEqual(huawei.get_uuid({'TYPE': 209, 'ID': 0}), '209:0')

    def test_ignores_extra_keys(self):
        data = {'TYPE': '11', 'ID': '5', 'NAME': 'CTE0.A', 'HEALTHSTATUS': '1'}
        self.assertEqual(huawei.get_uuid(data), '11:5')

    def test_missing_id_renders_placeholder(self):
        # An incomplete object still has to yield a printable identifier; a
        # KeyError here would abort the caller over one missing field.
        self.assertEqual(huawei.get_uuid({'TYPE': '207'}), '207:--')

    def test_missing_type_renders_placeholder(self):
        self.assertEqual(huawei.get_uuid({'ID': '0A'}), '--:0A')

    def test_empty_dict_renders_placeholders(self):
        self.assertEqual(huawei.get_uuid({}), '--:--')


# ---------------------------------------------------------------------------
# as_code(), assert_ok(), field() and sectors2bytes()
# ---------------------------------------------------------------------------


class TestAssertOk(unittest.TestCase):
    def test_success_returns(self):
        self.assertIsNone(huawei.assert_ok({'error': {'code': 0}, 'data': []}, 'the fans'))

    def test_success_as_a_string_returns(self):
        # Some endpoints report the code as a string. Treating that as an error would take
        # every check on such a firmware to UNKNOWN.
        self.assertIsNone(huawei.assert_ok({'error': {'code': '0'}}, 'the fans'))

    def test_error_aborts(self):
        with self.assertRaises(SystemExit) as ctx:
            huawei.assert_ok({'error': {'code': -401}}, 'the fans')
        self.assertEqual(ctx.exception.code, STATE_UNKNOWN)

    def test_error_text_names_the_query_and_the_appliance_reason(self):
        with self.assertRaises(SystemExit), contextlib.redirect_stdout(io.StringIO()) as out:
            huawei.assert_ok(
                {
                    'error': {
                        'code': -401,
                        'description': 'REST unauthorized',
                        'suggestion': 'log in again',
                    }
                },
                'the fans',
            )
        printed = out.getvalue()
        self.assertIn('the fans', printed)
        self.assertIn('-401', printed)
        self.assertIn('REST unauthorized', printed)
        self.assertIn('log in again', printed)

    def test_empty_response_aborts(self):
        # get_data() always answers with an envelope, so nothing at all means the check
        # never reached the appliance.
        with self.assertRaises(SystemExit):
            huawei.assert_ok({}, 'the fans')

    def test_scalar_error_aborts_without_a_type_error(self):
        # A firmware answering with a bare code rather than the documented object must end
        # in a clean UNKNOWN, not in an AttributeError inside the check.
        with self.assertRaises(SystemExit) as ctx:
            huawei.assert_ok({'error': -401}, 'the fans')
        self.assertEqual(ctx.exception.code, STATE_UNKNOWN)

    def test_missing_error_object_aborts(self):
        with self.assertRaises(SystemExit):
            huawei.assert_ok({'data': []}, 'the fans')


class TestAsCode(unittest.TestCase):
    def test_parses_the_strings_the_api_sends(self):
        self.assertEqual(huawei.as_code('27'), 27)

    def test_passes_an_integer_through(self):
        self.assertEqual(huawei.as_code(27), 27)

    def test_parses_a_negative_sentinel(self):
        self.assertEqual(huawei.as_code('-1'), -1)

    def test_unusable_values_are_none(self):
        # A missing field, the appliance's own '--' placeholder and an empty string all
        # mean "nothing to report". Raising here would end a check in a traceback over
        # one unexpected field.
        for value in (None, '', '--', 'n/a', [], {}):
            with self.subTest(value=value):
                self.assertIsNone(huawei.as_code(value))


class TestAsTemperature(unittest.TestCase):
    def test_parses_a_reading(self):
        self.assertEqual(huawei.as_temperature('42'), 42)
        self.assertEqual(huawei.as_temperature(42), 42)

    def test_controller_placeholder_is_none(self):
        # The vendor's own controller response example carries "-1" for a board
        # without a temperature sensor. Passed on as a reading it would be below
        # the implicit lower bound of every Nagios range, so a plain
        # --critical-temperature=55 would report CRITICAL on a healthy board.
        self.assertIsNone(huawei.as_temperature('-1'))

    def test_power_module_placeholder_is_none(self):
        # The power module example uses "0" for the same thing.
        self.assertIsNone(huawei.as_temperature('0'))
        self.assertIsNone(huawei.as_temperature(0))

    def test_unusable_values_are_none(self):
        for value in (None, '', '--', 'n/a', [], {}):
            with self.subTest(value=value):
                self.assertIsNone(huawei.as_temperature(value))


class TestField(unittest.TestCase):
    def test_reads_the_exact_name(self):
        self.assertEqual(huawei.field({'MODEL': 'x'}, 'MODEL'), 'x')

    def test_prefers_the_first_name_that_is_present(self):
        # A firmware that reports both an old field and its replacement has to yield the
        # preferred one, not whichever the dict happens to iterate first.
        data = {'allocatedPoolQuota': '10', 'ALLOCCAPACITY': '20'}
        self.assertEqual(
            huawei.field(data, 'allocatedPoolQuota', 'ALLOCCAPACITY'), '10'
        )

    def test_matches_a_different_case(self):
        # The sfp object is documented in camelCase and answered in upper case on the
        # same page of the REST Interface Reference.
        self.assertEqual(huawei.field({'RXPOWER': '[12]'}, 'rxPowerReal', 'RXPOWER'), '[12]')
        self.assertEqual(huawei.field({'healthStatus': '1'}, 'HEALTHSTATUS'), '1')

    def test_exact_match_wins_over_a_case_insensitive_one(self):
        data = {'SPEED': 'upper', 'speed': 'lower'}
        self.assertEqual(huawei.field(data, 'speed'), 'lower')

    def test_missing_field_yields_the_default(self):
        self.assertIsNone(huawei.field({}, 'MODEL'))
        self.assertEqual(huawei.field({}, 'MODEL', default='--'), '--')

    def test_present_but_empty_counts_as_found(self):
        # '--' and '' are what the appliance sends for "no value". Falling back to the
        # default would hide the difference between a field a firmware does not have and
        # one it has nothing to say about.
        self.assertEqual(huawei.field({'MODEL': ''}, 'MODEL', default='--'), '')


class TestGetPerformancePerfdata(unittest.TestCase):
    def test_renders_a_counter_under_its_vendor_name(self):
        self.assertEqual(
            huawei.get_performance_perfdata('207_0A', {'22': '4711'}),
            "'207_0A_total_iops'=4711;;;0 ",
        )

    def test_percentages_carry_both_bounds(self):
        self.assertEqual(
            huawei.get_performance_perfdata('207_0A', {'18': '80'}),
            "'207_0A_usage_percent'=80%;;;0;100 ",
        )

    def test_microseconds_become_seconds(self):
        # The vendor documents the response times in microseconds; a Nagios unit of
        # measurement knows seconds.
        self.assertEqual(
            huawei.get_performance_perfdata('207_0A', {'370': '385'}),
            "'207_0A_avg_io_response_time'=0.000385s;;;0 ",
        )

    def test_bandwidth_becomes_bytes(self):
        # 132 MB/s, read as binary multiples like every other capacity this API reports.
        self.assertEqual(
            huawei.get_performance_perfdata('207_0A', {'21': '132'}),
            "'207_0A_block_bandwidth'=138412032B;;;0 ",
        )

    def test_unknown_indicator_is_skipped(self):
        # A bare indicator number is not a metric name a dashboard can be built on, and
        # some firmware answers with indicators nobody asked for.
        self.assertEqual(huawei.get_performance_perfdata('207_0A', {'999999': '1'}), '')

    def test_unusable_value_is_skipped(self):
        # The appliance sends '--' for a counter it is not collecting.
        self.assertEqual(huawei.get_performance_perfdata('207_0A', {'22': '--'}), '')

    def test_no_samples_yield_no_perfdata(self):
        self.assertEqual(huawei.get_performance_perfdata('207_0A', {}), '')

    def test_every_documented_indicator_has_a_label_a_unit_and_a_factor(self):
        for data_id, descriptor in huawei.PERFORMANCE_INDICATORS.items():
            with self.subTest(data_id=data_id):
                label, uom, factor = descriptor
                self.assertTrue(label)
                self.assertIn(uom, (None, '%', 'B', 's'))
                self.assertGreater(factor, 0)


class TestSectors2Bytes(unittest.TestCase):
    def test_converts_with_the_default_sector_size(self):
        self.assertEqual(huawei.sectors2bytes('2048'), 1048576)

    def test_converts_with_a_reported_sector_size(self):
        self.assertEqual(huawei.sectors2bytes('2048', 4096), 8388608)

    def test_zero_stays_zero(self):
        # An empty pool is a real reading, not a missing one.
        self.assertEqual(huawei.sectors2bytes(0), 0)

    def test_negative_sentinels_are_none(self):
        # The appliance reports -1 for a capacity it does not have; graphing that gives a
        # spike where a gap belongs.
        self.assertIsNone(huawei.sectors2bytes('-1'))

    def test_unusable_values_are_none(self):
        for value in (None, '', '--'):
            with self.subTest(value=value):
                self.assertIsNone(huawei.sectors2bytes(value))


# ---------------------------------------------------------------------------
# Shared base for the HTTP functions: patches cache, time, time.sleep,
# url.fetch_json and url.fetch so nothing escapes the process.
# ---------------------------------------------------------------------------


class HuaweiHttpTestBase(unittest.TestCase):
    def setUp(self):
        self.args = Args()

        # url.fetch_json mock; individual tests set return_value / side_effect.
        self.fetch_json = mock.MagicMock(name='fetch_json', return_value=LOGIN_OK)
        self._p_fetch = mock.patch.object(huawei.url, 'fetch_json', self.fetch_json)

        # `_logout()` goes through url.fetch(), not url.fetch_json(). Without this
        # patch every test that ends a session would send a real DELETE to the
        # example host in Args.
        self.fetch = mock.MagicMock(name='fetch', return_value=(True, ''))
        self._p_fetch_raw = mock.patch.object(huawei.url, 'fetch', self.fetch)

        # cache.get returns None by default (empty cache); cache.set is a no-op.
        self.cache_get = mock.MagicMock(name='cache.get', return_value=None)
        self.cache_set = mock.MagicMock(name='cache.set')
        self._p_cget = mock.patch.object(huawei.cache, 'get', self.cache_get)
        self._p_cset = mock.patch.object(huawei.cache, 'set', self.cache_set)

        # Freeze the clock the module uses for cache expiry.
        self.now = mock.MagicMock(name='time.now', return_value=1_000_000)
        self._p_now = mock.patch.object(huawei.time, 'now', self.now)

        # Make the retry throttle (time.sleep) a no-op so the suite stays fast.
        self.sleep = mock.MagicMock(name='time.sleep')
        self._p_sleep = mock.patch.object(huawei, '_sleep', self.sleep)

        for p in (
            self._p_fetch,
            self._p_fetch_raw,
            self._p_cget,
            self._p_cset,
            self._p_now,
            self._p_sleep,
        ):
            p.start()
            self.addCleanup(p.stop)

    def last_call(self):
        self.assertTrue(self.fetch_json.called, 'fetch_json was never called')
        return self.fetch_json.call_args

    def sent_uri(self):
        return self.last_call().args[0]

    def sent_kwargs(self):
        return self.last_call().kwargs


# ---------------------------------------------------------------------------
# get_creds()
# ---------------------------------------------------------------------------


class TestGetCreds(HuaweiHttpTestBase):
    def test_login_returns_token_cookie_and_device_id(self):
        self.fetch_json.return_value = LOGIN_OK
        token, cookie, device_id = huawei.get_creds(self.args)
        self.assertEqual(token, '1234567890123456789012345678901234567890')
        self.assertEqual(cookie, 'session=abc123def456; Path=/deviceManager; HttpOnly')
        self.assertEqual(device_id, 'DEV0001')

    def test_login_uri_includes_device_id(self):
        huawei.get_creds(self.args)
        self.assertEqual(
            self.sent_uri(),
            'https://storage.example.com/deviceManager/rest/DEV0001/sessions',
        )

    def test_login_without_a_device_id_uses_the_placeholder_path(self):
        # The vendor's own login example addresses the placeholder, and the appliance
        # answers with its real device id. An operator therefore does not have to look
        # the id up before the check can run.
        self.args = Args(DEVICE_ID='')
        huawei.get_creds(self.args)
        self.assertEqual(
            self.sent_uri(),
            'https://storage.example.com/deviceManager/rest/xxxxx/sessions',
        )

    def test_login_without_a_device_id_takes_it_from_the_response(self):
        self.args = Args(DEVICE_ID='')
        _, _, device_id = huawei.get_creds(self.args)
        self.assertEqual(device_id, 'DEV0001')

    def test_supplied_device_id_wins_over_the_response(self):
        # An operator can read the id off DeviceManager, so an appliance answering with
        # something unexpected stays addressable.
        self.args = Args(DEVICE_ID='OPERATOR-SUPPLIED')
        _, _, device_id = huawei.get_creds(self.args)
        self.assertEqual(device_id, 'OPERATOR-SUPPLIED')

    def test_login_body_carries_credentials_and_scope(self):
        huawei.get_creds(self.args)
        self.assertEqual(
            self.sent_kwargs()['data'],
            {'username': 'linuxfabrik', 'password': 'linuxfabrik', 'scope': '0'},
        )

    def test_login_content_type_header(self):
        huawei.get_creds(self.args)
        self.assertEqual(
            self.sent_kwargs()['header'], {'Content-Type': 'application/json'}
        )

    def test_login_uses_serialized_json_encoding(self):
        huawei.get_creds(self.args)
        self.assertEqual(self.sent_kwargs()['encoding'], 'serialized-json')

    def test_login_requests_extended_response(self):
        # extended=True is required so the Set-Cookie header is available.
        huawei.get_creds(self.args)
        self.assertTrue(self.sent_kwargs()['extended'])

    def test_login_forwards_insecure_no_proxy_timeout(self):
        self.args = Args(INSECURE=True, NO_PROXY=True, TIMEOUT=42)
        huawei.get_creds(self.args)
        kw = self.sent_kwargs()
        self.assertTrue(kw['insecure'])
        self.assertTrue(kw['no_proxy'])
        self.assertEqual(kw['timeout'], 42)

    def test_login_caches_token_cookie_and_device_id(self):
        # One key, not three: a request needs all of them, so a write that only partly
        # succeeds would leave a cache that can never be reused and force a login on
        # every single run.
        huawei.get_creds(self.args)
        self.cache_set.assert_called_once_with(
            'huaweidorado-https://storage.example.com-linuxfabrik-session',
            json.dumps(
                [
                    '1234567890123456789012345678901234567890',
                    'session=abc123def456; Path=/deviceManager; HttpOnly',
                    'DEV0001',
                ]
            ),
            1_000_000 + 15 * 60,
            filename=huawei.CACHE_FILENAME,
        )

    def test_cache_expiry_uses_cache_expire_minutes(self):
        self.args = Args(CACHE_EXPIRE=30)
        huawei.get_creds(self.args)
        # now (1_000_000) + 30 minutes * 60 seconds
        for call in self.cache_set.call_args_list:
            self.assertEqual(call.args[2], 1_000_000 + 30 * 60)

    def test_cache_expire_zero_disables_caching(self):
        # Not "expires in zero seconds": lib.cache reads the expire argument as an
        # absolute timestamp, so passing now() would store an entry that lives for
        # about a second. An operator setting 0 asks for no caching at all.
        self.args = Args(CACHE_EXPIRE=0)
        token, _, _ = huawei.get_creds(self.args)
        self.assertEqual(token, '1234567890123456789012345678901234567890')
        self.assertFalse(self.cache_get.called)
        self.assertFalse(self.cache_set.called)

    def test_own_cache_file_is_used(self):
        huawei.get_creds(self.args)
        self.assertEqual(
            self.cache_get.call_args.kwargs['filename'], huawei.CACHE_FILENAME
        )

    def test_cache_key_includes_url_and_username(self):
        # The device id is not in the key: it is optional and the appliance accepts any
        # string for it on the initial login, so it does not identify an appliance. The
        # URL does. The user name is in the key because a session carries that user's role.
        self.args = Args(DEVICE_ID='OTHERBOX', USERNAME='readonly')
        huawei.get_creds(self.args)
        read_keys = [c.args[0] for c in self.cache_get.call_args_list]
        self.assertIn(
            'huaweidorado-https://storage.example.com-readonly-session',
            read_keys,
        )

    def test_cached_session_short_circuits_login(self):
        self.cache_get.return_value = json.dumps(
            ['CACHED-TOKEN', 'CACHED-COOKIE', 'CACHED-DEV']
        )
        token, cookie, device_id = huawei.get_creds(self.args)
        self.assertEqual(token, 'CACHED-TOKEN')
        self.assertEqual(cookie, 'CACHED-COOKIE')
        self.assertEqual(device_id, 'CACHED-DEV')
        self.assertFalse(self.fetch_json.called)
        self.assertFalse(self.cache_set.called)

    def test_force_relogin_replaces_the_cached_session(self):
        # The cache is still read on this path, but not to reuse the session: the old
        # one has to be handed back to the appliance, otherwise it occupies a slot in
        # the session pool until its timeout expires.
        self.cache_get.return_value = json.dumps(
            ['CACHED-TOKEN', 'CACHED-COOKIE', 'CACHED-DEV']
        )
        token, _, _ = huawei.get_creds(self.args, force_relogin=True)
        self.assertTrue(self.cache_get.called)
        self.assertTrue(self.fetch_json.called)
        self.assertEqual(token, '1234567890123456789012345678901234567890')

    def test_force_relogin_logs_the_cached_session_out(self):
        self.cache_get.return_value = json.dumps(
            ['CACHED-TOKEN', 'CACHED-COOKIE', 'CACHED-DEV']
        )
        huawei.get_creds(self.args, force_relogin=True)
        self.assertTrue(self.fetch.called, 'the old session was never logged out')
        self.assertEqual(self.fetch.call_args.kwargs['method'], 'DELETE')
        self.assertEqual(
            self.fetch.call_args.kwargs['header'],
            {'Cookie': 'CACHED-COOKIE', 'iBaseToken': 'CACHED-TOKEN'},
        )

    def test_logout_addresses_the_device_id_of_the_session(self):
        # Not args.DEVICE_ID: a session opened without one carries the appliance's own
        # answer, and that is the only path the logout is accepted on.
        self.args = Args(DEVICE_ID='')
        self.cache_get.return_value = json.dumps(
            ['CACHED-TOKEN', 'CACHED-COOKIE', 'CACHED-DEV']
        )
        huawei.get_creds(self.args, force_relogin=True)
        self.assertEqual(
            self.fetch.call_args.args[0],
            'https://storage.example.com/deviceManager/rest/CACHED-DEV/sessions',
        )

    def test_force_relogin_without_a_cached_session_logs_nothing_out(self):
        self.cache_get.return_value = None
        huawei.get_creds(self.args, force_relogin=True)
        self.assertFalse(self.fetch.called)

    def test_unusable_cache_entry_triggers_relogin(self):
        # Written by an older version, truncated, or missing half the pair. All
        # three have the same answer: log in again rather than build a request
        # header out of it.
        for cached in (
            'not-json',
            json.dumps('CACHED-TOKEN'),
            json.dumps(['CACHED-TOKEN']),
            json.dumps(['CACHED-TOKEN', 'CACHED-COOKIE']),
            json.dumps(['CACHED-TOKEN', 'CACHED-COOKIE', '']),
            json.dumps({'ibasetoken': 'CACHED-TOKEN'}),
        ):
            with self.subTest(cached=cached):
                self.fetch_json.reset_mock()
                self.fetch_json.return_value = LOGIN_OK
                self.cache_get.return_value = cached
                token, _, _ = huawei.get_creds(self.args)
                self.assertTrue(self.fetch_json.called)
                self.assertEqual(token, '1234567890123456789012345678901234567890')

    def test_empty_login_response_aborts(self):
        # Malformed / empty body: no token to work with. Aborting here beats
        # caching a None that only fails later, in an unrelated place.
        self.fetch_json.return_value = (True, {})
        with self.assertRaises(SystemExit):
            huawei.get_creds(self.args)
        self.assertFalse(self.cache_set.called)

    def test_rejected_login_aborts_without_caching(self):
        # A wrong password answers HTTP 200 with a non-zero error code.
        self.fetch_json.return_value = (
            True,
            {
                'response_json': {
                    'error': {'code': 1077949061, 'description': 'Invalid password'}
                },
                'response_header': {},
            },
        )
        with self.assertRaises(SystemExit):
            huawei.get_creds(self.args)
        self.assertFalse(self.cache_set.called)

    def test_login_failure_exits_via_coe(self):
        # url.fetch_json returns (False, error); base.coe must abort the run.
        self.fetch_json.return_value = (False, 'connection refused')
        with self.assertRaises(SystemExit):
            huawei.get_creds(self.args)


# ---------------------------------------------------------------------------
# get_data()
# ---------------------------------------------------------------------------


class TestGetData(HuaweiHttpTestBase):
    def setUp(self):
        super().setUp()
        # get_data calls get_creds internally; stub it so these tests focus on
        # the data request and retry loop, not on the login round-trip.
        self._p_creds = mock.patch.object(
            huawei, 'get_creds', return_value=('TOKEN', 'COOKIE', 'DEV0001')
        )
        self.get_creds = self._p_creds.start()
        self.addCleanup(self._p_creds.stop)
        self.fetch_json.return_value = DATA_OK

    def test_success_first_try_returns_payload(self):
        result = huawei.get_data('disk', self.args)
        self.assertEqual(result['error']['code'], 0)
        self.assertEqual(result['data'][0]['ID'], '0')

    def test_response_is_not_decorated_with_extra_keys(self):
        # The return value is the appliance's own document. Adding a key to it
        # would overwrite an API field that happens to share the name.
        result = huawei.get_data('disk', self.args)
        self.assertEqual(set(result), {'data', 'error'})

    def test_success_first_try_does_not_sleep(self):
        huawei.get_data('disk', self.args)
        self.assertFalse(self.sleep.called)
        self.assertEqual(self.fetch_json.call_count, 1)

    def test_uri_includes_device_id_and_endpoint(self):
        huawei.get_data('disk', self.args)
        self.assertEqual(
            self.sent_uri(),
            'https://storage.example.com/deviceManager/rest/DEV0001/disk',
        )

    def test_query_string_is_passed_through_on_the_endpoint(self):
        huawei.get_data('disk?range=[0-100]', self.args)
        self.assertEqual(
            self.sent_uri(),
            'https://storage.example.com/deviceManager/rest/DEV0001/disk?range=[0-100]',
        )

    def test_auth_headers_carry_token_and_cookie(self):
        huawei.get_data('disk', self.args)
        header = self.sent_kwargs()['header']
        self.assertEqual(header['Content-Type'], 'application/json')
        self.assertEqual(header['iBaseToken'], 'TOKEN')
        self.assertEqual(header['Cookie'], 'COOKIE')

    def test_forwards_insecure_no_proxy_timeout(self):
        self.args = Args(INSECURE=True, NO_PROXY=True, TIMEOUT=21)
        huawei.get_data('disk', self.args)
        kw = self.sent_kwargs()
        self.assertTrue(kw['insecure'])
        self.assertTrue(kw['no_proxy'])
        self.assertEqual(kw['timeout'], 21)

    def test_retries_until_max_on_persistent_error(self):
        # Every attempt is rejected; the loop runs its three bounded attempts.
        self.fetch_json.return_value = (True, {'error': {'code': -401}})
        huawei.get_data('disk', self.args)
        self.assertEqual(self.fetch_json.call_count, 3)
        # sleep runs only between attempts, so one fewer than the attempt count.
        self.assertEqual(self.sleep.call_count, 2)

    def test_forces_relogin_on_second_attempt(self):
        # A rejected first request must trigger a fresh login (force_relogin)
        # rather than reusing the same token forever.
        self.fetch_json.return_value = (True, {'error': {'code': -401}})
        huawei.get_data('disk', self.args)
        forced = [
            call
            for call in self.get_creds.call_args_list
            if call.kwargs.get('force_relogin')
        ]
        self.assertEqual(len(forced), 1)

    def test_retries_sleep_one_second(self):
        self.fetch_json.return_value = (True, {'error': {'code': -401}})
        huawei.get_data('disk', self.args)
        for call in self.sleep.call_args_list:
            self.assertEqual(call.args, (1,))

    def test_recovers_mid_loop(self):
        self.fetch_json.side_effect = [
            (True, {'error': {'code': -401}}),
            (True, {'error': {'code': 0}, 'data': ['recovered']}),
        ]
        result = huawei.get_data('disk', self.args)
        self.assertEqual(self.fetch_json.call_count, 2)
        # One sleep for the single failed attempt; the success breaks the loop.
        self.assertEqual(self.sleep.call_count, 1)
        self.assertEqual(result['data'], ['recovered'])

    def test_missing_error_key_is_treated_as_failure_and_retried(self):
        # .get('error', {}).get('code') -> None, which is != 0, so it retries.
        self.fetch_json.return_value = (True, {'data': 'x'})
        huawei.get_data('disk', self.args)
        self.assertEqual(self.fetch_json.call_count, 3)

    def test_empty_dict_response_retried_to_max(self):
        self.fetch_json.return_value = (True, {})
        huawei.get_data('disk', self.args)
        self.assertEqual(self.fetch_json.call_count, 3)

    def test_calls_get_creds_with_cached_session_first(self):
        # On a first-try success the login is consulted once, reusing the
        # cached session (force_relogin is False).
        huawei.get_data('disk', self.args)
        self.get_creds.assert_called_once_with(self.args, force_relogin=False)

    def test_fetch_failure_is_reported_in_the_documented_envelope(self):
        # get_data() never aborts: a transport failure becomes a failed attempt and
        # is handed back in the envelope, so the caller can report the reason itself.
        self.fetch_json.return_value = (False, 'timeout')
        result = huawei.get_data('disk', self.args)
        self.assertEqual(result['error']['code'], 'n/a')
        self.assertIn('timeout', result['error']['description'])

    def test_http_error_body_is_decoded_into_the_envelope(self):
        # An HTTP error status still carries the appliance's own JSON body, which
        # names the actual cause. lib.url skips the decode on a non-2xx status, so
        # the module has to do it or the reason is lost behind the status line.
        self.fetch_json.return_value = (
            False,
            '{"error": {"code": -401, "description": "authentication failed"}}',
        )
        result = huawei.get_data('disk', self.args)
        self.assertEqual(result['error']['code'], -401)
        self.assertEqual(result['error']['description'], 'authentication failed')


# ---------------------------------------------------------------------------
# get_error_code(), get_all_data() and get_performance()
# ---------------------------------------------------------------------------


class TestGetErrorCode(unittest.TestCase):
    def test_reads_the_documented_object(self):
        self.assertEqual(huawei.get_error_code({'error': {'code': 0}}), 0)
        self.assertEqual(huawei.get_error_code({'error': {'code': '-401'}}), '-401')

    def test_reads_a_scalar_error(self):
        # Not documented, but a firmware that answers with a bare value must not
        # make the caller crash on .get().
        self.assertEqual(huawei.get_error_code({'error': 0}), 0)

    def test_missing_error_key_is_none(self):
        self.assertIsNone(huawei.get_error_code({}))


class TestGetAllData(HuaweiHttpTestBase):
    def setUp(self):
        super().setUp()
        self._p_creds = mock.patch.object(
            huawei, 'get_creds', return_value=('TOKEN', 'COOKIE', 'DEV0001')
        )
        self._p_creds.start()
        self.addCleanup(self._p_creds.stop)

    @staticmethod
    def page(count, start=0):
        return (
            True,
            {
                'data': [{'ID': str(start + i)} for i in range(count)],
                'error': {'code': 0},
            },
        )

    def test_single_short_page_ends_the_walk(self):
        self.fetch_json.return_value = self.page(3)
        result, truncated = huawei.get_all_data('lun', self.args, page_size=100)
        self.assertEqual(len(result['data']), 3)
        self.assertFalse(truncated)
        self.assertEqual(self.fetch_json.call_count, 1)

    def test_full_page_is_followed_by_another_request(self):
        self.fetch_json.side_effect = [self.page(2), self.page(1, start=2)]
        result, truncated = huawei.get_all_data('lun', self.args, page_size=2)
        self.assertEqual([item['ID'] for item in result['data']], ['0', '1', '2'])
        self.assertFalse(truncated)

    def test_range_parameter_counts_up_per_page(self):
        self.fetch_json.side_effect = [self.page(2), self.page(0)]
        huawei.get_all_data('lun', self.args, page_size=2)
        uris = [call.args[0] for call in self.fetch_json.call_args_list]
        self.assertTrue(uris[0].endswith('lun?range=[0-2]'), uris[0])
        self.assertTrue(uris[1].endswith('lun?range=[2-4]'), uris[1])

    def test_range_is_appended_to_an_existing_query_string(self):
        self.fetch_json.return_value = self.page(0)
        huawei.get_all_data('alarm/currentalarm?filter=level::6', self.args)
        self.assertTrue(
            self.sent_uri().endswith(
                'alarm/currentalarm?filter=level::6&range=[0-100]'
            ),
            self.sent_uri(),
        )

    def test_page_cap_reports_truncation(self):
        # A firmware that ignores `range` hands out the same full page forever.
        # The cap is what keeps the check from running until its own timeout.
        self.fetch_json.return_value = self.page(2)
        result, truncated = huawei.get_all_data(
            'lun', self.args, page_size=2, max_pages=3
        )
        self.assertTrue(truncated)
        self.assertEqual(self.fetch_json.call_count, 3)
        self.assertEqual(len(result['data']), 6)

    def test_failed_request_is_handed_back_whole(self):
        # Reporting the objects collected so far would present a partial
        # inventory as a complete one.
        failed = (True, {'error': {'code': -401, 'description': 'no session'}})
        # get_data() retries a rejected request, so the failing page costs three
        # requests rather than one.
        self.fetch_json.side_effect = [self.page(2), failed, failed, failed]
        result, truncated = huawei.get_all_data('lun', self.args, page_size=2)
        self.assertEqual(huawei.get_error_code(result), -401)
        self.assertFalse(truncated)
        self.assertNotIn('ID', str(result.get('data', '')))

    def test_single_object_response_is_not_paged(self):
        self.fetch_json.return_value = (True, {'data': {'ID': '0'}, 'error': {'code': 0}})
        result, truncated = huawei.get_all_data('system/', self.args)
        self.assertEqual(result['data'], {'ID': '0'})
        self.assertFalse(truncated)
        self.assertEqual(self.fetch_json.call_count, 1)


class TestGetPerformance(HuaweiHttpTestBase):
    SAMPLE = (
        True,
        {
            'data': [
                {
                    'CMO_STATISTIC_DATA_ID_LIST': '21,22,370',
                    'CMO_STATISTIC_DATA_LIST': '132,4711,385',
                    'CMO_STATISTIC_UUID': '207:0A',
                }
            ],
            'error': {'code': 0},
        },
    )

    def setUp(self):
        super().setUp()
        self._p_creds = mock.patch.object(
            huawei, 'get_creds', return_value=('TOKEN', 'COOKIE', 'DEV0001')
        )
        self._p_creds.start()
        self.addCleanup(self._p_creds.stop)
        # The working endpoint spelling is remembered for the whole run, so it
        # has to be reset or the tests would depend on their order.
        huawei._performance_path = None
        self.addCleanup(setattr, huawei, '_performance_path', None)

    def test_zips_ids_and_values_back_together(self):
        self.fetch_json.return_value = self.SAMPLE
        self.assertEqual(
            huawei.get_performance('207:0A', (21, 22, 370), self.args),
            {'21': '132', '22': '4711', '370': '385'},
        )

    def test_request_carries_uuid_and_id_list(self):
        self.fetch_json.return_value = self.SAMPLE
        huawei.get_performance('207:0A', (21, 22, 370), self.args)
        self.assertIn('CMO_STATISTIC_UUID=207:0A', self.sent_uri())
        self.assertIn('CMO_STATISTIC_DATA_ID_LIST=21,22,370', self.sent_uri())

    def test_prefers_the_corrected_endpoint_spelling(self):
        self.fetch_json.return_value = self.SAMPLE
        huawei.get_performance('207:0A', (21,), self.args)
        self.assertIn('/performance_statistic/cur_statistic_data', self.sent_uri())

    def test_falls_back_to_the_misspelled_endpoint(self):
        # 6.1.0 spells it 'performace_statistic'. Nothing in a response says
        # which spelling an appliance answers to, so it has to be tried.
        self.fetch_json.side_effect = [
            (True, {'error': {'code': -1, 'description': 'not found'}}),
            self.SAMPLE,
        ]
        result = huawei.get_performance('207:0A', (21, 22, 370), self.args)
        self.assertEqual(result, {'21': '132', '22': '4711', '370': '385'})
        self.assertIn(
            '/performace_statistic/cur_statistic_data',
            self.fetch_json.call_args_list[1].args[0],
        )

    def test_working_spelling_is_reused_for_the_rest_of_the_run(self):
        self.fetch_json.side_effect = [
            (True, {'error': {'code': -1, 'description': 'not found'}}),
            self.SAMPLE,
            self.SAMPLE,
        ]
        huawei.get_performance('207:0A', (21,), self.args)
        huawei.get_performance('207:0B', (21,), self.args)
        self.assertEqual(self.fetch_json.call_count, 3)
        self.assertIn(
            '/performace_statistic/cur_statistic_data',
            self.fetch_json.call_args_list[2].args[0],
        )

    def test_probe_does_not_retry(self):
        # A wrong spelling answers with an error, which is the expected answer
        # rather than a fault. Retrying it would cost two further requests and a
        # forced re-login that drops the session the rest of the check reuses.
        self.fetch_json.side_effect = [
            (True, {'error': {'code': -1, 'description': 'not found'}}),
            self.SAMPLE,
        ]
        huawei.get_performance('207:0A', (21,), self.args)
        self.assertEqual(self.fetch_json.call_count, 2)
        self.assertFalse(self.sleep.called)

    def test_no_sample_returns_an_empty_mapping(self):
        # The normal answer for an object whose counters are not collected.
        self.fetch_json.return_value = (True, {'data': [], 'error': {'code': 0}})
        self.assertEqual(huawei.get_performance('207:0A', (21,), self.args), {})

    def test_both_spellings_failing_returns_an_empty_mapping(self):
        self.fetch_json.return_value = (
            True,
            {'error': {'code': -1, 'description': 'not found'}},
        )
        self.assertEqual(huawei.get_performance('207:0A', (21,), self.args), {})
        self.assertEqual(self.fetch_json.call_count, 2)


if __name__ == '__main__':
    unittest.main()
