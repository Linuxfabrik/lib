"""Unit tests for lib.psutil.

The only public helper is get_partitions, a thin filter over
psutil.disk_partitions. psutil itself is mocked so the suite is hermetic
and does not depend on the host's mount table.
"""

import collections
import sys
import unittest
from unittest import mock

sys.path.insert(0, '..')

try:
    import lib.psutil as lib_psutil

    HAVE_PSUTIL = True
except SystemExit:
    # lib.psutil sys.exit()s with STATE_UNKNOWN when psutil is missing.
    HAVE_PSUTIL = False


# Mirror the named tuple psutil's platform module returns. The real one also
# carries maxfile/maxpath on some releases and not on others, which is exactly
# why get_partitions() hands back four fields of its own.
sdiskpart = collections.namedtuple(
    'sdiskpart', ['device', 'mountpoint', 'fstype', 'opts']
)


def sample_partitions():
    """Realistic set of mounted partitions on a Linux host."""
    return [
        sdiskpart('/dev/sda1', '/', 'ext4', 'rw,relatime'),
        sdiskpart('/dev/sda2', '/boot', 'ext4', 'rw,relatime'),
        sdiskpart('/dev/sdb1', '/mnt/backup', 'xfs', 'rw,relatime'),
        sdiskpart('/dev/mapper/vg-home', '/home', 'ext4', 'rw,relatime'),
        sdiskpart('/dev/sdc1', '/var/lib/docker', 'btrfs', 'rw,relatime'),
    ]


def expected(parts):
    """The four-field tuples get_partitions() builds out of what psutil returned."""
    return [
        lib_psutil.sdiskpart(p.device, p.mountpoint, p.fstype, p.opts) for p in parts
    ]


@unittest.skipUnless(HAVE_PSUTIL, 'psutil module not installed')
class TestGetPartitions(unittest.TestCase):
    def setUp(self):
        # Patch the psutil reference imported into lib.psutil so no real
        # disk introspection happens during the tests.
        patcher = mock.patch.object(lib_psutil, 'psutil')
        self.mock_psutil = patcher.start()
        self.addCleanup(patcher.stop)
        self.mock_psutil._psplatform.disk_partitions.return_value = sample_partitions()

    def test_returns_all_when_no_ignore(self):
        result = lib_psutil.get_partitions()
        self.assertEqual(len(result), 5)
        self.assertEqual(result, expected(sample_partitions()))

    def test_lists_physical_devices_only_by_default(self):
        # Physical-only behaviour (mirrors df) must be preserved.
        lib_psutil.get_partitions()
        self.mock_psutil._psplatform.disk_partitions.assert_called_once_with(False)

    def test_include_all_asks_for_every_filesystem(self):
        lib_psutil.get_partitions(include_all=True)
        self.mock_psutil._psplatform.disk_partitions.assert_called_once_with(True)

    def test_the_blocking_lookups_are_skipped(self):
        # psutil.disk_partitions() looks up os.pathconf() per mount point, which never
        # returns on a network filesystem whose server is gone. The documented function
        # must not be the one that gets called.
        lib_psutil.get_partitions()
        self.mock_psutil.disk_partitions.assert_not_called()

    def test_the_documented_function_is_the_fallback(self):
        self.mock_psutil._psplatform.disk_partitions.side_effect = AttributeError
        self.mock_psutil.disk_partitions.return_value = sample_partitions()
        self.assertEqual(lib_psutil.get_partitions(), expected(sample_partitions()))
        self.mock_psutil.disk_partitions.assert_called_once_with(all=False)

    def test_four_fields_come_back_whatever_psutil_returned(self):
        for part in lib_psutil.get_partitions():
            self.assertEqual(part._fields, ('device', 'mountpoint', 'fstype', 'opts'))

    def test_default_ignore_is_none_keeps_everything(self):
        self.assertEqual(lib_psutil.get_partitions(None), expected(sample_partitions()))

    def test_empty_ignore_list_keeps_everything(self):
        self.assertEqual(lib_psutil.get_partitions([]), expected(sample_partitions()))

    def test_ignore_single_mountpoint(self):
        result = lib_psutil.get_partitions(['/boot'])
        mountpoints = [p.mountpoint for p in result]
        self.assertNotIn('/boot', mountpoints)
        self.assertEqual(len(result), 4)

    def test_ignore_multiple_mountpoints(self):
        result = lib_psutil.get_partitions(['/boot', '/home'])
        mountpoints = [p.mountpoint for p in result]
        self.assertNotIn('/boot', mountpoints)
        self.assertNotIn('/home', mountpoints)
        self.assertEqual(len(result), 3)

    def test_ignore_is_substring_match(self):
        # '/var' is not an exact mountpoint, but it is a substring of
        # '/var/lib/docker', so that partition must be dropped.
        result = lib_psutil.get_partitions(['/var'])
        mountpoints = [p.mountpoint for p in result]
        self.assertNotIn('/var/lib/docker', mountpoints)
        self.assertEqual(len(result), 4)

    def test_ignore_substring_can_match_many(self):
        # '/' is a substring of every mountpoint, so everything is dropped.
        self.assertEqual(lib_psutil.get_partitions(['/']), [])

    def test_ignore_no_match_keeps_everything(self):
        self.assertEqual(
            lib_psutil.get_partitions(['/nonexistent']),
            expected(sample_partitions()),
        )

    def test_ignore_filters_empty_strings(self):
        # filter(None, ...) drops '' so it must NOT match every mountpoint.
        # Without the filter, the '' substring would wipe out all partitions.
        result = lib_psutil.get_partitions(['', '/boot'])
        mountpoints = [p.mountpoint for p in result]
        self.assertNotIn('/boot', mountpoints)
        self.assertEqual(len(result), 4)

    def test_ignore_only_empty_strings_keeps_everything(self):
        self.assertEqual(
            lib_psutil.get_partitions(['', '']), expected(sample_partitions())
        )

    def test_ignore_none_entries_are_dropped(self):
        # filter(None, ...) also strips None, which would otherwise raise
        # on the substring `in` check.
        result = lib_psutil.get_partitions([None, '/boot'])
        mountpoints = [p.mountpoint for p in result]
        self.assertNotIn('/boot', mountpoints)
        self.assertEqual(len(result), 4)

    def test_returns_list_type(self):
        self.assertIsInstance(lib_psutil.get_partitions(), list)

    def test_empty_partition_table(self):
        self.mock_psutil._psplatform.disk_partitions.return_value = []
        self.assertEqual(lib_psutil.get_partitions(), [])
        self.assertEqual(lib_psutil.get_partitions(['/boot']), [])

    def test_namedtuple_fields_are_preserved(self):
        result = lib_psutil.get_partitions(['/boot', '/home', '/mnt', '/var'])
        self.assertEqual(len(result), 1)
        part = result[0]
        self.assertEqual(part.device, '/dev/sda1')
        self.assertEqual(part.mountpoint, '/')
        self.assertEqual(part.fstype, 'ext4')


class _Proc:
    """The shape psutil.process_iter(attrs) yields: an object with an `info` dict."""

    def __init__(self, name, pid, username):
        self.info = {'name': name, 'pid': pid, 'username': username}


class _Vanished(_Proc):
    """A process that goes away while the list is being built."""

    @property
    def info(self):
        raise lib_psutil.psutil.NoSuchProcess(1)

    @info.setter
    def info(self, value):
        pass


@unittest.skipUnless(HAVE_PSUTIL, 'psutil module not installed')
class TestGetProcessAccounts(unittest.TestCase):
    """get_process_accounts(): who a program's processes actually run as."""

    def _procs(self):
        return [
            _Proc('httpd', 10, 'root'),
            _Proc('httpd', 11, 'apache'),
            _Proc('httpd', 12, 'apache'),
            _Proc('nginx', 20, 'nginx'),
            _Proc('sshd', 30, 'root'),
        ]

    def _run(self, names, procs=None, namespace=None, links=None):
        links = links or {}
        with (
            mock.patch.object(
                lib_psutil.psutil, 'process_iter',
                return_value=self._procs() if procs is None else list(procs),
            ),
            mock.patch.object(
                lib_psutil.user, 'own_mount_namespace', return_value=namespace
            ),
            mock.patch.object(
                lib_psutil.os, 'readlink',
                side_effect=lambda path: links.get(path, namespace),
            ),
        ):
            return lib_psutil.get_process_accounts(names)

    def test_every_matching_process_is_one_entry(self):
        # Repeats are kept: three httpd processes are three accounts, which is
        # what tells one stray process from a whole pool of them.
        self.assertEqual(self._run(('httpd',)), ['root', 'apache', 'apache'])

    def test_several_names_are_matched(self):
        self.assertEqual(
            self._run(('httpd', 'apache2', 'nginx')),
            ['root', 'apache', 'apache', 'nginx'],
        )

    def test_a_name_nothing_runs_under_is_empty(self):
        self.assertEqual(self._run(('does-not-exist',)), [])

    def test_no_names_matches_nothing(self):
        self.assertEqual(self._run([]), [])

    def test_a_generator_is_accepted(self):
        # The names are consumed more than once, so an iterator has to survive.
        self.assertEqual(self._run(n for n in ('httpd',)),
                         ['root', 'apache', 'apache'])

    def test_a_foreign_mount_namespace_is_left_out(self):
        # The same program in a container shows up in the host's process list
        # under a mapped user id, which is not an account of this installation.
        links = {'/proc/11/ns/mnt': 'mnt:[4026532999]'}
        self.assertEqual(
            self._run(('httpd',), namespace='mnt:[4026531841]', links=links),
            ['root', 'apache'],
        )

    def test_without_a_namespace_nothing_is_filtered(self):
        # Not Linux: the kernel publishes none, so every process counts.
        self.assertEqual(self._run(('httpd',), namespace=None),
                         ['root', 'apache', 'apache'])

    def test_a_process_that_vanished_is_skipped(self):
        procs = [_Proc('httpd', 10, 'root'), _Vanished('httpd', 11, 'apache')]
        self.assertEqual(self._run(('httpd',), procs=procs), ['root'])


if __name__ == '__main__':
    unittest.main()
