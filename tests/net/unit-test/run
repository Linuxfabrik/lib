"""Unit tests for lib.net.

Everything that would reach the network is driven through mocks, so the suite
stays hermetic: fetch() and fetch_socket() against a mocked socket, get_proxy()
against a mocked environment, get_public_ip() against a mocked url.fetch(), and
get_netinfo() against a mocked psutil.
"""

import os
import re
import socket
import sys
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.net as net


class FakeSocket:
    """A socket that answers from a script, so no test opens a real one.

    `chunks` are returned by successive `recv()` calls; an empty one ends the
    conversation the way a closed connection does. `raises` lets a test drive the
    timeout and error paths instead.
    """

    def __init__(self, chunks=(), raises=None):
        self.chunks = list(chunks)
        self.raises = raises
        self.sent = []
        self.connected_to = None
        self.timeout = None

    def __enter__(self):
        return self

    def __exit__(self, *_):
        return False

    def settimeout(self, timeout):
        self.timeout = timeout

    def connect(self, args):
        self.connected_to = args

    def sendall(self, payload):
        self.sent.append(payload)

    def shutdown(self, _how):
        pass

    def close(self):
        pass

    def recv(self, _size):
        if self.raises is not None:
            raise self.raises
        return self.chunks.pop(0) if self.chunks else b''


class TestIpToCidr(unittest.TestCase):
    def test_counts_mask_bits(self):
        self.assertEqual(net.ip_to_cidr('255.255.255.0'), 24)


class TestCidrToHosts(unittest.TestCase):
    def test_ipv4(self):
        self.assertEqual(
            net.cidr_to_hosts('10.1.1.0/30'), (True, ['10.1.1.1', '10.1.1.2'])
        )

    def test_ipv4_host_bits_tolerated(self):
        # strict=False: host bits set in the input are accepted
        ok, hosts = net.cidr_to_hosts('10.1.1.5/30')
        self.assertTrue(ok)
        self.assertEqual(hosts, ['10.1.1.5', '10.1.1.6'])

    def test_ipv6(self):
        self.assertEqual(
            net.cidr_to_hosts('2001:db8::/126'),
            (True, ['2001:db8::1', '2001:db8::2', '2001:db8::3']),
        )

    def test_too_large_is_rejected(self):
        # an IPv6 /64 must not be enumerated (2^64 addresses)
        ok, result = net.cidr_to_hosts('2001:db8::/64')
        self.assertFalse(ok)
        self.assertIn('too large', result)

    def test_max_hosts_none_disables_limit(self):
        ok, hosts = net.cidr_to_hosts('10.0.0.0/24', max_hosts=None)
        self.assertTrue(ok)
        self.assertEqual(len(hosts), 254)

    def test_invalid_input(self):
        ok, result = net.cidr_to_hosts('not-a-net')
        self.assertFalse(ok)
        self.assertIn('Invalid network', result)


class TestIpv6Prefixlen(unittest.TestCase):
    def test_full_hex_mask(self):
        # psutil reports the IPv6 netmask as a full hex mask, not a prefix length
        self.assertEqual(net._ipv6_prefixlen('ffff:ffff:ffff:ffff::'), '64')
        self.assertEqual(
            net._ipv6_prefixlen('ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff'), '128'
        )

    def test_slash_form_and_fallback(self):
        self.assertEqual(net._ipv6_prefixlen('ffff:ffff:ffff:ffff::/64'), '64')
        self.assertEqual(net._ipv6_prefixlen(''), '128')
        self.assertEqual(net._ipv6_prefixlen(None), '128')


class TestNormalizeAddress(unittest.TestCase):
    """The same peer has to end up under the same name, whichever way a log spells it."""

    def test_an_address_that_is_already_canonical(self):
        self.assertEqual(net.normalize_address('198.51.100.7'), '198.51.100.7')

    def test_an_ipv4_written_as_a_mapped_ipv6_is_the_same_peer(self):
        # A dual-stack listener writes both spellings for one client, and
        # counting them apart would split a burst across two buckets.
        self.assertEqual(
            net.normalize_address('::ffff:198.51.100.7'),
            net.normalize_address('198.51.100.7'),
        )
        self.assertEqual(net.normalize_address('::FFFF:198.51.100.7'), '198.51.100.7')

    def test_an_ipv6_is_compressed_and_lowercased(self):
        self.assertEqual(
            net.normalize_address('2001:0DB8:0000:0000:0000:0000:0000:0001'),
            '2001:db8::1',
        )

    def test_the_brackets_around_an_ipv6_are_taken_off(self):
        self.assertEqual(net.normalize_address('[2001:db8::1]'), '2001:db8::1')

    def test_a_zone_is_kept(self):
        # Two hosts on different links carry the same link-local address and are
        # not the same peer.
        self.assertEqual(net.normalize_address('fe80::1%eth0'), 'fe80::1%eth0')
        self.assertNotEqual(
            net.normalize_address('fe80::1%eth0'),
            net.normalize_address('fe80::1%eth1'),
        )

    def test_what_only_looks_like_an_address(self):
        for text in ('999.1.2.3', '19:25:07', 'localhost', '', None, '1.2.3'):
            self.assertIsNone(net.normalize_address(text), text)


class TestAddressRegex(unittest.TestCase):
    """The patterns a consumer composes its own around."""

    def test_the_shapes_a_log_writes(self):
        pattern = re.compile(net.ADDRESS_REGEX)
        for text in (
            '198.51.100.7',
            '::1',
            '2001:db8::1',
            '[2001:db8::1]',
            '::ffff:198.51.100.7',
            'fe80::1%eth0',
        ):
            match = pattern.fullmatch(text)
            self.assertIsNotNone(match, text)

    def test_the_shape_alone_decides_nothing(self):
        # Both shapes are loose on purpose, the way fail2ban keeps them: the
        # clock at the head of a syslog line has the shape of an IPv6 address
        # and an impossible octet has the shape of an IPv4 one. That is why a
        # consumer anchors the pattern in the words around it and hands what it
        # found to normalize_address(), which is what actually decides.
        for text in ('19:25:07', '999.1.2.3'):
            self.assertIsNotNone(re.compile(net.ADDRESS_REGEX).fullmatch(text), text)
            self.assertIsNone(net.normalize_address(text), text)


class TestFetch(unittest.TestCase):
    def _fetch(self, sock, **kwargs):
        with mock.patch('socket.socket', return_value=sock):
            return net.fetch('host.example.com', 4242, **kwargs)

    def test_reads_the_banner(self):
        sock = FakeSocket([b'PONG\n'])
        self.assertEqual(self._fetch(sock), (True, 'PONG\n'))

    def test_sends_the_message_first(self):
        sock = FakeSocket([b'PONG\n'])
        self.assertEqual(self._fetch(sock, msg=b'PING\n'), (True, 'PONG\n'))
        self.assertEqual(sock.sent, [b'PING\n'])
        self.assertEqual(sock.connected_to, ('host.example.com', 4242))

    def test_closed_connection_yields_empty_text(self):
        self.assertEqual(self._fetch(FakeSocket()), (True, ''))

    def test_several_chunks_are_joined(self):
        sock = FakeSocket([b'one ', b'two'])
        self.assertEqual(self._fetch(sock), (True, 'one two'))

    def test_latin1_answer_is_decoded_not_lost(self):
        # a sensor answering in Latin-1 is not valid UTF-8; the bytes must still
        # reach the consumer as the characters they stand for
        sock = FakeSocket(['Grüße'.encode('latin-1')])
        self.assertEqual(self._fetch(sock), (True, 'Grüße'))

    def test_timeout_is_reported(self):
        success, message = self._fetch(FakeSocket(raises=socket.timeout()))
        self.assertFalse(success)
        self.assertIn('timed out', message)

    def test_socket_error_is_reported(self):
        success, message = self._fetch(FakeSocket(raises=OSError('broken')))
        self.assertFalse(success)
        self.assertIn('broken', message)

    def test_payload_and_dialog_are_mutually_exclusive(self):
        success, message = self._fetch(
            FakeSocket([b'x']), msg=b'PING\n', dialog=[(b'a', 'b')]
        )
        self.assertFalse(success)
        self.assertIn('mutually exclusive', message)

    def test_dialog_matches_the_expected_pattern(self):
        sock = FakeSocket([b'220 ready\n', b'250 ok\n'])
        success, results = self._fetch(
            sock, dialog=[(None, '220'), (b'EHLO x\r\n', '250')]
        )
        self.assertTrue(success, results)
        self.assertEqual(results, ['220 ready\n', '250 ok\n'])
        self.assertEqual(sock.sent, [b'EHLO x\r\n'])

    def test_dialog_reports_a_connection_closed_before_the_pattern(self):
        success, message = self._fetch(FakeSocket([b'220 ready\n']),
                                       dialog=[(None, '250')])
        self.assertFalse(success)
        self.assertIn('closed before pattern', message)


class TestFetchSocket(unittest.TestCase):
    def _fetch(self, sock, **kwargs):
        # AF_UNIX is created where the platform lacks it (CPython on Windows), so the
        # logic is exercised everywhere; the socket itself is a fake anyway
        family = mock.patch.object(socket, 'AF_UNIX', 1, create=True)
        with family, mock.patch('socket.socket', return_value=sock):
            return net.fetch_socket('/run/haproxy.sock', **kwargs)

    def test_a_platform_without_unix_sockets_says_so(self):
        with mock.patch.object(net, 'socket', mock.Mock(spec=[])):
            success, message = net.fetch_socket('/run/haproxy.sock')
        self.assertFalse(success)
        self.assertIn('not supported on this platform', message)

    def test_sends_the_command_and_reads_the_answer(self):
        sock = FakeSocket([b'stat one\n'])
        self.assertEqual(self._fetch(sock, cmd=b'show stat\n'), (True, 'stat one\n'))
        self.assertEqual(sock.sent, [b'show stat\n'])
        self.assertEqual(sock.connected_to, '/run/haproxy.sock')

    def test_without_a_command_it_only_reads(self):
        sock = FakeSocket([b'banner'])
        self.assertEqual(self._fetch(sock), (True, 'banner'))
        self.assertEqual(sock.sent, [])

    def test_error_names_the_socket_file(self):
        success, message = self._fetch(FakeSocket(raises=OSError('gone')))
        self.assertFalse(success)
        self.assertIn('/run/haproxy.sock', message)


class TestGetProxy(unittest.TestCase):
    def _proxy(self, target, env, **kwargs):
        with mock.patch.dict(os.environ, env, clear=True):
            return net.get_proxy(target, **kwargs)

    def test_returns_the_proxy_of_the_scheme(self):
        self.assertEqual(
            self._proxy(
                'https://host.example.com/x',
                {'https_proxy': 'http://proxy.example.com:3128'},
            ),
            (True, 'http://proxy.example.com:3128'),
        )

    def test_no_proxy_entry_wins(self):
        self.assertEqual(
            self._proxy(
                'https://host.example.org/x',
                {
                    'https_proxy': 'http://proxy.example.com:3128',
                    'no_proxy': '.example.org',
                },
            ),
            (True, None),
        )

    def test_no_proxy_argument_skips_the_environment(self):
        self.assertEqual(
            self._proxy(
                'https://host.example.com/x',
                {'https_proxy': 'http://proxy.example.com:3128'},
                no_proxy=True,
            ),
            (True, None),
        )

    def test_without_an_environment_there_is_no_proxy(self):
        self.assertEqual(self._proxy('https://host.example.com/x', {}), (True, None))

    def _system_proxy(self, target, bypass):
        # a proxy from the Windows or macOS system settings: getproxies() names it,
        # the environment does not, and proxy_bypass() reads its exception list
        no_env = mock.patch.dict(os.environ, {}, clear=True)
        system = mock.patch.object(
            net.urllib.request,
            'getproxies',
            return_value={'https': 'proxy.example.com:3128'},
        )
        exceptions = mock.patch.object(
            net.urllib.request, 'proxy_bypass', return_value=bypass
        )
        with no_env, system, exceptions as proxy_bypass:
            return net.get_proxy(target), proxy_bypass

    def test_system_proxy_exception_wins(self):
        result, proxy_bypass = self._system_proxy('https://10.1.2.3/x', True)
        self.assertEqual(result, (True, None))
        proxy_bypass.assert_called_once_with('10.1.2.3')

    def test_system_proxy_applies_outside_its_exceptions(self):
        result, _ = self._system_proxy('https://host.example.com/x', False)
        self.assertEqual(result, (True, 'http://proxy.example.com:3128'))

    def test_environment_proxy_ignores_the_system_exceptions(self):
        # with a proxy in the environment, only its own no_proxy list counts
        env = mock.patch.dict(
            os.environ, {'https_proxy': 'http://proxy.example.com:3128'}, clear=True
        )
        exceptions = mock.patch.object(
            net.urllib.request, 'proxy_bypass', return_value=True
        )
        with env, exceptions as proxy_bypass:
            result = net.get_proxy('https://host.example.com/x')
        self.assertEqual(result, (True, 'http://proxy.example.com:3128'))
        proxy_bypass.assert_not_called()

    def test_cidr_entry_covers_the_whole_network(self):
        self.assertEqual(
            self._proxy(
                'http://10.1.2.3/x',
                {
                    'http_proxy': 'http://proxy.example.com:3128',
                    'no_proxy': '10.0.0.0/8',
                },
            ),
            (True, None),
        )


class TestGetPublicIp(unittest.TestCase):
    def test_returns_the_address_a_service_answered(self):
        with mock.patch('lib.url.fetch', return_value=(True, '192.0.2.5\n')):
            self.assertEqual(
                net.get_public_ip('https://svc.example.com'), (True, '192.0.2.5')
            )

    def test_an_answer_that_is_no_address_is_not_passed_on(self):
        # a service that rate-limits answers with a page, not with an address
        with mock.patch('lib.url.fetch', return_value=(True, '<html>slow down</html>')):
            self.assertEqual(
                net.get_public_ip('https://svc.example.com'), (False, None)
            )

    def test_the_next_service_is_asked(self):
        with mock.patch(
            'lib.url.fetch', side_effect=[(True, 'nope'), (True, '2001:db8::1')]
        ):
            self.assertEqual(
                net.get_public_ip('https://a.example.com,https://b.example.com'),
                (True, '2001:db8::1'),
            )

    def test_no_services_no_lookup(self):
        with mock.patch('lib.url.fetch') as fetch_mock:
            self.assertEqual(net.get_public_ip(''), (False, None))
        fetch_mock.assert_not_called()

    def test_a_failed_request_is_skipped(self):
        with mock.patch('lib.url.fetch', return_value=(False, 'timeout')):
            self.assertEqual(
                net.get_public_ip('https://svc.example.com'), (False, None)
            )


class TestGetNetinfo(unittest.TestCase):
    def test_without_psutil_it_returns_an_empty_list(self):
        with mock.patch.object(net, 'HAVE_PSUTIL', False):
            self.assertEqual(net.get_netinfo(), [])

    def test_reports_the_address_of_the_default_route(self):
        with mock.patch.object(net, 'HAVE_PSUTIL', True), \
             mock.patch.object(net, '_default_route_ip', return_value='192.0.2.10'), \
             mock.patch.object(
                 net, '_iface_for_ip', return_value=('eth0', '255.255.255.0')
             ), \
             mock.patch.object(net, '_default_gateway', return_value='192.0.2.1'):
            netinfo = net.get_netinfo()
        self.assertEqual(netinfo['address'], '192.0.2.10')
        self.assertEqual(netinfo['mask'], '255.255.255.0')
        self.assertEqual(netinfo['mask_cidr'], 24)
        self.assertEqual(netinfo['gateway'], '192.0.2.1')
        # the public address is never filled in here, get_public_ip() answers that
        self.assertIsNone(netinfo['public_address'])

    def test_without_a_default_route_it_returns_an_empty_list(self):
        with mock.patch.object(net, 'HAVE_PSUTIL', True), \
             mock.patch.object(net, '_default_route_ip', return_value=None):
            self.assertEqual(net.get_netinfo(), [])


class TestGetSubnetHosts(unittest.TestCase):
    def _interfaces(self, interfaces):
        # psutil is replaced as a whole, so the tests run where it is not installed and
        # never see the interfaces of the host they run on
        psutil = mock.Mock(net_if_addrs=mock.Mock(return_value=interfaces))
        have = mock.patch.object(net, 'HAVE_PSUTIL', True)
        module = mock.patch.object(net, 'psutil', psutil, create=True)
        return have, module

    def test_lists_the_hosts_of_the_interface_subnet(self):
        addr = mock.Mock(family=net.AF_INET, address='192.0.2.1', netmask='255.255.255.0')
        have, module = self._interfaces({'eth0': [addr]})
        with have, module:
            success, hosts = net.get_subnet_hosts('eth0')
        self.assertTrue(success, hosts)
        self.assertEqual(hosts[0], '192.0.2.1')
        self.assertEqual(hosts[-1], '192.0.2.254')

    def test_without_an_interface_it_asks_get_netinfo(self):
        netinfo = {'address': '192.0.2.1', 'mask_cidr': 24}
        with mock.patch.object(net, 'HAVE_PSUTIL', True), \
             mock.patch.object(net, 'get_netinfo', return_value=netinfo):
            success, hosts = net.get_subnet_hosts()
        self.assertTrue(success, hosts)
        self.assertEqual(len(hosts), 254)

    def test_without_a_default_route_it_says_so(self):
        with mock.patch.object(net, 'HAVE_PSUTIL', True), \
             mock.patch.object(net, 'get_netinfo', return_value=[]):
            success, message = net.get_subnet_hosts()
        self.assertFalse(success)
        self.assertIn('default interface', message)

    def test_max_hosts_is_honoured(self):
        addr = mock.Mock(family=net.AF_INET, address='192.0.2.1', netmask='255.255.255.0')
        have, module = self._interfaces({'eth0': [addr]})
        with have, module:
            success, message = net.get_subnet_hosts('eth0', max_hosts=10)
        self.assertFalse(success)
        self.assertIn('10', message)

    def test_unknown_interface(self):
        have, module = self._interfaces({'eth0': []})
        with have, module:
            ok, result = net.get_subnet_hosts('does-not-exist0')
        self.assertFalse(ok)
        self.assertIn('No such interface', result)

    def test_without_psutil_it_says_so(self):
        with mock.patch.object(net, 'HAVE_PSUTIL', False):
            success, message = net.get_subnet_hosts('eth0')
        self.assertFalse(success)
        self.assertIn('psutil', message)

if __name__ == '__main__':
    unittest.main()
