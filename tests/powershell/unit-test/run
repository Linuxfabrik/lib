"""Unit tests for lib.powershell.

The module exposes a single public function:

- run_ps() runs `['powershell', '-Command', cmd]` through lib.shell.shell_exec()
  and returns a dict with retc/stdout/stderr. A command that cannot be run or that
  times out becomes a retc=1 result carrying shell_exec()'s message.

Running, killing on timeout and decoding are shell_exec()'s job and are covered by
tests/shell. Every test here mocks powershell.shell.shell_exec, so no real
`powershell` binary is ever spawned and the tests run on any OS in well under a
second.
"""

import sys
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.powershell as powershell

# Realistic sample output of `powershell -Command Get-Service WinRM | Format-List`
# captured on a Windows host. Used to prove the decoded stdout is passed
# through verbatim (run_ps does not parse).
SAMPLE_STDOUT = (
    'Status   : Running\r\n'
    'Name     : WinRM\r\n'
    'DisplayName : Windows Remote Management (WS-Management)\r\n'
)

# Realistic sample of a PowerShell error stream (a non-existent cmdlet).
SAMPLE_STDERR = (
    "Get-Frobnicate : The term 'Get-Frobnicate' is not recognized as the name "
    'of a cmdlet, function, script file, or operable program.\r\n'
)


def patch_shell_exec(stdout='', stderr='', retc=0):
    """Patch shell_exec to report a command that ran."""
    return mock.patch.object(
        powershell.shell,
        'shell_exec',
        return_value=(True, (stdout, stderr, retc)),
    )


def patch_shell_exec_failure(message):
    """Patch shell_exec to report a command that could not run or timed out."""
    return mock.patch.object(
        powershell.shell,
        'shell_exec',
        return_value=(False, message),
    )


class TestRunPsReturnShape(unittest.TestCase):
    def test_returns_dict_with_exactly_the_documented_keys(self):
        with patch_shell_exec():
            result = powershell.run_ps('Get-Process')
        self.assertEqual(set(result.keys()), {'retc', 'stdout', 'stderr'})

    def test_streams_are_passed_through(self):
        with patch_shell_exec(stdout=SAMPLE_STDOUT, stderr=SAMPLE_STDERR):
            result = powershell.run_ps('Get-Service WinRM | Format-List')
        self.assertEqual(result['stdout'], SAMPLE_STDOUT)
        self.assertEqual(result['stderr'], SAMPLE_STDERR)

    def test_non_ascii_output_is_passed_through(self):
        with patch_shell_exec(stdout='Müller Ωμέγα\r\n'):
            self.assertEqual(powershell.run_ps('x')['stdout'], 'Müller Ωμέγα\r\n')

    def test_success_returncode(self):
        with patch_shell_exec(retc=0):
            self.assertEqual(powershell.run_ps('x')['retc'], 0)

    def test_nonzero_returncode_is_not_normalized(self):
        with patch_shell_exec(stderr=SAMPLE_STDERR, retc=42):
            result = powershell.run_ps('Get-Frobnicate')
        self.assertEqual(result['retc'], 42)
        self.assertEqual(result['stderr'], SAMPLE_STDERR)

    def test_negative_returncode(self):
        with patch_shell_exec(retc=-1):
            self.assertEqual(powershell.run_ps('x')['retc'], -1)


class TestRunPsInvocation(unittest.TestCase):
    def test_invokes_powershell_with_command_flag(self):
        with patch_shell_exec() as m:
            powershell.run_ps('Get-Process')
        self.assertEqual(m.call_args.args[0], ['powershell', '-Command', 'Get-Process'])

    def test_command_with_quotes_and_pipes_stays_one_argument(self):
        cmd = 'Write-Output "a b" | Sort-Object'
        with patch_shell_exec() as m:
            powershell.run_ps(cmd)
        self.assertEqual(m.call_args.args[0], ['powershell', '-Command', cmd])

    def test_empty_command_still_invokes_powershell(self):
        with patch_shell_exec() as m:
            powershell.run_ps('')
        self.assertEqual(m.call_args.args[0], ['powershell', '-Command', ''])

    def test_no_timeout_by_default(self):
        with patch_shell_exec() as m:
            powershell.run_ps('x')
        self.assertIsNone(m.call_args.kwargs['timeout'])

    def test_timeout_is_passed_to_shell_exec(self):
        with patch_shell_exec() as m:
            powershell.run_ps('x', timeout=8)
        self.assertEqual(m.call_args.kwargs['timeout'], 8)

    def test_called_exactly_once(self):
        with patch_shell_exec() as m:
            powershell.run_ps('x')
        self.assertEqual(m.call_count, 1)


class TestRunPsFailure(unittest.TestCase):
    def test_timeout(self):
        with patch_shell_exec_failure('Timeout after 5 seconds.'):
            result = powershell.run_ps('Start-Sleep 999', timeout=5)
        self.assertEqual(
            result,
            {'retc': 1, 'stdout': '', 'stderr': 'Timeout after 5 seconds.'},
        )

    def test_powershell_not_found(self):
        # powershell not on PATH, for example on Linux without pwsh
        message = (
            'Error "[Errno 2] No such file or directory: \'powershell\'" while calling'
            ' command "powershell"'
        )
        with patch_shell_exec_failure(message):
            result = powershell.run_ps('Get-Process')
        self.assertEqual(result, {'retc': 1, 'stdout': '', 'stderr': message})


if __name__ == '__main__':
    unittest.main()
