"""Unit tests for lib.shell.

shell_exec() always runs with shell=False and requires the command as a list of
arguments (argv). It is exercised by mocking subprocess.Popen so the OS layer is
fully stubbed. A small set of end-to-end checks against trivial real commands
(echo / true / false / cat) is guarded behind a POSIX check and also asserts the
core security property: shell metacharacters in an argument stay literal.
"""

import gc
import os
import subprocess
import sys
import time
import typing
import unittest
import warnings
from unittest import mock

sys.path.insert(0, '..')

import lib.shell as shell

# ---------------------------------------------------------------------------
# Helpers / fakes
# ---------------------------------------------------------------------------


class FakePopen:
    """Minimal stand-in for subprocess.Popen.

    Records the args/kwargs it was constructed with so tests can assert on how
    shell_exec wired up the process, and returns canned communicate() output.
    """

    instances: typing.ClassVar = []

    def __init__(self, *args, **kwargs):
        self.args = args
        self.kwargs = kwargs
        recipe = type(self)._recipe
        self._stdout_bytes = recipe.get('stdout', b'')
        self._stderr_bytes = recipe.get('stderr', b'')
        self.returncode = recipe.get('returncode', 0)
        self._timeout = recipe.get('timeout', False)
        self.killed = False
        self.waited_for = None
        self.stdin = mock.MagicMock(name='stdin-pipe')
        self.stdout = mock.MagicMock(name='stdout-pipe')
        self.stderr = mock.MagicMock(name='stderr-pipe')
        type(self).instances.append(self)

    def communicate(self, input=None, timeout=None):
        self.last_input = input
        self.last_timeout = timeout
        if self._timeout:
            self._timeout = False
            raise subprocess.TimeoutExpired(cmd='x', timeout=timeout)
        return self._stdout_bytes, self._stderr_bytes

    def kill(self):
        self.killed = True

    def wait(self, timeout=None):
        self.waited_for = timeout
        return self.returncode

    _recipe: typing.ClassVar = {}


def make_popen(stdout=b'', stderr=b'', returncode=0, timeout=False):
    """Build a FakePopen subclass primed with a single canned result."""

    class _Primed(FakePopen):
        instances: typing.ClassVar = []
        _recipe: typing.ClassVar = {
            'stdout': stdout,
            'stderr': stderr,
            'returncode': returncode,
            'timeout': timeout,
        }

    return _Primed


# ---------------------------------------------------------------------------
# shell_exec() - argument type guard
# ---------------------------------------------------------------------------


class TestShellExecRequiresList(unittest.TestCase):
    def test_string_raises_type_error(self):
        with self.assertRaises(TypeError):
            shell.shell_exec('ls -l')

    def test_type_error_message_mentions_list(self):
        with self.assertRaises(TypeError) as ctx:
            shell.shell_exec('ls -l')
        self.assertIn('list', str(ctx.exception))

    def test_tuple_is_accepted(self):
        Fake = make_popen(stdout=b'ok\n')
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            success, result = shell.shell_exec(('true',))
        self.assertTrue(success)
        self.assertEqual(result, ('ok\n', '', 0))


# ---------------------------------------------------------------------------
# shell_exec() - process wiring (mocked Popen)
# ---------------------------------------------------------------------------


class TestShellExec(unittest.TestCase):
    def test_single_command_success(self):
        Fake = make_popen(stdout=b'out\n', stderr=b'err\n', returncode=0)
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            success, result = shell.shell_exec(['ls', '-l'])
        self.assertTrue(success)
        self.assertEqual(result, ('out\n', 'err\n', 0))

    def test_cmd_is_passed_verbatim_as_argv(self):
        Fake = make_popen()
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            shell.shell_exec(['ls', '-l', '/tmp/a b'])
        # The list is handed to Popen unchanged: no splitting, no joining.
        self.assertEqual(Fake.instances[0].args[0], ['ls', '-l', '/tmp/a b'])

    def test_always_uses_shell_false(self):
        Fake = make_popen()
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            shell.shell_exec(['true'])
        self.assertFalse(Fake.instances[0].kwargs['shell'])

    def test_metacharacters_stay_literal_arguments(self):
        # An argument that looks like a shell pipeline/redirect must reach Popen
        # as a single literal element, never split or interpreted.
        Fake = make_popen()
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            shell.shell_exec(['echo', '|reboot| ; rm -rf / && evil'])
        self.assertEqual(
            Fake.instances[0].args[0], ['echo', '|reboot| ; rm -rf / && evil']
        )
        # exactly one process, no pipeline splitting
        self.assertEqual(len(Fake.instances), 1)

    def test_returncode_is_propagated(self):
        Fake = make_popen(stdout=b'', stderr=b'nope\n', returncode=2)
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            success, result = shell.shell_exec(['false'])
        self.assertTrue(success)
        self.assertEqual(result[2], 2)

    def test_lc_all_defaults_to_C(self):
        Fake = make_popen()
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            shell.shell_exec(['true'])
        self.assertEqual(Fake.instances[0].kwargs['env']['LC_ALL'], 'C')

    def test_lc_all_override(self):
        Fake = make_popen()
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            shell.shell_exec(['true'], lc_all='en_US.UTF-8')
        self.assertEqual(Fake.instances[0].kwargs['env']['LC_ALL'], 'en_US.UTF-8')

    def test_env_is_merged_with_os_environ(self):
        Fake = make_popen()
        with (
            mock.patch.dict(os.environ, {'EXISTING': 'keep'}, clear=False),
            mock.patch.object(shell.subprocess, 'Popen', Fake),
        ):
            shell.shell_exec(['true'], env={'CUSTOM': 'value'})
        env = Fake.instances[0].kwargs['env']
        self.assertEqual(env['CUSTOM'], 'value')
        self.assertEqual(env['EXISTING'], 'keep')

    def test_env_none_removes_an_inherited_variable(self):
        Fake = make_popen()
        with (
            mock.patch.dict(os.environ, {'SECRET': 'inherited'}, clear=False),
            mock.patch.object(shell.subprocess, 'Popen', Fake),
        ):
            shell.shell_exec(['true'], env={'SECRET': None})
        self.assertNotIn('SECRET', Fake.instances[0].kwargs['env'])

    def test_env_none_for_an_unset_variable_is_harmless(self):
        Fake = make_popen()
        with (
            mock.patch.dict(os.environ, {}, clear=False),
            mock.patch.object(shell.subprocess, 'Popen', Fake),
        ):
            os.environ.pop('NEVER_SET', None)
            shell.shell_exec(['true'], env={'NEVER_SET': None})
        self.assertNotIn('NEVER_SET', Fake.instances[0].kwargs['env'])

    def test_env_none_does_not_remove_the_variable_here(self):
        Fake = make_popen()
        with (
            mock.patch.dict(os.environ, {'SECRET': 'inherited'}, clear=False),
            mock.patch.object(shell.subprocess, 'Popen', Fake),
        ):
            shell.shell_exec(['true'], env={'SECRET': None})
            self.assertEqual(os.environ['SECRET'], 'inherited')

    def test_caller_env_does_not_mutate_os_environ(self):
        Fake = make_popen()
        before = dict(os.environ)
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            shell.shell_exec(['true'], env={'TRANSIENT': 'x'})
        self.assertNotIn('TRANSIENT', os.environ)
        self.assertEqual(dict(os.environ), before)

    def test_cwd_is_passed_through(self):
        Fake = make_popen()
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            shell.shell_exec(['true'], cwd='/tmp')
        self.assertEqual(Fake.instances[0].kwargs['cwd'], '/tmp')

    def test_timeout_is_passed_to_communicate(self):
        Fake = make_popen()
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            shell.shell_exec(['true'], timeout=5)
        self.assertEqual(Fake.instances[0].last_timeout, 5)

    def test_stdin_is_encoded_to_bytes(self):
        Fake = make_popen()
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            shell.shell_exec(['cat'], stdin='hello')
        self.assertEqual(Fake.instances[0].last_input, b'hello')

    def test_no_stdin_passes_none_to_communicate(self):
        Fake = make_popen()
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            shell.shell_exec(['true'])
        self.assertIsNone(Fake.instances[0].last_input)

    def test_popen_construction_error_returns_false(self):
        def boom(*args, **kwargs):
            raise OSError('No such file or directory')

        with mock.patch.object(shell.subprocess, 'Popen', boom):
            success, result = shell.shell_exec(['nonexistent-binary'])
        self.assertFalse(success)
        self.assertIn('Error', result)
        self.assertIn('nonexistent-binary', result)

    def test_popen_construction_error_hides_the_arguments(self):
        # A missing program is the common case, and its arguments carry credentials in
        # shapes no name-based redaction recognizes (short options, positional values).
        def boom(*args, **kwargs):
            raise FileNotFoundError(2, 'No such file or directory', 'ipmitool')

        cmd = ['ipmitool', '-P', 'linuxfabrik', '-U', 'admin', 'sel', 'elist']
        with mock.patch.object(shell.subprocess, 'Popen', boom):
            success, result = shell.shell_exec(cmd)
        self.assertFalse(success)
        self.assertIn('ipmitool', result)
        self.assertNotIn('linuxfabrik', result)
        self.assertNotIn('admin', result)

    @unittest.skipIf(os.name == 'nt', 'sudo and pwd are POSIX-only')
    def test_popen_construction_error_names_the_program_behind_sudo(self):
        def boom(*args, **kwargs):
            raise FileNotFoundError(2, 'No such file or directory', 'sudo')

        entry = mock.Mock(pw_uid=1234)
        with (
            mock.patch('pwd.getpwnam', return_value=entry),
            mock.patch.object(shell.subprocess, 'Popen', boom),
        ):
            success, result = shell.shell_exec(
                ['redis-cli', '-a', 'linuxfabrik', 'info'], run_as='appuser'
            )
        self.assertFalse(success)
        self.assertIn('Command "sudo" not found', result)
        self.assertNotIn('linuxfabrik', result)

    def test_missing_program_is_named_with_a_hint(self):
        def boom(*args, **kwargs):
            raise FileNotFoundError(2, 'No such file or directory', 'docker')

        with mock.patch.object(shell.subprocess, 'Popen', boom):
            success, result = shell.shell_exec(['docker', 'info'])
        self.assertFalse(success)
        self.assertEqual(
            result,
            'Command "docker" not found (No such file or directory). Install it, or '
            'make sure it is in the PATH of the account running this.',
        )

    @unittest.skipIf(os.name == 'nt', 'sudo and pwd are POSIX-only')
    def test_missing_program_behind_sudo_is_named(self):
        def boom(*args, **kwargs):
            raise FileNotFoundError(2, 'No such file or directory', 'redis-cli')

        entry = mock.Mock(pw_uid=1234)
        with (
            mock.patch('pwd.getpwnam', return_value=entry),
            mock.patch.object(shell.subprocess, 'Popen', boom),
        ):
            success, result = shell.shell_exec(
                ['redis-cli', '-a', 'linuxfabrik', 'info'], run_as='appuser'
            )
        self.assertFalse(success)
        self.assertIn('Command "redis-cli" not found', result)
        self.assertNotIn('linuxfabrik', result)

    def test_missing_working_directory_is_not_reported_as_missing_program(self):
        def boom(*args, **kwargs):
            raise FileNotFoundError(2, 'No such file or directory', '/nonexistent')

        with mock.patch.object(shell.subprocess, 'Popen', boom):
            success, result = shell.shell_exec(['ls'], cwd='/nonexistent')
        self.assertFalse(success)
        self.assertNotIn('not found', result)
        self.assertIn('/nonexistent', result)

    def test_missing_program_real_run(self):
        success, result = shell.shell_exec(['linuxfabrik-no-such-program', '--secret'])
        self.assertFalse(success)
        self.assertIn('Command "linuxfabrik-no-such-program" not found', result)
        self.assertNotIn('--secret', result)

    def test_empty_argument_list_reports_instead_of_raising(self):
        success, result = shell.shell_exec([])
        self.assertFalse(success)
        self.assertIn('Error', result)

    def test_value_error_during_construction_returns_false(self):
        def boom(*args, **kwargs):
            raise ValueError('bad args')

        with mock.patch.object(shell.subprocess, 'Popen', boom):
            success, result = shell.shell_exec(['weird'])
        self.assertFalse(success)
        self.assertIn('bad args', result)

    def test_timeout_expired_kills_and_reports(self):
        Fake = make_popen(timeout=True)
        with (
            mock.patch.object(shell.os, 'name', 'posix'),
            mock.patch.object(shell.subprocess, 'Popen', Fake),
        ):
            success, result = shell.shell_exec(['sleep', '100'], timeout=1)
        self.assertFalse(success)
        self.assertEqual(result, 'Timeout after 1 seconds.')
        self.assertTrue(Fake.instances[0].killed)
        # the killed process is reaped, within a bound of its own, and its pipes let go
        process = Fake.instances[0]
        self.assertEqual(process.waited_for, shell._KILL_GRACE)
        for pipe in (process.stdin, process.stdout, process.stderr):
            pipe.close.assert_called_once_with()

    def test_timeout_on_windows_leaves_the_output_pipes_to_the_reader_threads(self):
        # On Windows communicate() reads stdout and stderr in threads that are still
        # blocked in read(); closing those pipes would wait for that read to return.
        Fake = make_popen(timeout=True)
        with (
            mock.patch.object(shell.os, 'name', 'nt'),
            mock.patch.object(shell.subprocess, 'Popen', Fake),
        ):
            success, result = shell.shell_exec(
                ['ping', '-n', '30', '127.0.0.1'], timeout=1
            )
        self.assertFalse(success)
        self.assertEqual(result, 'Timeout after 1 seconds.')
        process = Fake.instances[0]
        self.assertTrue(process.killed)
        self.assertEqual(process.waited_for, shell._KILL_GRACE)
        process.stdin.close.assert_called_once_with()
        process.stdout.close.assert_not_called()
        process.stderr.close.assert_not_called()

    def test_posix_decodes_utf8(self):
        # 'ü' as UTF-8 (0xc3 0xbc) decodes cleanly on POSIX.
        Fake = make_popen(stdout=b'm\xc3\xbcller\n')
        with (
            mock.patch.object(shell.os, 'name', 'posix'),
            mock.patch.object(shell.subprocess, 'Popen', Fake),
        ):
            _success, result = shell.shell_exec(['echo'])
        self.assertEqual(result[0], 'müller\n')

    def test_posix_non_utf8_falls_back_to_latin1(self):
        # A non-UTF-8 byte (0xfc = ü in Latin-1/CP1252) must decode via Latin-1,
        # not surrogateescape: a lone surrogate would decode here but crash later
        # when the plugin re-encodes the message for stdout (Linuxfabrik/lib#256).
        Fake = make_popen(stdout=b'M\xfcller\n')
        with (
            mock.patch.object(shell.os, 'name', 'posix'),
            mock.patch.object(shell.subprocess, 'Popen', Fake),
        ):
            _success, result = shell.shell_exec(['echo'])
        self.assertEqual(result[0], 'Müller\n')
        result[0].encode('utf-8')  # would raise under surrogateescape

    # On Windows a program picks the code page of its piped output itself. Under the
    # Icinga 2 agent, whose console is set to UTF-8, net.exe still writes the OEM code
    # page while cmd.exe and PowerShell write UTF-8 (monitoring-plugins#681). The OEM
    # codec only exists on Windows, so cp437 stands in for it here.
    def _windows(self, stdout, stderr=b''):
        Fake = make_popen(stdout=stdout, stderr=stderr)
        with (
            mock.patch.object(shell.os, 'name', 'nt'),
            mock.patch.object(shell, '_OEM_CODEC', 'cp437'),
            mock.patch.object(shell.subprocess, 'Popen', Fake),
        ):
            _success, result = shell.shell_exec(['net', 'user'])
        return result

    def test_windows_reads_the_oem_code_page(self):
        # net.exe: 'ü' is byte 0x81 in cp437
        self.assertEqual(self._windows(b'm\x81ller\n')[0], 'müller\n')

    def test_windows_reads_utf8(self):
        # cmd.exe and PowerShell under the agent
        self.assertEqual(self._windows('müller\n'.encode())[0], 'müller\n')

    def test_windows_decodes_stdout_and_stderr_each_on_their_own(self):
        result = self._windows(b'm\x81ller\n', 'müller\n'.encode())
        self.assertEqual(result[:2], ('müller\n', 'müller\n'))

    def test_windows_ascii_passes_through(self):
        self.assertEqual(self._windows(b'Administrator\n')[0], 'Administrator\n')

    def test_windows_empty_output(self):
        self.assertEqual(self._windows(b'')[0], '')

    def test_windows_byte_the_code_page_lacks_is_replaced(self):
        # cp1253 (Greek) leaves 0xAA undefined, and the result must still be text
        with mock.patch.object(shell, '_OEM_CODEC', 'cp1253'):
            text = shell._decode_windows_output(b'a\xaab')
        self.assertEqual(text, 'a\ufffdb')


# ---------------------------------------------------------------------------
# shell_exec() - running as another user
# ---------------------------------------------------------------------------


@unittest.skipUnless(os.name == 'posix', 'run_as is Unix-only')
class TestShellExecRunAs(unittest.TestCase):
    def _run(self, **kwargs):
        Fake = make_popen()
        entry = mock.Mock(pw_uid=1234)
        with (
            mock.patch('pwd.getpwnam', return_value=entry),
            mock.patch.object(shell.subprocess, 'Popen', Fake),
        ):
            shell.shell_exec(['php', '/opt/app/validate.php', '-s'], **kwargs)
        return Fake.instances[0]

    def test_session_runtime_directory_is_exported_by_default(self):
        self.assertEqual(
            self._run(run_as='appuser').args[0],
            [
                'sudo',
                '--user',
                'appuser',
                'env',
                'XDG_RUNTIME_DIR=/run/user/1234',
                'php',
                '/opt/app/validate.php',
                '-s',
            ],
        )

    def test_without_session_the_command_reaches_sudo_verbatim(self):
        # What a sudo rule naming the permitted command with its exact arguments
        # matches: no `env` in front of the program the caller asked for.
        self.assertEqual(
            self._run(run_as='appuser', run_as_session=False).args[0],
            ['sudo', '--user', 'appuser', 'php', '/opt/app/validate.php', '-s'],
        )

    def test_run_as_defaults_the_working_directory_to_root(self):
        self.assertEqual(self._run(run_as='appuser').kwargs['cwd'], '/')

    def test_run_as_keeps_an_explicit_working_directory(self):
        self.assertEqual(self._run(run_as='appuser', cwd='/tmp').kwargs['cwd'], '/tmp')

    def test_unknown_user_is_reported_instead_of_run(self):
        Fake = make_popen()
        with (
            mock.patch('pwd.getpwnam', side_effect=KeyError('nope')),
            mock.patch.object(shell.subprocess, 'Popen', Fake),
        ):
            success, result = shell.shell_exec(['true'], run_as='nope')
        self.assertFalse(success)
        self.assertIn('nope', result)
        self.assertEqual(Fake.instances, [])

    def test_run_as_session_alone_does_not_wrap_the_command(self):
        Fake = make_popen()
        with mock.patch.object(shell.subprocess, 'Popen', Fake):
            shell.shell_exec(['true'], run_as_session=False)
        self.assertEqual(Fake.instances[0].args[0], ['true'])


# ---------------------------------------------------------------------------
# safe_cli_value()
# ---------------------------------------------------------------------------


@unittest.skipIf(
    os.name == 'nt', 'the quoting is for a POSIX shell, checked with /bin/sh'
)
class TestQuoteCliValue(unittest.TestCase):
    def test_plain_values_stay_readable(self):
        # a value that needs no quoting must not get any, or every printed command
        # turns into a wall of quotes nobody reads
        for value in ('www.example.com', '/etc/acme.sh', '--ecc', 'ec-256'):
            self.assertEqual(shell.quote_cli_value(value), value)

    def test_empty_value_is_quoted(self):
        # an unquoted empty string would vanish from the command line entirely
        self.assertEqual(shell.quote_cli_value(''), "''")

    def test_whitespace_is_kept_as_one_word(self):
        self.assertEqual(
            shell.quote_cli_value('systemctl reload httpd'),
            "'systemctl reload httpd'",
        )

    def test_shell_metacharacters_cannot_start_a_second_command(self):
        for value in (
            'a; rm -rf /',
            'a && reboot',
            'a | tee /etc/passwd',
            '$(id)',
            '`id`',
            'a\nb',
            'a>b',
        ):
            quoted = shell.quote_cli_value(value)
            # the shell has to hand the value back unchanged, as a single argument
            out = subprocess.run(
                ['sh', '-c', f'printf %s {quoted}'],
                capture_output=True,
                text=True,
                check=True,
            )
            self.assertEqual(out.stdout, value)

    def test_embedded_single_quote(self):
        value = "it's here"
        quoted = shell.quote_cli_value(value)
        out = subprocess.run(
            ['sh', '-c', f'printf %s {quoted}'],
            capture_output=True,
            text=True,
            check=True,
        )
        self.assertEqual(out.stdout, value)

    def test_non_string_values(self):
        self.assertEqual(shell.quote_cli_value(42), '42')
        self.assertEqual(shell.quote_cli_value(None), 'None')


class TestSafeCliValue(unittest.TestCase):
    def test_plain_value_passes(self):
        self.assertEqual(
            shell.safe_cli_value('host.example', '--hostname'),
            (True, 'host.example'),
        )

    def test_leading_dash_is_rejected(self):
        ok, msg = shell.safe_cli_value('-oProxyCommand=evil', '--hostname')
        self.assertFalse(ok)
        self.assertIn('--hostname', msg)

    def test_single_dash_is_rejected(self):
        ok, _msg = shell.safe_cli_value('-f', '--hostname')
        self.assertFalse(ok)

    def test_non_string_passes_through(self):
        self.assertEqual(shell.safe_cli_value(5, 'count'), (True, 5))
        self.assertEqual(shell.safe_cli_value(None, 'thing'), (True, None))

    def test_value_with_inner_dash_passes(self):
        self.assertEqual(
            shell.safe_cli_value('some-host', '--hostname'),
            (True, 'some-host'),
        )


# ---------------------------------------------------------------------------
# End-to-end smoke checks against trivial real commands (POSIX only).
# These also assert the security property against a real subprocess.
# ---------------------------------------------------------------------------


@unittest.skipUnless(os.name == 'posix', 'POSIX-only smoke checks')
class TestShellExecRealCommands(unittest.TestCase):
    def test_echo_roundtrip(self):
        success, result = shell.shell_exec(['echo', 'linuxfabrik'])
        self.assertTrue(success)
        self.assertEqual(result[0].strip(), 'linuxfabrik')
        self.assertEqual(result[2], 0)

    def test_false_returns_nonzero(self):
        success, result = shell.shell_exec(['false'])
        self.assertTrue(success)
        self.assertNotEqual(result[2], 0)

    def test_real_stdin(self):
        success, result = shell.shell_exec(['cat'], stdin='from-stdin')
        self.assertTrue(success)
        self.assertEqual(result[0].strip(), 'from-stdin')

    def test_real_timeout(self):
        success, result = shell.shell_exec(['sleep', '5'], timeout=1)
        self.assertFalse(success)
        self.assertEqual(result, 'Timeout after 1 seconds.')

    def test_real_timeout_holds_when_the_pipes_outlive_the_command(self):
        # Killing the command does not close its pipes when something else holds them
        # open: an orphaned grandchild here, and a command sitting in an uninterruptible
        # sleep on storage that has gone away in the field. Reaping without a bound
        # waits for that instead of for the deadline the caller asked for, so this call
        # used to take as long as the grandchild lives (20 s) rather than the timeout.
        #
        # The killed command itself has to be reaped all the same. Reading the pipes to
        # their end did not, and left it a zombie that Python only reports once the
        # process object is collected ("ResourceWarning: subprocess ... is still
        # running").
        start = time.time()
        with warnings.catch_warnings(record=True) as caught:
            warnings.simplefilter('always', ResourceWarning)
            success, result = shell.shell_exec(
                ['sh', '-c', 'sleep 20 & sleep 20'],
                timeout=1,
            )
            gc.collect()
        elapsed = time.time() - start
        self.assertFalse(success)
        self.assertEqual(result, 'Timeout after 1 seconds.')
        self.assertLess(elapsed, 10)
        self.assertEqual(
            [str(w.message) for w in caught if w.category is ResourceWarning], []
        )

    def test_metacharacters_are_not_interpreted(self):
        # The whole string is one literal argument to echo; the shell would have
        # split it on '|' and run 'reboot'. shell=False means it never does.
        payload = '|reboot| ; rm -rf / && whoami'
        success, result = shell.shell_exec(['echo', payload])
        self.assertTrue(success)
        self.assertEqual(result[0].strip(), payload)

    def test_argument_with_spaces_stays_single(self):
        success, result = shell.shell_exec(['echo', 'one two three'])
        self.assertTrue(success)
        self.assertEqual(result[0].strip(), 'one two three')


class TestWhich(unittest.TestCase):
    def test_found(self):
        with mock.patch('lib.shell.shutil.which', return_value='/usr/bin/sh') as w:
            self.assertEqual(shell.which('sh'), '/usr/bin/sh')
            w.assert_called_once_with('sh')

    def test_not_found(self):
        with mock.patch('lib.shell.shutil.which', return_value=None):
            self.assertIsNone(shell.which('does-not-exist'))


class TestShellExecHidesArgumentsOnSpawnFailure(unittest.TestCase):
    """A command that cannot be started at all is reported back by its program name
    only. Its argument list may carry a credential, and the message is routinely
    printed as part of a result.
    """

    def test_argv_credential_is_not_reported(self):
        ok, msg = shell.shell_exec(['/nonexistent-binary', '--password', 'secret123'])
        self.assertFalse(ok)
        self.assertNotIn('secret123', msg)
        self.assertNotIn('--password', msg)
        # the program name stays readable, otherwise the message is useless
        self.assertIn('/nonexistent-binary', msg)

    def test_short_option_credential_is_not_reported(self):
        # the shapes a name-based redaction misses: `-P <password>`, `-c <community>`
        for cmd in (
            ['/nonexistent-binary', '-P', 'secret123'],
            ['/nonexistent-binary', '-c', 'secret123', '192.0.2.1'],
            ['/nonexistent-binary', '-psecret123'],
        ):
            ok, msg = shell.shell_exec(cmd)
            self.assertFalse(ok)
            self.assertNotIn('secret123', msg)


MIB = 1024 * 1024


def _python(code):
    """The argv of a command that runs `code` with the interpreter of the tests."""
    return [sys.executable, '-c', code]


class TestShellExecMaxBytes(unittest.TestCase):
    """`max_bytes` stops a command that prints more than the caller wants to hold. Without
    it everything is captured, as it always was."""

    def test_the_default_reads_everything(self):
        code = "import sys; sys.stdout.write('x' * 3000000); sys.stderr.write('e')"
        success, (out, err, retc) = shell.shell_exec(_python(code))
        self.assertTrue(success)
        self.assertEqual((len(out), err, retc), (3000000, 'e', 0))

    def test_a_small_output_is_the_same_with_and_without_a_cap(self):
        code = "import sys; print('out'); print('err', file=sys.stderr); sys.exit(3)"
        plain = shell.shell_exec(_python(code))
        for cap in (MIB, (MIB, MIB), (MIB, None), (None, MIB)):
            with self.subTest(cap=cap):
                self.assertEqual(shell.shell_exec(_python(code), max_bytes=cap), plain)

    def test_a_stdout_over_the_cap_is_refused_and_the_command_is_killed(self):
        code = (
            'import os, sys, time\n'
            "open(sys.argv[1], 'w').write(str(os.getpid()))\n"
            'for _ in range(500):\n'
            "    sys.stdout.buffer.write(b'x' * 1048576); sys.stdout.buffer.flush()\n"
            'time.sleep(30)\n'
        )
        import tempfile

        with tempfile.TemporaryDirectory() as directory:
            pid_file = os.path.join(directory, 'pid')
            started = time.monotonic()
            result = shell.shell_exec(
                [sys.executable, '-c', code, pid_file], max_bytes=4 * MIB, timeout=20
            )
            elapsed = time.monotonic() - started
            with open(pid_file, encoding='utf-8') as handle:
                pid = int(handle.read())
        self.assertEqual(result[0], False)
        self.assertEqual(result[1], f'The output of {sys.executable} exceeded 4 MiB.')
        self.assertLess(elapsed, 10)
        if os.name != 'nt':
            # killed and reaped, not left as a zombie or a runaway
            with self.assertRaises(ProcessLookupError):
                os.kill(pid, 0)

    def test_a_stderr_over_its_own_cap_is_refused(self):
        code = "import sys\nsys.stdout.write('fine')\nsys.stderr.write('e' * 5000000)\n"
        success, message = shell.shell_exec(_python(code), max_bytes=(100 * MIB, MIB))
        self.assertFalse(success)
        self.assertIn('exceeded 1 MiB', message)

    def test_a_stdout_that_is_open_stays_open_with_none(self):
        code = "import sys; sys.stdout.write('x' * 3000000)"
        success, (out, _, _) = shell.shell_exec(_python(code), max_bytes=(None, MIB))
        self.assertTrue(success)
        self.assertEqual(len(out), 3000000)

    def test_the_timeout_still_applies(self):
        started = time.monotonic()
        result = shell.shell_exec(
            _python('import time; time.sleep(30)'), timeout=1, max_bytes=MIB
        )
        self.assertEqual(result, (False, 'Timeout after 1 seconds.'))
        self.assertLess(time.monotonic() - started, 6)

    def test_stdin_is_delivered_while_the_output_is_read(self):
        # both pipes fill up: the input is 3 MB, and the command answers with 3 MB while
        # it reads. Reading one pipe after the other would deadlock.
        code = 'import sys\ndata = sys.stdin.read()\nsys.stdout.write(data)\n'
        payload = 'y' * 3000000
        success, (out, _, retc) = shell.shell_exec(
            _python(code), stdin=payload, max_bytes=8 * MIB, timeout=30
        )
        self.assertTrue(success)
        self.assertEqual((len(out), retc), (3000000, 0))

    def test_a_command_that_does_not_read_its_stdin_does_not_hang_the_call(self):
        success, (out, _, _) = shell.shell_exec(
            _python("print('done')"), stdin='z' * 3000000, max_bytes=MIB, timeout=20
        )
        self.assertTrue(success)
        self.assertEqual(out.strip(), 'done')

    def test_a_missing_program_is_reported_as_before(self):
        success, message = shell.shell_exec(['no-such-program-lf'], max_bytes=MIB)
        self.assertFalse(success)
        self.assertIn('not found', message)

    def test_invalid_bytes_are_decoded_as_before(self):
        code = "import sys; sys.stdout.buffer.write(b'caf\\xe9')"
        plain = shell.shell_exec(_python(code))
        self.assertEqual(shell.shell_exec(_python(code), max_bytes=MIB), plain)


class TestShellExecMaxBytesArguments(unittest.TestCase):
    """A `max_bytes` that cannot be used is refused before anything is started."""

    def test_what_is_refused(self):
        for value in (
            '5',
            b'5',
            -1,
            0,
            1.5,
            True,
            False,
            (1,),
            (1, 2, 3),
            [1],
            (0, MIB),
            (MIB, -1),
            (MIB, '5'),
            (True, MIB),
            {'out': MIB},
            (),
        ):
            with self.subTest(value=value):
                with mock.patch.object(shell.subprocess, 'Popen') as popen:
                    success, message = shell.shell_exec(
                        _python("print('x')"), max_bytes=value
                    )
                self.assertFalse(success)
                self.assertIn('max_bytes must be', message)
                popen.assert_not_called()

    def test_what_is_accepted(self):
        for value in (
            None,
            1,
            MIB,
            (MIB, MIB),
            [MIB, MIB],
            (None, MIB),
            (MIB, None),
            (None, None),
        ):
            with self.subTest(value=value):
                result = shell.shell_exec(_python("print('x')"), max_bytes=value)
                self.assertNotIn('max_bytes must be', str(result))

    def test_a_refusal_leaves_no_child_behind(self):
        import tempfile

        code = (
            'import os, sys, time\n'
            "open(sys.argv[1], 'w').write(str(os.getpid()))\n"
            'time.sleep(30)\n'
        )
        with tempfile.TemporaryDirectory() as directory:
            pid_file = os.path.join(directory, 'pid')
            success, _ = shell.shell_exec(
                [sys.executable, '-c', code, pid_file], max_bytes='5'
            )
            self.assertFalse(success)
            self.assertFalse(os.path.exists(pid_file))

    def test_an_error_inside_the_read_kills_and_reaps_the_command(self):
        import tempfile

        code = (
            'import os, sys, time\n'
            "open(sys.argv[1], 'w').write(str(os.getpid()))\n"
            'time.sleep(30)\n'
        )
        with tempfile.TemporaryDirectory() as directory:
            pid_file = os.path.join(directory, 'pid')

            def fail(p, *args):
                # the child is up once its pid file is written
                for _ in range(100):
                    if os.path.exists(pid_file) and os.path.getsize(pid_file):
                        break
                    time.sleep(0.05)
                raise RuntimeError('boom')

            with (
                mock.patch.object(shell, '_communicate_bounded', fail),
                self.assertRaises(RuntimeError),
            ):
                shell.shell_exec([sys.executable, '-c', code, pid_file], max_bytes=MIB)
            with open(pid_file, encoding='utf-8') as handle:
                pid = int(handle.read())
        if os.name != 'nt':
            with self.assertRaises(ProcessLookupError):
                os.kill(pid, 0)

    def test_a_cap_is_named_in_words_that_fit_it(self):
        for cap, words in (
            (1000, '1000 bytes'),
            (MIB, '1 MiB'),
            (4 * MIB, '4 MiB'),
            (MIB + MIB // 2, '1.5 MiB'),
            (MIB - 1, '1048575 bytes'),
        ):
            with self.subTest(cap=cap):
                self.assertEqual(shell._size(cap), words)
        _, message = shell.shell_exec(
            _python("import sys; sys.stdout.write('x' * 5000)"), max_bytes=1000
        )
        self.assertEqual(
            message, f'The output of {sys.executable} exceeded 1000 bytes.'
        )


class TestCommunicateBoundedThreads(unittest.TestCase):
    """The reader that Windows uses, run here on the pipes of a POSIX command: it needs
    nothing but `read1()` and file objects. A reviewer can check it against these cases."""

    def _run(self, code, stdin='', timeout=10, limits=(MIB, MIB)):
        p = subprocess.Popen(
            _python(code),
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        self.addCleanup(p.kill)
        deadline = time.monotonic() + timeout
        state = {}
        try:
            result = shell._communicate_bounded_threads(
                p,
                stdin.encode() if stdin else None,
                deadline,
                timeout,
                limits,
                'cmd',
                state,
            )
        finally:
            self.state = state
            p.kill()
            p.wait()
            for pipe in (p.stdout, p.stderr):
                pipe.close()
        return result

    def test_the_output_comes_back(self):
        out, err = self._run("import sys; print('out'); print('err', file=sys.stderr)")
        self.assertEqual((out.strip(), err.strip()), (b'out', b'err'))

    def test_stdin_is_delivered(self):
        out, _ = self._run(
            'import sys; sys.stdout.write(sys.stdin.read())',
            stdin='y' * 3000000,
            limits=(8 * MIB, MIB),
        )
        self.assertEqual(len(out), 3000000)

    def test_a_stream_over_its_cap_raises(self):
        with self.assertRaises(shell._OutputTooLarge) as caught:
            self._run(
                "import sys; sys.stderr.write('e' * 5000000)", limits=(8 * MIB, MIB)
            )
        self.assertEqual(caught.exception.cap, MIB)

    def test_the_timeout_raises(self):
        with self.assertRaises(subprocess.TimeoutExpired):
            self._run('import time; time.sleep(30)', timeout=1)

    def test_a_command_that_closes_stdout_early_does_not_burn_the_cpu(self):
        # stdout ended, stderr lives for a second: the wait must sleep, not spin
        code = 'import os, sys, time\nos.close(1)\ntime.sleep(1)\n'
        cpu = time.process_time()
        self._run(code, timeout=5)
        self.assertLess(time.process_time() - cpu, 0.5)

    def test_the_feeder_is_handed_back_while_it_writes(self):
        # a command that never reads its input: the feeder blocks on a full pipe
        with self.assertRaises(subprocess.TimeoutExpired):
            self._run('import time; time.sleep(30)', stdin='z' * 3000000, timeout=1)
        feeder = self.state['feeder']
        self.assertTrue(shell._feeding(self.state) or not feeder.is_alive())


@unittest.skipUnless(
    sys.platform.startswith('linux'), 'the memory limit is set with RLIMIT_AS'
)
class TestShellExecMaxBytesUnderALimit(unittest.TestCase):
    """The real thing, with the memory of the caller limited, so a command that prints more
    than the machine has fails the test instead of the machine."""

    LIMIT = 400 * MIB

    def _run(self, child_code, cap, expect):
        parent = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        script = (
            'import resource, sys\n'
            f'resource.setrlimit(resource.RLIMIT_AS, ({self.LIMIT}, {self.LIMIT}))\n'
            f'sys.path.insert(0, {parent!r})\n'
            'import lib.shell as shell\n'
            f'cmd = [sys.executable, "-c", {child_code!r}]\n'
            f'print(shell.shell_exec(cmd, max_bytes={cap!r}, timeout=120))\n'
        )
        done = subprocess.run(
            [sys.executable, '-c', script], capture_output=True, text=True, timeout=200
        )
        self.assertEqual(done.returncode, 0, msg=done.stderr[-600:])
        self.assertIn(expect, done.stdout)

    def test_300_mib_on_stdout(self):
        self._run(
            'import sys\n'
            'for _ in range(300):\n'
            '    sys.stdout.buffer.write(b"x" * 1048576); sys.stdout.buffer.flush()\n',
            32 * MIB,
            "exceeded 32 MiB.')",
        )

    def test_one_line_of_100_mib(self):
        self._run(
            'import sys; sys.stdout.buffer.write(b"y" * 104857600)',
            32 * MIB,
            "exceeded 32 MiB.')",
        )

    def test_a_full_stderr(self):
        self._run(
            'import sys\n'
            'for _ in range(300):\n'
            '    sys.stderr.buffer.write(b"e" * 1048576); sys.stderr.buffer.flush()\n',
            (128 * MIB, MIB),
            "exceeded 1 MiB.')",
        )


if __name__ == '__main__':
    unittest.main()
