"""Unit tests for lib.logsource.

Fixture-based, no container required. The file tests write real files into a
throwaway directory, so they exercise the rotation, truncation and rewrite
detection against the filesystem instead of against a mock. The journald and
container tests replace `lib.shell.shell_exec` with recorded output, so they
assert both the command that is built and the parsing of what comes back.
"""

import calendar
import datetime
import os
import sys
import tempfile
import time
import unittest
from unittest.mock import patch

sys.path.insert(0, '..')

import lib.logsource


class TestParse(unittest.TestCase):
    def test_file(self):
        self.assertEqual(
            lib.logsource.parse('/var/log/messages'),
            (True, ('file', None, '/var/log/messages')),
        )

    def test_file_with_colon_in_path(self):
        # an unknown prefix is part of the path, not a storage
        self.assertEqual(
            lib.logsource.parse('/var/log/weird:name.log'),
            (True, ('file', None, '/var/log/weird:name.log')),
        )

    def test_file_windows_drive_letter(self):
        self.assertEqual(
            lib.logsource.parse(r'C:\log\app.log'),
            (True, ('file', None, r'C:\log\app.log')),
        )

    def test_journald(self):
        self.assertEqual(
            lib.logsource.parse('systemd:sshd'),
            (True, ('journald', None, 'sshd')),
        )

    def test_container_engines(self):
        for engine in ('docker', 'kubectl', 'podman'):
            self.assertEqual(
                lib.logsource.parse(f'{engine}:database'),
                (True, ('container', engine, 'database')),
            )

    def test_target_is_stripped(self):
        self.assertEqual(
            lib.logsource.parse('systemd:  sshd  '),
            (True, ('journald', None, 'sshd')),
        )

    def test_empty_target(self):
        success, result = lib.logsource.parse('podman:')
        self.assertFalse(success)
        self.assertIn('names no target', result)

    def test_empty_source(self):
        for source in ('', None):
            success, result = lib.logsource.parse(source)
            self.assertFalse(success)
            self.assertIn('No log source', result)

    def test_wrong_type(self):
        success, _ = lib.logsource.parse(42)
        self.assertFalse(success)


class TestReadFile(unittest.TestCase):
    def setUp(self):
        self.tmpdir = tempfile.mkdtemp()
        self.path = os.path.join(self.tmpdir, 'app.log')

    def write(self, content, mode='a'):
        with open(self.path, mode) as handle:
            handle.write(content)

    def read(self, position=None, **kwargs):
        success, result = lib.logsource.read(self.path, position=position, **kwargs)
        self.assertTrue(success, msg=result)
        return result

    def test_first_run_reads_everything(self):
        self.write('one\ntwo\n', 'w')
        result = self.read()
        self.assertEqual(result['lines'], ['one', 'two'])
        self.assertEqual(result['kind'], lib.logsource.KIND_FILE)
        self.assertEqual(result['fidelity'], lib.logsource.FIDELITY_EXACT)
        self.assertEqual(result['label'], self.path)
        self.assertFalse(result['restarted'])
        self.assertFalse(result['truncated'])
        self.assertEqual(result['notice'], '')

    def test_empty_file(self):
        self.write('', 'w')
        result = self.read()
        self.assertEqual(result['lines'], [])
        self.assertEqual(result['position']['offset'], 0)

    def test_line_without_trailing_newline(self):
        self.write('no newline at eof', 'w')
        self.assertEqual(self.read()['lines'], ['no newline at eof'])

    def test_nothing_new(self):
        self.write('one\n', 'w')
        first = self.read()
        second = self.read(position=first['position'])
        self.assertEqual(second['lines'], [])
        self.assertFalse(second['restarted'])

    def test_append_returns_only_new_lines(self):
        self.write('one\n', 'w')
        first = self.read()
        self.write('two\nthree\n')
        second = self.read(position=first['position'])
        self.assertEqual(second['lines'], ['two', 'three'])
        self.assertFalse(second['restarted'])

    def test_rewrite_in_place_restarts(self):
        # same inode, and the new content is longer than what was read, so
        # neither the inode nor the size gives the rewrite away
        self.write('one\n', 'w')
        first = self.read()
        self.write('AAAA\nBBBB\nCCCC\n', 'w')
        second = self.read(position=first['position'])
        self.assertEqual(second['lines'], ['AAAA', 'BBBB', 'CCCC'])
        self.assertTrue(second['restarted'])

    def test_truncation_restarts(self):
        self.write('one\ntwo\nthree\n', 'w')
        first = self.read()
        self.write('x\n', 'w')
        second = self.read(position=first['position'])
        self.assertEqual(second['lines'], ['x'])
        self.assertTrue(second['restarted'])

    def test_rotation_restarts(self):
        self.write('one\n', 'w')
        first = self.read()
        os.rename(self.path, self.path + '.1')
        self.write('fresh\n', 'w')
        second = self.read(position=first['position'])
        self.assertEqual(second['lines'], ['fresh'])
        self.assertTrue(second['restarted'])

    def test_grown_from_empty_is_no_restart(self):
        # the previous run saw an empty file, so an offset of 0 stays valid and
        # nothing was missed
        self.write('', 'w')
        first = self.read()
        self.write('one\n')
        second = self.read(position=first['position'])
        self.assertEqual(second['lines'], ['one'])
        self.assertFalse(second['restarted'])

    def test_max_lines_keeps_the_newest(self):
        self.write('a\nb\nc\nd\ne\n', 'w')
        result = self.read(max_lines=2)
        self.assertEqual(result['lines'], ['d', 'e'])
        self.assertTrue(result['truncated'])

    def test_max_lines_still_advances_the_position(self):
        self.write('a\nb\nc\n', 'w')
        first = self.read(max_lines=1)
        self.write('d\n')
        second = self.read(position=first['position'], max_lines=1)
        self.assertEqual(second['lines'], ['d'])
        self.assertFalse(second['truncated'])

    def test_max_lines_not_reached(self):
        self.write('a\n', 'w')
        result = self.read(max_lines=10)
        self.assertEqual(result['lines'], ['a'])
        self.assertFalse(result['truncated'])

    def test_allowed_roots_permit(self):
        self.write('one\n', 'w')
        result = self.read(allowed_roots=[self.tmpdir])
        self.assertEqual(result['lines'], ['one'])

    def test_allowed_roots_refuse(self):
        self.write('one\n', 'w')
        success, result = lib.logsource.read(self.path, allowed_roots=['/var/log'])
        self.assertFalse(success)
        self.assertIn('Refusing to read', result)

    def test_allowed_roots_refuse_symlink_escape(self):
        outside = os.path.join(self.tmpdir, 'outside.log')
        with open(outside, 'w') as handle:
            handle.write('secret\n')
        root = os.path.join(self.tmpdir, 'root')
        os.mkdir(root)
        link = os.path.join(root, 'app.log')
        os.symlink(outside, link)
        success, result = lib.logsource.read(link, allowed_roots=[root])
        self.assertFalse(success)
        self.assertIn('Refusing to read', result)

    def test_invalid_utf8_falls_back_to_latin1(self):
        with open(self.path, 'wb') as handle:
            handle.write(b'caf\xe9 broken\n')
        self.assertEqual(self.read()['lines'], ['café broken'])

    def test_crlf_line_endings_are_stripped(self):
        with open(self.path, 'wb') as handle:
            handle.write(b'one\r\ntwo\r\n')
        self.assertEqual(self.read()['lines'], ['one', 'two'])

    def test_missing_file(self):
        success, result = lib.logsource.read(os.path.join(self.tmpdir, 'nope.log'))
        self.assertFalse(success)
        self.assertIn('I/O error', result)

    def test_position_from_another_kind_is_ignored(self):
        self.write('one\n', 'w')
        success, result = lib.logsource.read(
            self.path,
            position={'kind': lib.logsource.KIND_JOURNALD, 'cursor': 's=1'},
        )
        self.assertTrue(success)
        self.assertEqual(result['lines'], ['one'])

    def test_position_shape(self):
        self.write('one\n', 'w')
        position = self.read()['position']
        self.assertEqual(
            sorted(position),
            ['fingerprint', 'inode', 'kind', 'length', 'offset'],
        )
        self.assertEqual(position['kind'], lib.logsource.KIND_FILE)

    def test_legacy_integer_inode_is_compared_as_string(self):
        # a state written before the inode was stored as text reads back as int;
        # comparing without the cast would look like a rotation on every run
        self.write('one\n', 'w')
        first = self.read()
        legacy = dict(first['position'], inode=int(first['position']['inode']))
        self.write('two\n')
        second = self.read(position=legacy)
        self.assertEqual(second['lines'], ['two'])
        self.assertFalse(second['restarted'])


class TestReadRotated(unittest.TestCase):
    """A rotator moves the old file aside and the application starts a fresh one, so a
    caller reading a window of the log loses everything older than the last rotation
    unless it asks for the predecessors as well."""

    def setUp(self):
        self.tmpdir = tempfile.mkdtemp()
        self.path = os.path.join(self.tmpdir, 'app.log')

    def write(self, name, content, mtime=None):
        """Write one of the files a rotator would have left behind.

        Modification times are set explicitly, because the ordering is taken from them and
        a test that wrote its files within the same clock tick would not pin it down.
        """
        path = os.path.join(self.tmpdir, name)
        with open(path, 'w') as handle:
            handle.write(content)
        if mtime is not None:
            os.utime(path, (mtime, mtime))
        return path

    def write_gz(self, name, content, mtime=None):
        import gzip

        path = os.path.join(self.tmpdir, name)
        with gzip.open(path, 'wt') as handle:
            handle.write(content)
        if mtime is not None:
            os.utime(path, (mtime, mtime))
        return path

    def read(self, **kwargs):
        success, result = lib.logsource.read(self.path, **kwargs)
        self.assertTrue(success, msg=result)
        return result

    def test_not_asked_for_is_not_read(self):
        self.write('app.log.1', 'yesterday\n', mtime=1000)
        self.write('app.log', 'today\n', mtime=2000)
        result = self.read()
        self.assertEqual(result['lines'], ['today'])
        self.assertEqual(result['rotated'], [])

    def test_counted_generation(self):
        self.write('app.log.1', 'yesterday\n', mtime=1000)
        self.write('app.log', 'today\n', mtime=2000)
        result = self.read(rotated=1)
        self.assertEqual(result['lines'], ['yesterday', 'today'])
        self.assertEqual(result['rotated'], [os.path.join(self.tmpdir, 'app.log.1')])

    def test_dated_generation(self):
        self.write('app.log-20260827', 'older\n', mtime=1000)
        self.write('app.log-20260828', 'yesterday\n', mtime=2000)
        self.write('app.log', 'today\n', mtime=3000)
        result = self.read(rotated=1)
        # the newest predecessor by modification time, not the first by name
        self.assertEqual(result['lines'], ['yesterday', 'today'])

    def test_several_predecessors_arrive_oldest_first(self):
        self.write('app.log.3', 'three\n', mtime=1000)
        self.write('app.log.2', 'two\n', mtime=2000)
        self.write('app.log.1', 'one\n', mtime=3000)
        self.write('app.log', 'live\n', mtime=4000)
        result = self.read(rotated=3)
        self.assertEqual(result['lines'], ['three', 'two', 'one', 'live'])

    def test_more_asked_for_than_exist(self):
        self.write('app.log.1', 'one\n', mtime=1000)
        self.write('app.log', 'live\n', mtime=2000)
        self.assertEqual(self.read(rotated=10)['lines'], ['one', 'live'])

    def test_compressed_predecessor(self):
        # what delaycompress leaves behind: the newest is plain, the rest are gzipped
        self.write_gz('app.log.2.gz', 'two\n', mtime=1000)
        self.write('app.log.1', 'one\n', mtime=2000)
        self.write('app.log', 'live\n', mtime=3000)
        result = self.read(rotated=2)
        self.assertEqual(result['lines'], ['two', 'one', 'live'])

    def test_a_neighbours_log_is_not_a_predecessor(self):
        # the same directory holds other logs, and one of them starting with the
        # source's name must not be read as its rotation
        self.write('app.log-error.1', 'not mine\n', mtime=1000)
        self.write('app.log.backup', 'not mine either\n', mtime=1500)
        self.write('app.log', 'live\n', mtime=2000)
        result = self.read(rotated=5)
        self.assertEqual(result['lines'], ['live'])
        self.assertEqual(result['rotated'], [])

    def test_symlink_is_not_followed(self):
        secret = os.path.join(self.tmpdir, 'secret')
        with open(secret, 'w') as handle:
            handle.write('secret\n')
        os.symlink(secret, os.path.join(self.tmpdir, 'app.log.1'))
        self.write('app.log', 'live\n', mtime=2000)
        result = self.read(rotated=1)
        self.assertEqual(result['lines'], ['live'])
        self.assertNotIn('secret', ' '.join(result['lines']))

    def test_unreadable_predecessor_is_named_and_the_live_file_still_read(self):
        # a rotation that was interrupted leaves a truncated archive behind; the
        # live file is what the caller asked about and has to be reported anyway
        broken = os.path.join(self.tmpdir, 'app.log.1.gz')
        with open(broken, 'wb') as handle:
            handle.write(b'not gzip at all')
        os.utime(broken, (1000, 1000))
        self.write('app.log', 'live\n', mtime=2000)
        result = self.read(rotated=1)
        self.assertEqual(result['lines'], ['live'])
        self.assertEqual(result['rotated'], [])
        self.assertIn('Skipped a rotated file', result['notice'])
        self.assertIn('app.log.1.gz', result['notice'])

    def test_predecessor_is_confined_to_the_allowed_roots(self):
        # the live file decides the directory, so a predecessor is normally in the
        # same one; the check is what keeps that true if it ever is not
        self.write('app.log.1', 'one\n', mtime=1000)
        self.write('app.log', 'live\n', mtime=2000)
        result = self.read(rotated=1, allowed_roots=[self.tmpdir])
        self.assertEqual(result['lines'], ['one', 'live'])

    def test_max_lines_caps_across_all_files(self):
        self.write('app.log.1', 'one\ntwo\n', mtime=1000)
        self.write('app.log', 'three\nfour\n', mtime=2000)
        result = self.read(rotated=1, max_lines=3)
        self.assertEqual(result['lines'], ['two', 'three', 'four'])
        self.assertTrue(result['truncated'])

    def test_a_resuming_caller_gets_no_predecessor(self):
        # the lines of a predecessor were seen on an earlier run, and the position
        # that comes back describes the live file alone
        self.write('app.log.1', 'yesterday\n', mtime=1000)
        self.write('app.log', 'today\n', mtime=2000)
        first = self.read(rotated=1)
        self.assertEqual(first['lines'], ['yesterday', 'today'])
        with open(self.path, 'a') as handle:
            handle.write('later\n')
        second = self.read(rotated=1, position=first['position'])
        self.assertEqual(second['lines'], ['later'])
        self.assertEqual(second['rotated'], [])

    def test_the_position_describes_the_live_file(self):
        self.write('app.log.1', 'yesterday\n', mtime=1000)
        self.write('app.log', 'today\n', mtime=2000)
        result = self.read(rotated=1)
        self.assertEqual(result['position']['offset'], len('today\n'))


class TestReadJournald(unittest.TestCase):
    CURSOR = 's=485571998e574800b311165f5bf0bd42;i=ce9e34'

    def shell(self, stdout, stderr='', retc=0):
        return patch(
            'lib.shell.shell_exec',
            return_value=(True, (stdout, stderr, retc)),
        )

    def test_first_run_reads_the_current_boot(self):
        stdout = (
            f'2026-08-28T15:26:18+02:00 host sshd[1]: hello\n-- cursor: {self.CURSOR}\n'
        )
        with self.shell(stdout) as mock:
            success, result = lib.logsource.read('systemd:sshd')
        self.assertTrue(success)
        cmd = mock.call_args[0][0]
        self.assertIn('--boot', cmd)
        self.assertIn('--unit=sshd', cmd)
        self.assertIn('--show-cursor', cmd)
        self.assertEqual(
            result['lines'], ['2026-08-28T15:26:18+02:00 host sshd[1]: hello']
        )
        self.assertEqual(result['position']['cursor'], self.CURSOR)
        self.assertEqual(result['fidelity'], lib.logsource.FIDELITY_EXACT)
        self.assertEqual(result['label'], 'systemd:sshd')
        self.assertFalse(result['restarted'])

    def test_resume_uses_the_cursor(self):
        with self.shell(f'-- cursor: {self.CURSOR}\n') as mock:
            lib.logsource.read(
                'systemd:sshd',
                position={'kind': 'journald', 'cursor': self.CURSOR},
            )
        cmd = mock.call_args[0][0]
        self.assertIn(f'--after-cursor={self.CURSOR}', cmd)
        self.assertNotIn('--boot', cmd)

    def test_since_is_used_without_a_position(self):
        with self.shell('') as mock:
            lib.logsource.read('systemd:sshd', since='-8h')
        cmd = mock.call_args[0][0]
        self.assertIn('--since=-8h', cmd)
        self.assertNotIn('--boot', cmd)

    def test_cursor_wins_over_since(self):
        with self.shell('') as mock:
            lib.logsource.read(
                'systemd:sshd',
                position={'kind': 'journald', 'cursor': self.CURSOR},
                since='-8h',
            )
        cmd = mock.call_args[0][0]
        self.assertIn(f'--after-cursor={self.CURSOR}', cmd)
        self.assertNotIn('--since=-8h', cmd)

    def test_max_lines_is_passed_on(self):
        with self.shell('') as mock:
            lib.logsource.read('systemd:sshd', max_lines=50)
        self.assertIn('--lines=50', mock.call_args[0][0])

    def test_informational_lines_are_dropped(self):
        stdout = (
            '-- Boot 3b5678970f3044849d9b00ab3e5ab6ee --\n'
            '2026-08-28T15:26:18+02:00 host sshd[1]: real\n'
            '-- No entries --\n'
            f'-- cursor: {self.CURSOR}\n'
        )
        with self.shell(stdout):
            _, result = lib.logsource.read('systemd:sshd')
        self.assertEqual(
            result['lines'], ['2026-08-28T15:26:18+02:00 host sshd[1]: real']
        )

    def test_no_new_entries_keeps_the_stored_cursor(self):
        with self.shell('-- No entries --\n'):
            _, result = lib.logsource.read(
                'systemd:sshd',
                position={'kind': 'journald', 'cursor': self.CURSOR},
            )
        self.assertEqual(result['lines'], [])
        self.assertEqual(result['position']['cursor'], self.CURSOR)

    def test_unknown_unit_yields_no_cursor(self):
        with self.shell('-- No entries --\n'):
            _, result = lib.logsource.read('systemd:nope')
        self.assertIsNone(result['position']['cursor'])

    def test_unit_name_is_bound_to_its_option(self):
        # a unit starting with "-" must not be picked up as an option
        with self.shell('') as mock:
            lib.logsource.read('systemd:--version')
        self.assertIn('--unit=--version', mock.call_args[0][0])

    def test_non_zero_exit(self):
        with self.shell('', 'Failed to add match', 1):
            success, result = lib.logsource.read('systemd:sshd')
        self.assertFalse(success)
        self.assertIn('exited with error', result)

    def test_unreadable_journal_is_a_failure_not_an_empty_read(self):
        # journalctl exits 0 and only warns on stderr when the caller may not see
        # the system journal. Reporting that as "nothing logged" would be a
        # silently green check on a host whose log cannot be read at all.
        hint = (
            'Hint: You are currently not seeing messages from other users and '
            'the system.'
        )
        with self.shell('-- No entries --\n', hint):
            success, result = lib.logsource.read('systemd:sshd')
        self.assertFalse(success)
        self.assertIn('systemd-journal', result)
        self.assertIn(hint, result)

    def test_stderr_next_to_entries_becomes_a_notice(self):
        stdout = (
            f'2026-08-28T15:26:18+02:00 host sshd[1]: real\n-- cursor: {self.CURSOR}\n'
        )
        with self.shell(stdout, 'Hint: only showing your own messages.'):
            success, result = lib.logsource.read('systemd:sshd')
        self.assertTrue(success)
        self.assertEqual(len(result['lines']), 1)
        self.assertIn('only showing your own messages', result['notice'])

    def test_quiet_read_has_no_notice(self):
        with self.shell(f'-- cursor: {self.CURSOR}\n'):
            _, result = lib.logsource.read(
                'systemd:sshd',
                position={'kind': 'journald', 'cursor': self.CURSOR},
            )
        self.assertEqual(result['notice'], '')

    def test_shell_failure_is_passed_through(self):
        with patch('lib.shell.shell_exec', return_value=(False, 'timeout')):
            success, result = lib.logsource.read('systemd:sshd')
        self.assertFalse(success)
        self.assertEqual(result, 'timeout')


class TestReadContainer(unittest.TestCase):
    STAMP1 = '2026-08-28T15:30:26.100000000+02:00'
    STAMP2 = '2026-08-28T15:30:26.200000000+02:00'
    STAMP3 = '2026-08-28T15:30:26.300000000+02:00'

    def shell(self, stdout, stderr='', retc=0):
        return patch(
            'lib.shell.shell_exec',
            return_value=(True, (stdout, stderr, retc)),
        )

    def test_first_run_strips_the_timestamps(self):
        with self.shell(f'{self.STAMP1} out one\n{self.STAMP2} out two\n') as mock:
            success, result = lib.logsource.read('podman:db')
        self.assertTrue(success)
        cmd = mock.call_args[0][0]
        self.assertEqual(cmd[:3], ['podman', 'logs', '--timestamps'])
        self.assertEqual(cmd[-1], 'db')
        self.assertEqual(result['lines'], ['out one', 'out two'])
        self.assertEqual(result['fidelity'], lib.logsource.FIDELITY_APPROXIMATE)
        self.assertEqual(result['label'], 'podman:db')
        self.assertEqual(result['position']['timestamp'], self.STAMP2)
        self.assertEqual(result['notice'], '')

    def test_both_streams_are_merged_chronologically(self):
        with self.shell(f'{self.STAMP3} out\n', f'{self.STAMP1} err\n'):
            _, result = lib.logsource.read('podman:db')
        self.assertEqual(result['lines'], ['err', 'out'])

    def test_resume_drops_the_inclusive_repeat(self):
        # `--since` is inclusive, so the entry at the stored timestamp comes back
        with self.shell(f'{self.STAMP1} old\n{self.STAMP2} new\n') as mock:
            _, result = lib.logsource.read(
                'podman:db',
                position={'kind': 'container', 'timestamp': self.STAMP1},
            )
        self.assertIn(f'--since={self.STAMP1}', mock.call_args[0][0])
        self.assertEqual(result['lines'], ['new'])
        self.assertEqual(result['position']['timestamp'], self.STAMP2)

    def test_nothing_new_keeps_the_stored_timestamp(self):
        with self.shell(f'{self.STAMP1} old\n'):
            _, result = lib.logsource.read(
                'podman:db',
                position={'kind': 'container', 'timestamp': self.STAMP1},
            )
        self.assertEqual(result['lines'], [])
        self.assertEqual(result['position']['timestamp'], self.STAMP1)

    def test_kubectl_uses_since_time(self):
        with self.shell('') as mock:
            lib.logsource.read(
                'kubectl:pod',
                position={'kind': 'container', 'timestamp': self.STAMP1},
            )
        cmd = mock.call_args[0][0]
        self.assertIn(f'--since-time={self.STAMP1}', cmd)
        self.assertNotIn(f'--since={self.STAMP1}', cmd)

    def test_since_is_used_without_a_position(self):
        with self.shell('') as mock:
            lib.logsource.read('docker:db', since=self.STAMP1)
        self.assertIn(f'--since={self.STAMP1}', mock.call_args[0][0])

    def test_max_lines_is_passed_on(self):
        with self.shell('') as mock:
            lib.logsource.read('podman:db', max_lines=100)
        self.assertIn('--tail=100', mock.call_args[0][0])

    def test_unstamped_line_inherits_the_previous_stamp(self):
        with self.shell(f'{self.STAMP1} first\ncontinuation\n'):
            _, result = lib.logsource.read('podman:db')
        self.assertEqual(result['lines'], ['first', 'continuation'])
        self.assertEqual(result['position']['timestamp'], self.STAMP1)

    def test_container_name_starting_with_dash_is_refused(self):
        success, result = lib.logsource.read('podman:-rm')
        self.assertFalse(success)
        self.assertIn('container name', result)

    def test_non_zero_exit(self):
        with self.shell('', 'Error: no such container', 125):
            success, result = lib.logsource.read('podman:nope')
        self.assertFalse(success)
        self.assertIn('exited with error', result)

    def test_empty_log(self):
        with self.shell(''):
            success, result = lib.logsource.read('podman:db')
        self.assertTrue(success)
        self.assertEqual(result['lines'], [])
        self.assertIsNone(result['position']['timestamp'])


class TestTimestamp(unittest.TestCase):
    """When a line was written, from the application's stamp or the transport's."""

    def setUp(self):
        self.saved_tz = os.environ.get('TZ')
        os.environ['TZ'] = 'UTC'
        time.tzset()

    def tearDown(self):
        if self.saved_tz is None:
            os.environ.pop('TZ', None)
        else:
            os.environ['TZ'] = self.saved_tz
        time.tzset()

    def test_the_journald_prefix(self):
        # `--output=short-iso`, which is what _read_journald() asks for.
        self.assertEqual(
            lib.logsource.timestamp(
                '2026-08-28T17:16:18+0200 host httpd[20]: [ssl:error] AH02032: x'
            ),
            datetime.datetime(2026, 8, 28, 15, 16, 18),
        )

    def test_an_offset_is_converted_to_the_local_clock(self):
        self.assertEqual(
            lib.logsource.timestamp('2026-08-28T17:16:18+0200 a'),
            lib.logsource.timestamp('2026-08-28T15:16:18Z a'),
        )

    def test_the_consumer_reader_wins(self):
        # The application's own stamp says when the event happened; the
        # transport's says when the line arrived.
        def parse_line(line):
            return datetime.datetime(2001, 2, 3, 4, 5, 6) if 'x' in line else None

        self.assertEqual(
            lib.logsource.timestamp(
                '2026-08-28T17:16:18+0200 x', parse_line=parse_line
            ),
            datetime.datetime(2001, 2, 3, 4, 5, 6),
        )
        # Where it finds nothing, the transport's stamp is the fallback.
        self.assertEqual(
            lib.logsource.timestamp(
                '2026-08-28T17:16:18+0200 y', parse_line=parse_line
            ),
            datetime.datetime(2026, 8, 28, 15, 16, 18),
        )

    def test_a_line_without_any_timestamp(self):
        self.assertIsNone(lib.logsource.timestamp('AH00558: httpd: Could not ...'))

    def test_a_timestamp_that_is_not_at_the_start_is_not_the_line_header(self):
        self.assertIsNone(
            lib.logsource.timestamp('AH1: the backup of 2026-08-28T17:16:18 failed')
        )

    def test_an_unparsable_timestamp_is_not_an_error(self):
        self.assertIsNone(lib.logsource.timestamp('2026-13-45T99:99:99+0200 a'))

    def test_an_hour_padded_with_a_space(self):
        # What MariaDB writes before ten in the morning: an ISO 8601 date with
        # the hour padded by a space rather than by a zero.
        self.assertEqual(
            lib.logsource.timestamp('2026-08-29  6:00:21 4 [Warning] Access denied'),
            datetime.datetime(2026, 8, 29, 6, 0, 21),
        )
        self.assertEqual(
            lib.logsource.timestamp('2026-08-29 15:01:47 3 [Warning] Access denied'),
            datetime.datetime(2026, 8, 29, 15, 1, 47),
        )

    def test_the_traditional_syslog_format(self):
        # What rsyslog writes with the configuration the RHEL family ships.
        now = datetime.datetime.now()
        line = now.strftime('%b %d %H:%M:%S') + ' host sshd[193]: Server listening'
        self.assertEqual(
            lib.logsource.timestamp(line),
            now.replace(microsecond=0),
        )

    def test_a_day_below_the_tenth_is_padded_with_a_space(self):
        # `Aug  8`, two spaces, which is what the format asks for. A month back,
        # so the date is in the past whatever day the test runs on.
        moment = (datetime.datetime.now() - datetime.timedelta(days=30)).replace(
            day=8, microsecond=0
        )
        month = calendar.month_abbr[moment.month]
        line = f'{month}  8 {moment:%H:%M:%S} host sshd[193]: x'
        self.assertEqual(lib.logsource.timestamp(line), moment)

    def test_a_date_ahead_of_now_belongs_to_the_year_before(self):
        # The line the check reads in January was written in December. The offset
        # skips 29 February, which the year before does not necessarily have.
        now = datetime.datetime.now()
        for days in range(30, 40):
            ahead = (now + datetime.timedelta(days=days)).replace(microsecond=0)
            if (ahead.month, ahead.day) != (2, 29):
                break
        month = calendar.month_abbr[ahead.month]
        line = f'{month} {ahead.day:2d} {ahead:%H:%M:%S} host x: y'
        self.assertEqual(
            lib.logsource.timestamp(line), ahead.replace(year=ahead.year - 1)
        )

    def test_the_consumer_reader_still_wins_over_the_traditional_format(self):
        def parse_line(_):
            return datetime.datetime(2001, 2, 3, 4, 5, 6)

        self.assertEqual(
            lib.logsource.timestamp('Aug 28 19:34:14 host x: y', parse_line=parse_line),
            datetime.datetime(2001, 2, 3, 4, 5, 6),
        )

    def test_a_month_name_in_another_language_is_not_read(self):
        # A syslog daemon writes English month names on every host, so anything
        # else is not the header of a line but the beginning of a message.
        self.assertIsNone(lib.logsource.timestamp('Mai 28 19:34:14 host x: y'))

    def test_an_impossible_day_is_not_read(self):
        self.assertIsNone(lib.logsource.timestamp('Apr 31 19:34:14 host x: y'))

    def test_the_traditional_format_has_to_be_at_the_start(self):
        self.assertIsNone(
            lib.logsource.timestamp('sshd[1]: the backup of Aug 28 19:34:14 failed')
        )


class TestCountWithin(unittest.TestCase):
    """How many of the lines arrived lately, from whom, and how many carry no time."""

    @staticmethod
    def _lines(now, sources=()):
        lines = [
            (now - datetime.timedelta(minutes=1)).strftime('%Y-%m-%dT%H:%M:%S') + ' a',
            (now - datetime.timedelta(minutes=5)).strftime('%Y-%m-%dT%H:%M:%S') + ' b',
            (now - datetime.timedelta(hours=5)).strftime('%Y-%m-%dT%H:%M:%S') + ' c',
            'no timestamp at all',
        ]
        return lines + list(sources)

    def test_counts_only_what_falls_into_the_window(self):
        now = datetime.datetime.now()
        result = lib.logsource.count_within(
            self._lines(now), now - datetime.timedelta(minutes=10)
        )
        self.assertEqual(result['count'], 2)
        self.assertEqual(result['total'], 2)
        self.assertEqual(result['undated'], 1)
        self.assertIsNone(result['busiest'])
        self.assertEqual(result['sources'], 0)

    def test_an_empty_log_counts_nothing(self):
        self.assertEqual(
            lib.logsource.count_within([], datetime.datetime.now()),
            {'busiest': None, 'count': 0, 'sources': 0, 'total': 0, 'undated': 0},
        )

    def test_the_busiest_source_is_what_a_key_counts(self):
        # Three from one address and one each from two others: the number to
        # judge by is three, not five.
        now = datetime.datetime.now()
        stamp = (now - datetime.timedelta(minutes=1)).strftime('%Y-%m-%dT%H:%M:%S')
        lines = [f'{stamp} from {peer}' for peer in ('a', 'a', 'a', 'b', 'c')]
        result = lib.logsource.count_within(
            lines,
            now - datetime.timedelta(minutes=10),
            key=lambda line: line.rsplit(' ', 1)[1],
        )
        self.assertEqual(result['busiest'], 'a')
        self.assertEqual(result['count'], 3)
        self.assertEqual(result['total'], 5)
        self.assertEqual(result['sources'], 3)

    def test_lines_naming_no_source_are_one_bucket_of_their_own(self):
        # A burst nothing can be attributed to still has to reach a threshold.
        now = datetime.datetime.now()
        stamp = (now - datetime.timedelta(minutes=1)).strftime('%Y-%m-%dT%H:%M:%S')
        lines = [f'{stamp} anonymous'] * 4 + [f'{stamp} from a']
        result = lib.logsource.count_within(
            lines,
            now - datetime.timedelta(minutes=10),
            key=lambda line: line.rsplit(' ', 1)[1] if ' from ' in line else None,
        )
        self.assertIsNone(result['busiest'])
        self.assertEqual(result['count'], 4)
        self.assertEqual(result['sources'], 1)

    def test_a_key_that_names_nothing_at_all_still_counts(self):
        now = datetime.datetime.now()
        stamp = (now - datetime.timedelta(minutes=1)).strftime('%Y-%m-%dT%H:%M:%S')
        result = lib.logsource.count_within(
            [f'{stamp} x'] * 3,
            now - datetime.timedelta(minutes=10),
            key=lambda _: None,
        )
        self.assertEqual(
            (result['count'], result['total'], result['sources']), (3, 3, 0)
        )


if __name__ == '__main__':
    unittest.main()
