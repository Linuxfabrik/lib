"""Unit tests for lib.restic.

The security-relevant paths (a repository that runs an external program, and the
password and repository files a privileged process opens) are covered against a
throwaway directory whose ownership the tests control.
"""

import os
import shutil
import sys
import tempfile
import unittest

sys.path.insert(0, '..')

import lib.restic as restic


def _trusted_base():
    """Return a directory nobody but root and the test user can change, or None.

    /tmp is writable by everyone, so it never qualifies; the home directory
    usually does.
    """
    home = os.path.expanduser('~')
    if (
        hasattr(os, 'geteuid')
        and restic.disk.resolve_trusted_path(home, owners=[os.geteuid()])[0]
    ):
        return home
    return None


class TestErrorLines(unittest.TestCase):
    def test_json_errors_become_plain_lines(self):
        # restic 0.19.1 `--json` on a missing repository
        stderr = (
            '{"message_type":"exit_error","code":10,"message":"Fatal: repository does'
            ' not exist\\nIs there a repository at the following location?\\nx"}\n'
        )
        self.assertEqual(
            restic.error_lines(stderr),
            [
                'Fatal: repository does not exist',
                'Is there a repository at the following location?',
                'x',
            ],
        )

    def test_plain_text_is_kept(self):
        self.assertEqual(restic.error_lines('Fatal: x\n\n  y  \n'), ['Fatal: x', 'y'])

    def test_long_output_is_capped(self):
        lines = restic.error_lines('\n'.join(str(i) for i in range(30)))
        self.assertEqual(
            lines, ['0', '1', '2', '3', '4', '...', '25', '26', '27', '28', '29']
        )

    def test_no_text_gives_no_lines(self):
        for value in ('', None, b'x', '{"message": 5}'):
            with self.subTest(value=value):
                self.assertEqual(restic.error_lines(value), [])


class TestRepoArgs(unittest.TestCase):
    def test_exactly_one_source_is_required(self):
        self.assertFalse(restic.repo_args()[0])
        self.assertFalse(restic.repo_args(repo='/srv/b', repository_file='/etc/r')[0])

    def test_a_value_that_is_no_string_is_refused(self):
        for kwargs in ({'repo': 5}, {'repository_file': ['/etc/r']}):
            with self.subTest(kwargs=kwargs):
                self.assertEqual(
                    restic.repo_args(**kwargs),
                    (False, 'The repository has to be given as a string.'),
                )
        self.assertEqual(
            restic.password_file_arg(5),
            (False, 'The password file has to be given as a string.'),
        )

    def test_a_remote_repo_is_passed_through(self):
        for repo in ('rest:https://backup.example.com/repo', 's3:s3.example.com/b'):
            with self.subTest(repo=repo):
                self.assertEqual(
                    restic.repo_args(repo=repo), (True, [f'--repo={repo}'])
                )

    def test_a_rest_repo_over_a_unix_socket_is_refused(self):
        success, message = restic.repo_args(repo='rest:http+unix:///tmp/s.sock:/repo')
        self.assertFalse(success)
        self.assertIn('Unix socket', message)

    def test_an_sftp_repo_is_allowed(self):
        self.assertEqual(
            restic.repo_args(repo='sftp:user@host:/srv'),
            (True, ['--repo=sftp:user@host:/srv']),
        )

    @unittest.skipUnless(os.name == 'posix', 'ownership is a POSIX concept here')
    def test_an_empty_repo_does_not_drop_the_repository_file(self):
        # an empty --repo counts as not given, so the trusted file is used
        self.assertEqual(
            restic.repo_args(repo='', repository_file='/etc/hostname', owners=[]),
            (True, ['--repository-file=/etc/hostname']),
        )

    def test_an_sftp_repo_with_an_option_as_host_is_refused(self):
        for value in (
            'sftp:-oProxyCommand=id:/srv',
            'sftp:user@-oProxyCommand=id:/srv',
            'sftp:a@b@-oProxyCommand=id:/srv',
            'sftp://-oProxyCommand=id/srv',
            'sftp://user@-oProxyCommand=id:22/srv',
            'SFTP:-x:/srv',
        ):
            with self.subTest(value=value):
                success, message = restic.repo_args(repo=value)
                self.assertFalse(success)
                self.assertIn('option', message)

    # urllib refuses a bracketed host that is no IP address; that was a ValueError
    # out of a function that promises (False, message). restic 0.19.1 with Go 1.26
    # refuses it too, a build with an older Go may hand it to ssh as an option.
    def test_an_sftp_repo_with_an_invalid_bracketed_host_is_refused(self):
        for repo in (
            'sftp://[-oProxyCommand=id]/repo',
            'sftp://user@[-oProxyCommand=id]:22/repo',
            'sftp://[/repo',
        ):
            with self.subTest(repo=repo):
                success, message = restic.repo_args(repo=repo)
                self.assertFalse(success)
                self.assertIn('not a valid host', message)

    def test_an_sftp_repo_with_an_ipv6_host_is_allowed(self):
        self.assertEqual(
            restic.repo_args(repo='sftp://[2001:db8::1]/repo'),
            (True, ['--repo=sftp://[2001:db8::1]/repo']),
        )

    def test_an_sftp_repo_with_a_dash_in_user_or_path_is_allowed(self):
        for value in ('sftp:-user@host:/srv', 'sftp:host:-srv', 'sftp://host/-srv'):
            with self.subTest(value=value):
                self.assertEqual(
                    restic.repo_args(repo=value), (True, [f'--repo={value}'])
                )

    def test_an_rclone_repo_is_refused(self):
        for value in ('rclone:remote:path', 'RClone:remote:path', ' rclone:x'):
            with self.subTest(value=value):
                success, message = restic.repo_args(repo=value)
                self.assertFalse(success)
                self.assertIn('rclone', message)


@unittest.skipUnless(os.name == 'posix', 'ownership is a POSIX concept here')
class TestTrustedFiles(unittest.TestCase):
    """A repository file and a password file are accepted only where nobody but
    root and the running user can change them.
    """

    def setUp(self):
        base = _trusted_base()
        if base is None:
            self.skipTest('no directory on this host is trusted for the test user')
        self.base = tempfile.mkdtemp(prefix='.lftest-restic-', dir=base)
        self.file = os.path.join(self.base, 'repo')
        with open(self.file, 'w') as handle:
            handle.write('sftp:user@host:/srv\n')

    def tearDown(self):
        shutil.rmtree(self.base, ignore_errors=True)

    def test_repository_file_owned_by_the_user_is_used(self):
        self.assertEqual(
            restic.repo_args(repository_file=self.file),
            (True, [f'--repository-file={os.path.realpath(self.file)}']),
        )

    def test_password_file_owned_by_the_user_is_used(self):
        self.assertEqual(
            restic.password_file_arg(self.file),
            (True, [f'--password-file={os.path.realpath(self.file)}']),
        )

    def test_a_missing_password_file_is_refused(self):
        self.assertFalse(restic.password_file_arg(None)[0])
        self.assertFalse(restic.password_file_arg('')[0])

    def test_a_file_anybody_can_change_is_refused(self):
        work = tempfile.mkdtemp(prefix='lftest-restic-untrusted-')
        try:
            os.chmod(work, 0o777)  # nosec B103 - writable by everyone on purpose
            planted = os.path.join(work, 'repo')
            with open(planted, 'w') as handle:
                handle.write('sftp:x\n')
            for call in (
                restic.repo_args(repository_file=planted),
                restic.password_file_arg(planted),
            ):
                self.assertFalse(call[0])
                self.assertIn('nobody but root', call[1])
        finally:
            shutil.rmtree(work, ignore_errors=True)

    def test_a_local_repo_owned_by_the_user_is_used_by_its_resolved_path(self):
        repo = os.path.join(self.base, 'repo-dir')
        os.makedirs(repo)
        link = os.path.join(self.base, 'repo-link')
        os.symlink(repo, link)
        for given, expected in (
            (link, f'--repo={os.path.realpath(repo)}'),
            (f'local:{link}', f'--repo=local:{os.path.realpath(repo)}'),
        ):
            with self.subTest(given=given):
                self.assertEqual(restic.repo_args(repo=given), (True, [expected]))

    def test_a_local_repo_anybody_can_change_is_refused(self):
        # restic writes its locks there: a planted `locks/` symlink would redirect them
        work = tempfile.mkdtemp(prefix='lftest-restic-untrusted-')
        try:
            os.chmod(work, 0o777)  # nosec B103 - writable by everyone on purpose
            for given in (work, f'local:{work}'):
                with self.subTest(given=given):
                    success, message = restic.repo_args(repo=given)
                    self.assertFalse(success)
                    self.assertIn('nobody but root', message)
        finally:
            shutil.rmtree(work, ignore_errors=True)

    def test_missing_and_untrusted_get_the_same_answer(self):
        missing = restic.repo_args(repo='/root/.lftest-restic-missing/x')[1]
        untrusted = restic.repo_args(repo='/tmp')[1]
        self.assertEqual(
            missing.replace('/root/.lftest-restic-missing/x', '<p>'),
            untrusted.replace('/tmp', '<p>'),
        )

    def test_a_root_owned_file_is_accepted(self):
        # root is always a trusted owner, so a file only root can change is used
        # whether the check runs as root or as an unprivileged user.
        for call in (
            restic.repo_args(repository_file='/etc/hostname'),
            restic.password_file_arg('/etc/hostname'),
        ):
            self.assertTrue(call[0], call[1])


if __name__ == '__main__':
    unittest.main()
