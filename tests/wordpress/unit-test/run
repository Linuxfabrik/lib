"""Unit tests for lib.wordpress, driven by a throwaway WordPress installation tree.

The module reads a local installation from the filesystem, so the suite builds a real
directory layout in a temp directory instead of patching the reads. The file headers are
the ones a stock WordPress ships, taken verbatim from an installation, including the
traps they contain:

- `index.php` placeholders that WordPress puts into every directory and that carry no
  header, so they must not count as a plugin or a theme,
- a single-file plugin (`hello.php`) next to directory plugins,
- a plugin whose docblock carries an `@version` tag without a colon above the real
  `Version:` header, so the tag must not win,
- further source files inside a plugin directory that carry no `Plugin Name` header,
- a `Requires PHP:` line, so a header lookup must not match a neighbouring field.
"""

import os
import shutil
import sys
import tempfile
import unittest

sys.path.insert(0, '..')

import lib.wordpress as wordpress

VERSION_PHP = """<?php

/**
 * WordPress Version
 *
 * @global string $wp_version
 */
$wp_version = '7.0.2';
"""

# What a localized build adds to the file above. wordpress.org ships one release per
# language, and this is the only place the installation says which one it is.
LOCALIZED_VERSION_PHP = """<?php

/**
 * WordPress Version
 *
 * @global string $wp_version
 */
$wp_version = '7.0.2';

$wp_local_package = 'de_DE';
"""

PLACEHOLDER = '<?php\n// Silence is golden.\n'

HELLO_PHP = """<?php
/**
 * @package Hello_Dolly
 * @version 9.9.9
 */
/*
Plugin Name: Hello Dolly
Plugin URI: http://wordpress.org/plugins/hello-dolly/
Description: This is not just a plugin.
Author: Matt Mullenweg
Version: 1.7.2
Author URI: http://ma.tt/
Text Domain: hello-dolly
*/
"""

AKISMET_PHP = """<?php
/**
 * @package Akismet
 */
/*
Plugin Name: Akismet Anti-spam: Spam Protection
Plugin URI: https://akismet.com/
Description: Protects your blog from spam.
Version: 5.7
Requires at least: 5.8
Requires PHP: 7.2
Author: Automattic - Anti-spam Team
License: GPLv2 or later
Text Domain: akismet
*/
"""

NO_HEADER_PHP = '<?php\nclass Akismet_Admin {}\n'

# A header written as single-line comments, which WordPress reads by stripping the
# comment terminator off the value. Without that step the version reads `1.2 */`.
ONELINE_HEADER_PHP = """<?php
/* Plugin Name: One Liner */
/* Version: 1.2 */
"""

# The whole plugin on a single line, opening PHP tag and all. WordPress allows the tag in
# front of a header field, so this is a plugin to it like any other.
SAME_LINE_HEADER_PHP = '<?php /* Plugin Name: Same Line */\n'

# A file saved with carriage returns alone, which every editor on classic Mac OS wrote and
# some still produce. WordPress turns them into newlines before it reads the header.
CR_ONLY_HEADER_PHP = '<?php\r/*\rPlugin Name: Carriage Return\rVersion: 3.4\r*/\r'

# A second header-bearing file inside a plugin directory, sorting before the file named
# after the directory. WordPress has no notion of a main file, so the one carrying the
# directory name has to win or the admin page supplies the version.
ADMIN_PAGE_PHP = """<?php
/*
Plugin Name: Toolkit Admin Page
Version: 0.0.1
*/
"""

TOOLKIT_PHP = """<?php
/*
Plugin Name: Toolkit
Version: 3.4
*/
"""

UNVERSIONED_PLUGIN_PHP = """<?php
/*
Plugin Name: Homegrown Snippet
Description: A plugin that declares no version at all.
*/
"""

STYLE_CSS = """/*
Theme Name: Twenty Twenty-Five
Theme URI: https://wordpress.org/themes/twentytwentyfive/
Author: the WordPress team
Description: Twenty Twenty-Five emphasizes simplicity and adaptability.
Requires at least: 6.7
Requires PHP: 7.2
Version: 1.5
License: GNU General Public License v2 or later
Text Domain: twentytwentyfive
*/
"""

UNVERSIONED_STYLE_CSS = """/*
Theme Name: Homegrown Theme
Author: Linuxfabrik
*/
"""

WP_CONFIG_PHP = """<?php
define( 'DB_NAME', 'wordpress' );
define( 'DB_USER', 'wordpress' );
define( 'DB_PASSWORD', 'linuxfabrik' );
define( 'WP_HOME', 'https://www.example.com/' );
define( 'WP_SITEURL', 'https://www.example.com/blog' );

require_once ABSPATH . 'wp-settings.php';
"""

# Only the core address is pinned, and in the other PHP quoting style.
WP_CONFIG_SITEURL_ONLY_PHP = """<?php
define("DB_PASSWORD", "linuxfabrik");
define("WP_SITEURL", "https://blog.example.com");
"""

# A URL assembled at runtime is not a fixed address and must not be returned half-read.
WP_CONFIG_DYNAMIC_PHP = """<?php
define( 'DB_PASSWORD', 'linuxfabrik' );
define( 'WP_HOME', 'https://' . $_SERVER['HTTP_HOST'] );
"""

WP_CONFIG_NO_URL_PHP = """<?php
define( 'DB_NAME', 'wordpress' );
define( 'DB_PASSWORD', 'linuxfabrik' );
"""

# Switching an installation between a staging and a production address by commenting one
# of the two out is a common hand-edit. PHP evaluates none of the three commented forms,
# so neither may win over the definition that is actually in effect.
WP_CONFIG_COMMENTED_PHP = """<?php
/**
 * The base configuration.
 *
 * @package WordPress
 */
define( 'DB_PASSWORD', 'linuxfabrik' );
// define( 'WP_HOME', 'https://staging.example.com' );
# define( 'WP_HOME', 'https://old.example.com' );
/*
define( 'WP_HOME', 'https://retired.example.com' );
*/
define( 'WP_HOME', 'https://www.example.com/' );
"""

# `const` is the other spelling PHP makes visible to `defined()`, and `@define()` the
# same call with its warnings suppressed. WordPress honours all three.
WP_CONFIG_CONST_PHP = """<?php
define( 'DB_PASSWORD', 'linuxfabrik' );
const WP_HOME = 'https://const.example.com';
"""

WP_CONFIG_AT_DEFINE_PHP = """<?php
define( 'DB_PASSWORD', 'linuxfabrik' );
@define( 'WP_HOME', 'https://at.example.com' );
"""

# A body line that looks like a header field but sits far beyond the 8 KiB WordPress
# itself reads, so it is not a header field and must not create a phantom plugin.
LATE_HEADER_PHP = (
    '<?php\n/*\nPlugin Name: Early Bird\nVersion: 1.0\n*/\n'
    + '// padding\n' * 1200
    + '// Plugin Name: Phantom\n// Version: 6.6.6\n'
)


def write(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w', encoding='utf-8') as f:
        f.write(content)


class TestWordPress(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.root = tempfile.mkdtemp(prefix='lftest-wordpress-')
        cls.wp = os.path.join(cls.root, 'wordpress')
        plugins = os.path.join(cls.wp, 'wp-content', 'plugins')
        themes = os.path.join(cls.wp, 'wp-content', 'themes')
        write(os.path.join(cls.wp, 'wp-includes', 'version.php'), VERSION_PHP)
        write(os.path.join(plugins, 'index.php'), PLACEHOLDER)
        write(os.path.join(plugins, 'hello.php'), HELLO_PHP)
        write(os.path.join(plugins, 'akismet', 'akismet.php'), AKISMET_PHP)
        write(os.path.join(plugins, 'akismet', 'class.admin.php'), NO_HEADER_PHP)
        write(os.path.join(plugins, 'snippet', 'snippet.php'), UNVERSIONED_PLUGIN_PHP)
        write(os.path.join(plugins, 'oneliner', 'oneliner.php'), ONELINE_HEADER_PHP)
        write(os.path.join(plugins, 'toolkit', 'admin-page.php'), ADMIN_PAGE_PHP)
        write(os.path.join(plugins, 'toolkit', 'toolkit.php'), TOOLKIT_PHP)
        write(os.path.join(themes, 'index.php'), PLACEHOLDER)
        write(os.path.join(themes, 'twentytwentyfive', 'style.css'), STYLE_CSS)
        write(os.path.join(themes, 'homegrown', 'style.css'), UNVERSIONED_STYLE_CSS)
        write(os.path.join(cls.wp, 'wp-config.php'), WP_CONFIG_PHP)
        # a directory that exists but holds no WordPress
        cls.empty = os.path.join(cls.root, 'empty')
        os.makedirs(cls.empty)
        # the same core, but built for a language other than English
        cls.localized = os.path.join(cls.root, 'localized')
        write(
            os.path.join(cls.localized, 'wp-includes', 'version.php'),
            LOCALIZED_VERSION_PHP,
        )
        # the same installation below a path carrying glob metacharacters, which must be
        # read as data and not as a pattern
        cls.quoted = os.path.join(cls.root, 'site[1]')
        shutil.copytree(cls.wp, cls.quoted)

    @classmethod
    def tearDownClass(cls):
        shutil.rmtree(cls.root, ignore_errors=True)

    def test_is_installation(self):
        self.assertTrue(wordpress.is_installation(self.wp))

    def test_is_installation_on_unrelated_directory(self):
        self.assertFalse(wordpress.is_installation(self.empty))

    def test_is_installation_on_missing_path(self):
        self.assertFalse(wordpress.is_installation(os.path.join(self.root, 'nope')))

    def test_get_version(self):
        self.assertEqual(wordpress.get_version(self.wp), (True, '7.0.2'))

    def test_get_version_on_missing_installation(self):
        success, result = wordpress.get_version(self.empty)
        self.assertFalse(success)
        self.assertIn('version.php', result)

    def test_get_locale_of_a_localized_build(self):
        self.assertEqual(wordpress.get_locale(self.localized), (True, 'de_DE'))

    def test_get_locale_defaults_to_english(self):
        self.assertEqual(wordpress.get_locale(self.wp), (True, 'en_US'))

    def test_get_locale_on_missing_installation(self):
        success, result = wordpress.get_locale(self.empty)
        self.assertFalse(success)
        self.assertIn('version.php', result)

    def test_get_plugins(self):
        self.assertEqual(
            wordpress.get_plugins(self.wp),
            {
                'akismet': '5.7',
                'hello': '1.7.2',
                'oneliner': '1.2',
                'snippet': 'unknown',
                'toolkit': '3.4',
            },
        )

    def test_get_plugins_ignores_placeholder(self):
        self.assertNotIn('index', wordpress.get_plugins(self.wp))

    # A header written as `/* Version: 1.2 */` must not carry its own comment terminator
    # into the value, which is what WordPress strips in _cleanup_header_comment().
    def test_get_plugins_strips_comment_terminator(self):
        self.assertEqual(wordpress.get_plugins(self.wp)['oneliner'], '1.2')

    # `admin-page.php` sorts before `toolkit.php` and declares a version of its own. The
    # file named after the directory is the plugin's main file and has to win.
    def test_get_plugins_prefers_the_file_named_after_its_directory(self):
        self.assertEqual(wordpress.get_plugins(self.wp)['toolkit'], '3.4')

    def test_get_plugins_on_missing_installation(self):
        self.assertEqual(wordpress.get_plugins(self.empty), {})

    def test_get_themes(self):
        self.assertEqual(
            wordpress.get_themes(self.wp),
            {
                'homegrown': 'unknown',
                'twentytwentyfive': '1.5',
            },
        )

    def test_get_themes_ignores_placeholder(self):
        self.assertNotIn('index', wordpress.get_themes(self.wp))

    def test_get_themes_on_missing_installation(self):
        self.assertEqual(wordpress.get_themes(self.empty), {})

    # A `[` in the path is a glob metacharacter. Without quoting, the inventory would
    # silently come back empty while the installation is plainly there. The quoted tree
    # is a copy of the plain one, so the two inventories have to be identical; comparing
    # them rather than a literal keeps this test about the path and nothing else.
    def test_get_plugins_with_glob_metacharacters_in_path(self):
        self.assertEqual(
            wordpress.get_plugins(self.quoted), wordpress.get_plugins(self.wp)
        )
        self.assertTrue(wordpress.get_plugins(self.quoted))

    def test_get_themes_with_glob_metacharacters_in_path(self):
        self.assertEqual(
            wordpress.get_themes(self.quoted), wordpress.get_themes(self.wp)
        )
        self.assertTrue(wordpress.get_themes(self.quoted))

    def test_is_installation_with_glob_metacharacters_in_path(self):
        self.assertTrue(wordpress.is_installation(self.quoted))


class TestSiteUrl(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.root = tempfile.mkdtemp(prefix='lftest-wordpress-config-')

        def install(name, config=None, in_parent=False):
            wp = os.path.join(cls.root, name, 'wordpress')
            write(os.path.join(wp, 'wp-includes', 'version.php'), VERSION_PHP)
            if config is not None:
                target = os.path.pardir if in_parent else ''
                write(os.path.join(wp, target, 'wp-config.php'), config)
            return wp

        cls.both = install('both', WP_CONFIG_PHP)
        cls.siteurl_only = install('siteurl', WP_CONFIG_SITEURL_ONLY_PHP)
        cls.dynamic = install('dynamic', WP_CONFIG_DYNAMIC_PHP)
        cls.no_url = install('nourl', WP_CONFIG_NO_URL_PHP)
        cls.no_config = install('noconfig')
        cls.parent = install('parent', WP_CONFIG_PHP, in_parent=True)
        cls.commented = install('commented', WP_CONFIG_COMMENTED_PHP)
        cls.const = install('const', WP_CONFIG_CONST_PHP)
        cls.at_define = install('atdefine', WP_CONFIG_AT_DEFINE_PHP)

    @classmethod
    def tearDownClass(cls):
        shutil.rmtree(cls.root, ignore_errors=True)

    # WP_HOME is the visitor-facing address and wins over WP_SITEURL.
    def test_wp_home_wins(self):
        self.assertEqual(
            wordpress.get_site_url(self.both), (True, 'https://www.example.com')
        )

    def test_falls_back_to_wp_siteurl(self):
        self.assertEqual(
            wordpress.get_site_url(self.siteurl_only),
            (True, 'https://blog.example.com'),
        )

    # WordPress accepts the configuration one directory above the installation root.
    def test_config_one_directory_above(self):
        self.assertEqual(
            wordpress.get_site_url(self.parent), (True, 'https://www.example.com')
        )

    def test_runtime_assembled_url_is_skipped(self):
        self.assertEqual(wordpress.get_site_url(self.dynamic), (True, ''))

    def test_config_without_url_constants(self):
        self.assertEqual(wordpress.get_site_url(self.no_url), (True, ''))

    def test_missing_config(self):
        success, result = wordpress.get_site_url(self.no_config)
        self.assertFalse(success)
        self.assertIn('wp-config.php', result)

    # PHP evaluates none of the commented forms, so a stale staging address must not be
    # handed back in place of the address the site is actually served under.
    def test_commented_out_definitions_are_skipped(self):
        self.assertEqual(
            wordpress.get_site_url(self.commented), (True, 'https://www.example.com')
        )

    def test_const_is_read(self):
        self.assertEqual(
            wordpress.get_site_url(self.const), (True, 'https://const.example.com')
        )

    def test_at_define_is_read(self):
        self.assertEqual(
            wordpress.get_site_url(self.at_define), (True, 'https://at.example.com')
        )

    # The file holds the database credentials; none of them may come back to the caller.
    def test_credentials_are_not_returned(self):
        for path in (
            self.both,
            self.siteurl_only,
            self.no_url,
            self.commented,
            self.const,
            self.at_define,
        ):
            self.assertNotIn('linuxfabrik', wordpress.get_site_url(path)[1])


class TestHeaderValue(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.dir = tempfile.mkdtemp(prefix='lftest-wordpress-header-')
        cls.plugin = os.path.join(cls.dir, 'akismet.php')
        write(cls.plugin, AKISMET_PHP)
        cls.hello = os.path.join(cls.dir, 'hello.php')
        write(cls.hello, HELLO_PHP)
        cls.late = os.path.join(cls.dir, 'late.php')
        write(cls.late, LATE_HEADER_PHP)
        cls.oneliner = os.path.join(cls.dir, 'oneliner.php')
        write(cls.oneliner, ONELINE_HEADER_PHP)
        cls.hashed = os.path.join(cls.dir, 'hashed.php')
        write(cls.hashed, '<?php\n# Plugin Name: Hashed\n# Version: 2.0 ?>\n')
        cls.same_line = os.path.join(cls.dir, 'same-line.php')
        write(cls.same_line, SAME_LINE_HEADER_PHP)
        cls.cr_only = os.path.join(cls.dir, 'cr-only.php')
        write(cls.cr_only, CR_ONLY_HEADER_PHP)

    @classmethod
    def tearDownClass(cls):
        shutil.rmtree(cls.dir, ignore_errors=True)

    def test_plain_field(self):
        self.assertEqual(wordpress.get_header_value(self.plugin, 'Version'), '5.7')

    def test_field_with_space(self):
        self.assertEqual(
            wordpress.get_header_value(self.plugin, 'Plugin Name'),
            'Akismet Anti-spam: Spam Protection',
        )

    def test_case_insensitive(self):
        self.assertEqual(wordpress.get_header_value(self.plugin, 'version'), '5.7')

    def test_neighbouring_field_does_not_leak(self):
        self.assertEqual(wordpress.get_header_value(self.plugin, 'Requires PHP'), '7.2')

    # `@version 9.9.9` sits above `Version: 1.7.2` and carries no colon, so it is not a
    # header field and must not win.
    def test_docblock_tag_is_not_a_header(self):
        self.assertEqual(wordpress.get_header_value(self.hello, 'Version'), '1.7.2')

    # A one-line comment block closes on the same line as the value. WordPress strips
    # that terminator, so `/* Version: 1.2 */` is version 1.2, not `1.2 */`.
    def test_comment_terminator_is_stripped(self):
        self.assertEqual(wordpress.get_header_value(self.oneliner, 'Version'), '1.2')
        self.assertEqual(
            wordpress.get_header_value(self.oneliner, 'Plugin Name'), 'One Liner'
        )

    # `?>` closes the PHP block rather than the comment, and WordPress strips it the
    # same way.
    def test_php_close_tag_is_stripped(self):
        self.assertEqual(wordpress.get_header_value(self.hashed, 'Version'), '2.0')

    # WordPress allows the opening PHP tag in front of a header field, so a plugin that
    # fits on one line is still a plugin. Without that the file would carry no name and
    # would not be recognized at all.
    def test_field_behind_the_opening_php_tag(self):
        self.assertEqual(
            wordpress.get_header_value(self.same_line, 'Plugin Name'), 'Same Line'
        )

    # Carriage returns are turned into newlines before the header is read, so a field
    # ends at its own value rather than swallowing everything behind it.
    def test_carriage_returns_separate_the_fields(self):
        self.assertEqual(
            wordpress.get_header_value(self.cr_only, 'Plugin Name'), 'Carriage Return'
        )
        self.assertEqual(wordpress.get_header_value(self.cr_only, 'Version'), '3.4')

    def test_absent_field(self):
        self.assertEqual(wordpress.get_header_value(self.plugin, 'Network'), '')

    def test_unreadable_file(self):
        self.assertEqual(
            wordpress.get_header_value(os.path.join(self.dir, 'nope.php'), 'Version'),
            '',
        )

    # A field name is taken literally, so regex metacharacters cannot change the match.
    def test_field_name_is_literal(self):
        self.assertEqual(wordpress.get_header_value(self.plugin, 'Versio.'), '')

    # Only the leading HEADER_BYTES are the header block, the same amount WordPress
    # reads. A matching line further down is body text, not a header field.
    def test_only_the_leading_block_is_searched(self):
        self.assertEqual(
            wordpress.get_header_value(self.late, 'Plugin Name'), 'Early Bird'
        )
        self.assertEqual(wordpress.get_header_value(self.late, 'Version'), '1.0')


if __name__ == '__main__':
    unittest.main()
