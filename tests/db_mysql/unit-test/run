"""Tests for lib.db_mysql.

The version-banner parsing is pure and runs without a database. The
connection-based helpers are exercised against a real MariaDB LTS server
in a Red Hat family container (quay.io/sclorg) via lib.lftest, so this is
a container test (run via tools/run-container-tests; podman required).
"""

import os
import sys
import typing
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.db_mysql as db_mysql
import lib.lftest

HERE = os.path.dirname(os.path.abspath(__file__))
CONTAINERFILES_DIR = os.path.join(HERE, 'containerfiles')
CONTAINERFILES = sorted(
    name
    for name in os.listdir(CONTAINERFILES_DIR)
    if os.path.isfile(os.path.join(CONTAINERFILES_DIR, name))
)


class TestVersionBanner(unittest.TestCase):
    """Pure version-banner parsing, no database needed."""

    def test_mariadb_distrib_banner(self):
        self.assertEqual(
            db_mysql.get_server_info(
                banner='mysql  Ver 15.1 Distrib 10.11.8-MariaDB, for Linux'
            ),
            {
                'flavor': 'mariadb',
                'version': '10.11.8',
                'version_tuple': (10, 11, 8),
            },
        )

    def test_mysql_banner(self):
        self.assertEqual(
            db_mysql.get_server_info(
                banner='mysql  Ver 8.0.36 for Linux on x86_64 (MySQL Community Server - GPL)'
            ),
            {'flavor': 'mysql', 'version': '8.0.36', 'version_tuple': (8, 0, 36)},
        )

    def test_no_version_in_banner(self):
        self.assertIsNone(db_mysql.get_server_info(banner='garbage with no version'))

    def test_banner_flavor_detection_is_case_insensitive(self):
        # `_parse_version_banner()` and `_parse_version_value()` share one
        # flavor rule, so a lowercase `-mariadb` tag must not read as MySQL.
        info = db_mysql.get_server_info(banner='mysqld  Ver 10.11.8-mariadb for Linux')
        self.assertEqual(info['flavor'], 'mariadb')
        self.assertEqual(info['version'], '10.11.8')


class TestVersionValue(unittest.TestCase):
    """Pure `VERSION()` value parsing, no database needed."""

    def test_mariadb(self):
        self.assertEqual(
            db_mysql._parse_version_value('11.8.8-MariaDB-ubu2404'),
            ('mariadb', (11, 8, 8)),
        )

    def test_mysql(self):
        self.assertEqual(
            db_mysql._parse_version_value('8.4.9'),
            ('mysql', (8, 4, 9)),
        )

    def test_mysql_with_distro_suffix(self):
        self.assertEqual(
            db_mysql._parse_version_value('8.0.45-0ubuntu0.22.04.1'),
            ('mysql', (8, 0, 45)),
        )

    def test_mariadb_handshake_prefix_is_stripped(self):
        # MariaDB announces `5.5.5-<real version>` in the client handshake.
        self.assertEqual(
            db_mysql._parse_version_value('5.5.5-10.6.25-MariaDB-ubu2204'),
            ('mariadb', (10, 6, 25)),
        )

    def test_two_component_version_is_padded(self):
        # `version.version()` pads to three components.
        self.assertEqual(db_mysql._parse_version_value('11.8'), ('mysql', (11, 8, 0)))

    def test_unparseable(self):
        self.assertEqual(db_mysql._parse_version_value('not-a-version'), (None, ()))

    def test_distro_suffix_alone_is_not_a_version(self):
        # A bare `ubu2404` holds digits but no `major.minor`, so it must not
        # be mistaken for version 2404.
        self.assertEqual(db_mysql._parse_version_value('ubu2404'), (None, ()))

    def test_empty(self):
        self.assertEqual(db_mysql._parse_version_value(''), (None, ()))

    def test_none(self):
        self.assertEqual(db_mysql._parse_version_value(None), (None, ()))


class TestLod2Dict(unittest.TestCase):
    def test_maps_variable_name_to_value(self):
        self.assertEqual(
            db_mysql.lod2dict(
                [
                    {'Variable_name': 'a', 'Value': '1'},
                    {'Variable_name': 'b', 'Value': '2'},
                ]
            ),
            {'a': '1', 'b': '2'},
        )

    def test_empty(self):
        self.assertEqual(db_mysql.lod2dict([]), {})


class TestCheckPrivileges(unittest.TestCase):
    """The grant parsing, driven through a mocked select(), no server needed."""

    GRANTS: typing.ClassVar = [{'Grants for u@h': "GRANT SELECT, PROCESS ON *.* TO `u`@`h`"}]

    def _with_grants(self, grants):
        return mock.patch.object(db_mysql, 'select', return_value=(True, grants))

    def test_without_arguments_it_runs_the_smoke_test(self):
        with mock.patch.object(
            db_mysql, 'select', return_value=(True, {'version': '8.0.36'})
        ) as select_mock:
            success, result = db_mysql.check_privileges(None)
        self.assertTrue(success)
        self.assertEqual(result, {'version': '8.0.36'})
        self.assertIn('SELECT VERSION()', select_mock.call_args[0][1])

    def test_a_failed_smoke_test_names_usage(self):
        with mock.patch.object(db_mysql, 'select', return_value=(True, None)):
            success, message = db_mysql.check_privileges(None)
        self.assertFalse(success)
        self.assertIn('USAGE', message)

    def test_a_granted_privilege_is_found(self):
        with self._with_grants(self.GRANTS):
            success, _ = db_mysql.check_privileges(None, 'SELECT')
        self.assertTrue(success)

    def test_a_missing_privilege_is_named(self):
        with self._with_grants(self.GRANTS):
            success, message = db_mysql.check_privileges(None, 'REPLICATION CLIENT')
        self.assertFalse(success)
        self.assertIn('REPLICATION CLIENT', message)

    def test_several_privileges_are_and_ed(self):
        with self._with_grants(self.GRANTS):
            success, _ = db_mysql.check_privileges(None, 'SELECT', 'PROCESS')
        self.assertTrue(success)
        with self._with_grants(self.GRANTS):
            success, message = db_mysql.check_privileges(None, 'SELECT', 'SHUTDOWN')
        self.assertFalse(success)
        self.assertIn('SHUTDOWN', message)

    def test_a_list_is_any_of(self):
        # MariaDB 10.5+ split REPLICATION CLIENT into BINLOG MONITOR / SLAVE MONITOR
        grants = [{'g': 'GRANT BINLOG MONITOR ON *.* TO `u`@`h`'}]
        with self._with_grants(grants):
            success, _ = db_mysql.check_privileges(
                None, ['REPLICATION CLIENT', 'BINLOG MONITOR']
            )
        self.assertTrue(success)

    def test_a_missing_any_of_group_is_named_with_or(self):
        with self._with_grants(self.GRANTS):
            success, message = db_mysql.check_privileges(None, ['A GRANT', 'B GRANT'])
        self.assertFalse(success)
        self.assertIn('A GRANT or B GRANT', message)

    def test_all_privileges_short_circuits(self):
        grants = [{'g': 'GRANT ALL PRIVILEGES ON *.* TO `u`@`h`'}]
        with self._with_grants(grants):
            success, _ = db_mysql.check_privileges(None, 'REPLICATION CLIENT')
        self.assertTrue(success)

    def test_super_short_circuits(self):
        grants = [{'g': 'GRANT SUPER ON *.* TO `u`@`h`'}]
        with self._with_grants(grants):
            success, _ = db_mysql.check_privileges(None, 'PROCESS')
        self.assertTrue(success)

    def test_a_failed_grant_query_is_passed_on(self):
        with mock.patch.object(db_mysql, 'select', return_value=(False, 'gone away')):
            success, message = db_mysql.check_privileges(None, 'SELECT')
        self.assertFalse(success)
        self.assertEqual(message, 'gone away')

    def test_the_deprecated_shim_runs_the_smoke_test(self):
        with mock.patch.object(
            db_mysql, 'select', return_value=(True, {'version': '8.0.36'})
        ):
            self.assertEqual(
                db_mysql.check_select_privileges(None), (True, {'version': '8.0.36'})
            )


class TestGetFlavor(unittest.TestCase):
    def test_reports_the_flavor_of_the_server_info(self):
        with mock.patch.object(
            db_mysql, 'get_server_info', return_value={'flavor': 'mariadb'}
        ):
            self.assertEqual(db_mysql.get_flavor(), 'mariadb')

    def test_without_a_responding_binary_it_is_none(self):
        with mock.patch.object(db_mysql, 'get_server_info', return_value=None):
            self.assertIsNone(db_mysql.get_flavor())


class TestContainer(unittest.TestCase):
    pass


def _check_image(test, containerfile):
    path = os.path.join(CONTAINERFILES_DIR, containerfile)
    print(f'\n=== Testing {containerfile} ===', flush=True)
    with lib.lftest.run_mysql_compatible_from_containerfile(path) as (
        _container,
        defaults_file,
    ):
        ok, conn = db_mysql.connect({'defaults_file': defaults_file})
        test.assertTrue(ok, conn)
        try:
            # select(): basic round trip.
            ok, rows = db_mysql.select(conn, 'SELECT 1 AS one')
            test.assertTrue(ok, rows)
            test.assertEqual(rows[0]['one'], 1)

            # parameterized select (positional %s + list, per db_mysql.select).
            ok, rows = db_mysql.select(conn, 'SELECT %s AS n', data=[42])
            test.assertTrue(ok, rows)
            test.assertEqual(rows[0]['n'], 42)

            # get_all_status() / get_all_variables() return a dict (coe-unwrapped).
            status = db_mysql.get_all_status(conn)
            test.assertIsInstance(status, dict)
            test.assertIn('Uptime', status)

            variables = db_mysql.get_all_variables(conn)
            test.assertIsInstance(variables, dict)
            test.assertIn('version', variables)

            # get_engines(): InnoDB must be present on a default MariaDB.
            engines = db_mysql.get_engines(conn)
            test.assertTrue(any('innodb' in str(e).lower() for e in engines), engines)

            # get_replica_status(): None on a standalone server.
            test.assertIsNone(db_mysql.get_replica_status(conn))

            # get_replica_hosts(): [] on a standalone server. MariaDB rejects
            # `SHOW REPLICAS`, so this also exercises the fallback to the
            # legacy `SHOW SLAVE HOSTS`.
            test.assertEqual(db_mysql.get_replica_hosts(conn), [])

            # has_is_role_column(): returns a definite bool against the live server
            # (the exact value is server/version dependent).
            test.assertIsInstance(db_mysql.has_is_role_column(conn), bool)

            # get_version(): the containerfiles all run MariaDB, so the flavor is
            # pinned; the version is only checked for shape, not for an exact
            # value, so a container image bump does not break the test.
            flavor, server_version = db_mysql.get_version(conn)
            test.assertEqual(flavor, 'mariadb')
            test.assertEqual(len(server_version), 3)
            test.assertTrue(all(isinstance(part, int) for part in server_version))
            test.assertGreaterEqual(server_version, (10, 0, 0))

            # root (via the defaults file) has the SELECT smoke-test privilege.
            ok, _ = db_mysql.check_select_privileges(conn)
            test.assertTrue(ok)

            test.assertEqual(db_mysql.commit(conn), (True, None))
        finally:
            db_mysql.close(conn)


lib.lftest.attach_each(TestContainer, CONTAINERFILES, _check_image)


if __name__ == '__main__':
    unittest.main()
