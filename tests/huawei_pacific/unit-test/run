"""Unit tests for lib.huawei_pacific.

The module talks to a Huawei OceanStor Pacific appliance only through
lib.url.fetch_json (HTTP), persists the session token through lib.cache and
reads the clock through lib.time / time.sleep. All of those seams are mocked,
so no network call, no real cache file, and no real sleep ever happens.

Public functions under test:

- assert_ok()           -> abort unless the appliance reported success
- get_alarm_severity_state()      -> alarm severity -> STATE_*
- get_component_status_state()    -> fan / power supply status -> STATE_*
- get_creds()           -> login (POST /api/v2/aa/sessions) + X-Auth-Token caching
- get_data()            -> authenticated GET/POST, re-login on a rejected request
- get_disk_status_state()         -> code -> STATE_* mapping
- get_management_ips()  -> node enumeration for the node-scoped hwm/* endpoints
- get_performance()     -> newest sample per object and indicator (POST)
- get_node_running_status_state() -> node running status -> STATE_*
- get_pool_status_state()         -> code -> STATE_* mapping
- get_replication_health_status_state()  -> replication pair health -> STATE_*
- get_replication_running_status_state() -> replication pair running status -> STATE_*
- get_status_envelope() -> the object a response reports its outcome in
"""

import contextlib
import io
import sys
import typing
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.huawei_pacific as huawei_pacific
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN


class Args:
    """Plain attribute bag mirroring the argparse namespace the module reads."""

    def __init__(self, **kw):
        defaults = {
            'URL': 'https://storage.example.com',
            'USERNAME': 'linuxfabrik',
            'PASSWORD': 'linuxfabrik',
            'SCOPE': '0',
            'INSECURE': False,
            'NO_PROXY': False,
            'TIMEOUT': 8,
            'CACHE_EXPIRE': 15,
        }
        defaults.update(kw)
        for key, value in defaults.items():
            setattr(self, key, value)


# Login response as returned by url.fetch_json: a (success, dict) tuple whose
# dict carries the token in the body (no response header needed).
LOGIN_OK = (
    True,
    {
        'data': {
            'x_auth_token': 'NDQ2ODQwMTEzQUJCQkJCQkJCQkJCQkJC',
            'system_esn': '286ed489047020190103171152',
            'user_name': 'linuxfabrik',
        },
        'result': {'code': 0, 'description': '0'},
    },
)

# Data response for an authenticated query.
DATA_OK = (
    True,
    {
        'data': [
            {'name': 'Fan0', 'status': 'normal'},
            {'name': 'Fan1', 'status': 'normal'},
        ],
        'result': {'code': 0, 'description': ''},
    },
)


class TestMappingHelpers(unittest.TestCase):
    """Known-code assertions for the code -> text mapping helpers, run for both
    int and str input, plus the 'Unknown' fallback and the ValueError path.
    """

    # (function, sample_code, expected_text)
    KNOWN: typing.ClassVar = [
        (huawei_pacific.get_alarm_severity, 3, 'Warning (3)'),
        (huawei_pacific.get_alarm_severity, 6, 'Critical (6)'),
        (huawei_pacific.get_alarm_status, 1, 'Unrecovered (1)'),
        (huawei_pacific.get_alarm_status, 4, 'Recovered (4)'),
        (huawei_pacific.get_disk_status, 0, 'healthy (0)'),
        (huawei_pacific.get_disk_status, 1, 'faulty (1)'),
        (huawei_pacific.get_disk_status, 2, 'sub-healthy (2)'),
        (huawei_pacific.get_disk_status, 101, 'removed from the storage pool (101)'),
        (huawei_pacific.get_oam_agent_status, -1, 'not monitored (-1)'),
        (huawei_pacific.get_oam_agent_status, 0, 'healthy (0)'),
        (huawei_pacific.get_oam_agent_status, 1, 'faulty (1)'),
    ]

    FUNCS: typing.ClassVar = [
        huawei_pacific.get_alarm_severity,
        huawei_pacific.get_alarm_status,
        huawei_pacific.get_disk_status,
        huawei_pacific.get_oam_agent_status,
    ]

    def test_known_codes_as_int(self):
        for func, code, expected in self.KNOWN:
            with self.subTest(func=func.__name__, code=code):
                self.assertEqual(func(code), expected)

    def test_known_codes_as_str(self):
        for func, code, expected in self.KNOWN:
            with self.subTest(func=func.__name__, code=str(code)):
                self.assertEqual(func(str(code)), expected)

    def test_unknown_code_returns_unknown(self):
        for func in self.FUNCS:
            with self.subTest(func=func.__name__):
                self.assertEqual(func(999999), 'Unknown')

    def test_unusable_input_returns_unknown(self):
        # A field the appliance did not report reaches the helper as None,
        # because the callers read it with a plain .get(). That has to render
        # as 'Unknown' and let the check report a status; raising here would
        # take down the whole check over a single missing field.
        for func in self.FUNCS:
            for value in ('not-a-number', '', '  ', [], {}, None):
                with self.subTest(func=func.__name__, value=value):
                    self.assertEqual(func(value), 'Unknown')

    def test_minor_alarm_severity(self):
        # Documented for "Interface for Querying Alarm Details".
        self.assertEqual(huawei_pacific.get_alarm_severity(4), 'Minor (4)')


class TestGetResultCode(unittest.TestCase):
    def test_object_envelope(self):
        self.assertEqual(
            huawei_pacific.get_result_code({'result': {'code': 0}, 'data': []}), 0
        )

    def test_bare_integer_envelope(self):
        # The older /dsware/service/ endpoints report the code without wrapping it.
        self.assertEqual(
            huawei_pacific.get_result_code({'result': 1, 'nodeInfo': []}), 1
        )

    def test_string_code_is_handed_back_as_it_is(self):
        self.assertEqual(huawei_pacific.get_result_code({'result': {'code': '0'}}), '0')

    def test_missing_result_is_none(self):
        self.assertIsNone(huawei_pacific.get_result_code({'data': []}))

    def test_non_dict_input_is_none(self):
        self.assertIsNone(huawei_pacific.get_result_code(None))

    def test_error_envelope(self):
        # The batch query for replication pairs names the object `error`, although both
        # REST Interface References document it as `result`.
        self.assertEqual(
            huawei_pacific.get_result_code(
                {'data': [], 'error': {'code': 0, 'description': '0'}}
            ),
            0,
        )

    def test_error_envelope_reports_a_failure(self):
        self.assertEqual(
            huawei_pacific.get_result_code({'error': {'code': 50331651}}), 50331651
        )

    def test_result_wins_over_error(self):
        # `result` is the documented one, so a response carrying both is read there.
        self.assertEqual(
            huawei_pacific.get_result_code(
                {'result': {'code': 7}, 'error': {'code': 0}}
            ),
            7,
        )

    def test_empty_result_falls_through_to_error(self):
        # A firmware that sends the key without filling it must not mask the outcome
        # next to it.
        self.assertEqual(
            huawei_pacific.get_result_code({'result': None, 'error': {'code': 7}}), 7
        )


class TestGetStatusEnvelope(unittest.TestCase):
    def test_object_envelope(self):
        self.assertEqual(
            huawei_pacific.get_status_envelope({'result': {'code': 0, 'a': 'b'}}),
            {'code': 0, 'a': 'b'},
        )

    def test_error_envelope(self):
        self.assertEqual(
            huawei_pacific.get_status_envelope({'error': {'code': 1}}), {'code': 1}
        )

    def test_bare_code_has_no_envelope(self):
        self.assertEqual(huawei_pacific.get_status_envelope({'result': 0}), {})

    def test_missing_and_non_dict_have_no_envelope(self):
        for value in ({'data': []}, None, 'nope'):
            with self.subTest(value=value):
                self.assertEqual(huawei_pacific.get_status_envelope(value), {})


class TestReplicationStatusState(unittest.TestCase):
    def test_normal_and_synchronizing_are_ok(self):
        # An asynchronous pair is synchronizing while it transfers, which is the
        # working state rather than a fault.
        for code in (1, 23, '1', '23'):
            with self.subTest(code=code):
                self.assertEqual(
                    huawei_pacific.get_replication_running_status_state(code), STATE_OK
                )

    def test_interrupted_and_invalid_are_critical(self):
        for code in (34, 35):
            with self.subTest(code=code):
                self.assertEqual(
                    huawei_pacific.get_replication_running_status_state(code),
                    STATE_CRIT,
                )

    def test_split_and_to_be_recovered_warn(self):
        for code in (26, 33):
            with self.subTest(code=code):
                self.assertEqual(
                    huawei_pacific.get_replication_running_status_state(code),
                    STATE_WARN,
                )

    def test_unmapped_code_and_missing_value_warn(self):
        for code in (99, None, ''):
            with self.subTest(code=code):
                self.assertEqual(
                    huawei_pacific.get_replication_running_status_state(code),
                    STATE_WARN,
                )

    def test_health_normal_is_ok(self):
        self.assertEqual(
            huawei_pacific.get_replication_health_status_state(1), STATE_OK
        )

    def test_health_faulty_is_critical(self):
        self.assertEqual(
            huawei_pacific.get_replication_health_status_state('2'), STATE_CRIT
        )

    def test_health_invalid_and_unknown_warn(self):
        for code in (3, 99, None):
            with self.subTest(code=code):
                self.assertEqual(
                    huawei_pacific.get_replication_health_status_state(code),
                    STATE_WARN,
                )

    def test_descriptions_carry_the_original_code(self):
        self.assertEqual(
            huawei_pacific.get_replication_running_status(23), 'synchronizing (23)'
        )
        self.assertEqual(
            huawei_pacific.get_replication_health_status('2'), 'faulty (2)'
        )

    def test_unknown_codes_render_as_unknown(self):
        for func in (
            huawei_pacific.get_replication_running_status,
            huawei_pacific.get_replication_health_status,
        ):
            with self.subTest(func=func.__name__):
                self.assertEqual(func(99), 'Unknown')
                self.assertEqual(func(None), 'Unknown')


class TestStringCodeHelpers(unittest.TestCase):
    """These helpers key on strings instead of numeric codes, and hand an
    unrecognised code back unchanged, so they are tested on their own.
    """

    # (function, sample_code, expected_text)
    KNOWN: typing.ClassVar = [
        (huawei_pacific.get_base_board, 'STL6SPCM', 'Pacific (STL6SPCM)'),
        (huawei_pacific.get_base_board, 'STL6SPCN', 'Atlantic (STL6SPCN)'),
        (huawei_pacific.get_base_board, 'STL6SPCP', 'Arctic (STL6SPCP)'),
        (huawei_pacific.get_disk_role, 'main_storage', 'main storage (MAIN_STORAGE)'),
        (huawei_pacific.get_disk_role, 'osd_cache', 'cache (OSD_CACHE)'),
        (huawei_pacific.get_disk_type, 'sas_disk', 'SAS disk (SAS_DISK)'),
        (huawei_pacific.get_disk_type, 'sata_disk', 'SATA disk (SATA_DISK)'),
        (huawei_pacific.get_disk_type, 'ssd_card', 'SSD card or NVMe SSD (SSD_CARD)'),
        (huawei_pacific.get_disk_type, 'ssd_disk', 'SSD (SSD_DISK)'),
    ]

    FUNCS: typing.ClassVar = [
        huawei_pacific.get_base_board,
        huawei_pacific.get_disk_role,
        huawei_pacific.get_disk_type,
    ]

    def test_known_codes(self):
        for func, code, expected in self.KNOWN:
            with self.subTest(func=func.__name__, code=code):
                self.assertEqual(func(code), expected)

    def test_known_code_is_normalised(self):
        self.assertEqual(
            huawei_pacific.get_base_board(' stl6spcm '),
            'Pacific (STL6SPCM)',
        )

    def test_unknown_code_is_returned_unchanged(self):
        # The vendor's tables are demonstrably incomplete, and the raw code stays
        # readable because it is what a support case is opened with.
        for func in self.FUNCS:
            with self.subTest(func=func.__name__):
                self.assertEqual(func('no_such_code'), 'NO_SUCH_CODE')

    def test_missing_value_returns_unknown(self):
        for func in self.FUNCS:
            for value in (None, '', '   '):
                with self.subTest(func=func.__name__, value=value):
                    self.assertEqual(func(value), 'Unknown')


# ---------------------------------------------------------------------------
# The severity mappers. Unlike the text mappers these decide what a check
# reports, so every branch is pinned, including the fallback that must never
# silently pass as OK.
# ---------------------------------------------------------------------------


class TestComponentStatusState(unittest.TestCase):
    def test_normal_is_ok(self):
        self.assertEqual(huawei_pacific.get_component_status_state('normal'), STATE_OK)

    def test_fault_is_critical(self):
        self.assertEqual(huawei_pacific.get_component_status_state('fault'), STATE_CRIT)

    def test_value_is_normalised(self):
        # A firmware that capitalises the value differently must not turn a
        # healthy fan into a warning.
        self.assertEqual(huawei_pacific.get_component_status_state(' Normal '), STATE_OK)
        self.assertEqual(huawei_pacific.get_component_status_state('FAULT'), STATE_CRIT)

    def test_absent_is_ok(self):
        # An empty slot is not a fault. A chassis ships with more fan and power supply
        # bays than are usually populated, and the ones nobody ordered a part for report
        # this on every run.
        self.assertEqual(huawei_pacific.get_component_status_state('absent'), STATE_OK)

    def test_undocumented_value_warns(self):
        # The vendor's tables for these endpoints are demonstrably incomplete, so a value
        # none of the known ones covers is worth looking at rather than passing as OK.
        self.assertEqual(
            huawei_pacific.get_component_status_state('sleeping'), STATE_WARN
        )

    def test_missing_value_warns(self):
        for value in (None, '', '   '):
            with self.subTest(value=value):
                self.assertEqual(
                    huawei_pacific.get_component_status_state(value), STATE_WARN
                )


class TestDiskStatusState(unittest.TestCase):
    def test_healthy_is_ok(self):
        self.assertEqual(huawei_pacific.get_disk_status_state(0), STATE_OK)

    def test_faulty_is_critical(self):
        self.assertEqual(huawei_pacific.get_disk_status_state(1), STATE_CRIT)

    def test_sub_healthy_and_removed_warn(self):
        # The pool has already rebuilt around a removed disk, so what is left
        # is a slot to attend to rather than a redundancy loss.
        for code in (2, 101):
            with self.subTest(code=code):
                self.assertEqual(huawei_pacific.get_disk_status_state(code), STATE_WARN)

    def test_accepts_string_codes(self):
        self.assertEqual(huawei_pacific.get_disk_status_state('1'), STATE_CRIT)
        self.assertEqual(huawei_pacific.get_disk_status_state('0'), STATE_OK)

    def test_unmapped_code_warns(self):
        self.assertEqual(huawei_pacific.get_disk_status_state(42), STATE_WARN)

    def test_missing_value_warns(self):
        self.assertEqual(huawei_pacific.get_disk_status_state(None), STATE_WARN)


class TestNodeRunningStatusState(unittest.TestCase):
    def test_online_is_ok(self):
        self.assertEqual(
            huawei_pacific.get_node_running_status_state('online'), STATE_OK
        )

    def test_offline_is_critical(self):
        # A node that left the cluster took its share of the storage with it.
        self.assertEqual(
            huawei_pacific.get_node_running_status_state('offline'), STATE_CRIT
        )

    def test_value_is_normalised(self):
        self.assertEqual(
            huawei_pacific.get_node_running_status_state(' Online '), STATE_OK
        )

    def test_undocumented_value_warns(self):
        self.assertEqual(
            huawei_pacific.get_node_running_status_state('upgrading'), STATE_WARN
        )

    def test_missing_value_warns(self):
        for value in (None, '', '   '):
            with self.subTest(value=value):
                self.assertEqual(
                    huawei_pacific.get_node_running_status_state(value), STATE_WARN
                )


class TestPoolStatusState(unittest.TestCase):
    def test_normal_is_ok(self):
        self.assertEqual(huawei_pacific.get_pool_status_state(0), STATE_OK)

    def test_faulty_and_stopped_are_critical(self):
        for code in (1, 3, 4):
            with self.subTest(code=code):
                self.assertEqual(
                    huawei_pacific.get_pool_status_state(code), STATE_CRIT
                )

    def test_recoverable_states_warn(self):
        # The pool still serves reads, and the last three work themselves out.
        for code in (2, 5, 7, 8):
            with self.subTest(code=code):
                self.assertEqual(
                    huawei_pacific.get_pool_status_state(code), STATE_WARN
                )

    def test_unmapped_code_warns(self):
        self.assertEqual(huawei_pacific.get_pool_status_state(6), STATE_WARN)

    def test_missing_value_warns(self):
        self.assertEqual(huawei_pacific.get_pool_status_state(None), STATE_WARN)


class TestAssertOk(unittest.TestCase):
    def test_success_returns(self):
        self.assertIsNone(
            huawei_pacific.assert_ok({'result': {'code': 0}, 'data': []}, 'the fans')
        )

    def test_success_as_a_string_returns(self):
        self.assertIsNone(huawei_pacific.assert_ok({'result': {'code': '0'}}, 'the fans'))

    def test_bare_result_of_the_older_endpoints_returns(self):
        # The endpoints below /dsware/service/ send the code bare instead of wrapped in an
        # object. A consumer must not have to know which generation it is talking to.
        self.assertIsNone(
            huawei_pacific.assert_ok({'result': 0, 'nodeInfo': []}, 'the disks')
        )

    def test_error_aborts(self):
        with self.assertRaises(SystemExit) as ctx:
            huawei_pacific.assert_ok({'result': {'code': -401}}, 'the fans')
        self.assertEqual(ctx.exception.code, STATE_UNKNOWN)

    def test_bare_error_of_the_older_endpoints_aborts(self):
        with self.assertRaises(SystemExit):
            huawei_pacific.assert_ok({'result': 1}, 'the disks')

    def test_error_text_names_the_query_and_the_appliance_reason(self):
        with self.assertRaises(SystemExit), contextlib.redirect_stdout(io.StringIO()) as out:
            huawei_pacific.assert_ok(
                {
                    'result': {
                        'code': -401,
                        'description': 'authentication failed',
                        'suggestion': 'log in again',
                    }
                },
                'the fans',
            )
        printed = out.getvalue()
        self.assertIn('the fans', printed)
        self.assertIn('-401', printed)
        self.assertIn('authentication failed', printed)
        self.assertIn('log in again', printed)

    def test_empty_response_aborts(self):
        with self.assertRaises(SystemExit):
            huawei_pacific.assert_ok({}, 'the fans')

    def test_missing_result_aborts(self):
        with self.assertRaises(SystemExit):
            huawei_pacific.assert_ok({'data': []}, 'the fans')

    def test_recorded_responses_are_appended_to_the_abort(self):
        # Nothing is recorded unless the caller asked for verbose output, and an abort is
        # the moment those answers are needed most: without them the message names a code
        # and hides the response that explains it.
        out = io.StringIO()
        huawei_pacific.record_response('hwm/fan', {'result': {'code': -401}})
        try:
            with contextlib.redirect_stdout(out), self.assertRaises(SystemExit):
                huawei_pacific.assert_ok({'result': {'code': -401}}, 'the fans')
            printed = out.getvalue()
            self.assertIn('### GET hwm/fan', printed)
            self.assertIn('-401', printed)
        finally:
            huawei_pacific._recorded_responses.clear()

    def test_a_quiet_run_aborts_without_a_response_dump(self):
        out = io.StringIO()
        with contextlib.redirect_stdout(out), self.assertRaises(SystemExit):
            huawei_pacific.assert_ok({'result': {'code': -401}}, 'the fans')
        self.assertNotIn('### GET', out.getvalue())


class TestAlarmSeverityState(unittest.TestCase):
    def test_informational_is_ok(self):
        # A note, not a fault. It stays in the output, where an operator reads it after
        # the fact, but it does not alert.
        self.assertEqual(huawei_pacific.get_alarm_severity_state(2), STATE_OK)

    def test_critical_is_critical(self):
        self.assertEqual(huawei_pacific.get_alarm_severity_state(6), STATE_CRIT)

    def test_warning_minor_and_major_warn(self):
        # Major degrades the appliance without stopping it. An appliance full of major
        # alarms that all page someone at night is one nobody watches any more.
        for code in (3, 4, 5):
            with self.subTest(code=code):
                self.assertEqual(
                    huawei_pacific.get_alarm_severity_state(code), STATE_WARN
                )

    def test_accepts_the_strings_the_api_sends(self):
        self.assertEqual(huawei_pacific.get_alarm_severity_state('6'), STATE_CRIT)
        self.assertEqual(huawei_pacific.get_alarm_severity_state('2'), STATE_OK)

    def test_unmapped_code_warns(self):
        self.assertEqual(huawei_pacific.get_alarm_severity_state(99), STATE_WARN)

    def test_missing_value_warns(self):
        self.assertEqual(huawei_pacific.get_alarm_severity_state(None), STATE_WARN)


class PacificHttpTestBase(unittest.TestCase):
    def setUp(self):
        self.args = Args()

        self.fetch_json = mock.MagicMock(name='fetch_json', return_value=LOGIN_OK)
        self._p_fetch = mock.patch.object(
            huawei_pacific.url, 'fetch_json', self.fetch_json
        )

        # `_logout()` goes through url.fetch(), not url.fetch_json(). Without this
        # patch every test that ends a session would send a real DELETE to the
        # example host in Args.
        self.fetch = mock.MagicMock(name='fetch', return_value=(True, ''))
        self._p_fetch_raw = mock.patch.object(huawei_pacific.url, 'fetch', self.fetch)

        self.cache_get = mock.MagicMock(name='cache.get', return_value=None)
        self.cache_set = mock.MagicMock(name='cache.set')
        self._p_cget = mock.patch.object(huawei_pacific.cache, 'get', self.cache_get)
        self._p_cset = mock.patch.object(huawei_pacific.cache, 'set', self.cache_set)

        self.now = mock.MagicMock(name='time.now', return_value=1_000_000)
        self._p_now = mock.patch.object(huawei_pacific.time, 'now', self.now)

        self.sleep = mock.MagicMock(name='time.sleep')
        self._p_sleep = mock.patch.object(huawei_pacific, '_sleep', self.sleep)

        for p in (
            self._p_fetch,
            self._p_fetch_raw,
            self._p_cget,
            self._p_cset,
            self._p_now,
            self._p_sleep,
        ):
            p.start()
            self.addCleanup(p.stop)

    def last_call(self):
        self.assertTrue(self.fetch_json.called, 'fetch_json was never called')
        return self.fetch_json.call_args

    def sent_uri(self):
        return self.last_call().args[0]

    def sent_kwargs(self):
        return self.last_call().kwargs


class TestGetCreds(PacificHttpTestBase):
    def test_login_returns_token(self):
        self.fetch_json.return_value = LOGIN_OK
        token = huawei_pacific.get_creds(self.args)
        self.assertEqual(token, 'NDQ2ODQwMTEzQUJCQkJCQkJCQkJCQkJC')

    def test_login_uri(self):
        huawei_pacific.get_creds(self.args)
        self.assertEqual(
            self.sent_uri(), 'https://storage.example.com/api/v2/aa/sessions'
        )

    def test_login_body_carries_credentials_and_scope(self):
        huawei_pacific.get_creds(self.args)
        self.assertEqual(
            self.sent_kwargs()['data'],
            {
                'user_name': 'linuxfabrik',
                'password': 'linuxfabrik',
                'isEncrypt': False,
                'scope': '0',
            },
        )

    def test_login_uses_serialized_json_encoding(self):
        huawei_pacific.get_creds(self.args)
        self.assertEqual(self.sent_kwargs()['encoding'], 'serialized-json')

    def test_login_caches_token(self):
        huawei_pacific.get_creds(self.args)
        self.cache_set.assert_called_once_with(
            'huaweipacific-https://storage.example.com-linuxfabrik-xauthtoken',
            'NDQ2ODQwMTEzQUJCQkJCQkJCQkJCQkJC',
            1_000_000 + 15 * 60,
            filename=huawei_pacific.CACHE_FILENAME,
        )

    def test_cache_key_namespaced_by_url(self):
        self.args = Args(URL='https://other.example.com')
        huawei_pacific.get_creds(self.args)
        read_keys = [c.args[0] for c in self.cache_get.call_args_list]
        self.assertIn(
            'huaweipacific-https://other.example.com-linuxfabrik-xauthtoken', read_keys
        )

    def test_cache_key_namespaced_by_username(self):
        # A session carries its user's role. Without the user name in the key, a check
        # running as a different account would silently reuse the first account's
        # session and query the appliance with the wrong privileges.
        self.args = Args(USERNAME='readonly')
        huawei_pacific.get_creds(self.args)
        read_keys = [c.args[0] for c in self.cache_get.call_args_list]
        self.assertIn(
            'huaweipacific-https://storage.example.com-readonly-xauthtoken', read_keys
        )

    def test_own_cache_file_is_used(self):
        huawei_pacific.get_creds(self.args)
        self.assertEqual(
            self.cache_get.call_args.kwargs['filename'], huawei_pacific.CACHE_FILENAME
        )

    def test_cache_expire_zero_disables_caching(self):
        # Not "expires in zero seconds": lib.cache reads the expire argument as an
        # absolute timestamp, so passing now() would store an entry that lives for
        # about a second. An operator setting 0 asks for no caching at all.
        self.args = Args(CACHE_EXPIRE=0)
        token = huawei_pacific.get_creds(self.args)
        self.assertEqual(token, 'NDQ2ODQwMTEzQUJCQkJCQkJCQkJCQkJC')
        self.assertFalse(self.cache_get.called)
        self.assertFalse(self.cache_set.called)

    def test_cached_token_short_circuits_login(self):
        self.cache_get.return_value = 'CACHED-TOKEN'
        token = huawei_pacific.get_creds(self.args)
        self.assertEqual(token, 'CACHED-TOKEN')
        self.assertFalse(self.fetch_json.called)
        self.assertFalse(self.cache_set.called)

    def test_force_relogin_replaces_the_cached_session(self):
        # The cache is still read on this path, but not to reuse the token: the old
        # session has to be handed back to the appliance, otherwise it stays open
        # until the appliance's own timeout expires it.
        self.cache_get.return_value = 'CACHED-TOKEN'
        token = huawei_pacific.get_creds(self.args, force_relogin=True)
        self.assertTrue(self.cache_get.called)
        self.assertTrue(self.fetch_json.called)
        self.assertEqual(token, 'NDQ2ODQwMTEzQUJCQkJCQkJCQkJCQkJC')

    def test_force_relogin_logs_the_cached_session_out(self):
        self.cache_get.return_value = 'CACHED-TOKEN'
        huawei_pacific.get_creds(self.args, force_relogin=True)
        self.assertTrue(self.fetch.called, 'the old session was never logged out')
        self.assertEqual(
            self.fetch.call_args.args[0],
            'https://storage.example.com/api/v2/aa/sessions',
        )
        self.assertEqual(self.fetch.call_args.kwargs['method'], 'DELETE')
        self.assertEqual(
            self.fetch.call_args.kwargs['header']['X-Auth-Token'], 'CACHED-TOKEN'
        )

    def test_force_relogin_without_a_cached_session_logs_nothing_out(self):
        self.cache_get.return_value = None
        huawei_pacific.get_creds(self.args, force_relogin=True)
        self.assertFalse(self.fetch.called)

    def test_login_failure_exits_via_coe(self):
        self.fetch_json.return_value = (False, 'connection refused')
        with self.assertRaises(SystemExit):
            huawei_pacific.get_creds(self.args)

    def test_rejected_login_aborts_without_caching(self):
        # A wrong password, an expired password or a locked account answer
        # HTTP 200 with a non-zero result code and no token. Aborting here
        # beats caching a None that only fails later, in an unrelated place.
        self.fetch_json.return_value = (
            True,
            {
                'result': {
                    'code': 1077949061,
                    'description': 'The user name or password is incorrect.',
                }
            },
        )
        with self.assertRaises(SystemExit):
            huawei_pacific.get_creds(self.args)
        self.assertFalse(self.cache_set.called)

    def test_empty_login_response_aborts(self):
        self.fetch_json.return_value = (True, {})
        with self.assertRaises(SystemExit):
            huawei_pacific.get_creds(self.args)
        self.assertFalse(self.cache_set.called)

    def test_non_object_login_response_aborts(self):
        # A JSON array parses fine but has no .get(), so without a type check this
        # would raise an AttributeError and print a traceback instead of a status.
        self.fetch_json.return_value = (True, ['unexpected'])
        with self.assertRaises(SystemExit):
            huawei_pacific.get_creds(self.args)

    def test_expired_password_aborts(self):
        self.fetch_json.return_value = self._login_with_password_status(3)
        with self.assertRaises(SystemExit):
            huawei_pacific.get_creds(self.args)
        self.assertFalse(self.cache_set.called)

    def test_initial_and_must_change_password_still_log_in(self):
        # Neither REST Interface Reference says these states restrict a session, and
        # aborting on them took every check on a freshly deployed appliance to UNKNOWN.
        # If the appliance really does refuse the requests, get_data() reports its own
        # error text, which names the cause better than a guess made here.
        for status in (4, 6):
            with self.subTest(password_status=status):
                self.cache_set.reset_mock()
                self.fetch_json.return_value = self._login_with_password_status(status)
                token = huawei_pacific.get_creds(self.args)
                self.assertEqual(token, 'NDQ2ODQwMTEzQUJCQkJCQkJCQkJCQkJC')
                self.assertTrue(self.cache_set.called)

    @staticmethod
    def _login_with_password_status(status):
        success, body = LOGIN_OK
        data = dict(body['data'], password_status=status)
        return success, dict(body, data=data)


class TestGetData(PacificHttpTestBase):
    def setUp(self):
        super().setUp()
        self._p_creds = mock.patch.object(
            huawei_pacific, 'get_creds', return_value='TOKEN'
        )
        self.get_creds = self._p_creds.start()
        self.addCleanup(self._p_creds.stop)
        self.fetch_json.return_value = DATA_OK

    def test_success_first_try_returns_payload(self):
        result = huawei_pacific.get_data('hwm/power', self.args)
        self.assertEqual(result['result']['code'], 0)
        self.assertEqual(result['data'][0]['name'], 'Fan0')

    def test_response_is_not_decorated_with_extra_keys(self):
        # The return value is the appliance's own document. Adding a key to it would
        # overwrite an API field that happens to share the name.
        result = huawei_pacific.get_data('hwm/power', self.args)
        self.assertEqual(set(result), {'data', 'result'})

    def test_uri_includes_api_v2_and_endpoint(self):
        huawei_pacific.get_data('hwm/power', self.args)
        self.assertEqual(
            self.sent_uri(), 'https://storage.example.com/api/v2/hwm/power'
        )

    def test_base_path_reaches_the_older_endpoint_generation(self):
        huawei_pacific.get_data(
            'cluster/diskpool/queryNodeDiskInfo?diskPoolId=0',
            self.args,
            base_path='dsware/service',
        )
        self.assertEqual(
            self.sent_uri(),
            'https://storage.example.com/dsware/service/cluster/diskpool/'
            'queryNodeDiskInfo?diskPoolId=0',
        )

    def test_bare_integer_result_counts_as_success(self):
        # The older endpoints report the status code as a bare integer instead of
        # wrapping it in an object. A zero there must not be retried as an error.
        self.fetch_json.return_value = (True, {'result': 0, 'nodeInfo': []})
        result = huawei_pacific.get_data(
            'cluster/diskpool/queryNodeDiskInfo?diskPoolId=0',
            self.args,
            base_path='dsware/service',
        )
        self.assertEqual(result, {'result': 0, 'nodeInfo': []})
        self.assertEqual(self.fetch_json.call_count, 1)

    def test_bare_integer_error_is_retried(self):
        self.fetch_json.return_value = (True, {'result': 1})
        huawei_pacific.get_data('cluster/x', self.args, base_path='dsware/service')
        self.assertEqual(self.fetch_json.call_count, 3)

    def test_auth_header_carries_x_auth_token(self):
        huawei_pacific.get_data('hwm/power', self.args)
        header = self.sent_kwargs()['header']
        self.assertEqual(header['Content-Type'], 'application/json')
        self.assertEqual(header['X-Auth-Token'], 'TOKEN')

    def test_get_when_no_payload(self):
        # A GET read forwards no body; fetch_json infers GET from data=None.
        huawei_pacific.get_data('hwm/power', self.args)
        self.assertIsNone(self.sent_kwargs()['data'])

    def test_post_with_payload(self):
        huawei_pacific.get_data(
            'hwm/fan', self.args, payload={'server_list': ['192.0.2.10']}
        )
        self.assertEqual(self.sent_kwargs()['data'], {'server_list': ['192.0.2.10']})

    def test_forces_relogin_on_second_attempt(self):
        self.fetch_json.return_value = (True, {'result': {'code': 1}})
        huawei_pacific.get_data('hwm/power', self.args)
        forced = [
            call
            for call in self.get_creds.call_args_list
            if call.kwargs.get('force_relogin')
        ]
        self.assertEqual(len(forced), 1)

    def test_retries_until_max_on_persistent_error(self):
        self.fetch_json.return_value = (True, {'result': {'code': 1}})
        huawei_pacific.get_data('hwm/power', self.args)
        self.assertEqual(self.fetch_json.call_count, 3)
        self.assertEqual(self.sleep.call_count, 2)

    def test_recovers_mid_loop(self):
        self.fetch_json.side_effect = [
            (True, {'result': {'code': 1}}),
            (True, {'result': {'code': 0}, 'data': ['recovered']}),
        ]
        result = huawei_pacific.get_data('hwm/power', self.args)
        self.assertEqual(self.fetch_json.call_count, 2)
        self.assertEqual(result['data'], ['recovered'])

    def test_query_string_is_passed_through_on_the_endpoint(self):
        huawei_pacific.get_data(
            'common/alarms?range=[0-100]&filter=alarmStatus::1', self.args
        )
        self.assertEqual(
            self.sent_uri(),
            'https://storage.example.com/api/v2/common/alarms'
            '?range=[0-100]&filter=alarmStatus::1',
        )

    def test_forced_method_without_body_sends_no_content_type(self):
        # A bare verb must not announce a body that is not there.
        huawei_pacific.get_data('file_service/file_systems', self.args, method='GET')
        self.assertNotIn('Content-Type', self.sent_kwargs()['header'])
        self.assertEqual(self.sent_kwargs()['method'], 'GET')

    def test_forwards_insecure_no_proxy_timeout(self):
        self.args = Args(INSECURE=True, NO_PROXY=True, TIMEOUT=21)
        huawei_pacific.get_data('hwm/power', self.args)
        kw = self.sent_kwargs()
        self.assertTrue(kw['insecure'])
        self.assertTrue(kw['no_proxy'])
        self.assertEqual(kw['timeout'], 21)

    def test_fetch_failure_is_reported_in_the_documented_envelope(self):
        # get_data() never aborts: a transport failure becomes a failed attempt and is
        # handed back in the envelope, so the caller can report the reason itself.
        self.fetch_json.return_value = (False, 'timeout')
        result = huawei_pacific.get_data('hwm/power', self.args)
        self.assertEqual(result['result']['code'], 'n/a')
        self.assertIn('timeout', result['result']['description'])

    def test_http_error_body_is_decoded_into_the_envelope(self):
        # An HTTP error status still carries the appliance's own JSON body, which names
        # the actual cause. lib.url skips the decode on a non-2xx status, so the module
        # has to do it or the reason is lost behind the status line.
        self.fetch_json.return_value = (
            False,
            '{"result": {"code": -401, "description": "authentication failed"}}',
        )
        result = huawei_pacific.get_data('hwm/power', self.args)
        self.assertEqual(result['result']['code'], -401)
        self.assertEqual(result['result']['description'], 'authentication failed')


class TestGetManagementIps(PacificHttpTestBase):
    """get_management_ips() collects the node IPs the hwm/* endpoints need."""

    def setUp(self):
        super().setUp()
        self._p_creds = mock.patch.object(
            huawei_pacific, 'get_creds', return_value='TOKEN'
        )
        self._p_creds.start()
        self.addCleanup(self._p_creds.stop)

    def respond(self, nodes, count=None):
        """Answer cluster/servers with `nodes` and cluster/servers/count with `count`."""
        if count is None:
            count = len(nodes)

        def fake(uri, **_):
            if uri.endswith('/count'):
                return True, {'data': {'count': count}, 'result': {'code': 0}}
            return True, {'data': nodes, 'result': {'code': 0}}

        self.fetch_json.side_effect = fake

    def test_returns_management_ips_of_nodes_in_the_cluster(self):
        self.respond(
            [
                {'id': 1, 'in_cluster': True, 'management_ip': '192.0.2.11'},
                {'id': 2, 'in_cluster': True, 'management_ip': '192.0.2.12'},
            ]
        )
        self.assertEqual(
            huawei_pacific.get_management_ips(self.args), ['192.0.2.11', '192.0.2.12']
        )

    def test_node_not_in_the_cluster_is_skipped(self):
        self.respond(
            [
                {'id': 1, 'in_cluster': True, 'management_ip': '192.0.2.11'},
                {'id': 2, 'in_cluster': False, 'management_ip': '192.0.2.12'},
            ]
        )
        self.assertEqual(huawei_pacific.get_management_ips(self.args), ['192.0.2.11'])

    def test_node_about_to_be_added_is_skipped(self):
        # in_cluster is tri-state: false (not added), true (added) and null (to be
        # added). A node still being added holds no cluster hardware, and its missing
        # management IP must not take the whole check to UNKNOWN.
        self.respond(
            [
                {'id': 1, 'in_cluster': True, 'management_ip': '192.0.2.11'},
                {'id': 2, 'in_cluster': None, 'management_ip': None},
            ]
        )
        self.assertEqual(huawei_pacific.get_management_ips(self.args), ['192.0.2.11'])

    def test_node_without_the_field_is_kept(self):
        # A firmware that does not report in_cluster must not narrow the result.
        self.respond([{'id': 1, 'management_ip': '192.0.2.11'}])
        self.assertEqual(huawei_pacific.get_management_ips(self.args), ['192.0.2.11'])

    def test_clustered_node_without_ip_aborts(self):
        # Returning the rest would let a hardware check cover part of the cluster and
        # still report OK, hiding a failed component on the nodes that were dropped.
        self.respond(
            [
                {'id': 1, 'in_cluster': True, 'management_ip': '192.0.2.11'},
                {'id': 2, 'name': 'node02', 'in_cluster': True},
            ]
        )
        with self.assertRaises(SystemExit):
            huawei_pacific.get_management_ips(self.args)

    def test_truncated_node_list_aborts(self):
        # The API-wide default caps a list response at 100 entries, and the endpoint
        # does not document whether it is affected. A silently short list would leave
        # nodes unmonitored while the check still reports OK.
        self.respond(
            [{'id': 1, 'in_cluster': True, 'management_ip': '192.0.2.11'}], count=2
        )
        with self.assertRaises(SystemExit):
            huawei_pacific.get_management_ips(self.args)

    def test_unavailable_count_endpoint_is_not_fatal(self):
        # The count is a cross-check, not the data itself.
        def fake(uri, **_):
            if uri.endswith('/count'):
                return True, {'result': {'code': 1, 'description': 'not supported'}}
            return True, {
                'data': [{'id': 1, 'in_cluster': True, 'management_ip': '192.0.2.11'}],
                'result': {'code': 0},
            }

        self.fetch_json.side_effect = fake
        self.assertEqual(huawei_pacific.get_management_ips(self.args), ['192.0.2.11'])

    def test_failed_node_query_aborts(self):
        self.fetch_json.return_value = (
            True,
            {'result': {'code': 1, 'description': 'internal error'}},
        )
        with self.assertRaises(SystemExit):
            huawei_pacific.get_management_ips(self.args)


class TestGetPerformance(PacificHttpTestBase):
    """get_performance() reads the newest sample of each indicator."""

    def setUp(self):
        super().setUp()
        self._p_creds = mock.patch.object(
            huawei_pacific, 'get_creds', return_value='TOKEN'
        )
        self._p_creds.start()
        self.addCleanup(self._p_creds.stop)

    def respond(self, rows):
        self.fetch_json.return_value = (
            True,
            {'data': rows, 'result': {'code': 0}},
        )

    def test_returns_the_newest_value_per_object_and_indicator(self):
        # The window holds several samples so that a skipped collection cycle does not
        # leave the check with nothing. Only the newest of them is the current state.
        self.respond(
            [
                {
                    'id': '1',
                    'indicator': '68',
                    'indicator_values': ['17.0', '9.0'],
                    'object_type': '16385',
                    'timestamp': [1000, 1010],
                },
                {
                    'id': '1',
                    'indicator': '69',
                    'indicator_values': ['45.0'],
                    'object_type': '16385',
                    'timestamp': [1010],
                },
                {
                    'id': '2',
                    'indicator': '68',
                    'indicator_values': ['50.0', '41.0'],
                    'object_type': '16385',
                    'timestamp': [1000, 1010],
                },
            ]
        )
        self.assertEqual(
            huawei_pacific.get_performance(
                huawei_pacific.PERFORMANCE_OBJECT_NODE, (68, 69), self.args, ids=(1, 2)
            ),
            {'1': {'68': '9.0', '69': '45.0'}, '2': {'68': '41.0'}},
        )

    def test_posts_the_documented_body(self):
        self.respond([])
        huawei_pacific.get_performance(
            huawei_pacific.PERFORMANCE_OBJECT_NODE, (68,), self.args, ids=(1,), window=60
        )
        payload = self.sent_kwargs()['data']
        self.assertEqual(payload['begin_time'], 1_000_000 - 60)
        self.assertEqual(payload['end_time'], 1_000_000)
        self.assertEqual(
            payload['objects'],
            [{'object_type': '16385', 'indicators': ['68'], 'ids': [1]}],
        )

    def test_cluster_query_carries_no_ids(self):
        # The cluster is the one object type that takes none, because there is only ever
        # one of it; sending an empty list is rejected.
        self.respond([])
        huawei_pacific.get_performance(
            huawei_pacific.PERFORMANCE_OBJECT_CLUSTER, (123, 124), self.args
        )
        self.assertNotIn('ids', self.sent_kwargs()['data']['objects'][0])

    def test_uses_the_documented_endpoint(self):
        self.respond([])
        huawei_pacific.get_performance(
            huawei_pacific.PERFORMANCE_OBJECT_CLUSTER, (68,), self.args
        )
        self.assertEqual(
            self.sent_uri(),
            'https://storage.example.com/api/v2/pms/performance_data',
        )

    def test_does_not_retry(self):
        # One of several calls in a run: an appliance that collects no performance data
        # answers with an error, and retrying spends the check's remaining budget on
        # learning what the first answer already said.
        self.fetch_json.return_value = (
            True,
            {'result': {'code': 1, 'description': 'not collecting'}},
        )
        huawei_pacific.get_performance(
            huawei_pacific.PERFORMANCE_OBJECT_CLUSTER, (68,), self.args
        )
        self.assertEqual(self.fetch_json.call_count, 1)

    def test_failed_request_yields_no_samples(self):
        self.fetch_json.return_value = (
            True,
            {'result': {'code': 1, 'description': 'not collecting'}},
        )
        self.assertEqual(
            huawei_pacific.get_performance(
                huawei_pacific.PERFORMANCE_OBJECT_CLUSTER, (68,), self.args
            ),
            {},
        )

    def test_rows_without_a_value_are_dropped(self):
        # A row with an empty value list is what the appliance answers with while
        # collection is warming up. Reporting it as a metric would graph an empty string.
        self.respond(
            [
                {'id': '1', 'indicator': '68', 'indicator_values': []},
                {'id': '1', 'indicator': '69', 'indicator_values': ['45.0']},
            ]
        )
        self.assertEqual(
            huawei_pacific.get_performance(
                huawei_pacific.PERFORMANCE_OBJECT_NODE, (68, 69), self.args, ids=(1,)
            ),
            {'1': {'69': '45.0'}},
        )

    def test_malformed_rows_are_skipped(self):
        self.respond(
            [
                'not-a-row',
                {'indicator': '68', 'indicator_values': ['1']},
                {'id': '1', 'indicator_values': ['2']},
                {'id': '1', 'indicator': '68', 'indicator_values': ['3']},
            ]
        )
        self.assertEqual(
            huawei_pacific.get_performance(
                huawei_pacific.PERFORMANCE_OBJECT_NODE, (68,), self.args, ids=(1,)
            ),
            {'1': {'68': '3'}},
        )


if __name__ == '__main__':
    unittest.main()
