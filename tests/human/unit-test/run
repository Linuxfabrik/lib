"""Unit tests for lib.human. Pure functions, no fixtures or containers.

Covers the documented examples plus edge cases: zero, unit boundaries,
very large and negative values, and wrong input types.
"""

import sys
import time
import unittest

sys.path.insert(0, '..')

import lib.base as base
import lib.human as human


class TestBytes2Human(unittest.TestCase):
    def test_examples(self):
        self.assertEqual(human.bytes2human(1024), '1.0KiB')
        self.assertEqual(human.bytes2human(1500000), '1.4MiB')
        self.assertEqual(human.bytes2human(1024, space=True), '1.0 KiB')

    def test_zero_and_small(self):
        self.assertEqual(human.bytes2human(0), '0.0B')
        self.assertEqual(human.bytes2human(1), '1.0B')

    def test_unit_boundaries(self):
        self.assertEqual(human.bytes2human(1023), '1023.0B')
        self.assertEqual(human.bytes2human(1025), '1.0KiB')
        self.assertEqual(human.bytes2human(1536), '1.5KiB')

    def test_decimals_parameter(self):
        self.assertEqual(human.bytes2human(1536, decimals=0), '2KiB')
        self.assertEqual(human.bytes2human(1536, decimals=3), '1.500KiB')

    def test_decimals_and_space_combined(self):
        self.assertEqual(human.bytes2human(1536, decimals=0, space=True), '2 KiB')

    def test_very_large(self):
        self.assertEqual(human.bytes2human(10**15), '909.5TiB')

    def test_negative(self):
        self.assertEqual(human.bytes2human(-1024), '-1.0KiB')

    def test_wrong_type_raises(self):
        with self.assertRaises(TypeError):
            human.bytes2human('abc')
        with self.assertRaises(TypeError):
            human.bytes2human(None)


class TestBitsAndBps(unittest.TestCase):
    def test_bits2human(self):
        self.assertEqual(human.bits2human(1000), '125.0B')
        self.assertEqual(human.bits2human(0), '0.0B')

    def test_bits2human_decimals(self):
        self.assertEqual(human.bits2human(1500, decimals=0), '188B')

    def test_bps2human(self):
        self.assertEqual(human.bps2human(1000000), '1.0Mbps')

    def test_bps2human_decimals(self):
        self.assertEqual(human.bps2human(1500000, decimals=2), '1.50Mbps')


class TestNumber2Human(unittest.TestCase):
    def test_examples_and_edges(self):
        self.assertEqual(human.number2human(1234567), '1.2M')
        self.assertEqual(human.number2human(999), '999.0')
        self.assertEqual(human.number2human(0), '0.0')
        self.assertEqual(human.number2human(10**12), '1.0T')
        self.assertEqual(human.number2human(-5), '-5.0')


class TestSeconds2Human(unittest.TestCase):
    def test_examples(self):
        self.assertEqual(human.seconds2human(3661), '1h 1m')
        self.assertEqual(human.seconds2human(90), '1m 30s')
        self.assertEqual(human.seconds2human(3661, full_name=True), '1hour 1minute')

    def test_keep_short_false_includes_all_units(self):
        self.assertEqual(human.seconds2human(3661, keep_short=False), '1h 1m 1s')
        self.assertEqual(
            human.seconds2human(3661, keep_short=False, full_name=True),
            '1hour 1minute 1second',
        )

    def test_zero_keeps_its_unit(self):
        self.assertEqual(human.seconds2human(0), '0s')
        self.assertEqual(human.seconds2human('0'), '0s')
        self.assertEqual(human.seconds2human(0, full_name=True), '0seconds')

    def test_negative_is_signed(self):
        self.assertEqual(human.seconds2human(-5), '-5s')
        self.assertEqual(human.seconds2human(-3661), '-1h 1m')
        self.assertEqual(human.seconds2human(-3661, keep_short=False), '-1h 1m 1s')

    def test_very_large(self):
        self.assertEqual(human.seconds2human(10**8), '3Y 2M')


class TestHuman2Bytes(unittest.TestCase):
    def test_examples(self):
        self.assertEqual(human.human2bytes('1K'), 1024)
        self.assertEqual(human.human2bytes('1KB', binary=True), 1024)
        self.assertEqual(human.human2bytes('1k', binary=False), 1000)

    def test_zero_and_large_unit(self):
        self.assertEqual(human.human2bytes('0'), 0)
        self.assertEqual(human.human2bytes('5PB'), 5629499534213120)

    def test_garbage_and_wrong_type_return_zero(self):
        # Documented graceful behaviour: unparseable input yields 0.
        self.assertEqual(human.human2bytes('xyz'), 0)
        self.assertEqual(human.human2bytes(123), 0)
        self.assertEqual(human.human2bytes(''), 0)
        self.assertEqual(human.human2bytes('N/A'), 0)

    def test_value_without_a_unit_is_a_byte_count(self):
        # Configuration files and thresholds carry plain byte counts.
        self.assertEqual(human.human2bytes('1024'), 1024)
        self.assertEqual(human.human2bytes('134217728'), 134217728)
        self.assertEqual(human.human2bytes('  2048  '), 2048)
        self.assertEqual(human.human2bytes('-1'), -1)
        # Truncates like every other branch of the function.
        self.assertEqual(human.human2bytes('3.7'), 3)


class TestHuman2Seconds(unittest.TestCase):
    def test_units(self):
        self.assertEqual(human.human2seconds('1h'), 3600)
        self.assertEqual(human.human2seconds('1d'), 86400)
        self.assertEqual(human.human2seconds('0s'), 0)

    def test_garbage_returns_zero(self):
        self.assertEqual(human.human2seconds('xyz'), 0)


class TestHumanDuration2Seconds(unittest.TestCase):
    def test_compound(self):
        self.assertEqual(human.humanduration2seconds('1h 30m'), 5400)
        self.assertEqual(human.humanduration2seconds('2h'), 7200)


class TestHumanRange(unittest.TestCase):
    def test_humanrange2bytes(self):
        self.assertEqual(human.humanrange2bytes('1K:2K'), '1024:2048')

    def test_humanrange2seconds(self):
        self.assertEqual(human.humanrange2seconds('1m:2m'), '60:120')

    def test_open_bounds_survive(self):
        # An omitted bound is not a value to convert.
        self.assertEqual(human.humanrange2bytes(':1K'), ':1024')
        self.assertEqual(human.humanrange2bytes('1K:'), '1024:')

    def test_markers_without_a_number_pass_through(self):
        # `~` and a bare `@` carry no number. They have to survive untouched,
        # so that a range parser still sees a bound it accepts.
        self.assertEqual(human.humanrange2bytes('~:1K'), '~:1024')
        self.assertEqual(human.humanrange2bytes('@~:1K'), '@~:1024')
        self.assertEqual(human.humanrange2bytes('~:'), '~:')
        self.assertEqual(human.humanrange2bytes('@'), '@')
        self.assertEqual(human.humanrange2seconds('~:1m'), '~:60')

    def test_negative_bound_keeps_its_sign(self):
        self.assertEqual(human.humanrange2bytes('-1K:1K'), '-1024:1024')

    def test_inverted_range_keeps_its_marker(self):
        self.assertEqual(human.humanrange2bytes('@1K:2K'), '@1024:2048')

    def test_unitless_bounds_survive_as_byte_counts(self):
        # A threshold typed without a qualifier used to collapse to 0, which
        # made a range read as "alert on anything above zero".
        self.assertEqual(human.humanrange2bytes('1024'), '1024')
        self.assertEqual(human.humanrange2bytes('1024:2048'), '1024:2048')

    def test_range_that_is_only_an_omitted_bound_on_both_sides(self):
        # `:` is the range 0..inf and never alerts. Losing the colon, or growing a
        # second one, turns "accept everything" into a range no parser can read.
        self.assertEqual(human.humanrange2bytes(':'), ':')
        self.assertEqual(human.humanrange2seconds(':'), ':')
        self.assertEqual(human.humanrange2bytes('@:'), '@:')

    def test_bound_the_converters_cannot_read_is_left_for_the_range_parser(self):
        # The converters answer 0 for anything they cannot read. As a range bound that
        # is the threshold zero, not "no threshold", so a typo must not become `0:0`.
        for text in ['abc', '1,5M', '1.5,2M', '90%', '1_000M', '0.00.0', '1.52.5']:
            with self.subTest(text=text):
                self.assertEqual(human.humanrange2bytes(text), text)
        self.assertEqual(human.humanrange2bytes('1K:abc'), '1024:abc')
        self.assertEqual(human.humanrange2bytes('1K:1,5M'), '1024:1,5M')
        self.assertEqual(human.humanrange2seconds('abc'), 'abc')
        self.assertEqual(human.humanrange2seconds('1,5h'), '1,5h')

    def test_a_bound_that_really_is_zero_still_converts(self):
        self.assertEqual(human.humanrange2bytes('0'), '0')
        self.assertEqual(human.humanrange2bytes('0K:1K'), '0:1024')

    def test_a_long_digit_bound_is_rejected_without_stalling_the_check(self):
        # A bound of many digits that fails only at its last character sent the
        # grammar into exponential backtracking, so one typo in a threshold hung
        # the check until the monitoring server killed it, printing nothing.
        text = '0' * 64 + '!'
        started = time.monotonic()
        self.assertEqual(human.humanrange2bytes(text), text)
        self.assertLess(time.monotonic() - started, 1)

    def test_multi_unit_duration_bound(self):
        self.assertEqual(human.humanrange2seconds('1Y1D'), '31622400')
        self.assertEqual(human.humanrange2seconds('@10m:1Y1D'), '@600:31622400')


class TestHumanRangeFeedsTheRangeParser(unittest.TestCase):
    """A converted range is only useful if `lib.base` can still read it back."""

    def assert_range(self, converted, expected):
        success, result = base._parse_range(converted)
        self.assertTrue(success, f'{converted!r}: {result}')
        self.assertEqual(result, expected)

    def test_converted_ranges_stay_readable(self):
        cases = [
            ('1K', (0, 1024.0, False)),
            (':1K', (0, 1024.0, False)),
            ('1K:', (1024.0, float('inf'), False)),
            (':', (0, float('inf'), False)),
            ('~:1M', (float('-inf'), 1048576.0, False)),
            ('~:', (float('-inf'), float('inf'), False)),
            ('@', (0, float('inf'), True)),
            ('@4K:5 MiB', (4096.0, 5242880.0, True)),
            ('-10:-5', (-10.0, -5.0, False)),
        ]
        for text, expected in cases:
            with self.subTest(text=text):
                self.assert_range(human.humanrange2bytes(text), expected)

    def test_unreadable_bound_reaches_the_parser_as_unreadable(self):
        for text in ['abc', '1K:abc', '1,5M', '1_000M', '1K:1,5M']:
            with self.subTest(text=text):
                success, _ = base._parse_range(human.humanrange2bytes(text))
                self.assertFalse(success)


class TestExtractHrNumbers(unittest.TestCase):
    def test_extracts_integer_with_unit(self):
        self.assertEqual(human.extract_hrnumbers('cpu 1.5K mem 2M'), ['2M'])


if __name__ == '__main__':
    unittest.main()
