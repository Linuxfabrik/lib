"""Unit tests for lib.nextcloud.

The module exposes a single public function, `run_occ`, which shells out to
Nextcloud's `occ` admin CLI as the owner of `config/config.php`. It has four
external touch points, all of which are patched so the suite is fully
hermetic (no PHP, no `occ`, no `sudo`, no filesystem stat, no subprocess):

- `shutil.which('php')`  -> locate the PHP interpreter
- `_locate(...)`         -> resolved installation, `occ` and the UID owning
                           config/config.php, or an error
- `os.geteuid()`         -> decide whether the sudo prefix is needed at all
- `shell.shell_exec(...)` -> run the assembled `sudo ... php occ <cmd>` line

We assert the full command-building contract (PHP lookup, owner lookup path,
the exact `['sudo', '--user', '#<uid>', <php>, <occ>, '--no-warnings', *<cmd>]`
argument list, the dropped sudo prefix when the process already runs as the
owner, and the `cwd` / `timeout` handover) and the full response-handling
contract: JSON parsing (incl. case-insensitive `_format`), raw-text mode,
the missing-PHP and unknown-owner errors, both failure shapes `shell_exec`
can return, the return-code path with its stderr-then-stdout fallback, and
malformed / empty JSON handling.

Captured-style `occ` payloads (`occ status`, `occ user:list --output=json`)
live in fixtures and are fed through the JSON path end to end.
"""

import contextlib
import json
import os
import shutil
import sys
import tempfile
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.nextcloud as nextcloud

FIXTURE_DIR = os.path.join(os.path.dirname(__file__), 'fixtures')

# A canonical, fully-resolved install used across the suite.
NC_PATH = '/var/www/nextcloud'
PHP_BIN = '/usr/bin/php'
UID = 33  # typical www-data UID on Debian-family
OTHER_UID = 1000  # the monitoring user, i.e. not the owner of config.php

# The argument list that follows the (optional) sudo prefix.
OCC_ARGV = [PHP_BIN, '/var/www/nextcloud/occ', '--no-warnings']


def setUpModule():
    # run_occ() builds a sudo and php command line for a Linux host
    if os.name == 'nt':
        raise unittest.SkipTest('lib.nextcloud.run_occ() is POSIX-only')


@contextlib.contextmanager
def without_geteuid():
    """
    Run the block on an `os` that has no `geteuid()`, as on Windows.

    `run_occ` probes for the function instead of testing the platform, so this is the
    only way to reach the "cannot tell who we are, always sudo" branch on Linux.
    """
    saved = getattr(os, 'geteuid', None)
    if saved is not None:
        del os.geteuid
    try:
        yield
    finally:
        if saved is not None:
            os.geteuid = saved


def load_fixture_text(name):
    """Return the raw textual contents of a captured-style fixture."""
    with open(os.path.join(FIXTURE_DIR, name), encoding='utf-8') as f:
        return f.read()


def load_fixture(name):
    """Return the parsed object of a captured-style JSON fixture."""
    return json.loads(load_fixture_text(name))


def located(owner):
    """Return a stand-in for `_locate()` that finds an installation owned by `owner`."""

    def _locate(path, php, timeout=None):
        return True, (path, os.path.join(path, 'occ'), owner)

    return _locate


def patched(
    which=PHP_BIN,
    owner=UID,
    shell_ret=(True, ('{}', '', 0)),
    euid=OTHER_UID,
    php_trusted=True,
):
    """
    Build the four patchers that isolate run_occ from the host.

    Returns a context-manager list to be entered via ExitStack, and the
    shell_exec mock so call assertions can be made. `which=None` simulates a
    host without PHP. `shell_ret` is what shell_exec returns, either
    (True, (stdout, stderr, rc)) or (False, <message>). `euid` is the effective
    UID of the calling process and defaults to something other than `owner`, so
    the sudo prefix is on unless a test says otherwise.
    """
    which_p = mock.patch.object(nextcloud.shutil, 'which', return_value=which)
    # the interpreter is judged like any program run on the caller's behalf
    trusted_p = mock.patch.object(
        nextcloud.disk,
        'resolve_trusted_path',
        side_effect=lambda candidate, owners=None: (
            (True, candidate)
            if php_trusted
            else (False, f'Refusing "{candidate}": writable by everyone.')
        ),
    )
    owner_p = mock.patch.object(nextcloud, '_locate', side_effect=located(owner))
    euid_p = mock.patch.object(nextcloud.os, 'geteuid', create=True, return_value=euid)
    shell_mock = mock.Mock(return_value=shell_ret)
    shell_p = mock.patch.object(nextcloud.shell, 'shell_exec', shell_mock)
    return (which_p, trusted_p, owner_p, euid_p, shell_p), shell_mock


class _Base(unittest.TestCase):
    """Shared helper to run run_occ under the four patches."""

    def run_occ(
        self,
        *args,
        which=PHP_BIN,
        owner=UID,
        shell_ret=(True, ('{}', '', 0)),
        euid=OTHER_UID,
        php_trusted=True,
        **kwargs,
    ):
        (which_p, trusted_p, owner_p, euid_p, shell_p), shell_mock = patched(
            which, owner, shell_ret, euid, php_trusted
        )
        with which_p, trusted_p, owner_p, euid_p, shell_p:
            result = nextcloud.run_occ(*args, **kwargs)
        self.shell_mock = shell_mock
        return result

    def argv(self):
        """Return the argument list handed to the last shell_exec call."""
        (cmd,), _kwargs = self.shell_mock.call_args
        return cmd


# -----------------------------------------------------------------------------
# Missing PHP interpreter
# -----------------------------------------------------------------------------


class TestMissingPhp(_Base):
    """When shutil.which('php') returns falsy, fail before doing anything."""

    def test_returns_false(self):
        ok, _ = self.run_occ(NC_PATH, 'status', which=None)
        self.assertFalse(ok)

    def test_descriptive_message(self):
        _ok, msg = self.run_occ(NC_PATH, 'status', which=None)
        self.assertIn('php', msg)
        self.assertIn('PATH', msg)

    def test_php_looked_up_by_name(self):
        with mock.patch.object(nextcloud.shutil, 'which', return_value=None) as w:
            nextcloud.run_occ(NC_PATH, 'status')
        w.assert_called_once_with('php')

    def test_owner_not_consulted_when_no_php(self):
        # No point statting config.php if there is no interpreter to run occ.
        with (
            mock.patch.object(nextcloud.shutil, 'which', return_value=None),
            mock.patch.object(nextcloud, '_locate') as go,
            mock.patch.object(nextcloud.shell, 'shell_exec') as se,
        ):
            nextcloud.run_occ(NC_PATH, 'status')
        go.assert_not_called()
        se.assert_not_called()

    def test_empty_string_php_is_missing(self):
        # shutil.which can return '' in pathological PATHs; treat as missing.
        ok, _ = self.run_occ(NC_PATH, 'status', which='')
        self.assertFalse(ok)


# -----------------------------------------------------------------------------
# Command construction
# -----------------------------------------------------------------------------


class TestCommandConstruction(_Base):
    """Assert how the sudo/php/occ argument list is assembled."""

    def test_php_looked_up_by_name(self):
        self.run_occ(NC_PATH, 'status')
        self.shell_mock.assert_called_once()

    def test_owner_lookup_targets_config_php(self):
        with (
            mock.patch.object(nextcloud.shutil, 'which', return_value=PHP_BIN),
            # keep the host out: on a runner /usr/bin/php links to /usr/bin/php8.3
            mock.patch.object(
                nextcloud.disk,
                'resolve_trusted_path',
                side_effect=lambda candidate, owners=None: (True, candidate),
            ),
            mock.patch.object(nextcloud, '_locate', side_effect=located(UID)) as go,
            mock.patch.object(
                nextcloud.os, 'geteuid', create=True, return_value=OTHER_UID
            ),
            mock.patch.object(
                nextcloud.shell, 'shell_exec', return_value=(True, ('{}', '', 0))
            ),
        ):
            nextcloud.run_occ(NC_PATH, 'status')
        go.assert_called_once_with(NC_PATH, PHP_BIN, timeout=None)

    def test_full_command_list(self):
        self.run_occ(NC_PATH, 'status')
        self.assertEqual(self.argv(), ['sudo', '--user', '#33', *OCC_ARGV, 'status'])

    def test_command_uses_sudo_user_with_uid(self):
        self.run_occ(NC_PATH, 'status')
        self.assertEqual(self.argv()[:3], ['sudo', '--user', '#33'])

    def test_command_uses_resolved_php_path(self):
        self.run_occ(NC_PATH, 'status', which='/opt/php8/bin/php')
        self.assertIn('/opt/php8/bin/php', self.argv())

    def test_an_untrusted_php_is_not_run(self):
        success, message = self.run_occ(
            NC_PATH, 'status', which='/tmp/php', php_trusted=False
        )
        self.assertFalse(success)
        self.assertIn('/tmp/php', message)
        self.shell_mock.assert_not_called()

    def test_command_points_at_occ_in_path(self):
        self.run_occ('/srv/nc', 'status')
        self.assertIn('/srv/nc/occ', self.argv())

    def test_subcommand_with_args_passed_verbatim(self):
        self.run_occ(NC_PATH, 'user:list --output=json')
        self.assertEqual(self.argv()[-2:], ['user:list', '--output=json'])

    def test_no_warnings_is_injected(self):
        # Keeps Nextcloud's startup banners out of stdout, where they would break
        # the JSON parse.
        self.run_occ(NC_PATH, 'status')
        self.assertIn('--no-warnings', self.argv())

    def test_no_warnings_precedes_the_subcommand(self):
        # An optional-value option in front of it would otherwise swallow it as its
        # value; Symfony accepts global options anywhere.
        self.run_occ(NC_PATH, 'user:list --output json')
        argv = self.argv()
        self.assertLess(argv.index('--no-warnings'), argv.index('user:list'))

    def test_no_warnings_follows_the_occ_path(self):
        self.run_occ(NC_PATH, 'status')
        argv = self.argv()
        self.assertEqual(
            argv[argv.index('--no-warnings') - 1], '/var/www/nextcloud/occ'
        )

    def test_sudo_dropped_when_already_the_owner(self):
        # No sudoers entry needed, and it works in containers that ship without sudo.
        self.run_occ(NC_PATH, 'status', owner=UID, euid=UID)
        self.assertEqual(self.argv(), [*OCC_ARGV, 'status'])

    def test_sudo_used_when_not_the_owner(self):
        self.run_occ(NC_PATH, 'status', owner=UID, euid=OTHER_UID)
        self.assertEqual(self.argv()[0], 'sudo')

    def test_sudo_used_when_geteuid_is_unavailable(self):
        # On a platform without geteuid() we cannot tell, so keep the prefix. Patched
        # by hand because the shared helper would try to patch the absent function.
        shell_mock = mock.Mock(return_value=(True, ('{}', '', 0)))
        with (
            without_geteuid(),
            mock.patch.object(nextcloud.shutil, 'which', return_value=PHP_BIN),
            mock.patch.object(nextcloud, '_locate', side_effect=located(UID)),
            mock.patch.object(nextcloud.shell, 'shell_exec', shell_mock),
        ):
            nextcloud.run_occ(NC_PATH, 'status')
        (cmd,), _kwargs = shell_mock.call_args
        self.assertEqual(cmd[:3], ['sudo', '--user', '#33'])

    def test_root_still_sudoes_down_to_the_owner(self):
        self.run_occ(NC_PATH, 'status', owner=UID, euid=0)
        self.assertEqual(self.argv()[:3], ['sudo', '--user', '#33'])

    def test_cwd_is_the_nextcloud_root(self):
        # console.php chdirs there itself; doing it up front avoids its complaint
        # about an unreadable inherited working directory.
        self.run_occ(NC_PATH, 'status')
        _args, kwargs = self.shell_mock.call_args
        self.assertEqual(kwargs['cwd'], NC_PATH)

    def test_timeout_defaults_to_none(self):
        self.run_occ(NC_PATH, 'status')
        _args, kwargs = self.shell_mock.call_args
        self.assertIsNone(kwargs['timeout'])

    def test_timeout_is_handed_over(self):
        self.run_occ(NC_PATH, 'status', timeout=7)
        _args, kwargs = self.shell_mock.call_args
        self.assertEqual(kwargs['timeout'], 7)

    def test_shell_exec_gets_the_argv_positionally(self):
        self.run_occ(NC_PATH, 'status')
        self.shell_mock.assert_called_once()
        args, kwargs = self.shell_mock.call_args
        self.assertEqual(len(args), 1)
        self.assertIsInstance(args[0], list)
        self.assertEqual(set(kwargs), {'cwd', 'timeout'})


# -----------------------------------------------------------------------------
# Unresolvable config.php owner
# -----------------------------------------------------------------------------


class TestUnknownOwner(unittest.TestCase):
    """config/config.php is missing, so there is no owner to run `occ` as."""

    def run_occ(self, path):
        with (
            mock.patch.object(nextcloud.shutil, 'which', return_value=PHP_BIN),
            mock.patch.object(nextcloud.shell, 'shell_exec') as shell_mock,
        ):
            result = nextcloud.run_occ(path, 'status')
        self.shell_mock = shell_mock
        return result

    def test_returns_false(self):
        ok, _ = self.run_occ('/nonexistent/nextcloud')
        self.assertFalse(ok)

    def test_message_names_the_file(self):
        _ok, msg = self.run_occ('/nonexistent/nextcloud')
        self.assertIn(
            os.path.join('/nonexistent/nextcloud', 'config', 'config.php'), msg
        )

    def test_occ_is_not_executed(self):
        # Without a UID there is nothing sensible to pass to sudo --user.
        self.run_occ('/nonexistent/nextcloud')
        self.shell_mock.assert_not_called()


def _trusted_base():
    """Return a fresh directory whose whole path nobody but root and the current
    user can change, or None where the test host offers none.

    The default temp directory does not qualify: /tmp is writable by everyone.
    """
    home = os.path.expanduser('~')
    if (
        not hasattr(os, 'getuid')
        or not nextcloud.disk.resolve_trusted_path(home, owners=[os.getuid()])[0]
    ):
        return None
    return tempfile.mkdtemp(prefix='.lftest-nextcloud-', dir=home)


@unittest.skipUnless(os.name == 'posix', 'ownership is a POSIX concept here')
class TestInstallationTrust(unittest.TestCase):
    """`occ` runs only from an installation nobody else can change, as its owner.

    One test per way somebody without access to the installation could choose the
    account or the code: a symlinked config.php, an installation in a directory
    anybody can write to, an `occ` that resolves into such a directory.
    """

    def setUp(self):
        self.base = _trusted_base()
        if self.base is None:
            self.skipTest('no directory on this host is trusted for the test user')
        self.nc = self.make_installation(self.base)

    def tearDown(self):
        shutil.rmtree(self.base, ignore_errors=True)

    @staticmethod
    def make_installation(parent):
        nc = os.path.join(parent, 'nextcloud')
        os.makedirs(os.path.join(nc, 'config'))
        with open(os.path.join(nc, 'config', 'config.php'), 'w') as f:
            f.write('<?php\n')
        with open(os.path.join(nc, 'occ'), 'w') as f:
            f.write('<?php\n')
        return nc

    def run_occ(self, path, apps=(), data=None, config_ret=None, probe_ret=None):
        """Run `run_occ()` with PHP stubbed out. The configuration read answers with
        `apps` and `data` (default: `data/` below the installation), or `config_ret`;
        the sudo probe answers with `probe_ret` (default: sudo would run it)."""
        if data is None:
            data = os.path.join(path, 'data')
        config = json.dumps({'apps': list(apps), 'data': data})

        def shell_exec(cmd, **kwargs):
            if '-r' in cmd:
                return config_ret or (True, (config, '', 0))
            if cmd[-1] == 'true':
                return probe_ret or (True, ('', '', 0))
            return True, ('{}', '', 0)

        with (
            mock.patch.object(nextcloud.shutil, 'which', return_value=PHP_BIN),
            mock.patch.object(
                nextcloud.shell, 'shell_exec', side_effect=shell_exec
            ) as shell_mock,
        ):
            result = nextcloud.run_occ(path, 'status')
        self.shell_mock = shell_mock
        return result

    def occ_ran(self):
        # neither the configuration read nor the sudo probe
        return any(
            '-r' not in call.args[0] and call.args[0][-1] != 'true'
            for call in self.shell_mock.call_args_list
        )

    def test_trusted_installation_runs_resolved_occ_as_its_owner(self):
        self.assertEqual(self.run_occ(self.nc), (True, {}))
        (cmd,), kwargs = self.shell_mock.call_args
        self.assertTrue(self.occ_ran())
        occ = os.path.realpath(os.path.join(self.nc, 'occ'))
        self.assertIn(occ, cmd)
        self.assertEqual(kwargs['cwd'], os.path.realpath(self.nc))
        if os.geteuid() != os.getuid():
            self.assertEqual(cmd[:3], ['sudo', '--user', f'#{os.getuid()}'])

    def test_installation_named_through_a_symlink_runs_by_its_real_path(self):
        link = os.path.join(self.base, 'nextcloud-link')
        os.symlink(self.nc, link)
        self.assertEqual(self.run_occ(link), (True, {}))
        _, kwargs = self.shell_mock.call_args
        self.assertEqual(kwargs['cwd'], os.path.realpath(self.nc))

    def test_occ_that_resolves_elsewhere_after_the_check_is_refused(self):
        # a link flipped between the checks: what was checked has to be what runs
        real_resolve = nextcloud.disk.resolve_trusted_path

        def flipping(candidate, owners=None):
            success, result = real_resolve(candidate, owners=owners)
            if success and candidate.endswith(os.sep + 'occ'):
                return True, os.path.join(self.base, 'elsewhere', 'occ')
            return success, result

        with mock.patch.object(
            nextcloud.disk, 'resolve_trusted_path', side_effect=flipping
        ):
            ok, msg = self.run_occ(self.nc)
        self.assertFalse(ok)
        self.assertIn('real path', msg)
        self.assertFalse(self.occ_ran())

    def test_symlinked_config_php_is_refused(self):
        # The owner of the link target would decide the account, here root.
        config = os.path.join(self.nc, 'config', 'config.php')
        os.remove(config)
        os.symlink('/etc/passwd', config)
        ok, msg = self.run_occ(self.nc)
        self.assertFalse(ok)
        self.assertIn('not a regular file', msg)
        self.shell_mock.assert_not_called()

    def test_installation_in_a_directory_anybody_can_write_is_refused(self):
        work = tempfile.mkdtemp(prefix='lftest-nextcloud-untrusted-')
        try:
            nc = self.make_installation(work)
            ok, msg = self.run_occ(nc)
            self.assertFalse(ok)
            self.assertIn('writable by everyone', msg)
            self.shell_mock.assert_not_called()
        finally:
            shutil.rmtree(work, ignore_errors=True)

    def test_occ_resolving_into_a_directory_anybody_can_write_is_refused(self):
        work = tempfile.mkdtemp(prefix='lftest-nextcloud-untrusted-')
        try:
            planted = os.path.join(work, 'occ')
            with open(planted, 'w') as f:
                f.write('<?php\n')
            occ = os.path.join(self.nc, 'occ')
            os.remove(occ)
            os.symlink(planted, occ)
            ok, msg = self.run_occ(self.nc)
            self.assertFalse(ok)
            self.assertIn('writable by everyone', msg)
            self.shell_mock.assert_not_called()
        finally:
            shutil.rmtree(work, ignore_errors=True)

    # occ loads far more than occ and config.php: console.php, lib/, 3rdparty/, the
    # apps and config/*.config.php. Any of them somebody else can change runs their
    # code as the owner of config.php, root included. The refusal does not name the
    # object: the caller chose the path, but may not be allowed to look below it.
    def test_code_below_the_installation_somebody_else_can_change_is_refused(self):
        for relative in (
            'console.php',
            os.path.join('apps', 'files', 'appinfo', 'app.php'),
            os.path.join('lib', 'base.php'),
        ):
            with self.subTest(relative=relative):
                path = os.path.join(self.nc, relative)
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, 'w') as f:
                    f.write('<?php\n')
                os.chmod(path, 0o666)  # nosec B103 - writable by everyone on purpose
                ok, msg = self.run_occ(self.nc)
                self.assertFalse(ok)
                self.assertIn('something below it can be changed', msg)
                self.assertNotIn(os.path.basename(relative), msg)
                self.assertFalse(self.occ_ran())
                os.remove(path)

    # The configuration is PHP that is about to run; it is checked first.
    def test_configuration_somebody_else_can_change_never_runs(self):
        extra = os.path.join(self.nc, 'config', 'extra.config.php')
        with open(extra, 'w') as f:
            f.write('<?php\n')
        os.chmod(extra, 0o666)  # nosec B103 - writable by everyone on purpose
        ok, msg = self.run_occ(self.nc)
        self.assertFalse(ok)
        self.assertIn('something below it can be changed', msg)
        self.shell_mock.assert_not_called()

    def test_configuration_is_read_as_the_owner(self):
        self.run_occ(self.nc)
        (cmd,), _kwargs = self.shell_mock.call_args_list[0]
        self.assertIn('-r', cmd)
        root = os.path.realpath(self.nc)
        self.assertEqual(cmd[-2:], [root, os.path.join(root, 'config') + os.sep])
        if os.geteuid() != os.getuid():
            self.assertEqual(cmd[:3], ['sudo', '--user', f'#{os.getuid()}'])

    # PHP's own message is not passed on: a parse error quotes the configuration,
    # here the database password, and the caller may not be allowed to read it.
    def test_unreadable_configuration_is_refused_without_quoting_it(self):
        parse_error = (
            'PHP Parse error:  syntax error, unexpected single-quoted string '
            '"linuxfabrik", expecting "]" in /var/www/nextcloud/config/config.php on '
            'line 7'
        )
        for config_ret in (
            (True, ('', parse_error, 255)),
            (True, (parse_error, '', 255)),
        ):
            with self.subTest(config_ret=config_ret):
                ok, msg = self.run_occ(self.nc, config_ret=config_ret)
                self.assertFalse(ok)
                self.assertIn('Could not read the configuration', msg)
                self.assertIn('rc=255', msg)
                self.assertNotIn('linuxfabrik', msg)
                self.assertNotIn('Parse error', msg)
                self.assertFalse(self.occ_ran())

    # Without a sudo rule, PHP never runs. The failure is put down to sudo, with
    # sudo's own answer to a separate `true`, which cannot quote the configuration.
    # Measured with sudo 1.9 on Rocky 9: the lecture on stderr, then two `sudo:` lines.
    def test_refused_sudo_is_named_instead_of_php(self):
        refused = (
            True,
            (
                '',
                'We trust you have received the usual lecture\n'
                'sudo: a terminal is required to read the password\n'
                'sudo: a password is required\n',
                1,
            ),
        )
        not_the_owner = os.getuid() + 1
        with mock.patch.object(
            nextcloud.os, 'geteuid', create=True, return_value=not_the_owner
        ):
            ok, msg = self.run_occ(self.nc, config_ret=refused, probe_ret=refused)
        self.assertFalse(ok)
        self.assertIn(f'uid {os.getuid()}', msg)
        self.assertIn('sudo answered "a password is required"', msg)
        self.assertNotIn('Could not read the configuration', msg)
        self.assertNotIn('lecture', msg)
        probe = self.shell_mock.call_args_list[-1].args[0]
        self.assertEqual(
            probe, ['sudo', '--non-interactive', '--user', f'#{os.getuid()}', 'true']
        )
        self.assertFalse(self.occ_ran())

    def test_php_failure_behind_a_working_sudo_keeps_quiet_about_php(self):
        not_the_owner = os.getuid() + 1
        with mock.patch.object(
            nextcloud.os, 'geteuid', create=True, return_value=not_the_owner
        ):
            ok, msg = self.run_occ(
                self.nc, config_ret=(True, ('', 'PHP Parse error: linuxfabrik', 255))
            )
        self.assertFalse(ok)
        self.assertIn('Could not read the configuration', msg)
        self.assertNotIn('linuxfabrik', msg)

    def test_no_sudo_probe_when_running_as_the_owner(self):
        with mock.patch.object(
            nextcloud.os, 'geteuid', create=True, return_value=os.getuid()
        ):
            ok, msg = self.run_occ(
                self.nc, config_ret=(True, ('', 'PHP Parse error', 255))
            )
        self.assertFalse(ok)
        self.assertIn('Could not read the configuration', msg)
        self.assertFalse(
            any(call.args[0][-1] == 'true' for call in self.shell_mock.call_args_list)
        )

    # Nothing is loaded from the data directory and its entry cannot be replaced, so
    # its own mode does not matter either.
    def test_data_directory_writable_by_everyone_is_accepted(self):
        data = os.path.join(self.nc, 'data')
        os.makedirs(data)
        os.chmod(data, 0o777)  # nosec B103 - writable by everyone on purpose
        self.assertEqual(self.run_occ(self.nc), (True, {}))

    # A data directory on a volume of its own, linked into the installation, is left
    # out like one that datadirectory names directly.
    def test_linked_data_directory_on_another_volume_is_accepted(self):
        volume = tempfile.mkdtemp(prefix='lftest-nextcloud-volume-')
        self.addCleanup(shutil.rmtree, volume, True)
        data = os.path.join(volume, 'data')
        os.makedirs(data)
        os.chmod(data, 0o777)  # nosec B103 - writable by everyone on purpose
        os.symlink(data, os.path.join(self.nc, 'data'))
        self.assertEqual(self.run_occ(self.nc), (True, {}))
        # Named by its resolved location below a directory another account controls,
        # it cannot decide anything: the link in the installation is followed and the
        # path to its target checked like any other.
        self.assertFalse(self.run_occ(self.nc, data=data)[0])

    # Where datadirectory resolves to must not decide what is left out: whoever
    # controls a component of its path would point it at apps/ and have the code
    # there skipped, which then runs as the owner of config.php.
    def test_data_directory_path_cannot_be_pointed_at_code(self):
        ext = os.path.join(self.base, 'ext')
        os.makedirs(ext)
        os.chmod(ext, 0o777)  # nosec B103 - a mount point or a home another account controls
        apps = os.path.join(self.nc, 'apps')
        code = os.path.join(apps, 'evil', 'app.php')
        os.makedirs(os.path.dirname(code))
        with open(code, 'w') as f:
            f.write('<?php\n')
        os.chmod(code, 0o666)  # nosec B103 - writable by everyone on purpose
        data = os.path.join(ext, 'data')
        os.makedirs(data)
        self.assertFalse(self.run_occ(self.nc, data=data)[0])
        # the other account swaps the data directory for a link to apps/
        os.rmdir(data)
        os.symlink(apps, data)
        ok, _msg = self.run_occ(self.nc, data=data)
        self.assertFalse(ok)
        self.assertFalse(self.occ_ran())

    # An app directory is checked on its own even when the data directory would hide
    # it from the check of the installation.
    def test_app_directory_named_as_data_directory_is_still_checked(self):
        apps = os.path.join(self.nc, 'apps')
        code = os.path.join(apps, 'evil', 'app.php')
        os.makedirs(os.path.dirname(code))
        with open(code, 'w') as f:
            f.write('<?php\n')
        os.chmod(code, 0o666)  # nosec B103 - writable by everyone on purpose
        ok, _msg = self.run_occ(self.nc, apps=[apps], data=apps)
        self.assertFalse(ok)

    # The data directory holds no code, and can hold millions of files.
    def test_configured_data_directory_is_not_searched(self):
        upload = os.path.join(self.nc, 'storage', 'alice', 'files', 'upload.php')
        os.makedirs(os.path.dirname(upload))
        with open(upload, 'w') as f:
            f.write('<?php\n')
        os.chmod(upload, 0o666)  # nosec B103 - writable by everyone on purpose
        self.assertFalse(self.run_occ(self.nc)[0])
        self.assertEqual(
            self.run_occ(self.nc, data=os.path.join(self.nc, 'storage')), (True, {})
        )

    # apps_paths can place apps outside the installation (Fedora:
    # /var/lib/nextcloud/apps); occ loads them as well.
    def test_app_directory_outside_the_installation_is_checked(self):
        outside = os.path.join(self.base, 'appstore')
        os.makedirs(os.path.join(outside, 'evil'))
        self.assertEqual(self.run_occ(self.nc, apps=[outside]), (True, {}))
        code = os.path.join(outside, 'evil', 'app.php')
        with open(code, 'w') as f:
            f.write('<?php\n')
        os.chmod(code, 0o666)  # nosec B103 - writable by everyone on purpose
        ok, msg = self.run_occ(self.nc, apps=[outside])
        self.assertFalse(ok)
        self.assertIn('app directory its configuration names', msg)
        self.assertNotIn('appstore', msg)
        self.assertFalse(self.occ_ran())

    def test_app_directory_in_the_data_directory_is_checked(self):
        apps = os.path.join(self.nc, 'data', 'apps')
        os.makedirs(apps)
        code = os.path.join(apps, 'app.php')
        with open(code, 'w') as f:
            f.write('<?php\n')
        os.chmod(code, 0o666)  # nosec B103 - writable by everyone on purpose
        ok, _msg = self.run_occ(self.nc, apps=[apps])
        self.assertFalse(ok)

    # occ runs in the installation, so a relative app directory is relative to it and
    # not to the working directory of the caller
    def test_relative_app_directory_is_checked_below_the_installation(self):
        apps = os.path.join(self.nc, 'apps-extra')
        os.makedirs(os.path.join(apps, 'evil'))
        cwd = os.getcwd()
        os.chdir(self.base)
        try:
            self.assertEqual(self.run_occ(self.nc, apps=['apps-extra']), (True, {}))
            code = os.path.join(apps, 'evil', 'app.php')
            with open(code, 'w') as f:
                f.write('<?php\n')
            os.chmod(code, 0o666)  # nosec B103 - writable by everyone on purpose
            self.assertFalse(self.run_occ(self.nc, apps=['apps-extra'])[0])
            self.assertFalse(self.occ_ran())
        finally:
            os.chdir(cwd)

    # occ refuses a missing app directory itself; it is not checked for later.
    def test_missing_app_directory_is_refused(self):
        ok, msg = self.run_occ(self.nc, apps=[os.path.join(self.base, 'nowhere')])
        self.assertFalse(ok)
        self.assertIn('does not exist', msg)
        self.assertNotIn('nowhere', msg)

    def test_installation_writable_by_everyone_is_refused(self):
        os.chmod(self.nc, 0o777)  # nosec B103 - writable by everyone on purpose
        ok, msg = self.run_occ(self.nc)
        self.assertFalse(ok)
        self.assertIn('writable by everyone', msg)
        self.shell_mock.assert_not_called()


# -----------------------------------------------------------------------------
# JSON response handling (default _format='json')
# -----------------------------------------------------------------------------


class TestJsonResponse(_Base):
    """Assert JSON parsing on the success path."""

    def test_parses_object(self):
        ok, data = self.run_occ(
            NC_PATH, 'status', shell_ret=(True, ('{"installed": true}', '', 0))
        )
        self.assertTrue(ok)
        self.assertEqual(data, {'installed': True})

    def test_parses_array(self):
        ok, data = self.run_occ(
            NC_PATH, 'status', shell_ret=(True, ('[1, 2, 3]', '', 0))
        )
        self.assertTrue(ok)
        self.assertEqual(data, [1, 2, 3])

    def test_returns_python_types(self):
        ok, data = self.run_occ(
            NC_PATH,
            'status',
            shell_ret=(True, ('{"maintenance": false, "n": 7, "v": null}', '', 0)),
        )
        self.assertTrue(ok)
        self.assertIs(data['maintenance'], False)
        self.assertEqual(data['n'], 7)
        self.assertIsNone(data['v'])

    def test_default_format_is_json(self):
        # No _format kwarg -> JSON parsing happens.
        ok, data = self.run_occ(
            NC_PATH, 'status', shell_ret=(True, ('{"a": 1}', '', 0))
        )
        self.assertTrue(ok)
        self.assertEqual(data, {'a': 1})

    def test_parses_bare_scalar(self):
        # `occ config:app:get --output=json` emits a bare JSON string; consumers
        # rely on getting a str back.
        ok, data = self.run_occ(
            NC_PATH,
            'config:app:get --output=json support subscription_key',
            shell_ret=(True, ('"linuxfabrik"', '', 0)),
        )
        self.assertTrue(ok)
        self.assertEqual(data, 'linuxfabrik')

    def test_format_json_is_case_insensitive(self):
        ok, data = self.run_occ(
            NC_PATH, 'status', _format='JSON', shell_ret=(True, ('{"a": 1}', '', 0))
        )
        self.assertTrue(ok)
        self.assertEqual(data, {'a': 1})

    def test_format_json_mixed_case(self):
        ok, data = self.run_occ(
            NC_PATH, 'status', _format='Json', shell_ret=(True, ('{"a": 1}', '', 0))
        )
        self.assertTrue(ok)
        self.assertEqual(data, {'a': 1})


# -----------------------------------------------------------------------------
# Malformed / empty JSON
# -----------------------------------------------------------------------------


class TestJsonErrors(_Base):
    """Assert behaviour when stdout is not valid JSON."""

    def test_non_json_text_fails(self):
        ok, msg = self.run_occ(
            NC_PATH, 'status', shell_ret=(True, ('not json at all', '', 0))
        )
        self.assertFalse(ok)
        self.assertIn('JSON decode error', msg)

    def test_error_includes_raw_stdout(self):
        ok, msg = self.run_occ(
            NC_PATH, 'status', shell_ret=(True, ('garbage-123', '', 0))
        )
        self.assertFalse(ok)
        self.assertIn('Raw stdout', msg)
        self.assertIn('garbage-123', msg)

    def test_empty_stdout_is_json_error(self):
        # rc==0 but empty stdout: json.loads('') raises -> decode error.
        ok, msg = self.run_occ(NC_PATH, 'status', shell_ret=(True, ('', '', 0)))
        self.assertFalse(ok)
        self.assertIn('JSON decode error', msg)

    def test_truncated_json_fails(self):
        ok, msg = self.run_occ(
            NC_PATH, 'status', shell_ret=(True, ('{"installed": tr', '', 0))
        )
        self.assertFalse(ok)
        self.assertIn('JSON decode error', msg)


# -----------------------------------------------------------------------------
# Raw text response handling (_format != 'json')
# -----------------------------------------------------------------------------


class TestTextResponse(_Base):
    """Assert raw-text mode trims and returns stdout untouched otherwise."""

    def test_text_format_returns_string(self):
        ok, text = self.run_occ(
            NC_PATH,
            'status',
            _format='text',
            shell_ret=(True, ('Nextcloud is installed', '', 0)),
        )
        self.assertTrue(ok)
        self.assertEqual(text, 'Nextcloud is installed')

    def test_text_is_stripped(self):
        ok, text = self.run_occ(
            NC_PATH, 'status', _format='text', shell_ret=(True, ('  hello \n', '', 0))
        )
        self.assertTrue(ok)
        self.assertEqual(text, 'hello')

    def test_text_does_not_parse_json(self):
        # In text mode JSON-looking output stays a raw string.
        ok, text = self.run_occ(
            NC_PATH, 'status', _format='text', shell_ret=(True, ('{"a": 1}', '', 0))
        )
        self.assertTrue(ok)
        self.assertEqual(text, '{"a": 1}')

    def test_arbitrary_non_json_format_is_text(self):
        # Any _format other than 'json' triggers the text branch.
        ok, text = self.run_occ(
            NC_PATH, 'status', _format='plain', shell_ret=(True, (' ok ', '', 0))
        )
        self.assertTrue(ok)
        self.assertEqual(text, 'ok')


# -----------------------------------------------------------------------------
# Failure path (return code / success flag)
# -----------------------------------------------------------------------------


class TestFailurePath(_Base):
    """Assert the command-failure contract and its message composition."""

    def test_nonzero_rc_is_failure(self):
        ok, _ = self.run_occ(NC_PATH, 'status', shell_ret=(True, ('', 'boom', 1)))
        self.assertFalse(ok)

    def test_failure_message_contains_command(self):
        _ok, msg = self.run_occ(NC_PATH, 'status', shell_ret=(True, ('', 'boom', 1)))
        self.assertIn(
            'sudo --user #33 /usr/bin/php /var/www/nextcloud/occ --no-warnings status',
            msg,
        )

    def test_failure_message_contains_rc(self):
        _ok, msg = self.run_occ(NC_PATH, 'status', shell_ret=(True, ('', 'boom', 7)))
        self.assertIn('rc=7', msg)

    def test_failure_prefers_stderr(self):
        _ok, msg = self.run_occ(
            NC_PATH, 'status', shell_ret=(True, ('some stdout', 'the stderr', 1))
        )
        self.assertIn('the stderr', msg)

    def test_failure_falls_back_to_stdout_when_no_stderr(self):
        # stderr empty -> the (or-fallback) stdout is shown instead.
        ok, msg = self.run_occ(
            NC_PATH, 'status', shell_ret=(True, ('the stdout', '', 5))
        )
        self.assertFalse(ok)
        self.assertIn('the stdout', msg)
        self.assertIn('rc=5', msg)

    def test_failure_short_circuits_before_json_parse(self):
        # Valid JSON in stdout must not turn an rc!=0 run into a success.
        ok, msg = self.run_occ(
            NC_PATH, 'status', shell_ret=(True, ('{"a": 1}', 'err', 1))
        )
        self.assertFalse(ok)
        self.assertIn('err', msg)


# -----------------------------------------------------------------------------
# shell_exec reporting its own failure
# -----------------------------------------------------------------------------


class TestShellExecFailure(_Base):
    """
    shell_exec() signals its own failures as (False, <message string>), not as a
    triple. run_occ has to hand that through instead of trying to unpack it.
    """

    def test_timeout_returns_false(self):
        ok, _ = self.run_occ(
            NC_PATH, 'status', shell_ret=(False, 'Timeout after 5 seconds.')
        )
        self.assertFalse(ok)

    def test_timeout_message_passed_through(self):
        _ok, msg = self.run_occ(
            NC_PATH, 'status', shell_ret=(False, 'Timeout after 5 seconds.')
        )
        self.assertEqual(msg, 'Timeout after 5 seconds.')

    def test_spawn_error_passed_through(self):
        # What shell_exec reports when Popen() raises, e.g. sudo not installed.
        raw = 'Error "[Errno 2] No such file or directory: \'sudo\'" while calling command'
        ok, msg = self.run_occ(NC_PATH, 'status', shell_ret=(False, raw))
        self.assertFalse(ok)
        self.assertEqual(msg, raw)

    def test_text_format_also_reports_the_failure(self):
        ok, msg = self.run_occ(
            NC_PATH,
            'app:update --showonly',
            _format='text',
            shell_ret=(False, 'Timeout after 5 seconds.'),
        )
        self.assertFalse(ok)
        self.assertEqual(msg, 'Timeout after 5 seconds.')


# -----------------------------------------------------------------------------
# Captured-style payloads, end to end (still hermetic)
# -----------------------------------------------------------------------------


class TestCapturedPayloads(_Base):
    """Feed real-shaped occ output through the JSON path."""

    def test_occ_status_payload(self):
        raw = load_fixture_text('status.json')
        expected = load_fixture('status.json')
        ok, data = self.run_occ(NC_PATH, 'status', shell_ret=(True, (raw, '', 0)))
        self.assertTrue(ok)
        self.assertEqual(data, expected)
        self.assertIs(data['installed'], True)
        self.assertIs(data['maintenance'], False)
        self.assertEqual(data['versionstring'], '29.0.4')

    def test_occ_user_list_payload(self):
        raw = load_fixture_text('user-list.json')
        expected = load_fixture('user-list.json')
        ok, data = self.run_occ(
            NC_PATH, 'user:list --output=json', shell_ret=(True, (raw, '', 0))
        )
        self.assertTrue(ok)
        self.assertEqual(data, expected)
        self.assertEqual(data['alice'], 'Alice Example')
        self.assertEqual(len(data), 3)

    def test_occ_status_text_mode_returns_raw(self):
        raw = load_fixture_text('status.json')
        ok, text = self.run_occ(
            NC_PATH, 'status', _format='text', shell_ret=(True, (raw, '', 0))
        )
        self.assertTrue(ok)
        # Text mode keeps it a string (stripped), not a dict.
        self.assertIsInstance(text, str)
        self.assertEqual(text, raw.strip())


if __name__ == '__main__':
    unittest.main()
