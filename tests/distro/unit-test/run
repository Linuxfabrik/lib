"""


@contextlib.contextmanager
def fake_fs(files, links=()):
    """Run the enclosed block against a simulated filesystem.

    `files` maps an absolute path to its content. Any path not in the mapping is
    treated as missing. `links` lists paths that report as symlinks.
    """

    def fake_isfile(path):
        return path in files

    def fake_getsize(path):
        return len(files[path])

    def fake_access(path, _mode):
        return path in files

    def fake_islink(path):
        return path in links

    def fake_listdir(path):
        prefix = path.rstrip('/') + '/'
        return [
            entry[len(prefix) :]
            for entry in files
            if entry.startswith(prefix) and '/' not in entry[len(prefix) :]
        ]

    def fake_open(path, *args, **kwargs):
        if path not in files:
            raise FileNotFoundError(path)
        return io.StringIO(files[path])

    with (
        mock.patch('lib.distro.os.path.isfile', side_effect=fake_isfile),
        mock.patch('lib.distro.os.path.getsize', side_effect=fake_getsize),
        mock.patch('lib.distro.os.path.islink', side_effect=fake_islink),
        mock.patch('lib.distro.os.access', side_effect=fake_access),
        mock.patch('lib.distro.os.listdir', side_effect=fake_listdir),
        mock.patch('builtins.open', side_effect=fake_open),
    ):
        yield


class TestFileExists(unittest.TestCase):
    """_file_exists: existence + non-empty semantics."""

    def setUp(self):
        self.dir = tempfile.mkdtemp(prefix='lftest-distro-')
        self.empty = os.path.join(self.dir, 'empty')
        self.nonempty = os.path.join(self.dir, 'nonempty')
        with open(self.empty, 'w', encoding='utf-8'):
            pass
        with open(self.nonempty, 'w', encoding='utf-8') as f:
            f.write('data')

    def test_missing_file_is_false(self):
        self.assertFalse(distro._file_exists(os.path.join(self.dir, 'nope')))

    def test_nonempty_file_is_true(self):
        self.assertTrue(distro._file_exists(self.nonempty))

    def test_empty_file_is_false_by_default(self):
        self.assertFalse(distro._file_exists(self.empty))

    def test_empty_file_true_when_allow_empty(self):
        self.assertTrue(distro._file_exists(self.empty, allow_empty=True))

    def test_missing_file_still_false_with_allow_empty(self):
        # allow_empty only relaxes the size check, not the existence check.
        self.assertFalse(
            distro._file_exists(os.path.join(self.dir, 'nope'), allow_empty=True)
        )

    def test_directory_is_not_a_file(self):
        self.assertFalse(distro._file_exists(self.dir))


class TestGetFileContent(unittest.TestCase):
    """_get_file_content: read whole file as text, never raise."""

    def test_reads_and_strips(self):
        with fake_fs({'/etc/alpine-release': ALPINE_RELEASE}):
            self.assertEqual(distro._get_file_content('/etc/alpine-release'), '3.21.7')

    def test_keeps_whitespace_when_asked(self):
        with fake_fs({'/etc/alpine-release': ALPINE_RELEASE}):
            self.assertEqual(
                distro._get_file_content('/etc/alpine-release', strip=False),
                ALPINE_RELEASE,
            )

    def test_missing_file_returns_default(self):
        with fake_fs({}):
            self.assertIsNone(distro._get_file_content('/etc/os-release'))
            self.assertEqual(distro._get_file_content('/etc/os-release', 'x'), 'x')

    def test_empty_file_returns_default(self):
        with fake_fs({'/etc/arch-release': '   \n'}):
            self.assertIsNone(distro._get_file_content('/etc/arch-release'))

    def test_unreadable_file_returns_default(self):
        with (
            mock.patch('lib.distro.os.path.isfile', return_value=True),
            mock.patch('lib.distro.os.access', return_value=False),
        ):
            self.assertIsNone(distro._get_file_content('/etc/shadow-release'))

    def test_oserror_returns_default(self):
        with (
            mock.patch('lib.distro.os.path.isfile', return_value=True),
            mock.patch('lib.distro.os.access', return_value=True),
            mock.patch('builtins.open', side_effect=OSError('boom')),
        ):
            self.assertIsNone(distro._get_file_content('/etc/os-release'))


class TestGetFileLines(unittest.TestCase):
    """_get_file_lines: line list, empty on failure."""

    def test_splits_lines(self):
        with fake_fs({'/etc/debian_version': '12.14\n'}):
            self.assertEqual(distro._get_file_lines('/etc/debian_version'), ['12.14'])

    def test_missing_file_returns_empty_list(self):
        with fake_fs({}):
            self.assertEqual(distro._get_file_lines('/etc/debian_version'), [])


class TestGetOsReleaseInfo(unittest.TestCase):
    """_get_os_release_info: os-release into a lowercased dict."""

    def test_parses_keys_and_strips_quotes(self):
        with fake_fs({'/etc/os-release': OS_RELEASE_UBUNTU}):
            values = distro._get_os_release_info()
        self.assertEqual(values['name'], 'Ubuntu')
        self.assertEqual(values['id'], 'ubuntu')
        self.assertEqual(values['version_id'], '24.04')
        self.assertEqual(values['version_codename'], 'noble')

    def test_single_quotes_are_stripped(self):
        with fake_fs({'/etc/os-release': OS_RELEASE_GENTOO}):
            values = distro._get_os_release_info()
        self.assertEqual(values['name'], 'Gentoo')
        self.assertEqual(values['id'], 'gentoo')

    def test_falls_back_to_usr_lib(self):
        with fake_fs({'/usr/lib/os-release': OS_RELEASE_CLEARLINUX}):
            values = distro._get_os_release_info()
        self.assertEqual(values['name'], 'Clear Linux OS')

    def test_etc_wins_over_usr_lib(self):
        files = {
            '/etc/os-release': OS_RELEASE_UBUNTU,
            '/usr/lib/os-release': OS_RELEASE_CLEARLINUX,
        }
        with fake_fs(files):
            self.assertEqual(distro._get_os_release_info()['name'], 'Ubuntu')

    def test_comments_and_blank_lines_are_ignored(self):
        data = '# a comment\n\nNAME="X"\ngarbage\n'
        with fake_fs({'/etc/os-release': data}):
            self.assertEqual(distro._get_os_release_info(), {'name': 'X'})

    def test_missing_file_returns_empty(self):
        with fake_fs({}):
            self.assertEqual(distro._get_os_release_info(), {})


class TestGetLsbReleaseInfo(unittest.TestCase):
    """_get_lsb_release_info: lsb-release into a lowercased dict."""

    def test_parses_keys(self):
        with fake_fs({'/etc/lsb-release': LSB_RELEASE_UBUNTU}):
            values = distro._get_lsb_release_info()
        self.assertEqual(values['distrib_id'], 'Ubuntu')
        self.assertEqual(values['distrib_release'], '24.04')
        self.assertEqual(values['distrib_codename'], 'noble')

    def test_missing_file_returns_empty(self):
        with fake_fs({}):
            self.assertEqual(distro._get_lsb_release_info(), {})


class TestGetDistroReleaseInfo(unittest.TestCase):
    """_get_distro_release_info: name, version and release name from /etc."""

    def test_redhat_release_with_codename(self):
        with fake_fs({'/etc/redhat-release': REDHAT_RELEASE}):
            info = distro._get_distro_release_info()
        self.assertEqual(info['name'], 'Red Hat Enterprise Linux')
        self.assertEqual(info['version'], '9.7')
        self.assertEqual(info['codename'], 'Plow')

    def test_release_without_codename(self):
        with fake_fs({'/etc/oracle-release': ORACLE_RELEASE}):
            info = distro._get_distro_release_info()
        self.assertEqual(info['version'], '9.8')
        self.assertNotIn('codename', info)

    def test_multiword_codename(self):
        with fake_fs({'/etc/rocky-release': ROCKY_RELEASE}):
            self.assertEqual(distro._get_distro_release_info()['codename'], 'Blue Onyx')

    def test_candidates_are_sorted(self):
        # Oracle ships both. Sorting makes oracle-release win, which is what keeps
        # the Red Hat release name from leaking into an Oracle Linux fact set.
        files = {
            '/etc/oracle-release': ORACLE_RELEASE,
            '/etc/redhat-release': REDHAT_RELEASE_ON_ORACLE,
        }
        with fake_fs(files):
            info = distro._get_distro_release_info()
        self.assertEqual(info['name'], 'Oracle Linux Server')
        self.assertNotIn('codename', info)

    def test_ignored_basenames_are_skipped(self):
        # /etc/system-release repeats the product name in the parentheses and would
        # otherwise be reported as the release name of Amazon Linux.
        files = {
            '/etc/os-release': OS_RELEASE_AMAZON,
            '/etc/system-release': 'Amazon Linux release 2023.9.1 (Amazon Linux)\n',
        }
        with fake_fs(files):
            self.assertEqual(distro._get_distro_release_info(), {})

    def test_unparsable_file_is_skipped(self):
        # /etc/alpine-release holds a bare version and identifies nothing.
        with fake_fs({'/etc/alpine-release': ALPINE_RELEASE}):
            self.assertEqual(distro._get_distro_release_info(), {})

    def test_unreadable_etc_returns_empty(self):
        with mock.patch('lib.distro.os.listdir', side_effect=OSError('boom')):
            self.assertEqual(distro._get_distro_release_info(), {})


class TestGetBestVersion(unittest.TestCase):
    """_get_best_version: the two distributions whose os-release is too coarse."""

    def test_debian_gains_minor_version(self):
        with fake_fs({'/etc/debian_version': '12.14\n'}):
            self.assertEqual(distro._get_best_version('debian', '12', {}), '12.14')

    def test_debian_testing_keeps_os_release_version(self):
        with fake_fs({'/etc/debian_version': 'trixie/sid\n'}):
            self.assertEqual(distro._get_best_version('debian', '13', {}), '13')

    def test_centos_is_cut_to_two_components(self):
        info = {'version': '7.9.2009'}
        self.assertEqual(distro._get_best_version('centos', '7', info), '7.9')

    def test_other_distributions_are_untouched(self):
        self.assertEqual(distro._get_best_version('fedora', '41', {}), '41')


class TestGuessDistribution(unittest.TestCase):
    """_guess_distribution: the baseline facts before any release file is parsed."""

    def test_ubuntu(self):
        files = {
            '/etc/lsb-release': LSB_RELEASE_UBUNTU,
            '/etc/os-release': OS_RELEASE_UBUNTU,
        }
        with fake_fs(files):
            guess = distro._guess_distribution()
        self.assertEqual(guess['distribution'], 'Ubuntu')
        self.assertEqual(guess['distribution_version'], '24.04')
        self.assertEqual(guess['distribution_major_version'], '24')
        self.assertEqual(guess['distribution_release'], 'noble')

    def test_rhel_is_normalised_and_takes_codename_from_release_file(self):
        files = {
            '/etc/os-release': OS_RELEASE_RHEL,
            '/etc/redhat-release': REDHAT_RELEASE,
        }
        with fake_fs(files):
            guess = distro._guess_distribution()
        # 'Rhel' is normalised so that the OS family map has something to match.
        self.assertEqual(guess['distribution'], 'Redhat')
        self.assertEqual(guess['distribution_version'], '9.7')
        self.assertEqual(guess['distribution_release'], 'Plow')

    def test_amazon_is_normalised(self):
        with fake_fs({'/etc/os-release': OS_RELEASE_AMAZON}):
            self.assertEqual(distro._guess_distribution()['distribution'], 'Amazon')

    def test_empty_version_codename_survives(self):
        # Fedora sets VERSION_CODENAME to the empty string. That is an answer, so
        # the release name from /etc/fedora-release must not override it.
        files = {
            '/etc/fedora-release': FEDORA_RELEASE,
            '/etc/os-release': OS_RELEASE_FEDORA,
        }
        with fake_fs(files):
            self.assertEqual(distro._guess_distribution()['distribution_release'], '')

    def test_missing_codename_becomes_na(self):
        with fake_fs({'/etc/os-release': OS_RELEASE_ALPINE}):
            self.assertEqual(distro._guess_distribution()['distribution_release'], 'NA')

    def test_no_files_at_all(self):
        with fake_fs({}):
            guess = distro._guess_distribution()
        self.assertEqual(guess['distribution'], 'OtherLinux')
        self.assertEqual(guess['distribution_version'], 'NA')
        self.assertEqual(guess['distribution_major_version'], 'NA')
        self.assertEqual(guess['distribution_release'], 'NA')


class TestParseDistFile(unittest.TestCase):
    """_parse_dist_file: dispatch by variety name."""

    def test_search_string_match(self):
        ok, facts = distro._parse_dist_file(
            'RedHat', REDHAT_RELEASE, '/etc/redhat-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'RedHat')
        self.assertEqual(facts['distribution_file_search_string'], 'Red Hat')

    def test_search_string_miss_falls_back_to_first_word(self):
        ok, facts = distro._parse_dist_file(
            'RedHat', ROCKY_RELEASE, '/etc/redhat-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Rocky')
        self.assertNotIn('distribution_file_search_string', facts)

    def test_search_string_miss_on_blank_data(self):
        ok, facts = distro._parse_dist_file('RedHat', '"', '/etc/redhat-release', {})
        self.assertTrue(ok)
        self.assertNotIn('distribution', facts)

    def test_oraclelinux_search_string(self):
        ok, facts = distro._parse_dist_file(
            'OracleLinux', ORACLE_RELEASE, '/etc/oracle-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'OracleLinux')

    def test_os_release_alias_match(self):
        ok, facts = distro._parse_dist_file(
            'Archlinux', 'NAME="Arch Linux"', '/etc/os-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Archlinux')

    def test_os_release_alias_miss(self):
        ok, _facts = distro._parse_dist_file(
            'Archlinux', OS_RELEASE_UBUNTU, '/etc/os-release', {}
        )
        self.assertFalse(ok)

    def test_variety_without_parser_reports_no_match(self):
        # Gentoo has no parser, here or in Ansible. It is picked up by the generic
        # 'NA' entry at the end of OSDIST_LIST instead.
        ok, facts = distro._parse_dist_file(
            'Gentoo', GENTOO_RELEASE, '/etc/gentoo-release', {}
        )
        self.assertFalse(ok)
        self.assertEqual(facts, {})

    def test_quotes_are_stripped_before_parsing(self):
        ok, facts = distro._parse_dist_file(
            'RedHat', '"Red Hat ..."', '/etc/redhat-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'RedHat')

    def test_every_osdist_list_name_is_resolvable(self):
        # A name that is neither a marker, an alias, allowempty nor backed by a
        # parser can never match. Gentoo is the documented exception.
        allow_empty = {
            entry['name'] for entry in distro.OSDIST_LIST if entry.get('allowempty')
        }
        for entry in distro.OSDIST_LIST:
            name = entry['name']
            resolvable = (
                name in distro.SEARCH_STRING
                or name in distro.OS_RELEASE_ALIAS
                or name in distro._DIST_FILE_PARSERS
                or name in allow_empty
            )
            self.assertTrue(resolvable or name == 'Gentoo', name)


class TestParsers(unittest.TestCase):
    """The individual release file parsers."""

    def test_alpine(self):
        ok, facts = distro._parse_distribution_file_alpine(
            'Alpine', '3.21.7', '/etc/alpine-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Alpine')
        # The file holds nothing but the version, so there is no marker to look for.
        self.assertEqual(facts['distribution_version'], '3.21.7')

    def test_amazon_os_release(self):
        ok, facts = distro._parse_distribution_file_amazon(
            'Amazon', OS_RELEASE_AMAZON, '/etc/os-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Amazon')
        self.assertEqual(facts['distribution_version'], '2023')
        self.assertEqual(facts['distribution_major_version'], '2023')
        self.assertEqual(facts['distribution_minor_version'], 'NA')

    def test_amazon_two_part_version(self):
        data = 'NAME="Amazon Linux"\nVERSION_ID="2.0"\n'
        _ok, facts = distro._parse_distribution_file_amazon(
            'Amazon', data, '/etc/os-release', {}
        )
        self.assertEqual(facts['distribution_major_version'], '2')
        self.assertEqual(facts['distribution_minor_version'], '0')

    def test_amazon_three_part_version_does_not_raise(self):
        data = 'NAME="Amazon Linux"\nVERSION_ID="2.0.1"\n'
        _ok, facts = distro._parse_distribution_file_amazon(
            'Amazon', data, '/etc/os-release', {}
        )
        self.assertEqual(facts['distribution_major_version'], '2')
        self.assertEqual(facts['distribution_minor_version'], '0')

    def test_amazon_system_release(self):
        data = 'Amazon Linux release 2 (Karoo)'
        ok, facts = distro._parse_distribution_file_amazon(
            'Amazon', data, '/etc/system-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution_version'], '2')

    def test_amazon_rejects_foreign_content(self):
        ok, _facts = distro._parse_distribution_file_amazon(
            'Amazon', OS_RELEASE_UBUNTU, '/etc/os-release', {}
        )
        self.assertFalse(ok)

    def test_centos_stream(self):
        ok, facts = distro._parse_distribution_file_centos(
            'CentOS', CENTOS_STREAM_RELEASE, '/etc/centos-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution_release'], 'Stream')

    def test_centos_tencentos(self):
        ok, facts = distro._parse_distribution_file_centos(
            'CentOS', 'TencentOS Server 3.1', '/etc/centos-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'TencentOS')

    def test_centos_plain_reports_no_match(self):
        # Plain CentOS defers to /etc/redhat-release, which derives the name from
        # the file content.
        ok, _facts = distro._parse_distribution_file_centos(
            'CentOS', 'CentOS Linux release 7.9.2009 (Core)', '/etc/centos-release', {}
        )
        self.assertFalse(ok)

    def test_clearlinux(self):
        ok, facts = distro._parse_distribution_file_clearlinux(
            'ClearLinux', OS_RELEASE_CLEARLINUX, '/usr/lib/os-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Clear Linux OS')
        self.assertEqual(facts['distribution_version'], '41750')

    def test_clearlinux_rejects_foreign_content(self):
        ok, _facts = distro._parse_distribution_file_clearlinux(
            'ClearLinux', OS_RELEASE_UBUNTU, '/usr/lib/os-release', {}
        )
        self.assertFalse(ok)

    def test_coreos(self):
        collected = {'distribution': 'Coreos'}
        ok, facts = distro._parse_distribution_file_coreos(
            'Coreos', 'GROUP=stable', '/etc/coreos/update.conf', collected
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution_release'], 'stable')

    def test_coreos_rejects_other_distributions(self):
        ok, _facts = distro._parse_distribution_file_coreos(
            'Coreos', 'GROUP=stable', '/etc/coreos/update.conf', {'distribution': 'X'}
        )
        self.assertFalse(ok)

    def test_debian(self):
        with fake_fs({'/etc/debian_version': '12.14\n'}):
            ok, facts = distro._parse_distribution_file_debian(
                'Debian', OS_RELEASE_DEBIAN, '/etc/os-release', {}
            )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Debian')
        self.assertEqual(facts['distribution_release'], 'bookworm')
        self.assertEqual(facts['distribution_minor_version'], '14')

    def test_debian_ubuntu(self):
        ok, facts = distro._parse_distribution_file_debian(
            'Debian', OS_RELEASE_UBUNTU, '/etc/os-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Ubuntu')

    def test_debian_kali(self):
        data = 'NAME="Kali GNU/Linux"\nDISTRIB_RELEASE=2024.1\n'
        ok, facts = distro._parse_distribution_file_debian(
            'Debian', data, '/etc/os-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Kali')
        self.assertEqual(facts['distribution_release'], '2024.1')

    def test_debian_mint(self):
        data = 'NAME="Linux Mint"\nVERSION_ID="21.3"\n'
        ok, facts = distro._parse_distribution_file_debian(
            'Debian', data, '/etc/os-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Linux Mint')
        self.assertEqual(facts['distribution_major_version'], '21')

    def test_debian_devuan(self):
        data = 'PRETTY_NAME="Devuan GNU/Linux 5 (daedalus)"\nVERSION_ID="5"\n'
        ok, facts = distro._parse_distribution_file_debian(
            'Debian', data, '/etc/os-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Devuan')

    def test_debian_uos_defers_to_uniontech(self):
        # The RHEL based UOS Server carries a PLATFORM_ID and is not a Debian.
        data = 'NAME="UOS Server"\nPLATFORM_ID="platform:uel20"\n'
        ok, _facts = distro._parse_distribution_file_debian(
            'Debian', data, '/etc/os-release', {}
        )
        self.assertFalse(ok)

    def test_debian_cumulus_short_version_does_not_raise(self):
        data = 'NAME="Cumulus Linux"\nVERSION_ID=4.2\n'
        ok, facts = distro._parse_distribution_file_debian(
            'Debian', data, '/etc/os-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution_major_version'], '4')

    def test_debian_rejects_foreign_content(self):
        # This is the regression that used to classify every os-release based
        # distribution as Debian.
        for data in (OS_RELEASE_SUSE_LEAP, OS_RELEASE_ALPINE, OS_RELEASE_AMAZON):
            ok, _facts = distro._parse_distribution_file_debian(
                'Debian', data, '/etc/os-release', {}
            )
            self.assertFalse(ok, data.splitlines()[0])

    def test_flatcar(self):
        collected = {'distribution': 'Flatcar'}
        ok, facts = distro._parse_distribution_file_flatcar(
            'Flatcar', 'VERSION="3975.2.0"', '/etc/os-release', collected
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution_version'], '3975.2.0')
        self.assertEqual(facts['distribution_major_version'], '3975')

    def test_mandriva(self):
        data = 'DISTRIB_ID=Mandriva\nDISTRIB_RELEASE="2011"\n'
        ok, facts = distro._parse_distribution_file_mandriva(
            'Mandriva', data, '/etc/lsb-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Mandriva')
        self.assertEqual(facts['distribution_version'], '2011')

    def test_na(self):
        collected = {'distribution_version': 'NA'}
        ok, facts = distro._parse_distribution_file_na(
            'NA', OS_RELEASE_GENTOO, '/etc/os-release', collected
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Gentoo')
        self.assertEqual(facts['distribution_version'], '2.18')

    def test_na_keeps_a_version_that_was_already_found(self):
        collected = {'distribution_version': '2.18'}
        _ok, facts = distro._parse_distribution_file_na(
            'NA', OS_RELEASE_GENTOO, '/etc/os-release', collected
        )
        self.assertNotIn('distribution_version', facts)

    def test_openwrt(self):
        data = 'DISTRIB_ID="OpenWrt"\nDISTRIB_RELEASE="23.05.5"\n'
        ok, facts = distro._parse_distribution_file_openwrt(
            'OpenWrt', data, '/etc/openwrt_release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution_version'], '23.05.5')

    def test_slackware(self):
        ok, facts = distro._parse_distribution_file_slackware(
            'Slackware', 'Slackware 15.0', '/etc/slackware-version', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'Slackware')
        self.assertEqual(facts['distribution_version'], '15.0')

    def test_suse_leap(self):
        with fake_fs({}):
            ok, facts = distro._parse_distribution_file_suse(
                'SUSE', OS_RELEASE_SUSE_LEAP, '/etc/os-release', {}
            )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'openSUSE Leap')
        self.assertEqual(facts['distribution_version'], '16.0')
        self.assertEqual(facts['distribution_major_version'], '16')

    def test_suse_sles(self):
        with fake_fs({}):
            ok, facts = distro._parse_distribution_file_suse(
                'SUSE', OS_RELEASE_SLES, '/etc/os-release', {}
            )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'SLES')
        self.assertEqual(facts['distribution_version'], '15.7')
        # SLES has no release names, so the minor version stands in for one.
        self.assertEqual(facts['distribution_release'], '7')

    def test_suse_sles_non_numeric_version_id_does_not_raise(self):
        data = (
            'NAME="SLES"\n'
            'VERSION_ID="rolling"\n'
            'PRETTY_NAME="SUSE Linux Enterprise Server"\n'
        )
        with fake_fs({}):
            ok, facts = distro._parse_distribution_file_suse(
                'SUSE', data, '/etc/os-release', {}
            )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution_release'], '0')

    def test_suse_sap_via_variant_id(self):
        data = OS_RELEASE_SLES + 'VARIANT_ID="sles-sap"\n'
        with fake_fs({}):
            _ok, facts = distro._parse_distribution_file_suse(
                'SUSE', data, '/etc/os-release', {}
            )
        self.assertEqual(facts['distribution'], 'SLES_SAP')

    def test_suse_sap_via_baseproduct_link(self):
        with (
            fake_fs({}, links=('/etc/products.d/baseproduct',)),
            mock.patch(
                'lib.distro.os.path.realpath',
                return_value='/etc/products.d/SLES_SAP.prod',
            ),
        ):
            _ok, facts = distro._parse_distribution_file_suse(
                'SUSE', OS_RELEASE_SLES, '/etc/os-release', {}
            )
        self.assertEqual(facts['distribution'], 'SLES_SAP')

    def test_suse_rejects_foreign_content(self):
        ok, _facts = distro._parse_distribution_file_suse(
            'SUSE', OS_RELEASE_UBUNTU, '/etc/os-release', {}
        )
        self.assertFalse(ok)

    def test_uniontech_redhat_release_style(self):
        data = 'UnionTech OS Server release 20 (kongzi)'
        ok, facts = distro._parse_distribution_file_uniontech(
            'UnionTech', data, '/etc/redhat-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution'], 'UnionTech')
        self.assertEqual(facts['distribution_release'], 'kongzi')
        self.assertEqual(facts['distribution_version'], '20')

    def test_uniontech_os_release_style(self):
        data = 'PLATFORM_ID="platform:uel20"\nVERSION_ID="20"\n'
        ok, facts = distro._parse_distribution_file_uniontech(
            'UnionTech', data, '/etc/os-release', {}
        )
        self.assertTrue(ok)
        self.assertEqual(facts['distribution_version'], '20')

    def test_uniontech_rejects_foreign_content(self):
        ok, _facts = distro._parse_distribution_file_uniontech(
            'UnionTech', REDHAT_RELEASE, '/etc/redhat-release', {}
        )
        self.assertFalse(ok)


class TestMapOsFamily(unittest.TestCase):
    """_map_os_family: distribution -> os_family."""

    def test_redhat_family(self):
        for member in (
            'AlmaLinux',
            'Amazon',
            'CentOS',
            'Fedora',
            'OracleLinux',
            'RedHat',
            'Rocky',
            'UnionTech',
        ):
            self.assertEqual(distro._map_os_family(member), 'RedHat')

    def test_debian_family(self):
        for member in ('Debian', 'Kali', 'Linux Mint', 'Pop!_OS', 'Ubuntu', 'Uos'):
            self.assertEqual(distro._map_os_family(member), 'Debian')

    def test_suse_family(self):
        for member in (
            'SLED',
            'SLES',
            'SLES_SAP',
            'openSUSE Leap',
            'openSUSE Tumbleweed',
        ):
            self.assertEqual(distro._map_os_family(member), 'Suse')

    def test_other_families(self):
        self.assertEqual(distro._map_os_family('Alpine'), 'Alpine')
        self.assertEqual(distro._map_os_family('Manjaro'), 'Archlinux')
        self.assertEqual(distro._map_os_family('Funtoo'), 'Gentoo')
        self.assertEqual(distro._map_os_family('Clear Linux OS'), 'ClearLinux')

    def test_unknown_returns_input(self):
        self.assertEqual(distro._map_os_family('TotallyUnknown'), 'TotallyUnknown')

    def test_no_distribution_belongs_to_two_families(self):
        seen = set()
        for members in distro.OS_FAMILY_MAP.values():
            for member in members:
                self.assertNotIn(member, seen, member)
                seen.add(member)


class TestProcessDistFiles(unittest.TestCase):
    """_process_dist_files: end to end against simulated filesystems.

    Every case here was misclassified before the module was aligned with Ansible.
    """

    def _run(self, files, links=()):
        with fake_fs(files, links=links):
            return distro._process_dist_files()

    def test_rhel(self):
        facts = self._run(
            {'/etc/os-release': OS_RELEASE_RHEL, '/etc/redhat-release': REDHAT_RELEASE}
        )
        self.assertEqual(facts['distribution'], 'RedHat')
        self.assertEqual(facts['distribution_file_path'], '/etc/redhat-release')
        self.assertEqual(facts['distribution_version'], '9.7')
        self.assertEqual(facts['distribution_release'], 'Plow')
        self.assertTrue(facts['distribution_file_parsed'])

    def test_almalinux_name_comes_from_file_content(self):
        facts = self._run({'/etc/redhat-release': ALMA_RELEASE})
        self.assertEqual(facts['distribution'], 'AlmaLinux')
        self.assertEqual(facts['distribution_file_variety'], 'RedHat')

    def test_oracle_wins_over_redhat(self):
        # Oracle Linux ships a /etc/redhat-release naming Red Hat. Without the
        # ordering in OSDIST_LIST it would be reported as RedHat.
        facts = self._run(
            {
                '/etc/oracle-release': ORACLE_RELEASE,
                '/etc/redhat-release': REDHAT_RELEASE_ON_ORACLE,
                '/etc/system-release': ORACLE_RELEASE,
            }
        )
        self.assertEqual(facts['distribution'], 'OracleLinux')
        self.assertEqual(facts['distribution_file_path'], '/etc/oracle-release')

    def test_suse_leap(self):
        facts = self._run({'/etc/os-release': OS_RELEASE_SUSE_LEAP})
        self.assertEqual(facts['distribution'], 'openSUSE Leap')
        self.assertEqual(facts['distribution_file_variety'], 'SUSE')

    def test_sles(self):
        facts = self._run({'/etc/os-release': OS_RELEASE_SLES})
        self.assertEqual(facts['distribution'], 'SLES')
        self.assertEqual(facts['distribution_file_variety'], 'SUSE')

    def test_alpine_matches_its_own_release_file(self):
        facts = self._run(
            {
                '/etc/alpine-release': ALPINE_RELEASE,
                '/etc/os-release': OS_RELEASE_ALPINE,
            }
        )
        self.assertEqual(facts['distribution'], 'Alpine')
        self.assertEqual(facts['distribution_file_path'], '/etc/alpine-release')
        self.assertEqual(facts['distribution_version'], '3.21.7')

    def test_amazon(self):
        facts = self._run({'/etc/os-release': OS_RELEASE_AMAZON})
        self.assertEqual(facts['distribution'], 'Amazon')
        self.assertEqual(facts['distribution_file_variety'], 'Amazon')

    def test_ubuntu(self):
        facts = self._run(
            {
                '/etc/lsb-release': LSB_RELEASE_UBUNTU,
                '/etc/os-release': OS_RELEASE_UBUNTU,
            }
        )
        self.assertEqual(facts['distribution'], 'Ubuntu')
        self.assertEqual(facts['distribution_file_variety'], 'Debian')
        self.assertEqual(facts['distribution_release'], 'noble')

    def test_debian(self):
        facts = self._run(
            {
                '/etc/debian_version': '12.14\n',
                '/etc/os-release': OS_RELEASE_DEBIAN,
            }
        )
        self.assertEqual(facts['distribution'], 'Debian')
        self.assertEqual(facts['distribution_version'], '12.14')
        self.assertEqual(facts['distribution_minor_version'], '14')

    def test_centos_stream(self):
        facts = self._run(
            {
                '/etc/centos-release': CENTOS_STREAM_RELEASE,
                '/etc/redhat-release': CENTOS_STREAM_RELEASE,
            }
        )
        self.assertEqual(facts['distribution'], 'CentOS')
        self.assertEqual(facts['distribution_release'], 'Stream')

    def test_gentoo_falls_through_to_the_generic_entry(self):
        facts = self._run(
            {
                '/etc/gentoo-release': GENTOO_RELEASE,
                '/etc/os-release': OS_RELEASE_GENTOO,
            }
        )
        self.assertEqual(facts['distribution'], 'Gentoo')
        self.assertEqual(facts['distribution_file_variety'], 'NA')

    def test_archlinux_allowempty_short_circuits(self):
        facts = self._run({'/etc/arch-release': ''})
        self.assertEqual(facts['distribution'], 'Archlinux')
        self.assertEqual(facts['distribution_file_variety'], 'Archlinux')
        # The empty file is the marker, so nothing was parsed.
        self.assertNotIn('distribution_file_parsed', facts)

    def test_no_files_returns_the_guess(self):
        facts = self._run({})
        self.assertEqual(facts['distribution'], 'OtherLinux')
        self.assertNotIn('distribution_file_path', facts)

    def test_unreadable_file_is_skipped(self):
        def fake_access(path, _mode):
            return path != '/etc/redhat-release'

        files = {
            '/etc/os-release': OS_RELEASE_RHEL,
            '/etc/redhat-release': REDHAT_RELEASE,
        }
        with fake_fs(files), mock.patch('lib.distro.os.access', fake_access):
            facts = distro._process_dist_files()
        # redhat-release was skipped, so the generic entry took over.
        self.assertEqual(facts['distribution_file_variety'], 'NA')


class TestGetDistributionFacts(unittest.TestCase):
    """get_distribution_facts: the public entry point."""

    def _run(self, files, system='Linux'):
        with (
            fake_fs(files),
            mock.patch('lib.distro.platform.system', return_value=system),
        ):
            return distro.get_distribution_facts()

    def test_rhel(self):
        facts = self._run(
            {'/etc/os-release': OS_RELEASE_RHEL, '/etc/redhat-release': REDHAT_RELEASE}
        )
        self.assertEqual(facts['os_family'], 'RedHat')
        self.assertEqual(facts['os_info'], 'Red Hat Enterprise Linux 9.7 (Plow)')

    def test_os_family_of_the_families_plugins_branch_on(self):
        cases = (
            ({'/etc/os-release': OS_RELEASE_SUSE_LEAP}, 'Suse'),
            ({'/etc/os-release': OS_RELEASE_AMAZON}, 'RedHat'),
            ({'/etc/os-release': OS_RELEASE_UBUNTU}, 'Debian'),
            ({'/etc/arch-release': ''}, 'Archlinux'),
            (
                {
                    '/etc/alpine-release': ALPINE_RELEASE,
                    '/etc/os-release': OS_RELEASE_ALPINE,
                },
                'Alpine',
            ),
        )
        for files, expected in cases:
            self.assertEqual(self._run(files)['os_family'], expected, expected)

    def test_os_info_is_name_plus_version(self):
        facts = self._run({'/etc/os-release': OS_RELEASE_UBUNTU})
        self.assertEqual(facts['os_info'], 'Ubuntu 24.04.4 LTS (Noble Numbat)')

    def test_os_info_absent_without_os_release(self):
        facts = self._run({'/etc/redhat-release': REDHAT_RELEASE})
        self.assertNotIn('os_info', facts)

    def test_os_family_falls_back_to_the_distribution(self):
        facts = self._run({})
        self.assertEqual(facts['distribution'], 'OtherLinux')
        self.assertEqual(facts['os_family'], 'OtherLinux')

    def test_non_linux_skips_the_release_files(self):
        with (
            fake_fs({'/etc/os-release': OS_RELEASE_UBUNTU}),
            mock.patch('lib.distro.platform.system', return_value='Windows'),
            mock.patch('lib.distro.platform.release', return_value='10'),
            mock.patch('lib.distro.platform.version', return_value='10.0.19041'),
        ):
            facts = distro.get_distribution_facts()
        self.assertEqual(facts['distribution'], 'Windows')
        self.assertEqual(facts['os_family'], 'Windows')
        self.assertNotIn('distribution_file_path', facts)

    def test_returns_dict_type(self):
        self.assertIsInstance(self._run({}), dict)


if __name__ == '__main__':
    unittest.main()
