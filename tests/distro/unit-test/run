"""Unit tests for lib.distro.

The module reads host release files (/etc/os-release and friends). To stay hermetic
and host-independent, every filesystem touch is mocked through `fake_fs`, which maps
absolute paths to file content. Parser tests are driven by realistic sample release
file content taken from the distributions in question.

The end-to-end tests in TestProcessDistFiles double as regression tests: every one of
them used to be misclassified before the module was aligned with Ansible.
"""

import contextlib
import io
import os
import sys
import tempfile
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.distro as distro

# --- Realistic release file fixtures ---

