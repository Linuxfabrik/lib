"""Unit tests for lib.kvm.

Nothing here talks to libvirt. Everything that would run `virsh` is driven
through a mocked `lib.shell.shell_exec()`, and the parsers are fed the output a
hypervisor produced, so the whole file runs in a fraction of a second and needs
neither a hypervisor nor root.

All expected values were probed against the module first, then pinned. Notably:
`parse_volumes()` returns an empty list unless the header carries both a
capacity and an allocation column, and `group_by_store()` groups by capacity
first and only then by how far the free space drifted.
"""

import sys
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.kvm as kvm

DOMSTATS = """Domain: 'web01'
  state.state=1
  state.reason=1
  balloon.current=2097152
  balloon.maximum=2097152
  vcpu.current=2

Domain: 'db 01'
  state.state=5
  balloon.current=1048576
"""

POOL_INFO = """Name:           default
UUID:           abc-123
State:          running
Persistent:     yes
Autostart:      yes
Capacity:       100.00 GiB
Allocation:     20.00 GiB
Available:      80.00 GiB
"""

VOL_LIST = """ Name          Path                                  Capacity   Allocation
-------------------------------------------------------------------------
 web01.qcow2   /var/lib/libvirt/images/web01.qcow2   20.00 GiB  8.00 GiB
 db01.qcow2    /var/lib/libvirt/images/db01.qcow2    50.00 GiB  50.00 GiB
"""


def _virsh(stdout='', stderr='', retc=0, success=True):
    """Answer `shell.shell_exec()` the way virsh would have."""
    return mock.patch.object(
        kvm.shell, 'shell_exec', return_value=(success, (stdout, stderr, retc))
    )


class TestParseDomstats(unittest.TestCase):
    def test_reads_every_domain(self):
        self.assertEqual(sorted(kvm.parse_domstats(DOMSTATS)), ['db 01', 'web01'])

    def test_a_name_with_a_space_survives(self):
        # the name comes from the quoted `Domain: '<name>'` header
        self.assertIn('db 01', kvm.parse_domstats(DOMSTATS))

    def test_digits_become_int_everything_else_stays_text(self):
        stats = kvm.parse_domstats(DOMSTATS + '  block.0.name=vda\n')
        self.assertEqual(stats['db 01']['balloon.current'], 1048576)
        self.assertEqual(stats['db 01']['block.0.name'], 'vda')

    def test_empty_output(self):
        self.assertEqual(kvm.parse_domstats(''), {})


class TestParsePoolInfo(unittest.TestCase):
    def test_keys_are_lowercased(self):
        info = kvm.parse_pool_info(POOL_INFO)
        self.assertEqual(info['name'], 'default')
        self.assertEqual(info['state'], 'running')
        self.assertEqual(info['capacity'], '100.00 GiB')

    def test_empty_output(self):
        self.assertEqual(kvm.parse_pool_info(''), {})


class TestParseVolumes(unittest.TestCase):
    def test_reads_name_path_and_sizes(self):
        volumes = kvm.parse_volumes(VOL_LIST)
        self.assertEqual([v['name'] for v in volumes], ['web01.qcow2', 'db01.qcow2'])
        self.assertEqual(volumes[0]['capacity'], 21474836480)
        self.assertEqual(volumes[0]['allocation'], 8589934592)
        self.assertEqual(volumes[0]['path'], '/var/lib/libvirt/images/web01.qcow2')

    def test_without_the_size_columns_nothing_is_read(self):
        # `vol-list` without --details carries no capacity, and a consumer must not
        # mistake that for a pool without volumes carrying sizes
        plain = ' Name         Path\n------------------\n a.qcow2     /tmp/a.qcow2\n'
        self.assertEqual(kvm.parse_volumes(plain), [])

    def test_empty_output(self):
        self.assertEqual(kvm.parse_volumes(''), [])


class TestGroupByStore(unittest.TestCase):
    POOLS = (
        {'name': 'a', 'capacity': 1000, 'available': 400},
        {'name': 'b', 'capacity': 1000, 'available': 404},
        {'name': 'c', 'capacity': 1000, 'available': 900},
        {'name': 'd', 'capacity': 2000, 'available': 400},
    )

    def _names(self, drift=0.01):
        return [
            [entry['name'] for entry in group]
            for group in kvm.group_by_store(list(self.POOLS), drift=drift)
        ]

    def test_pools_of_one_filesystem_end_up_together(self):
        # 4 of 1000 bytes is 0.4%, within the default drift
        self.assertIn(['a', 'b'], self._names())

    def test_the_same_size_but_a_different_fill_stays_apart(self):
        self.assertIn(['c'], self._names())

    def test_a_different_capacity_stays_apart(self):
        self.assertIn(['d'], self._names())

    def test_every_entry_appears_exactly_once(self):
        groups = self._names()
        self.assertEqual(sum(len(g) for g in groups), len(self.POOLS))

    def test_a_wider_drift_merges_more(self):
        self.assertIn(['a', 'b', 'c'], self._names(drift=0.6))

    def test_empty_input(self):
        self.assertEqual(kvm.group_by_store([]), [])


class TestVirsh(unittest.TestCase):
    def test_connects_read_only_to_the_uri(self):
        with (
            mock.patch.object(kvm.shell, 'which', return_value='/usr/bin/virsh'),
            _virsh(stdout='ok') as exec_mock,
        ):
            success, stdout = kvm.virsh(['list', '--all'], uri='qemu:///system')
        self.assertTrue(success)
        self.assertEqual(stdout, 'ok')
        argv = exec_mock.call_args[0][0]
        self.assertEqual(argv[:3], ['virsh', '--readonly', '--connect=qemu:///system'])
        self.assertEqual(argv[3:], ['list', '--all'])

    def test_without_virsh_it_names_the_package(self):
        with mock.patch.object(kvm.shell, 'which', return_value=None):
            success, message = kvm.virsh(['list'])
        self.assertFalse(success)
        self.assertIn('libvirt-client', message)

    def test_a_non_zero_return_code_is_explained(self):
        with (
            mock.patch.object(kvm.shell, 'which', return_value='/usr/bin/virsh'),
            _virsh(stderr='error: failed to connect to the hypervisor', retc=1),
        ):
            success, message = kvm.virsh(['list'])
        self.assertFalse(success)
        self.assertNotEqual(message, '')

    def test_a_failed_call_is_passed_on(self):
        with (
            mock.patch.object(kvm.shell, 'which', return_value='/usr/bin/virsh'),
            mock.patch.object(
                kvm.shell, 'shell_exec', return_value=(False, 'timed out')
            ),
        ):
            self.assertEqual(kvm.virsh(['list']), (False, 'timed out'))


class TestVirshUriGuard(unittest.TestCase):
    """A caller-chosen URI must not make libvirt run a program or open a path.

    Probed against libvirt 12.0.0: `?command=` replaces the `ssh` of the ssh
    transport and is the program of the `ext` transport, `argv` is its argument,
    and a query name is matched case-insensitively after percent-decoding, with
    `&` and `;` as separators.
    """

    def _refused(self, uri):
        with (
            mock.patch.object(kvm.shell, 'which', return_value='/usr/bin/virsh'),
            _virsh(stdout='ok') as exec_mock,
        ):
            success, message = kvm.virsh(['list'], uri=uri)
        self.assertFalse(success, uri)
        self.assertIn('URI', message)
        exec_mock.assert_not_called()

    def _accepted(self, uri):
        with (
            mock.patch.object(kvm.shell, 'which', return_value='/usr/bin/virsh'),
            _virsh(stdout='ok') as exec_mock,
        ):
            success, _ = kvm.virsh(['list'], uri=uri)
        self.assertTrue(success, uri)
        self.assertEqual(exec_mock.call_args[0][0][2], f'--connect={uri}')

    def test_ext_transport_is_refused(self):
        self._refused('qemu+ext:///system?command=/usr/bin/touch&argv=/x')
        self._refused('qemu+EXT:///system')

    def test_command_replaces_ssh_is_refused(self):
        self._refused('qemu+ssh://host/system?command=/usr/bin/touch')

    def test_query_name_is_matched_like_libvirt(self):
        self._refused('qemu+ssh://host/system?COMMAND=/usr/bin/touch')
        self._refused('qemu+ssh://host/system?%63ommand=/usr/bin/touch')
        self._refused('qemu+ssh://host/system?no_tty=1;command=/usr/bin/touch')
        self._refused('qemu+ssh://host/system?no_tty=1&command=/usr/bin/touch')

    def test_other_program_and_path_parameters_are_refused(self):
        for name in ('argv', 'name', 'netcat'):
            self._refused(f'qemu+ssh://host/system?{name}=/x')

    def test_socket_is_refused_beside_every_transport(self):
        # also the local one: a root caller would parse what a planted socket answers
        for transport in ('ssh', 'libssh', 'libssh2', 'tcp', 'tls', 'unix'):
            self._refused(f'qemu+{transport}://host/system?socket=/x')
        self._refused(
            'qemu+unix:///system?socket=/opt/libvirt/run/libvirt/libvirt-sock'
        )
        self._refused('qemu:///system?socket=/run/libvirt/libvirt-sock')

    def test_parameters_that_make_libvirt_open_a_file_are_refused(self):
        for name in ('authfile', 'keyfile', 'known_hosts', 'pkipath', 'tls_priority'):
            self._refused(f'qemu+ssh://host/system?{name}=/etc/libvirt/{name}')

    def test_an_alias_is_refused(self):
        for alias in ('default', 'qemu', 'prod'):
            self._refused(alias)

    def test_a_trailing_slash_is_refused_like_libvirt_does(self):
        # probed: "unexpected qemu URI path '/system/', try qemu:///system"
        self._refused('qemu:///system/')

    def test_unknown_parameter_is_refused(self):
        self._refused('qemu+ssh://host/system?whatever=1')

    def test_path_that_selects_a_directory_is_refused(self):
        self._refused('qemu:///embed?root=/tmp/x')
        self._refused('qemu:///../../tmp/x')

    def test_driver_that_reads_a_file_is_refused(self):
        self._refused('test:///etc/shadow')

    def test_malformed_uri_is_refused(self):
        for uri in (
            '',
            None,
            5,
            '--connect=x',
            'qemu:///system ?x',
            'qemu:///a\nb',
            'qemu:///system\n',
            'qemu+ssh://-oProxyCommand=x/system',
            'qemu:///system#a',
        ):
            self._refused(uri)

    def test_percent_encoded_dash_in_user_or_host_is_refused(self):
        self._refused('qemu+ssh://%2doProxyCommand=x@/system')
        self._refused('qemu+ssh://user@%2dhost/system')

    def test_a_refusal_does_not_show_the_password(self):
        for uri in (
            'qemu+ssh://user:linuxfabrik@host/system?command=x',
            'qemu+ext://user:linuxfabrik@host/system',
            'qemu+ssh://user:linuxfabrik@host/etc',
        ):
            with (
                mock.patch.object(kvm.shell, 'which', return_value='/usr/bin/virsh'),
                _virsh(),
            ):
                success, message = kvm.virsh(['list'], uri=uri)
            self.assertFalse(success)
            self.assertNotIn('linuxfabrik', message)
            self.assertIn('user:******@host', message)

    def test_a_failed_connection_does_not_show_the_password(self):
        uri = 'qemu+ssh://user:linuxfabrik@host/system'
        stderr = f'error: failed to connect to the hypervisor\nerror: {uri}: refused'
        with (
            mock.patch.object(kvm.shell, 'which', return_value='/usr/bin/virsh'),
            _virsh(stderr=stderr, retc=1),
        ):
            success, message = kvm.virsh(['list'], uri=uri)
        self.assertFalse(success)
        self.assertNotIn('linuxfabrik', message)

    def test_the_usual_uris_pass(self):
        for uri in (
            'qemu:///system',
            'qemu:///session',
            'qemu+ssh://root@host.example/system',
            'qemu+ssh://host.example/system?no_tty=1&known_hosts_verify=ignore',
            'qemu+tls://host.example/system?no_verify=1',
            'qemu+tcp://192.0.2.1:16509/system',
            'qemu+libssh2://user@host/system?known_hosts_verify=ignore',
            'xen+ssh://user@host/system',
            'qemu+unix:///system',
            'lxc:///',
            'xen:///',
        ):
            self._accepted(uri)


class TestReaders(unittest.TestCase):
    """The functions that put a virsh call and a parser together."""

    def _with_virsh(self, answer):
        return mock.patch.object(kvm, 'virsh', return_value=answer)

    def test_get_domstats_parses_what_virsh_answered(self):
        with self._with_virsh((True, DOMSTATS)) as virsh_mock:
            success, domains = kvm.get_domstats(groups=['balloon', 'state'])
        self.assertTrue(success)
        self.assertEqual(domains['web01']['state.state'], 1)
        args = virsh_mock.call_args[0][0]
        self.assertEqual(args[0], 'domstats')
        self.assertIn('--balloon', args)
        self.assertIn('--state', args)

    def test_get_domstats_passes_a_failure_on(self):
        with self._with_virsh((False, 'no hypervisor')):
            self.assertEqual(kvm.get_domstats(), (False, 'no hypervisor'))

    def test_get_pool_info_parses_what_virsh_answered(self):
        with self._with_virsh((True, POOL_INFO)):
            success, info = kvm.get_pool_info('default')
        self.assertTrue(success)
        self.assertEqual(info['state'], 'running')

    def test_get_volumes_parses_what_virsh_answered(self):
        with self._with_virsh((True, VOL_LIST)):
            success, volumes = kvm.get_volumes('default')
        self.assertTrue(success)
        self.assertEqual(len(volumes), 2)

    def test_get_pools_lists_the_names(self):
        with self._with_virsh((True, ' default\n images\n')):
            success, pools = kvm.get_pools()
        self.assertTrue(success)
        self.assertEqual(pools, ['default', 'images'])

    def test_get_domains_lists_the_names(self):
        with self._with_virsh((True, 'web01\ndb01\n')):
            success, domains = kvm.get_domains()
        self.assertTrue(success)
        self.assertEqual(domains, ['web01', 'db01'])

    def test_get_pool_xml_hands_the_document_over(self):
        with self._with_virsh((True, '<pool type="dir"/>')):
            success, xml = kvm.get_pool_xml('default')
        self.assertTrue(success)
        self.assertIn('<pool', xml)


class TestStateTables(unittest.TestCase):
    def test_domain_states_name_every_libvirt_state(self):
        self.assertEqual(kvm.DOMAIN_STATES[1], 'running')
        self.assertEqual(kvm.DOMAIN_STATES[5], 'shut off')

    def test_a_reason_is_named_per_state(self):
        self.assertIn(5, kvm.DOMAIN_STATE_REASONS)


if __name__ == '__main__':
    unittest.main()
