"""Unit tests for lib.container.

Where each sample comes from is stated at the sample. The Podman one was taken
from podman 5.8.4 on Fedora 44, pointed at a socket that is not there. The Docker
ones are the strings the consumers have been reading for years, which is what the
behaviour under test was built around; this host runs podman-docker rather than
Docker, so they could not be taken again here.
"""

import contextlib
import sys
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.container as container
from lib.globals import STATE_CRIT, STATE_OK, STATE_UNKNOWN, STATE_WARN

# What the Docker client writes for a caller that is not in the group owning the
# socket. The words that matter are the kernel's, at the end of the line.
PERMISSION_DENIED = (
    'permission denied while trying to connect to the Docker daemon socket at '
    'unix:///var/run/docker.sock: Get "http://%2Fvar%2Frun%2Fdocker.sock/v1.51/'
    'containers/json": dial unix /var/run/docker.sock: connect: permission denied'
)

# What the Docker client writes where the engine is not running.
ENGINE_DOWN = (
    'Cannot connect to the Docker daemon at unix:///var/run/docker.sock. '
    'Is the docker daemon running?'
)

# What podman 5.8.4 on Fedora 44 writes for the same situation, captured by pointing
# it at a socket that does not exist. It says the same thing in different words and
# behind a prefix of its own, which is why nothing here matches on the wording of an
# outage: only the refused permission is recognized, everything else is passed on.
PODMAN_ENGINE_DOWN = (
    'Cannot connect to Podman. Please verify your connection to the Linux system '
    'using `podman system connection list`, or try `podman machine init` and '
    '`podman machine start` to manage a new Linux VM\n'
    'Error: unable to connect to Podman socket: Get '
    '"http://d/v5.8.4/libpod/_ping": dial unix /nonexistent/podman.sock: connect: '
    'no such file or directory: unix:///nonexistent/podman.sock'
)

# What a swarm manager that lost its quorum answers, behind both prefixes.
NO_LEADER = (
    'Error response from daemon: rpc error: code = Unknown desc = The swarm does '
    'not have a leader. It is possible that too few managers are online. Make sure '
    'more than half of the managers are online.'
)


class TestStripDaemonError(unittest.TestCase):
    def test_drops_both_prefixes(self):
        self.assertEqual(
            container.strip_daemon_error(NO_LEADER),
            'The swarm does not have a leader. It is possible that too few managers '
            'are online. Make sure more than half of the managers are online.',
        )

    def test_drops_the_daemon_prefix_alone(self):
        self.assertEqual(
            container.strip_daemon_error(
                'Error response from daemon: This node is not a swarm manager.'
            ),
            'This node is not a swarm manager.',
        )

    def test_drops_the_rpc_prefix_alone(self):
        self.assertEqual(
            container.strip_daemon_error('rpc error: code = 5 desc = node not found'),
            'node not found',
        )

    def test_leaves_a_message_without_a_prefix_alone(self):
        self.assertEqual(container.strip_daemon_error(ENGINE_DOWN), ENGINE_DOWN)

    def test_collapses_a_wrapped_message_onto_one_line(self):
        self.assertEqual(
            container.strip_daemon_error('one\n  two\t three '),
            'one two three',
        )

    def test_only_the_first_prefix_goes(self):
        # A client that failed on several items prints one answer per item. Dropping
        # every occurrence would glue two sentences together without a separator.
        self.assertEqual(
            container.strip_daemon_error(
                'Error response from daemon: a Error response from daemon: b'
            ),
            'a Error response from daemon: b',
        )

    def test_a_prefix_in_the_middle_stays(self):
        self.assertEqual(
            container.strip_daemon_error('x Error response from daemon: y'),
            'x y',
        )

    def test_a_prefix_with_nothing_behind_it_stays_readable(self):
        # The trailing space goes with the whitespace normalisation, so the prefix no
        # longer matches and is reported as the whole message. There is nothing else
        # to report in that case, and the caller sees that the client said nothing.
        self.assertEqual(
            container.strip_daemon_error('Error response from daemon: '),
            'Error response from daemon:',
        )

    def test_an_empty_message_stays_empty(self):
        self.assertEqual(container.strip_daemon_error(''), '')

    def test_whitespace_only_is_empty(self):
        self.assertEqual(container.strip_daemon_error('   \n\t '), '')

    def test_none_is_empty_rather_than_the_word(self):
        # A caller passing on a result it does not have must not print "None" as if
        # the client had written it.
        self.assertEqual(container.strip_daemon_error(None), '')

    def test_bytes_are_decoded_rather_than_shown_as_a_repr(self):
        self.assertEqual(
            container.strip_daemon_error(b'Error response from daemon: gone'),
            'gone',
        )

    def test_bytes_that_are_not_utf8_are_still_read(self):
        self.assertEqual(
            container.strip_daemon_error(b'caf\xe9 not found'),
            'café not found',
        )

    def test_a_number_is_rendered_rather_than_raising(self):
        self.assertEqual(container.strip_daemon_error(42), '42')

    def test_a_long_message_is_passed_through_whole(self):
        message = 'x' * 100000
        self.assertEqual(container.strip_daemon_error(message), message)


class TestStripTaskId(unittest.TestCase):
    def test_a_swarm_task_name_loses_its_id(self):
        self.assertEqual(
            container.strip_task_id('traefik_traefik.2.1idw12p2yqpxutlzkcwign4at'),
            'traefik_traefik.2',
        )

    def test_a_plain_name_with_a_dot_in_it_is_left_alone(self):
        self.assertEqual(container.strip_task_id('backup.daily'), 'backup.daily')

    def test_an_id_that_is_too_short_is_not_one(self):
        name = 'a.1idw12p2yqpxutlzkcwign4a'
        self.assertEqual(container.strip_task_id(name), name)

    def test_an_id_that_is_too_long_is_not_one(self):
        name = 'a.1idw12p2yqpxutlzkcwign4att'
        self.assertEqual(container.strip_task_id(name), name)

    def test_the_id_is_lowercase_only(self):
        # The engine writes it in base 36 lowercase. Matching uppercase too would eat
        # the tail of a name somebody chose themselves.
        name = 'x.1IDW12P2YQPXUTLZKCWIGN4AT'
        self.assertEqual(container.strip_task_id(name), name)

    def test_an_empty_name_stays_empty(self):
        self.assertEqual(container.strip_task_id(''), '')

    def test_none_is_empty_rather_than_the_word(self):
        self.assertEqual(container.strip_task_id(None), '')

    def test_bytes_are_decoded_first(self):
        self.assertEqual(container.strip_task_id(b'x.1idw12p2yqpxutlzkcwign4at'), 'x')


class TestGetEngineError(unittest.TestCase):
    def test_a_refused_permission_is_unknown(self):
        message, state = container.get_engine_error(PERMISSION_DENIED)
        self.assertEqual(state, STATE_UNKNOWN)
        self.assertIn('No permission to talk to the container engine', message)
        # The original answer stays in the message: the socket path in it is what
        # says which engine was asked.
        self.assertIn('/var/run/docker.sock', message)

    def test_a_refused_permission_ignores_the_fallback_state(self):
        _, state = container.get_engine_error(
            PERMISSION_DENIED, fallback_state=STATE_OK
        )
        self.assertEqual(state, STATE_UNKNOWN)

    def test_an_engine_that_is_down_is_critical(self):
        message, state = container.get_engine_error(ENGINE_DOWN)
        self.assertEqual(state, STATE_CRIT)
        self.assertEqual(message, ENGINE_DOWN)

    def test_podman_says_the_same_thing_in_its_own_words(self):
        message, state = container.get_engine_error(PODMAN_ENGINE_DOWN)
        self.assertEqual(state, STATE_CRIT)
        self.assertIn('unable to connect to Podman socket', message)

    def test_the_fallback_state_is_the_callers_choice(self):
        for fallback in (STATE_OK, STATE_WARN, STATE_CRIT, STATE_UNKNOWN):
            with self.subTest(fallback=fallback):
                _, state = container.get_engine_error(
                    ENGINE_DOWN, fallback_state=fallback
                )
                self.assertEqual(state, fallback)

    def test_a_reason_on_stdout_is_read_too(self):
        message, state = container.get_engine_error('', PERMISSION_DENIED)
        self.assertEqual(state, STATE_UNKNOWN)
        self.assertIn('No permission to talk to the container engine', message)

    def test_both_streams_end_up_in_the_message(self):
        message, _ = container.get_engine_error('first', 'second')
        self.assertEqual(message, 'first\nsecond')

    def test_the_match_is_case_insensitive(self):
        _, state = container.get_engine_error('Permission Denied')
        self.assertEqual(state, STATE_UNKNOWN)

    def test_a_client_that_said_nothing_still_reports(self):
        message, state = container.get_engine_error('', '')
        self.assertEqual(message, '')
        self.assertEqual(state, STATE_CRIT)

    def test_none_on_both_streams_is_empty_rather_than_the_word(self):
        message, state = container.get_engine_error(None, None)
        self.assertEqual(message, '')
        self.assertEqual(state, STATE_CRIT)

    def test_bytes_are_decoded_rather_than_shown_as_a_repr(self):
        message, state = container.get_engine_error(b'permission denied')
        self.assertEqual(state, STATE_UNKNOWN)
        self.assertTrue(message.endswith('permission denied'))
        self.assertNotIn("b'", message)

    def test_bytes_that_are_not_utf8_are_still_read(self):
        message, _ = container.get_engine_error(b'caf\xe9 not found')
        self.assertEqual(message, 'café not found')

    def test_the_message_is_not_stripped_of_its_prefixes(self):
        # Stripping is a decision of the caller: a consumer that wants the bare
        # sentence calls strip_daemon_error() on the way in.
        message, _ = container.get_engine_error(NO_LEADER)
        self.assertTrue(message.startswith('Error response from daemon:'))


class TestRun(unittest.TestCase):
    """run(): one time budget for all engine commands of a run."""

    def _run(self, answer, now=(100.0, 100.0), **kwargs):
        clock = iter(now)
        # ExitStack rather than a parenthesized `with`, which Python 3.9 cannot parse
        with contextlib.ExitStack() as stack:
            stack.enter_context(
                mock.patch.object(
                    container.time, 'now', side_effect=lambda **_: next(clock)
                )
            )
            m = stack.enter_context(
                mock.patch.object(container.shell, 'shell_exec', return_value=answer)
            )
            result = container.run(**kwargs)
        return result, m

    def test_hands_back_what_the_client_printed(self):
        result, m = self._run(
            (True, ('{}', '', 0)), cmd=['podman', 'info'], timeout=8, started=100.0
        )
        self.assertEqual(result, (True, ('{}', '', 0)))
        self.assertEqual(m.call_args.args[0], ['podman', 'info'])

    def test_a_non_zero_exit_code_is_not_judged(self):
        answer = (True, ('', 'Cannot connect to the Docker daemon', 1))
        result, _ = self._run(answer, cmd=['docker', 'ps'], timeout=8, started=100.0)
        self.assertEqual(result, answer)

    def test_the_command_gets_what_is_left_of_the_budget(self):
        _, m = self._run(
            (True, ('', '', 0)),
            now=(103.0,),
            cmd=['docker', 'ps'],
            timeout=8,
            started=100.0,
        )
        self.assertAlmostEqual(m.call_args.kwargs['timeout'], 5.0)

    def test_started_defaults_to_now(self):
        _, m = self._run((True, ('', '', 0)), now=(50.0, 50.0), cmd=['x'], timeout=8)
        self.assertAlmostEqual(m.call_args.kwargs['timeout'], 8.0)

    def test_a_spent_budget_does_not_start_the_client(self):
        result, m = self._run(
            (True, ('', '', 0)),
            now=(108.0,),
            cmd=['docker', 'stats', '--no-stream'],
            timeout=8,
            started=100.0,
        )
        m.assert_not_called()
        self.assertEqual(
            result,
            (
                False,
                (
                    'Timeout after 8s while running `docker stats --no-stream`.',
                    STATE_WARN,
                ),
            ),
        )

    def test_a_client_that_times_out_is_a_warning(self):
        result, _ = self._run(
            (False, 'Timeout after 7.5 seconds.'),
            cmd=['podman', 'ps'],
            timeout=8,
            started=100.0,
            run_as='rocketchat',
        )
        # the message names the configured budget and the user the client ran as
        self.assertEqual(
            result,
            (
                False,
                (
                    'Timeout after 8s while running `podman ps` (user: `rocketchat`).',
                    STATE_WARN,
                ),
            ),
        )

    def test_a_long_command_is_quoted_in_part(self):
        ids = [f'sha256:{i:064x}' for i in range(500)]
        result, _ = self._run(
            (False, 'Timeout after 7.5 seconds.'),
            cmd=['podman', 'image', 'inspect', *ids],
            timeout=8,
            started=100.0,
        )
        message = result[1][0]
        self.assertTrue(
            message.startswith(
                f'Timeout after 8s while running `podman image inspect {ids[0]} ... (499 more)`'
            )
        )
        self.assertLess(len(message), 200)

    def test_a_short_command_keeps_every_argument(self):
        cmd = ['docker', 'service', 'ps', '--no-trunc', '--format', '{{json .}}', 'web']
        result, _ = self._run(
            (False, 'Timeout after 7.5 seconds.'), cmd=cmd, timeout=8, started=100.0
        )
        self.assertIn(f'`{" ".join(cmd)}`', result[1][0])

    def test_a_fractional_timeout_is_accepted(self):
        result, m = self._run(
            (False, 'Timeout after 2.5 seconds.'),
            now=(100.0,),
            cmd=['docker', 'ps'],
            timeout=2.5,
            started=100.0,
        )
        self.assertAlmostEqual(m.call_args.kwargs['timeout'], 2.5)
        self.assertEqual(
            result[1], ('Timeout after 2.5s while running `docker ps`.', STATE_WARN)
        )

    def test_an_unusable_start_is_unknown_without_starting_anything(self):
        for started in ('100', float('nan'), float('inf'), True, [100]):
            with self.subTest(started=started):
                result, m = self._run(
                    (True, ('', '', 0)), cmd=['docker'], timeout=8, started=started
                )
                m.assert_not_called()
                self.assertEqual(result[1][1], STATE_UNKNOWN)

    def test_arguments_given_as_bytes_are_quoted_as_text(self):
        result, _ = self._run(
            (False, 'Timeout after 7.5 seconds.'),
            cmd=[b'podman', b'caf\xe9'],
            timeout=8,
            started=100.0,
        )
        self.assertIn('`podman café`', result[1][0])

    def test_a_first_argument_beyond_the_limit_is_quoted_whole(self):
        # the executable is always named, even where it alone exceeds the limit
        executable = '/opt/' + 'x' * 150 + '/podman'
        result, _ = self._run(
            (False, 'Timeout after 7.5 seconds.'),
            cmd=[executable, 'ps'],
            timeout=8,
            started=100.0,
        )
        self.assertIn(f'`{executable} ... (1 more)`', result[1][0])

    def test_run_as_is_passed_on(self):
        _, m = self._run(
            (True, ('', '', 0)), cmd=['podman'], timeout=8, started=100.0, run_as='u'
        )
        self.assertEqual(m.call_args.kwargs['run_as'], 'u')

    def test_a_client_that_cannot_be_started_is_unknown(self):
        result, _ = self._run(
            (False, "[Errno 2] No such file or directory: 'docker'"),
            cmd=['docker', 'ps'],
            timeout=8,
            started=100.0,
        )
        self.assertEqual(
            result,
            (False, ("[Errno 2] No such file or directory: 'docker'", STATE_UNKNOWN)),
        )

    def test_a_tuple_command_is_accepted(self):
        _, m = self._run((True, ('', '', 0)), cmd=('docker', 'ps'), timeout=8)
        self.assertEqual(m.call_args.args[0], ['docker', 'ps'])

    def test_unusable_arguments_are_unknown_without_starting_anything(self):
        for cmd, timeout in (
            ('docker ps', 8),
            ([], 8),
            (None, 8),
            (['docker'], 0),
            (['docker'], -1),
            (['docker'], '8'),
            (['docker'], True),
            (['docker'], None),
            (['docker'], float('nan')),
            (['docker'], float('inf')),
        ):
            with self.subTest(cmd=cmd, timeout=timeout):
                result, m = self._run((True, ('', '', 0)), cmd=cmd, timeout=timeout)
                m.assert_not_called()
                self.assertFalse(result[0])
                self.assertEqual(result[1][1], STATE_UNKNOWN)


if __name__ == '__main__':
    unittest.main()
