"""Unit tests for lib.txt. Pure functions, no fixtures or containers."""

import sys
import unittest

sys.path.insert(0, '..')

import lib.txt as txt


class TestCompileRegex(unittest.TestCase):
    def test_single_pattern(self):
        ok, pattern = txt.compile_regex(r'^[a-z]+$')
        self.assertTrue(ok)
        self.assertIsNotNone(pattern.match('abc'))
        self.assertIsNone(pattern.match('ABC'))

    def test_list_of_patterns(self):
        result = txt.compile_regex([r'^[a-z]+$', r'\d+'])
        self.assertEqual(len(result), 2)
        self.assertTrue(all(ok for ok, _ in result))

    def test_invalid_pattern_returns_error(self):
        ok, msg = txt.compile_regex(r'[')
        self.assertFalse(ok)
        self.assertIn('errors', msg)


class TestExceptionToText(unittest.TestCase):
    def test_formats_type_and_message(self):
        self.assertEqual(txt.exception2text(ValueError('boom')), 'ValueError: boom')


class TestExtractStr(unittest.TestCase):
    def test_marker_not_found_is_empty(self):
        self.assertEqual(txt.extract_str('abcde', 'x', 'y'), '')

    def test_from_to_excluded_by_default(self):
        self.assertEqual(txt.extract_str('abcde', 'b', 'x'), 'cde')
        self.assertEqual(txt.extract_str('abcde', 'b', 'd'), 'c')

    def test_include_fromto(self):
        self.assertEqual(
            txt.extract_str('abcde', 'b', 'x', include_fromto=True), 'bcde'
        )
        self.assertEqual(txt.extract_str('abcde', 'b', 'd', include_fromto=True), 'bcd')

    def test_be_tolerant_combinations(self):
        # to-marker missing: tolerant returns the rest, non-tolerant returns ''.
        self.assertEqual(txt.extract_str('abcde', 'b', 'x', be_tolerant=True), 'cde')
        self.assertEqual(txt.extract_str('abcde', 'b', 'x', be_tolerant=False), '')


class TestFilterMltext(unittest.TestCase):
    def setUp(self):
        self.s = 'Lorem ipsum\n\ndolor sit amet\n\nconsectetur adipisicing'

    def test_drops_paragraphs_matching_any_pattern(self):
        self.assertEqual(
            txt.filter_mltext(self.s, ['ipsum']),
            '\ndolor sit amet\n\nconsectetur adipisicing\n',
        )

    def test_substring_match(self):
        self.assertEqual(txt.filter_mltext(self.s, ['d']), 'Lorem ipsum\n\n\n')


class TestMatchRegex(unittest.TestCase):
    def test_match(self):
        ok, m = txt.match_regex(r'^abc$', 'abc')
        self.assertTrue(ok)
        self.assertIsNotNone(m)

    def test_no_match_is_none(self):
        ok, m = txt.match_regex(r'^abc$', 'xyz')
        self.assertTrue(ok)
        self.assertIsNone(m)

    def test_invalid_pattern(self):
        ok, msg = txt.match_regex(r'[', 'text', key='ex')
        self.assertFalse(ok)
        self.assertIn('ex', msg)


class TestMltext2Array(unittest.TestCase):
    def test_sorts_by_column(self):
        s = '1662130953 timedatex\n1662130757 python3-pip-wheel\n1662130975 python3-dateutil'
        self.assertEqual(
            txt.mltext2array(s, sort_key=0),
            [
                ['1662130757', 'python3-pip-wheel'],
                ['1662130953', 'timedatex'],
                ['1662130975', 'python3-dateutil'],
            ],
        )

    def test_skip_header_with_sort_key(self):
        self.assertEqual(
            txt.mltext2array('h1 h2\n3 b\n1 a', skip_header=True, sort_key=1),
            [['1', 'a'], ['3', 'b']],
        )


class TestMultiReplace(unittest.TestCase):
    def test_applies_all_replacements(self):
        self.assertEqual(
            txt.multi_replace('Hello World!', {'Hello': 'Hi', 'World': 'Universe'}),
            'Hi Universe!',
        )

    def test_empty_map_returns_input(self):
        self.assertEqual(txt.multi_replace('abc', {}), 'abc')


class TestPluralize(unittest.TestCase):
    def test_default_suffix(self):
        self.assertEqual(txt.pluralize('vote', 0), 'votes')
        self.assertEqual(txt.pluralize('vote', 1), 'vote')
        self.assertEqual(txt.pluralize('vote', 2), 'votes')

    def test_custom_suffix(self):
        self.assertEqual(txt.pluralize('class', 2, 'es'), 'classes')

    def test_singular_plural_pair(self):
        self.assertEqual(txt.pluralize('cand', 1, 'y,ies'), 'candy')
        self.assertEqual(txt.pluralize('cand', 2, 'y,ies'), 'candies')
        self.assertEqual(txt.pluralize('', 1, 'is,are'), 'is')
        self.assertEqual(txt.pluralize('', 2, 'is,are'), 'are')


class TestSanitizeSensitiveData(unittest.TestCase):
    # A credential sitting in its own element of a stringified argument list, the shape
    # an argv takes in an error message. The dict form was already covered, the list
    # form was not.
    def test_redacts_sshpass_in_argv(self):
        out = txt.sanitize_sensitive_data(
            "while calling command \"['sshpass', '-p', 'secret123', 'ssh']\""
        )
        self.assertNotIn('secret123', out)
        self.assertIn("'sshpass', '-p', '******'", out)

    def test_redacts_long_option_in_argv(self):
        out = txt.sanitize_sensitive_data("['restic', '--password', 'secret123']")
        self.assertNotIn('secret123', out)

    def test_redacts_double_quoted_argv(self):
        out = txt.sanitize_sensitive_data('["sshpass", "-p", "secret123"]')
        self.assertNotIn('secret123', out)

    # "-p" is the port option of ssh and scp, so it is only redacted behind sshpass.
    # Blanking every "-p" value would hide a port number for no gain.
    def test_keeps_ssh_port_readable(self):
        out = txt.sanitize_sensitive_data("['ssh', '-p', '22', 'root@203.0.113.1']")
        self.assertIn("'-p', '22'", out)

    def test_redacts_password(self):
        self.assertEqual(
            txt.sanitize_sensitive_data('user=admin&password=secret123'),
            'user=admin&password=******',
        )

    def test_custom_replacement(self):
        out = txt.sanitize_sensitive_data('api_key = xyz987', replacement='X')
        self.assertNotIn('xyz987', out)

    def test_redacts_json_form(self):
        out = txt.sanitize_sensitive_data(
            '{"user": "admin", "password": "linuxfabrik"}'
        )
        self.assertNotIn('linuxfabrik', out)
        self.assertIn('admin', out)

    def test_redacts_python_mapping_form(self):
        # An f-string around a dict renders repr(), which single-quotes its
        # keys and values and therefore escapes the JSON pattern.
        body = {'user_name': 'admin', 'password': 'linuxfabrik', 'scope': '0'}
        out = txt.sanitize_sensitive_data(f'Type error, data="{body}"')
        self.assertNotIn('linuxfabrik', out)
        self.assertIn('admin', out)

    def test_redacts_mapping_token_and_key_variants(self):
        for field in ('token', 'secret', 'api_key', 'access-token', 'http_auth'):
            with self.subTest(field=field):
                out = txt.sanitize_sensitive_data(f"{{'{field}': 'linuxfabrik'}}")
                self.assertNotIn('linuxfabrik', out)

    # A `login:password` pair handed to a command line, the only way tools such as
    # curl and wpscan accept HTTP basic credentials.
    def test_redacts_http_auth_option(self):
        out = txt.sanitize_sensitive_data(
            'wpscan --url=https://www.example.com --http-auth=admin:linuxfabrik'
        )
        self.assertNotIn('linuxfabrik', out)
        self.assertIn('--http-auth=******', out)
        self.assertIn('--url=https://www.example.com', out)

    # An option naming a credential *file* holds a path, not a secret. Blanking it
    # would hide the one thing an admin needs to check.
    def test_keeps_credential_file_path_readable(self):
        out = txt.sanitize_sensitive_data('--http-auth-file=/etc/icinga2/wpscan.auth')
        self.assertIn('/etc/icinga2/wpscan.auth', out)

    # A credential inside a URL is preceded by no sensitive name at all, so only the
    # userinfo pattern catches it.
    def test_redacts_url_userinfo(self):
        out = txt.sanitize_sensitive_data(
            '--proxy=http://admin:linuxfabrik@192.0.2.1:3128'
        )
        self.assertNotIn('linuxfabrik', out)
        self.assertEqual(out, '--proxy=http://admin:******@192.0.2.1:3128')

    def test_redacts_url_userinfo_without_login(self):
        out = txt.sanitize_sensitive_data('redis://:linuxfabrik@localhost')
        self.assertNotIn('linuxfabrik', out)

    # A URL carries userinfo only in front of an '@'. A port, a path and a bare
    # login have to survive untouched, or every URL in every message turns to noise.
    def test_keeps_ordinary_urls_readable(self):
        for url in (
            'https://www.example.com:8443/path',
            'https://github.com/Linuxfabrik/monitoring-plugins/blob/main/x',
            'https://admin@www.example.com/path',
        ):
            with self.subTest(url=url):
                self.assertEqual(txt.sanitize_sensitive_data(url), url)


class TestToBytes(unittest.TestCase):
    def test_str_and_int(self):
        self.assertEqual(txt.to_bytes('hello'), b'hello')
        self.assertEqual(txt.to_bytes(1234), b'1234')

    def test_encoding(self):
        self.assertEqual(txt.to_bytes('abc', encoding='latin-1'), b'abc')

    def test_none_empty(self):
        self.assertEqual(txt.to_bytes(None, nonstring='empty'), b'')

    def test_errors_replace(self):
        self.assertEqual(
            txt.to_bytes('café', encoding='ascii', errors='replace'), b'caf?'
        )


class TestToText(unittest.TestCase):
    def test_bytes_and_str(self):
        self.assertEqual(txt.to_text(b'hello'), 'hello')
        self.assertEqual(txt.to_text('already text'), 'already text')

    def test_nonstring_empty(self):
        self.assertEqual(txt.to_text(None, nonstring='empty'), '')

    def test_strict_or_latin1_valid_utf8(self):
        self.assertEqual(
            txt.to_text('über'.encode(), errors='strict_or_latin1'), 'über'
        )

    def test_strict_or_latin1_falls_back_on_invalid_utf8(self):
        # 0xfc is ü in Latin-1/CP1252 and an invalid UTF-8 start byte. With
        # surrogateescape it would decode to a lone surrogate and crash on the
        # later stdout re-encode; Latin-1 maps it to a real scalar instead (#256).
        self.assertEqual(txt.to_text(b'M\xfcller', errors='strict_or_latin1'), 'Müller')

    def test_strict_or_latin1_result_re_encodes_for_stdout(self):
        # The decoded text must survive a strict UTF-8 re-encode (what print()/stdout
        # does), which surrogateescape would not.
        txt.to_text(b'M\xfcller', errors='strict_or_latin1').encode('utf-8')

    def test_strict_or_latin1_str_passes_through(self):
        self.assertEqual(
            txt.to_text('already text', errors='strict_or_latin1'), 'already text'
        )

    def test_strict_or_latin1_every_byte_survives(self):
        # Latin-1 maps all 256 byte values, so no input can raise.
        self.assertEqual(
            len(txt.to_text(bytes(range(256)), errors='strict_or_latin1')), 256
        )


class TestUnescape(unittest.TestCase):
    def test_resolves_numeric_character_references(self):
        # Some sources encode the punctuation of plain text, so a hardware model reads as
        # 'Expansion Module&#40;24 Cores&#41;' unless it is resolved.
        self.assertEqual(
            txt.unescape('Expansion Module&#40;24 Cores&#41;'),
            'Expansion Module(24 Cores)',
        )

    def test_resolves_named_references(self):
        self.assertEqual(txt.unescape('a &amp; b'), 'a & b')

    def test_text_without_an_ampersand_is_returned_as_it_is(self):
        self.assertEqual(txt.unescape('CTE0.IOM.L5.P0'), 'CTE0.IOM.L5.P0')

    def test_empty_string(self):
        self.assertEqual(txt.unescape(''), '')

    def test_resolves_the_named_keys_of_a_mapping(self):
        self.assertEqual(
            txt.unescape({'MODEL': 'Board&#40;2*8G&#41;', 'ID': '0'}, keys=('MODEL',)),
            {'MODEL': 'Board(2*8G)', 'ID': '0'},
        )

    def test_resolves_every_string_value_without_keys(self):
        self.assertEqual(
            txt.unescape({'A': '&#39;x&#39;', 'B': 1}),
            {'A': "'x'", 'B': 1},
        )

    def test_a_key_that_is_not_there_is_not_an_error(self):
        self.assertEqual(txt.unescape({'ID': '0'}, keys=('MODEL',)), {'ID': '0'})

    def test_source_mapping_is_not_modified(self):
        # The caller keeps the values the source sent, so it can still compare against
        # them.
        source = {'MODEL': 'Board&#40;x&#41;'}
        txt.unescape(source, keys=('MODEL',))
        self.assertEqual(source, {'MODEL': 'Board&#40;x&#41;'})

    def test_other_types_pass_through(self):
        # A consumer hands a field through without first checking what it holds.
        for value in (None, 42, [1, 2], True):
            with self.subTest(value=value):
                self.assertEqual(txt.unescape(value), value)


class TestUniq(unittest.TestCase):
    def test_dedups_tokens_preserving_order(self):
        self.assertEqual(txt.uniq('a a b a'), 'a b')
        self.assertEqual(
            txt.uniq(
                'This is a test. This is a second test. And this is a third test.'
            ),
            'This is a test. second And this third',
        )

    def test_empty_input(self):
        self.assertEqual(txt.uniq(''), '')


class TestShorten(unittest.TestCase):
    def test_fits_already(self):
        self.assertEqual(txt.shorten('short enough', 40), 'short enough')

    def test_exactly_max_len(self):
        self.assertEqual(txt.shorten('abcde', 5), 'abcde')

    def test_cuts_out_of_the_middle(self):
        result = txt.shorten('alice, bob, carol, dave, erin, frank', 20)
        self.assertEqual(result, 'alice, b...in, frank')
        self.assertEqual(len(result), 20)

    # Head and tail are both kept, so two values differing only at the end stay
    # distinguishable. That is the reason for cutting out of the middle at all.
    def test_keeps_head_and_tail(self):
        first = txt.shorten('prefix-' + 'x' * 50 + '-alpha', 20)
        second = txt.shorten('prefix-' + 'x' * 50 + '-omega', 20)
        self.assertTrue(first.startswith('prefix'))
        self.assertTrue(first.endswith('alpha'))
        self.assertTrue(second.endswith('omega'))
        self.assertNotEqual(first, second)

    def test_custom_ellipsis(self):
        self.assertEqual(txt.shorten('abcdefghij', 5, ellipsis='*'), 'ab*ij')

    # A result made only of the marker would carry nothing, so it degrades to a plain
    # head-truncation instead.
    def test_max_len_too_small_for_the_marker(self):
        self.assertEqual(txt.shorten('abcdefghij', 3), 'abc')
        self.assertEqual(txt.shorten('abcdefghij', 2), 'ab')

    def test_empty_input(self):
        self.assertEqual(txt.shorten('', 10), '')


if __name__ == '__main__':
    unittest.main()
