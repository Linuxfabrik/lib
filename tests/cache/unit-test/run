"""Unit tests for lib.cache (SQLite-backed key-value store).

Each test uses a throwaway directory via the `path=` argument so the real
per-user cache is never touched and tests stay isolated.
"""

import sys
import tempfile
import unittest

sys.path.insert(0, '..')

import lib.cache as cache
import lib.time as lftime


class TestCache(unittest.TestCase):
    def setUp(self):
        self.path = tempfile.mkdtemp(prefix='lftest-cache-')

    def test_set_get_roundtrip(self):
        self.assertTrue(cache.set('k', 'v', path=self.path))
        self.assertEqual(cache.get('k', path=self.path), 'v')

    def test_get_as_dict(self):
        cache.set('k', 'v', path=self.path)
        self.assertEqual(
            cache.get('k', path=self.path, as_dict=True),
            {'key': 'k', 'value': 'v', 'timestamp': 0},
        )

    def test_overwrite(self):
        cache.set('k', 'v', path=self.path)
        cache.set('k', 'v2', path=self.path)
        self.assertEqual(cache.get('k', path=self.path), 'v2')

    def test_missing_key_returns_false(self):
        self.assertFalse(cache.get('missing', path=self.path))

    def test_expired_key_returns_false(self):
        cache.set('e', 'x', expire=lftime.now() - 10, path=self.path)
        self.assertFalse(cache.get('e', path=self.path))

    def test_unexpired_key_still_served(self):
        cache.set('e', 'x', expire=lftime.now() + 3600, path=self.path)
        self.assertEqual(cache.get('e', path=self.path), 'x')

    def test_expired_key_served_with_allow_stale(self):
        cache.set('e', 'x', expire=lftime.now() - 10, path=self.path)
        self.assertEqual(cache.get('e', allow_stale=True, path=self.path), 'x')

    def test_allow_stale_reports_when_the_entry_expired(self):
        expired_at = lftime.now() - 10
        cache.set('e', 'x', expire=expired_at, path=self.path)
        self.assertEqual(
            cache.get('e', as_dict=True, allow_stale=True, path=self.path)['timestamp'],
            expired_at,
        )

    def test_allow_stale_keeps_the_entry(self):
        cache.set('e', 'x', expire=lftime.now() - 10, path=self.path)
        cache.get('e', allow_stale=True, path=self.path)
        self.assertEqual(cache.get('e', allow_stale=True, path=self.path), 'x')

    def test_plain_get_drops_the_expired_entry(self):
        cache.set('e', 'x', expire=lftime.now() - 10, path=self.path)
        cache.get('e', path=self.path)
        self.assertFalse(cache.get('e', allow_stale=True, path=self.path))

    def test_prune_removes_expired_entries(self):
        cache.set('e', 'x', expire=lftime.now() - 10, path=self.path)
        self.assertTrue(cache.prune(path=self.path))
        self.assertFalse(cache.get('e', allow_stale=True, path=self.path))

    def test_prune_keeps_unexpired_and_permanent_entries(self):
        cache.set('permanent', 'a', path=self.path)
        cache.set('fresh', 'b', expire=lftime.now() + 3600, path=self.path)
        cache.prune(path=self.path)
        self.assertEqual(cache.get('permanent', path=self.path), 'a')
        self.assertEqual(cache.get('fresh', path=self.path), 'b')

    def test_prune_before_keeps_recently_expired_entries(self):
        now = lftime.now()
        cache.set('recent', 'a', expire=now - 86400, path=self.path)
        cache.set('ancient', 'b', expire=now - 60 * 86400, path=self.path)
        cache.prune(before=now - 30 * 86400, path=self.path)
        self.assertEqual(cache.get('recent', allow_stale=True, path=self.path), 'a')
        self.assertFalse(cache.get('ancient', allow_stale=True, path=self.path))


if __name__ == '__main__':
    unittest.main()
