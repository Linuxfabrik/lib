"""Unit tests for lib.args (argparse type/validator helpers)."""

import argparse
import os
import sys
import tempfile
import unittest

sys.path.insert(0, '..')

import lib.args as args


class TestCsv(unittest.TestCase):
    def test_splits_on_comma(self):
        self.assertEqual(args.csv('a,b,c'), ['a', 'b', 'c'])

    def test_empty_yields_single_empty_field(self):
        self.assertEqual(args.csv(''), [''])

    def test_strips_whitespace(self):
        self.assertEqual(args.csv(' a , b '), ['a', 'b'])


class TestEpilog(unittest.TestCase):
    def test_name_is_taken_from_the_file_name(self):
        self.assertEqual(
            args.epilog('/usr/lib64/nagios/plugins/example'),
            f'Documentation: {args.DOCS_BASE_URL}/check-plugins/example/',
        )

    def test_extensions_are_stripped(self):
        for path in ('/opt/example.exe', '/opt/example.EXE', '/opt/example.py'):
            self.assertEqual(
                args.epilog(path),
                f'Documentation: {args.DOCS_BASE_URL}/check-plugins/example/',
            )

    def test_section_is_configurable(self):
        self.assertEqual(
            args.epilog('/opt/notify-host-mail', section='notification-plugins'),
            f'Documentation: {args.DOCS_BASE_URL}/notification-plugins/notify-host-mail/',
        )


class TestHelpFormatter(unittest.TestCase):
    def format_help(self, parser, columns):
        """Renders the help text as if the terminal was `columns` wide."""
        previous = os.environ.get('COLUMNS')
        os.environ['COLUMNS'] = str(columns)
        try:
            return parser.format_help()
        finally:
            if previous is None:
                del os.environ['COLUMNS']
            else:
                os.environ['COLUMNS'] = previous

    def test_url_survives_a_narrow_terminal(self):
        # The default formatter would break this URL at one of its hyphens.
        epilog = args.epilog('/opt/infomaniak-swiss-backup-products')
        parser = argparse.ArgumentParser(
            prog='infomaniak-swiss-backup-products',
            description='Lorem ipsum dolor sit amet.',
            epilog=epilog,
            formatter_class=args.HelpFormatter,
        )
        url = epilog.split()[-1]
        self.assertIn(url, self.format_help(parser, 40))

    def test_description_is_still_wrapped(self):
        parser = argparse.ArgumentParser(
            prog='example',
            description='word ' * 30,
            formatter_class=args.HelpFormatter,
        )
        for line in self.format_help(parser, 40).splitlines():
            self.assertLessEqual(len(line), 40)


class TestOrNone(unittest.TestCase):
    def test_float_or_none(self):
        self.assertEqual(args.float_or_none('1.5'), 1.5)
        self.assertIsNone(args.float_or_none('none'))

    def test_int_or_none(self):
        self.assertEqual(args.int_or_none('5'), 5)
        self.assertIsNone(args.int_or_none('none'))

    def test_str_or_none(self):
        self.assertEqual(args.str_or_none('x'), 'x')
        self.assertIsNone(args.str_or_none('none'))

    def test_range_or_none(self):
        self.assertEqual(args.range_or_none('10'), '10')
        self.assertIsNone(args.range_or_none('none'))


class TestLoadSecret(unittest.TestCase):
    def _write(self, content):
        with tempfile.NamedTemporaryFile('w', delete=False) as handle:
            handle.write(content)
        self.addCleanup(os.unlink, handle.name)
        return handle.name

    def test_reads_the_secret(self):
        self.assertEqual(args.load_secret(self._write('linuxfabrik')), 'linuxfabrik')

    def test_strips_the_trailing_newline_an_editor_appends(self):
        self.assertEqual(args.load_secret(self._write('linuxfabrik\n')), 'linuxfabrik')

    def test_strips_a_windows_line_ending(self):
        self.assertEqual(
            args.load_secret(self._write('linuxfabrik\r\n')), 'linuxfabrik'
        )

    def test_only_the_first_line_is_the_secret(self):
        self.assertEqual(
            args.load_secret(self._write('linuxfabrik\nnot the secret\n')),
            'linuxfabrik',
        )

    def test_surrounding_spaces_are_part_of_the_secret(self):
        # Stripping them would make a valid password fail with no way to tell why.
        self.assertEqual(
            args.load_secret(self._write('  linuxfabrik  \n')), '  linuxfabrik  '
        )

    def test_empty_file_aborts(self):
        # An empty secret would be sent to the remote end as an empty password, which
        # drives the account towards its lockout threshold.
        with self.assertRaises(SystemExit):
            args.load_secret(self._write(''))

    def test_file_holding_only_a_newline_aborts(self):
        with self.assertRaises(SystemExit):
            args.load_secret(self._write('\n'))

    def test_unreadable_file_aborts(self):
        with self.assertRaises(SystemExit):
            args.load_secret('/nonexistent/linuxfabrik')


class TestNumberUnitMethod(unittest.TestCase):
    def test_defaults(self):
        self.assertEqual(args.number_unit_method('50'), ('50', '%', 'USED'))

    def test_custom_unit_and_method(self):
        # The unit is upper-cased.
        self.assertEqual(
            args.number_unit_method('80', unit='GiB', method='FREE'),
            ('80', 'GIB', 'FREE'),
        )


class TestDuration(unittest.TestCase):
    """duration(): decodes a duration, refuses what it cannot decode."""

    def test_accepts_every_unit(self):
        self.assertEqual(args.duration('30s'), 30)
        self.assertEqual(args.duration('90m'), 5400)
        self.assertEqual(args.duration('12h'), 43200)
        self.assertEqual(args.duration('8d'), 691200)
        self.assertEqual(args.duration('2W'), 1209600)
        self.assertEqual(args.duration('3M'), 7776000)
        self.assertEqual(args.duration('1Y'), 31536000)

    def test_day_and_week_are_case_insensitive(self):
        # Only `m` (minutes) and `M` (months) differ by case.
        self.assertEqual(args.duration('8D'), args.duration('8d'))
        self.assertEqual(args.duration('2W'), args.duration('2w'))
        self.assertNotEqual(args.duration('3m'), args.duration('3M'))

    def test_accepts_a_fraction(self):
        self.assertEqual(args.duration('1.5W'), 907200)
        self.assertEqual(args.duration('.5D'), 43200)

    def test_zero_is_a_valid_duration(self):
        self.assertEqual(args.duration('0D'), 0)
        self.assertEqual(args.duration('0s'), 0)

    def test_rejects_what_human2seconds_would_read_as_zero(self):
        # human2seconds() returns 0 for garbage as well as for a real zero.
        # Passing that through would turn `--grace-updates=8` into "no grace at
        # all", which is exactly the misreading that stops a check alerting.
        for value in ('8', '8x', '', 'd', 'abc', 'D8', '8dd', '-1d'):
            with self.assertRaises(argparse.ArgumentTypeError):
                args.duration(value)


if __name__ == '__main__':
    unittest.main()
