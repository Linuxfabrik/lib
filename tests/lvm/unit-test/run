              "lv": [
                  {"data_percent":"0.01", "lv_active":"active", "lv_attr":"swi-a-s---", "lv_check_needed":"unknown", "lv_full_name":"testvg/goodsnap", "lv_health_status":"", "lv_layout":"linear", "lv_merge_failed":"", "lv_metadata_size":"", "lv_name":"goodsnap", "lv_role":"public,snapshot,thicksnapshot", "lv_size":"314572800", "lv_snapshot_invalid":"", "lv_time":"2026-08-27 11:19:13 +0200", "lv_when_full":"", "metadata_percent":"", "origin":"orig", "pool_lv":"", "vg_name":"testvg"},
                  {"data_percent":"100.00", "lv_active":"active", "lv_attr":"swi-I-s---", "lv_check_needed":"unknown", "lv_full_name":"testvg/snap", "lv_health_status":"", "lv_layout":"linear", "lv_merge_failed":"", "lv_metadata_size":"", "lv_name":"snap", "lv_role":"public,snapshot,thicksnapshot", "lv_size":"209715200", "lv_snapshot_invalid":"snapshot invalid", "lv_time":"2026-08-27 11:09:04 +0200", "lv_when_full":"", "metadata_percent":"", "origin":"orig", "pool_lv":"", "vg_name":"testvg"},
