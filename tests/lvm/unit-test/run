"""Unit tests for lib.lvm.

Every report below was captured from a real `lvs` or `vgs` run on Rocky 10
(lvm2 2.03.28) against volumes that were actually driven into the state they show:
a classic snapshot whose copy-on-write store was filled until the kernel threw it
away, a thin pool written past its data volume, a thin pool whose metadata was
exhausted through `dmsetup message ... create_thin`, and a volume group with a
physical volume removed underneath it.
"""

import json
import sys
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.lvm as lvm
from lib.globals import STATE_UNKNOWN, STATE_WARN

# A healthy classic snapshot, one the kernel has thrown away, a healthy thin pool,
# a thin pool whose metadata is full, a thin volume, a thin snapshot (created
# inactive, so it reports no percentages at all) and a plain linear volume.
LVS = """
  {
      "report": [
