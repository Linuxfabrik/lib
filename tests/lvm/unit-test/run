                  {"data_percent":"74.34", "lv_active":"active", "lv_attr":"twi-aotzM-", "lv_check_needed":"", "lv_full_name":"testvg/mpool", "lv_health_status":"metadata_read_only", "lv_layout":"thin,pool", "lv_merge_failed":"unknown", "lv_metadata_size":"4194304", "lv_name":"mpool", "lv_role":"private", "lv_size":"4294967296", "lv_snapshot_invalid":"unknown", "lv_time":"2026-08-27 11:13:23 +0200", "lv_when_full":"queue", "metadata_percent":"100.00", "origin":"", "pool_lv":"", "vg_name":"testvg"},
                  {"data_percent":"25.00", "lv_active":"active", "lv_attr":"Vwi-aotz--", "lv_check_needed":"unknown", "lv_full_name":"testvg/tvol", "lv_health_status":"", "lv_layout":"thin,sparse", "lv_merge_failed":"unknown", "lv_metadata_size":"", "lv_name":"tvol", "lv_role":"public,origin,thinorigin", "lv_size":"4294967296", "lv_snapshot_invalid":"unknown", "lv_time":"2026-08-27 11:10:34 +0200", "lv_when_full":"", "metadata_percent":"", "origin":"", "pool_lv":"tpool", "vg_name":"testvg"},
                  {"data_percent":"", "lv_active":"", "lv_attr":"Vwi---tz-k", "lv_check_needed":"unknown", "lv_full_name":"testvg/tsnap", "lv_health_status":"", "lv_layout":"thin,sparse", "lv_merge_failed":"unknown", "lv_metadata_size":"", "lv_name":"tsnap", "lv_role":"public,snapshot,thinsnapshot", "lv_size":"4294967296", "lv_snapshot_invalid":"unknown", "lv_time":"2026-08-27 11:10:35 +0200", "lv_when_full":"", "metadata_percent":"", "origin":"tvol", "pool_lv":"tpool", "vg_name":"testvg"},
                  {"data_percent":"", "lv_active":"active", "lv_attr":"-wi-a---p-", "lv_check_needed":"unknown", "lv_full_name":"parttest/spanned", "lv_health_status":"partial", "lv_layout":"linear", "lv_merge_failed":"unknown", "lv_metadata_size":"", "lv_name":"spanned", "lv_role":"public", "lv_size":"3221225472", "lv_snapshot_invalid":"unknown", "lv_time":"2026-08-27 11:21:40 +0200", "lv_when_full":"", "metadata_percent":"", "origin":"", "pool_lv":"", "vg_name":"parttest"}
