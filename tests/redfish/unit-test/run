# ---------------------------------------------------------------------------
# get_systems_storage_drives (CapacityBytes humanizing)
# ---------------------------------------------------------------------------
class TestGetSystemsStorageDrives(unittest.TestCase):
    def test_full_payload(self):
        out = redfish.get_systems_storage_drives(load(DRIVE_BODY))
        self.assertEqual(out['BlockSizeBytes'], 512)
        self.assertEqual(out['CapableSpeedGbs'], 12)
        self.assertEqual(out['Description'], 'Disk Drive Bay 0')
        self.assertEqual(out['MediaType'], 'SSD')
        self.assertEqual(out['Model'], '970 EVO')
        self.assertEqual(out['Protocol'], 'NVMe')
        self.assertEqual(out['SerialNumber'], 'S1234NEAB00001')
        self.assertEqual(out['Status_State'], 'Enabled')
        self.assertEqual(out['Status_Health'], 'OK')
        self.assertEqual(out['Status_HealthRollup'], 'OK')
        # CapacityBytes is humanized via lib.human.bytes2human.
        self.assertEqual(out['CapacityBytes'], CAP_500GB)

    def test_capacity_matches_human_helper(self):
        out = redfish.get_systems_storage_drives({'CapacityBytes': 500000000000})
        self.assertEqual(out['CapacityBytes'], human.bytes2human(500000000000))

    def test_capacity_missing_is_empty(self):
        out = redfish.get_systems_storage_drives({})
        self.assertEqual(out['CapacityBytes'], '')

    def test_capacity_zero_is_empty(self):
        # `if capacity` is falsy for 0 -> '' rather than bytes2human(0).
        out = redfish.get_systems_storage_drives({'CapacityBytes': 0})
        self.assertEqual(out['CapacityBytes'], '')

    def test_failure_predicted_false_preserved(self):
        out = redfish.get_systems_storage_drives({'FailurePredicted': False})
        self.assertEqual(out['FailurePredicted'], False)

    def test_temperature_from_current_temperature_celsius(self):
        # vendor quirk: HPE SmartStorage exposes CurrentTemperatureCelsius
        out = redfish.get_systems_storage_drives({'CurrentTemperatureCelsius': 37})
        self.assertEqual(out['Temperature'], 37)

    def test_temperature_from_oem_temperature_celsius(self):
        out = redfish.get_systems_storage_drives(
            {'Oem': {'Hpe': {'TemperatureCelsius': 41}}}
        )
        self.assertEqual(out['Temperature'], 41)

    def test_temperature_from_oem_temperature_c(self):
        out = redfish.get_systems_storage_drives(
            {'Oem': {'Dell': {'TemperatureC': 29}}}
        )
        self.assertEqual(out['Temperature'], 29)

    def test_temperature_missing_is_empty(self):
        out = redfish.get_systems_storage_drives({})
        self.assertEqual(out['Temperature'], '')

    def test_output_key_set_is_exact(self):
        out = redfish.get_systems_storage_drives({})
        # CapacityBytes and Temperature are added on top of the flat + nested key
        # sets.
        expected = (
            set(redfish.SYSTEMS_STORAGE_DRIVES_KEYS)
            | set(redfish.SYSTEMS_STORAGE_DRIVES_NESTED_KEYS)
            | {'CapacityBytes', 'Temperature'}
        )
        self.assertEqual(set(out), expected)


# ---------------------------------------------------------------------------
# get_vendor
# ---------------------------------------------------------------------------
class TestGetVendor(unittest.TestCase):
    def test_explicit_vendor_lowercased(self):
        self.assertEqual(redfish.get_vendor({'Vendor': 'DELL'}), 'dell')

    def test_oem_first_key_used(self):
        self.assertEqual(redfish.get_vendor({'Oem': {'SomeVendor': 'x'}}), 'somevendor')

    def test_empty_dict_is_generic(self):
        self.assertEqual(redfish.get_vendor({}), 'generic')

    def test_empty_oem_is_generic(self):
        self.assertEqual(redfish.get_vendor({'Oem': {}}), 'generic')

    def test_vendor_none_falls_back_to_oem(self):
        self.assertEqual(redfish.get_vendor({'Vendor': None, 'Oem': {'Hpe': 1}}), 'hpe')

    def test_vendor_empty_string_falls_back_to_oem(self):
        self.assertEqual(
            redfish.get_vendor({'Vendor': '', 'Oem': {'Lenovo': 1}}), 'lenovo'
        )

    def test_oem_none_is_generic(self):
        # `redfish.get('Oem') or {}` guards an explicit None Oem.
        self.assertEqual(redfish.get_vendor({'Oem': None}), 'generic')

    def test_vendor_wins_over_oem(self):
        self.assertEqual(
            redfish.get_vendor({'Vendor': 'Dell', 'Oem': {'Hpe': 1}}), 'dell'
        )


# ---------------------------------------------------------------------------
# build_url (@odata.id SSRF pinning)
# ---------------------------------------------------------------------------
class TestBuildUrl(unittest.TestCase):
    def test_relative_link_is_pinned_to_base_host(self):
        self.assertEqual(
            redfish.build_url('https://bmc', '/redfish/v1/Systems/1'),
            (True, 'https://bmc/redfish/v1/Systems/1'),
        )

    def test_base_host_wins_over_link_authority(self):
        # the @odata.id can only supply a path, never a new host
        ok, url_out = redfish.build_url('https://bmc', '/redfish/v1/x')
        self.assertTrue(ok)
        self.assertTrue(url_out.startswith('https://bmc/'))

    def test_userinfo_injection_is_refused(self):
        ok, err = redfish.build_url('https://bmc', '@evil.example.com/x')
        self.assertFalse(ok)
        self.assertIn('Refusing', err)

    def test_protocol_relative_link_is_refused(self):
        ok, err = redfish.build_url('https://bmc', '//evil.example.com/x')
        self.assertFalse(ok)
        self.assertIn('Refusing', err)

    def test_non_string_link_is_refused(self):
        ok, err = redfish.build_url('https://bmc', None)
        self.assertFalse(ok)
        self.assertIn('Refusing', err)


# ---------------------------------------------------------------------------
# fetch_collection ($expand with plain fallback; lib.url is mocked)
# ---------------------------------------------------------------------------
class TestFetchCollection(unittest.TestCase):
    @mock.patch.object(redfish, 'url')
    def test_expand_success_is_a_single_request(self, url_mock):
        coll = {'Members': [{'@odata.id': '/x/1', 'Id': '1'}]}
        url_mock.fetch_json.return_value = (True, coll)
        ok, out = redfish.fetch_collection('https://bmc/redfish/v1/Chassis/1/Sensors')
        self.assertTrue(ok)
        self.assertEqual(out, coll)
        self.assertEqual(url_mock.fetch_json.call_count, 1)
        # the single request carries the $expand query
        self.assertIn('$expand=.($levels=1)', url_mock.fetch_json.call_args[0][0])

    @mock.patch.object(redfish, 'url')
    def test_custom_expand_suffix_is_used(self, url_mock):
        url_mock.fetch_json.return_value = (True, {'Members': []})
        redfish.fetch_collection('https://bmc/x', expand='?$expand=*($levels=3)')
        self.assertIn('$expand=*($levels=3)', url_mock.fetch_json.call_args[0][0])

    @mock.patch.object(redfish, 'url')
    def test_expand_rejected_falls_back_to_plain(self, url_mock):
        plain = {'Members': [{'@odata.id': '/x/1'}]}
        url_mock.fetch_json.side_effect = [(False, 'HTTP 400'), (True, plain)]
        ok, out = redfish.fetch_collection('https://bmc/redfish/v1/Chassis/1/Sensors')
        self.assertTrue(ok)
        self.assertEqual(out, plain)
        self.assertEqual(url_mock.fetch_json.call_count, 2)
        # the fallback request drops the $expand query
        self.assertNotIn('$expand', url_mock.fetch_json.call_args_list[1][0][0])

    @mock.patch.object(redfish, 'url')
    def test_expand_non_dict_falls_back_to_plain(self, url_mock):
        url_mock.fetch_json.side_effect = [
            (True, 'not-a-dict'),
            (True, {'Members': []}),
        ]
        ok, out = redfish.fetch_collection('https://bmc/x')
        self.assertTrue(ok)
        self.assertEqual(out, {'Members': []})
        self.assertEqual(url_mock.fetch_json.call_count, 2)

    @mock.patch.object(redfish, 'url')
    def test_both_requests_fail_propagates_error(self, url_mock):
        url_mock.fetch_json.side_effect = [(False, 'boom'), (False, 'boom2')]
        ok, out = redfish.fetch_collection('https://bmc/x')
        self.assertFalse(ok)
        self.assertEqual(out, 'boom2')

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_cache_hit_skips_the_request(self, url_mock, cache_mock):
        cache_mock.get.return_value = json.dumps({'Members': [{'Id': '1'}]})
        ok, out = redfish.fetch_collection('https://bmc/x', cache_expire=300)
        self.assertTrue(ok)
        self.assertEqual(out, {'Members': [{'Id': '1'}]})
        url_mock.fetch_json.assert_not_called()

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_cache_miss_fetches_and_fills_by_plain_url(
        self, url_mock, cache_mock, time_mock
    ):
        cache_mock.get.return_value = False
        time_mock.now.return_value = 1000
        coll = {'Members': [{'@odata.id': '/x/1', 'Id': '1'}]}
        url_mock.fetch_json.return_value = (True, coll)
        ok, out = redfish.fetch_collection('https://bmc/x', cache_expire=300)
        self.assertTrue(ok)
        self.assertEqual(out, coll)
        # cached under the plain URL (not the $expand variant)
        cache_mock.set.assert_called_once_with(
            'redfish-https://bmc/x',
            json.dumps(coll),
            1000 + 300,
            filename=redfish.CACHE_FILENAME,
        )


# ---------------------------------------------------------------------------
# get_expand_suffix (derive the deepest advertised $expand; lib.url is mocked)
# ---------------------------------------------------------------------------
def _root(**expand_query):
    """A service-root document advertising the given ExpandQuery support."""
    return (True, {'ProtocolFeaturesSupported': {'ExpandQuery': expand_query}})


class TestGetExpandSuffix(unittest.TestCase):
    @mock.patch.object(redfish, 'url')
    def test_expandall_uses_star_and_caps_levels(self, url_mock):
        # MaxLevels 9 is capped at MAX_EXPAND_LEVELS (1): one level inlines the members,
        # every further one only inflates the answer
        url_mock.fetch_json.return_value = _root(
            ExpandAll=True, Levels=True, MaxLevels=9
        )
        self.assertEqual(
            redfish.get_expand_suffix('https://bmc'), '?$expand=*($levels=1)'
        )

    @mock.patch.object(redfish, 'url')
    def test_a_single_advertised_level_is_used(self, url_mock):
        url_mock.fetch_json.return_value = _root(
            ExpandAll=True, Levels=True, MaxLevels=1
        )
        self.assertEqual(
            redfish.get_expand_suffix('https://bmc'), '?$expand=*($levels=1)'
        )

    @mock.patch.object(redfish, 'url')
    def test_nolinks_only_uses_dot_operator(self, url_mock):
        url_mock.fetch_json.return_value = _root(
            ExpandAll=False, NoLinks=True, Levels=True, MaxLevels=2
        )
        self.assertEqual(
            redfish.get_expand_suffix('https://bmc'), '?$expand=.($levels=1)'
        )

    @mock.patch.object(redfish, 'url')
    def test_no_levels_support_omits_levels_clause(self, url_mock):
        url_mock.fetch_json.return_value = _root(ExpandAll=True, Levels=False)
        self.assertEqual(redfish.get_expand_suffix('https://bmc'), '?$expand=*')

    @mock.patch.object(redfish, 'url')
    def test_no_expand_support_returns_default(self, url_mock):
        url_mock.fetch_json.return_value = (True, {'ProtocolFeaturesSupported': {}})
        self.assertEqual(
            redfish.get_expand_suffix('https://bmc'), redfish.DEFAULT_EXPAND
        )

    @mock.patch.object(redfish, 'url')
    def test_unreadable_root_returns_default(self, url_mock):
        url_mock.fetch_json.return_value = (False, 'HTTP 500')
        self.assertEqual(
            redfish.get_expand_suffix('https://bmc'), redfish.DEFAULT_EXPAND
        )


# ---------------------------------------------------------------------------
# fetch_members (populate bare refs, skip expanded; lib.url is mocked)
# ---------------------------------------------------------------------------
class TestFetchMembers(unittest.TestCase):
    @mock.patch.object(redfish, 'url')
    def test_all_expanded_makes_no_requests(self, url_mock):
        members = [
            {'@odata.id': '/x/1', 'Id': '1'},
            {'@odata.id': '/x/2', 'Reading': 5},
        ]
        ok, out = redfish.fetch_members(members, 'https://bmc')
        self.assertTrue(ok)
        self.assertEqual(out, members)
        url_mock.fetch_json.assert_not_called()

    @mock.patch.object(redfish, 'url')
    def test_bare_refs_are_fetched_and_host_is_pinned(self, url_mock):
        url_mock.fetch_json.side_effect = [
            (True, {'Id': '1', 'Reading': 1}),
            (True, {'Id': '2', 'Reading': 2}),
        ]
        members = [{'@odata.id': '/redfish/v1/x/1'}, {'@odata.id': '/redfish/v1/x/2'}]
        ok, out = redfish.fetch_members(members, 'https://bmc')
        self.assertTrue(ok)
        self.assertEqual(out, [{'Id': '1', 'Reading': 1}, {'Id': '2', 'Reading': 2}])
        self.assertEqual(url_mock.fetch_json.call_count, 2)
        self.assertEqual(
            url_mock.fetch_json.call_args_list[0][0][0], 'https://bmc/redfish/v1/x/1'
        )

    @mock.patch.object(redfish, 'url')
    def test_mixed_expanded_and_bare_only_fetches_the_bare_one(self, url_mock):
        url_mock.fetch_json.return_value = (True, {'Id': '2', 'Reading': 2})
        members = [{'@odata.id': '/x/1', 'Id': '1'}, {'@odata.id': '/redfish/v1/x/2'}]
        ok, out = redfish.fetch_members(members, 'https://bmc')
        self.assertTrue(ok)
        self.assertEqual(out[0], {'@odata.id': '/x/1', 'Id': '1'})
        self.assertEqual(out[1], {'Id': '2', 'Reading': 2})
        self.assertEqual(url_mock.fetch_json.call_count, 1)

    @mock.patch.object(redfish, 'url')
    def test_malformed_odata_id_is_refused_without_request(self, url_mock):
        ok, out = redfish.fetch_members([{'@odata.id': '@evil/x'}], 'https://bmc')
        self.assertFalse(ok)
        self.assertIn('Refusing', out)
        url_mock.fetch_json.assert_not_called()

    @mock.patch.object(redfish, 'url')
    def test_member_fetch_failure_propagates(self, url_mock):
        url_mock.fetch_json.return_value = (False, 'Bad Gateway')
        ok, out = redfish.fetch_members(
            [{'@odata.id': '/redfish/v1/x/1'}], 'https://bmc'
        )
        self.assertFalse(ok)
        self.assertEqual(out, 'Bad Gateway')

    @mock.patch.object(redfish, 'url')
    def test_non_dict_member_is_skipped(self, url_mock):
        members = ['not-a-dict', {'@odata.id': '/x/1', 'Id': '1'}]
        ok, out = redfish.fetch_members(members, 'https://bmc')
        self.assertTrue(ok)
        self.assertEqual(out, [{'@odata.id': '/x/1', 'Id': '1'}])
        url_mock.fetch_json.assert_not_called()

    def test_empty_members_returns_empty_list(self):
        self.assertEqual(redfish.fetch_members([], 'https://bmc'), (True, []))

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_bare_member_is_cached_by_url(self, url_mock, cache_mock, time_mock):
        cache_mock.get.return_value = False
        time_mock.now.return_value = 1000
        url_mock.fetch_json.return_value = (True, {'Id': '1'})
        ok, out = redfish.fetch_members(
            [{'@odata.id': '/redfish/v1/x/1'}], 'https://bmc', cache_expire=300
        )
        self.assertTrue(ok)
        self.assertEqual(out, [{'Id': '1'}])
        cache_mock.set.assert_called_once_with(
            'redfish-https://bmc/redfish/v1/x/1',
            json.dumps({'Id': '1'}),
            1000 + 300,
            filename=redfish.CACHE_FILENAME,
        )

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_cached_member_skips_the_request(self, url_mock, cache_mock):
        cache_mock.get.return_value = json.dumps({'Id': '1'})
        ok, out = redfish.fetch_members(
            [{'@odata.id': '/redfish/v1/x/1'}], 'https://bmc', cache_expire=300
        )
        self.assertTrue(ok)
        self.assertEqual(out, [{'Id': '1'}])
        url_mock.fetch_json.assert_not_called()


# ---------------------------------------------------------------------------
# fetch_resource (cached plain GET, no $expand; lib.url is mocked)
# ---------------------------------------------------------------------------
class TestFetchResource(unittest.TestCase):
    @mock.patch.object(redfish, 'url')
    def test_plain_get_without_expand(self, url_mock):
        url_mock.fetch_json.return_value = (True, {'Vendor': 'Contoso'})
        ok, out = redfish.fetch_resource('https://bmc/redfish/v1/')
        self.assertTrue(ok)
        self.assertEqual(out, {'Vendor': 'Contoso'})
        self.assertEqual(url_mock.fetch_json.call_count, 1)
        self.assertNotIn('$expand', url_mock.fetch_json.call_args[0][0])

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_cache_hit_skips_the_request(self, url_mock, cache_mock):
        cache_mock.get.return_value = json.dumps({'Vendor': 'Contoso'})
        ok, out = redfish.fetch_resource('https://bmc/redfish/v1/', cache_expire=300)
        self.assertTrue(ok)
        self.assertEqual(out, {'Vendor': 'Contoso'})
        url_mock.fetch_json.assert_not_called()

    @mock.patch.object(redfish, 'url')
    def test_failure_propagates(self, url_mock):
        url_mock.fetch_json.return_value = (False, 'HTTP 500')
        ok, out = redfish.fetch_resource('https://bmc/redfish/v1/')
        self.assertFalse(ok)
        self.assertEqual(out, 'HTTP 500')


# ---------------------------------------------------------------------------
# is_member_expanded (populated vs bare-reference detection)
# ---------------------------------------------------------------------------
class TestIsMemberExpanded(unittest.TestCase):
    def test_bare_reference_is_not_expanded(self):
        self.assertFalse(redfish.is_member_expanded({'@odata.id': '/x/1'}))

    def test_only_odata_annotations_is_not_expanded(self):
        self.assertFalse(
            redfish.is_member_expanded(
                {'@odata.id': '/x/1', '@odata.type': '#Sensor.v1_0_0.Sensor'}
            )
        )

    def test_populated_member_is_expanded(self):
        self.assertTrue(
            redfish.is_member_expanded({'@odata.id': '/x/1', 'Reading': 22.5})
        )

    def test_empty_dict_is_not_expanded(self):
        self.assertFalse(redfish.is_member_expanded({}))

    def test_non_dict_is_not_expanded(self):
        self.assertFalse(redfish.is_member_expanded('nope'))
        self.assertFalse(redfish.is_member_expanded(None))


# ---------------------------------------------------------------------------
# record_responses / format_responses / replay (a --verbose output as a fixture)
# ---------------------------------------------------------------------------
class TestRecordAndReplay(unittest.TestCase):
    def setUp(self):
        self.trace_path = redfish._TRACE['path']
        redfish._TRACE['path'] = ''
        redfish._REPLAY['responses'] = None
        redfish._RESPONSES.update(expand='', formatted=False, items=[], on=True)

    def tearDown(self):
        redfish._TRACE['path'] = self.trace_path
        redfish._REPLAY['responses'] = None
        redfish._RESPONSES.update(expand='', formatted=False, items=[], on=False)

    @mock.patch.object(redfish, 'url')
    def test_a_recorded_walk_replays_without_a_controller(self, url_mock):
        collection = {
            '@odata.id': '/redfish/v1/Chassis/1/Sensors',
            'Members': [{'@odata.id': '/redfish/v1/Chassis/1/Sensors/T1'}],
        }
        sensor = {'@odata.id': '/redfish/v1/Chassis/1/Sensors/T1', 'Reading': 21}
        url_mock.fetch_json.side_effect = [(True, collection), (True, sensor)]
        _, coll = redfish.fetch_collection(
            'https://203.0.113.10/redfish/v1/Chassis/1/Sensors'
        )
        redfish.fetch_members(coll['Members'], 'https://203.0.113.10')
        text = redfish.format_responses()
        # the collection keeps the query it was asked for with, the host stays out
        self.assertIn(
            '### GET /redfish/v1/Chassis/1/Sensors?$expand=.($levels=1)', text
        )
        self.assertNotIn('203.0.113.10', text)

        # replay it surrounded by a check's message, the way a bug report carries it
        redfish._RESPONSES.update(on=False, items=[])
        url_mock.reset_mock()
        self.assertEqual(redfish.replay(f'Everything is ok.\n\n{text}\n'), (True, 2))
        _, coll = redfish.fetch_collection('https://bmc/redfish/v1/Chassis/1/Sensors')
        self.assertEqual(coll, collection)
        self.assertEqual(
            redfish.fetch_members(coll['Members'], 'https://bmc'), (True, [sensor])
        )
        url_mock.fetch_json.assert_not_called()

    @mock.patch.object(redfish, 'url')
    def test_a_failed_request_is_recorded_and_replayed_as_a_failure(self, url_mock):
        url_mock.fetch_json.return_value = (
            False,
            'HTTP error "500 Internal Server Error" while fetching '
            'https://203.0.113.10/redfish/v1/Chassis/1/Thermal',
        )
        redfish.fetch_resource('https://203.0.113.10/redfish/v1/Chassis/1/Thermal')
        text = redfish.format_responses()
        self.assertIn('### GET /redfish/v1/Chassis/1/Thermal (failed)', text)
        self.assertNotIn('203.0.113.10', text)
        redfish.replay(text)
        ok, out = redfish.fetch_resource('https://bmc/redfish/v1/Chassis/1/Thermal')
        self.assertFalse(ok)
        self.assertIn('500 Internal Server Error', out)

    def test_an_unrecorded_path_is_answered_with_a_404(self):
        redfish.replay('### GET /redfish/v1/Chassis\n{"Members": []}')
        ok, out = redfish.fetch_resource('https://bmc/redfish/v1/Chassis/1/Thermal')
        self.assertFalse(ok)
        self.assertIn('404 Not Found', out)

    def test_the_service_root_is_found_with_and_without_a_trailing_slash(self):
        redfish.replay('### GET /redfish/v1\n{"Vendor": "Contoso"}')
        self.assertEqual(
            redfish.fetch_resource('https://bmc/redfish/v1/'), (True, {'Vendor': 'Contoso'})
        )

    def test_the_expand_suffix_is_derived_from_a_replayed_root(self):
        root = {
            'ProtocolFeaturesSupported': {
                'ExpandQuery': {'ExpandAll': True, 'Levels': True, 'MaxLevels': 2}
            }
        }
        redfish.replay(f'### GET /redfish/v1\n{json.dumps(root)}')
        self.assertEqual(
            redfish.get_expand_suffix('https://bmc', cache_expire=300),
            '?$expand=*($levels=1)',
        )

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_a_recording_run_reads_the_root_despite_a_cached_suffix(
        self, url_mock, cache_mock
    ):
        # a sibling consumer cached the suffix; the recording still needs the root
        cache_mock.get.return_value = '?$expand=*($levels=1)'
        url_mock.fetch_json.return_value = (True, {'Vendor': 'Contoso'})
        redfish.get_expand_suffix('https://bmc', cache_expire=300)
        url_mock.fetch_json.assert_called_once()
        self.assertIn('### GET /redfish/v1\n', redfish.format_responses())

    def test_the_output_names_consumer_versions_and_expand_query(self):
        redfish._RESPONSES.update(
            expand='?$expand=*($levels=1)',
            items=[('/redfish/v1/Chassis', {'Members': []}, False)],
        )
        header = redfish.format_responses().split('\n\n')[0]
        self.assertIn(f'lib/redfish.py v{redfish.__version__}', header)
        self.assertIn('Collections requested with: ?$expand=*($levels=1)', header)

    @mock.patch.object(redfish, 'cache')
    def test_a_cached_response_is_recorded_and_marked(self, cache_mock):
        cache_mock.get.return_value = json.dumps({'Members': []})
        redfish.fetch_collection('https://bmc/redfish/v1/Systems', cache_expire=300)
        self.assertIn(
            '### GET /redfish/v1/Systems (from the cache)', redfish.format_responses()
        )

    @mock.patch.object(redfish, 'cache')
    def test_a_replay_neither_reads_nor_writes_the_cache(self, cache_mock):
        redfish.replay('### GET /redfish/v1/Systems\n{"Members": []}')
        redfish.fetch_collection('https://bmc/redfish/v1/Systems', cache_expire=300)
        cache_mock.get.assert_not_called()
        cache_mock.set.assert_not_called()

    @mock.patch.object(redfish, 'url')
    def test_a_replay_does_not_log_in(self, url_mock):
        redfish.replay('### GET /redfish/v1\n{}')
        self.assertEqual(redfish.get_auth_header(_args(), cache_expire=300), {})
        url_mock.fetch_json.assert_not_called()

    @mock.patch.object(redfish, 'url')
    def test_sensitive_fields_are_redacted(self, url_mock):
        url_mock.fetch_json.return_value = (
            True,
            {'Id': '1', 'Password': 'linuxfabrik', 'Oem': {'Contoso': {'Token': 'x1y2'}}},
        )
        redfish.fetch_resource('https://bmc/redfish/v1/AccountService/Accounts/1')
        text = redfish.format_responses()
        self.assertNotIn('linuxfabrik', text)
        self.assertNotIn('x1y2', text)

    @mock.patch.object(redfish, 'url')
    def test_nothing_is_recorded_unless_switched_on(self, url_mock):
        redfish._RESPONSES['on'] = False
        url_mock.fetch_json.return_value = (True, {'Id': '1'})
        redfish.fetch_resource('https://bmc/redfish/v1/Systems/1')
        self.assertEqual(redfish._RESPONSES['items'], [])

    def test_replay_without_recorded_responses_fails(self):
        ok, err = redfish.replay('Everything is ok. Checked sensors on 1 member.')
        self.assertFalse(ok)
        self.assertIn('no recorded Redfish responses', err)
        self.assertIsNone(redfish._REPLAY['responses'])

    def test_replay_of_broken_json_names_the_path(self):
        ok, err = redfish.replay('### GET /redfish/v1/Chassis\n{"Members": [')
        self.assertFalse(ok)
        self.assertIn('/redfish/v1/Chassis', err)

    @mock.patch.object(redfish, 'atexit')
    def test_the_exit_handler_is_registered_once(self, atexit_mock):
        redfish._RESPONSES['on'] = False
        redfish.record_responses()
        redfish.record_responses()
        atexit_mock.register.assert_called_once_with(
            redfish._print_unformatted_responses
        )

    def test_the_exit_handler_prints_only_what_was_not_handed_over(self):
        redfish._RESPONSES['items'] = [('/redfish/v1/Chassis', {'Name': 'a|b'}, False)]
        with mock.patch('builtins.print') as print_mock:
            redfish._print_unformatted_responses()
        printed = print_mock.call_args[0][0]
        self.assertIn('### GET /redfish/v1/Chassis', printed)
        # a pipe would start the performance data of the check's output
        self.assertNotIn('|', printed)
        with mock.patch('builtins.print') as print_mock:
            redfish._print_unformatted_responses()
        print_mock.assert_not_called()


# ---------------------------------------------------------------------------
# get_manager, get_systems_ethernetinterfaces, get_systems_processors,
# get_systems_storage_volumes, get_updateservice_firmwareinventory: the
# remaining flat+nested projections. Same contract as the ones above: every
# documented key is always present, a field the controller omits reads as ''.
# ---------------------------------------------------------------------------
class TestGetManager(unittest.TestCase):
    BODY: typing.ClassVar = {
        'FirmwareVersion': '1.45',
        'Id': 'iDRAC.Embedded.1',
        'ManagerType': 'BMC',
        'Model': '13G Monolithic',
        'Name': 'Manager',
        'PowerState': 'On',
        'Status': {'State': 'Enabled', 'Health': 'OK', 'HealthRollup': 'OK'},
        'UUID': '3242-4a34',
    }

    def test_full_payload(self):
        out = redfish.get_manager(self.BODY)
        self.assertEqual(out['FirmwareVersion'], '1.45')
        self.assertEqual(out['ManagerType'], 'BMC')
        self.assertEqual(out['UUID'], '3242-4a34')
        self.assertEqual(out['Status_State'], 'Enabled')
        self.assertEqual(out['Status_HealthRollup'], 'OK')

    def test_empty(self):
        out = redfish.get_manager({})
        self.assertEqual(set(out.values()), {''})

    def test_output_key_set_is_exact(self):
        expected = set(redfish.MANAGER_KEYS) | set(redfish.MANAGER_NESTED_KEYS)
        self.assertEqual(set(redfish.get_manager({})), expected)

    def test_missing_healthrollup_reads_empty(self):
        body = dict(self.BODY, Status={'State': 'Enabled', 'Health': 'OK'})
        self.assertEqual(redfish.get_manager(body)['Status_HealthRollup'], '')


class TestGetSystemsEthernetInterfaces(unittest.TestCase):
    BODY: typing.ClassVar = {
        'Description': 'NIC 1',
        'FQDN': 'host.example.com',
        'FullDuplex': True,
        'HostName': 'host',
        'Id': 'NIC.1',
        'LinkStatus': 'LinkUp',
        'MACAddress': '00-00-5E-00-53-00',
        'Name': 'System NIC 1',
        'PermanentMACAddress': '00-00-5E-00-53-00',
        'SpeedMbps': 1000,
        'Status': {'State': 'Enabled', 'Health': 'OK'},
    }

    def test_full_payload(self):
        out = redfish.get_systems_ethernetinterfaces(self.BODY)
        self.assertEqual(out['MACAddress'], '00-00-5E-00-53-00')
        self.assertEqual(out['LinkStatus'], 'LinkUp')
        self.assertEqual(out['SpeedMbps'], 1000)
        self.assertIs(out['FullDuplex'], True)
        self.assertEqual(out['Status_Health'], 'OK')
        # the controller sent no rollup
        self.assertEqual(out['Status_HealthRollup'], '')

    def test_empty(self):
        out = redfish.get_systems_ethernetinterfaces({})
        self.assertEqual(set(out.values()), {''})

    def test_output_key_set_is_exact(self):
        expected = set(redfish.ETHERNET_KEYS) | set(redfish.ETHERNET_NESTED_KEYS)
        self.assertEqual(set(redfish.get_systems_ethernetinterfaces({})), expected)

    def test_down_link_is_passed_through(self):
        body = dict(self.BODY, LinkStatus='LinkDown', SpeedMbps=None)
        out = redfish.get_systems_ethernetinterfaces(body)
        self.assertEqual(out['LinkStatus'], 'LinkDown')
        self.assertIsNone(out['SpeedMbps'])


class TestGetSystemsProcessors(unittest.TestCase):
    BODY: typing.ClassVar = {
        'Id': 'CPU.Socket.1',
        'InstructionSet': 'x86-64',
        'Location': {'PartLocation': {'ServiceLabel': 'CPU 1'}},
        'Manufacturer': 'Intel',
        'MaxSpeedMHz': 3600,
        'Model': 'Xeon Gold 6338',
        'Name': 'CPU 1',
        'ProcessorArchitecture': 'x86',
        'ProcessorType': 'CPU',
        'Socket': 'CPU.Socket.1',
        'Status': {'State': 'Enabled', 'Health': 'OK'},
        'TotalCores': 32,
        'TotalThreads': 64,
    }

    def test_full_payload(self):
        out = redfish.get_systems_processors(self.BODY)
        self.assertEqual(out['Model'], 'Xeon Gold 6338')
        self.assertEqual(out['TotalCores'], 32)
        self.assertEqual(out['TotalThreads'], 64)
        self.assertEqual(out['MaxSpeedMHz'], 3600)
        self.assertEqual(out['Status_Health'], 'OK')

    def test_three_level_location_path(self):
        out = redfish.get_systems_processors(self.BODY)
        self.assertEqual(out['Location_ServiceLabel'], 'CPU 1')

    def test_partial_location_reads_empty(self):
        body = dict(self.BODY, Location={'PartLocation': {}})
        self.assertEqual(
            redfish.get_systems_processors(body)['Location_ServiceLabel'], ''
        )

    def test_empty(self):
        out = redfish.get_systems_processors({})
        self.assertEqual(set(out.values()), {''})

    def test_output_key_set_is_exact(self):
        expected = set(redfish.PROCESSOR_KEYS) | set(redfish.PROCESSOR_NESTED_KEYS)
        self.assertEqual(set(redfish.get_systems_processors({})), expected)


class TestGetSystemsStorageVolumes(unittest.TestCase):
    BODY: typing.ClassVar = {
        'CapacityBytes': 1000000000000,
        'Encrypted': False,
        'Id': 'Disk.Virtual.0',
        'Name': 'Virtual Disk 0',
        'RAIDType': 'RAID1',
        'Status': {'State': 'Enabled', 'Health': 'OK'},
        'VolumeType': 'Mirrored',
    }

    def test_capacity_is_humanized(self):
        out = redfish.get_systems_storage_volumes(self.BODY)
        # binary units, as lib.human.bytes2human renders them
        self.assertEqual(out['CapacityBytes'], '931.3GiB')
        self.assertEqual(out['RAIDType'], 'RAID1')
        self.assertIs(out['Encrypted'], False)

    def test_missing_capacity_reads_empty(self):
        body = dict(self.BODY)
        del body['CapacityBytes']
        self.assertEqual(redfish.get_systems_storage_volumes(body)['CapacityBytes'], '')

    def test_non_numeric_capacity_reads_empty(self):
        # firmware that answers "N/A" for a member it cannot read must not take
        # the whole check down
        body = dict(self.BODY, CapacityBytes='N/A')
        self.assertEqual(redfish.get_systems_storage_volumes(body)['CapacityBytes'], '')

    def test_numeric_string_capacity_is_humanized(self):
        body = dict(self.BODY, CapacityBytes='1000000000000')
        out = redfish.get_systems_storage_volumes(body)
        self.assertEqual(out['CapacityBytes'], '931.3GiB')

    def test_output_key_set_is_exact(self):
        expected = set(redfish.VOLUME_KEYS) | set(redfish.VOLUME_NESTED_KEYS)
        self.assertEqual(set(redfish.get_systems_storage_volumes({})), expected)


