def load(body):
    """Decode a captured body the way a plugin does after lib.url fetched it."""
    return json.loads(body)


# ---------------------------------------------------------------------------
# Shared expectations derived from the dependencies (probed, then pinned), so a
# change in base/human surfaces here instead of silently passing.
# ---------------------------------------------------------------------------

CRIT_SUFFIX = base.state2str(STATE_CRIT, prefix=' ')  # ' [CRITICAL]'
WARN_SUFFIX = base.state2str(STATE_WARN, prefix=' ')  # ' [WARNING]'
CAP_500GB = human.bytes2human(500000000000)  # '465.7GiB'


# ---------------------------------------------------------------------------
# get_auth_header (create a session, return header + token + ttl; lib.url mocked)
# ---------------------------------------------------------------------------
# a session creation response as lib.url returns it with extended=True: the
# X-Auth-Token header, lower-cased by lib.url (RFC 9110, section 5.1).
SESSION_CREATED = (True, {'response_header': {'x-auth-token': 'new-token'}})

UNAUTHORIZED = (
    'HTTP error "401 Unauthorized" while fetching '
    'https://203.0.113.10/redfish/v1/Chassis'
)


def _args(**over):
    """Build a minimal args namespace with sane, RFC-5737 defaults."""
    values = {
        'CACHE_EXPIRE': 60,  # minutes
        'INSECURE': True,
        'NO_PROXY': False,
        'PASSWORD': 'linuxfabrik',
        'TIMEOUT': 8,
        'URL': 'https://203.0.113.10',
        'USERNAME': 'linuxfabrik',
    }
    values.update(over)
    return types.SimpleNamespace(**values)


TOKEN_KEY = 'redfish-https://203.0.113.10-linuxfabrik-token'
SESSION_KEY = 'redfish-https://203.0.113.10-linuxfabrik-session'


class TestGetAuthHeader(unittest.TestCase):
    def test_no_credentials_returns_empty_header(self):
        # Without both username and password there is nothing to authenticate.
        self.assertEqual(redfish.get_auth_header(_args(USERNAME='', PASSWORD='')), {})
        self.assertEqual(redfish.get_auth_header(_args(PASSWORD='')), {})

    @mock.patch.object(redfish, 'url')
    def test_uncached_session_returns_token_header_without_probing_timeout(
        self, url_mock
    ):
        # cache_expire=0 (default): create a session, return its token header, and
        # do NOT probe the SessionService (there is no lifetime to bound).
        url_mock.fetch_json.side_effect = [SESSION_CREATED]
        header = redfish.get_auth_header(_args())
        self.assertEqual(header, {'X-Auth-Token': 'new-token'})
        self.assertEqual(url_mock.fetch_json.call_count, 1)

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_cached_token_short_circuits(self, url_mock, cache_mock):
        # A cached token is returned as-is; no session is created.
        cache_mock.get.return_value = 'cached-token'
        header = redfish.get_auth_header(_args(), cache_expire=300)
        self.assertEqual(header, {'X-Auth-Token': 'cached-token'})
        url_mock.fetch_json.assert_not_called()
        cache_mock.set.assert_not_called()

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_caching_bounds_ttl_with_session_timeout_margin(
        self, url_mock, cache_mock, time_mock
    ):
        cache_mock.get.return_value = False  # cache miss
        time_mock.now.return_value = 1000
        url_mock.fetch_json.side_effect = [
            SESSION_CREATED,
            (True, {'SessionTimeout': 300}),
        ]
        header = redfish.get_auth_header(_args(TIMEOUT=8), cache_expire=3600)
        self.assertEqual(header, {'X-Auth-Token': 'new-token'})
        # 300 - 8 = 292, cached until now + 292
        self.assertEqual(
            cache_mock.set.call_args_list[0][0],
            (TOKEN_KEY, 'new-token', 1000 + 292),
        )

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_cache_expire_does_not_cap_the_session_timeout(
        self, url_mock, cache_mock, time_mock
    ):
        # A token is a credential, not data that goes stale: it stays valid until the
        # session ends, so cache_expire (which keeps fetched data fresh) must not shorten
        # it. Capping it here used to force a login, and therefore a new session, every
        # cache_expire seconds, leaving the controller with one session per interval.
        cache_mock.get.return_value = False
        time_mock.now.return_value = 1000
        url_mock.fetch_json.side_effect = [
            SESSION_CREATED,
            (True, {'SessionTimeout': 86400}),
        ]
        redfish.get_auth_header(_args(TIMEOUT=8), cache_expire=60)
        # 86400 - 8, not the 60 of cache_expire
        self.assertEqual(cache_mock.set.call_args_list[0][0][2], 1000 + 86392)

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_string_session_timeout_is_coerced(self, url_mock, cache_mock, time_mock):
        cache_mock.get.return_value = False
        time_mock.now.return_value = 1000
        url_mock.fetch_json.side_effect = [
            SESSION_CREATED,
            (True, {'SessionTimeout': '300'}),
        ]
        redfish.get_auth_header(_args(TIMEOUT=8), cache_expire=3600)
        self.assertEqual(cache_mock.set.call_args[0][2], 1000 + 292)

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_an_absurd_session_timeout_is_capped_at_the_schema_maximum(
        self, url_mock, cache_mock, time_mock
    ):
        # beyond what SQLite stores as an integer, the token could not be cached at all
        cache_mock.get.return_value = False
        time_mock.now.return_value = 1000
        url_mock.fetch_json.side_effect = [
            SESSION_CREATED,
            (True, {'SessionTimeout': 10**20}),
        ]
        redfish.get_auth_header(_args(TIMEOUT=8), cache_expire=3600)
        self.assertEqual(
            cache_mock.set.call_args_list[0][0], (TOKEN_KEY, 'new-token', 1000 + 86392)
        )

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_an_unusable_session_timeout_falls_back_to_cache_expire(
        self, url_mock, cache_mock, time_mock
    ):
        for value in (True, 'inf', -300, [300]):
            with self.subTest(value=value):
                cache_mock.reset_mock()
                cache_mock.get.return_value = False
                time_mock.now.return_value = 1000
                url_mock.fetch_json.side_effect = [
                    SESSION_CREATED,
                    (True, {'SessionTimeout': value}),
                ]
                redfish.get_auth_header(_args(TIMEOUT=8), cache_expire=3600)
                self.assertEqual(
                    cache_mock.set.call_args_list[0][0],
                    (TOKEN_KEY, 'new-token', 1000 + 3600),
                )

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_margin_never_drops_below_one_second(self, url_mock, cache_mock, time_mock):
        # SessionTimeout below the margin would go negative; clamped to 1.
        cache_mock.get.return_value = False
        time_mock.now.return_value = 1000
        url_mock.fetch_json.side_effect = [
            SESSION_CREATED,
            (True, {'SessionTimeout': 5}),
        ]
        redfish.get_auth_header(_args(TIMEOUT=8), cache_expire=3600)
        self.assertEqual(cache_mock.set.call_args[0][2], 1000 + 1)

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_missing_session_timeout_falls_back_to_cache_expire(
        self, url_mock, cache_mock, time_mock
    ):
        cache_mock.get.return_value = False
        time_mock.now.return_value = 1000
        url_mock.fetch_json.side_effect = [SESSION_CREATED, (True, {'Id': 'default'})]
        redfish.get_auth_header(_args(TIMEOUT=8), cache_expire=120)
        # only cache_expire applies: 120
        self.assertEqual(cache_mock.set.call_args[0][2], 1000 + 120)

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_sessionservice_get_failure_falls_back_to_cache_expire(
        self, url_mock, cache_mock, time_mock
    ):
        cache_mock.get.return_value = False
        time_mock.now.return_value = 1000
        url_mock.fetch_json.side_effect = [SESSION_CREATED, (False, 'Bad Gateway')]
        redfish.get_auth_header(_args(TIMEOUT=8), cache_expire=180)
        self.assertEqual(cache_mock.set.call_args[0][2], 1000 + 180)

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_session_creation_failure_falls_back_to_basic_auth(
        self, url_mock, cache_mock
    ):
        # No X-Auth-Token in the response header -> no session token.
        cache_mock.get.return_value = False
        url_mock.fetch_json.side_effect = [(False, 'Unauthorized')]
        header = redfish.get_auth_header(_args(), cache_expire=300)
        # 'linuxfabrik:linuxfabrik' base64-encoded.
        self.assertEqual(
            header, {'Authorization': 'Basic bGludXhmYWJyaWs6bGludXhmYWJyaWs='}
        )
        # nothing is cached on the Basic-auth fallback
        cache_mock.set.assert_not_called()
        # Only the session-creation POST was attempted; no SessionService GET.
        self.assertEqual(url_mock.fetch_json.call_count, 1)

    @mock.patch.object(redfish, 'url')
    def test_non_dict_session_response_falls_back_to_basic_auth(self, url_mock):
        # success but body is not a dict -> the isinstance guard rejects it.
        url_mock.fetch_json.side_effect = [(True, 'not-a-dict')]
        header = redfish.get_auth_header(_args())
        self.assertEqual(
            header, {'Authorization': 'Basic bGludXhmYWJyaWs6bGludXhmYWJyaWs='}
        )


# ---------------------------------------------------------------------------
# get_chassis
# ---------------------------------------------------------------------------

class TestSessionLifecycle(unittest.TestCase):
    """The session a login creates must not outlive its usefulness on the controller."""

    def setUp(self):
        redfish._AUTH['renewable'] = True
        redfish._AUTH['args'] = None

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_session_is_remembered_for_the_next_run_to_delete(
        self, url_mock, cache_mock, time_mock
    ):
        # The run that opens a session is gone by the time its token expires, so the
        # session's URL and token are cached for the next run to hand back.
        cache_mock.get.return_value = False
        time_mock.now.return_value = 1000
        url_mock.fetch_json.side_effect = [
            (
                True,
                {
                    'response_header': {
                        'x-auth-token': 'new-token',
                        'location': '/redfish/v1/SessionService/Sessions/7',
                    }
                },
            ),
            (True, {'SessionTimeout': 300}),
        ]
        redfish.get_auth_header(_args(TIMEOUT=8), cache_expire=3600)
        stored = [
            c for c in cache_mock.set.call_args_list if c[0][0].endswith('-session')
        ]
        self.assertEqual(len(stored), 1)
        self.assertEqual(
            json.loads(stored[0][0][1]),
            {
                'uri': 'https://203.0.113.10/redfish/v1/SessionService/Sessions/7',
                'token': 'new-token',
                'timeout': 300,
            },
        )
        # kept for as long as the controller keeps the session, not just as long as the token
        self.assertEqual(stored[0][0][2], 1000 + 300)

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_an_unknown_session_timeout_is_remembered_as_zero(
        self, url_mock, cache_mock, time_mock
    ):
        # a controller that does not report its SessionTimeout leaves nothing to
        # re-arm by
        cache_mock.get.return_value = False
        time_mock.now.return_value = 1000
        url_mock.fetch_json.side_effect = [
            (
                True,
                {
                    'response_header': {
                        'x-auth-token': 'new-token',
                        'location': '/redfish/v1/SessionService/Sessions/7',
                    }
                },
            ),
            (True, {}),
        ]
        redfish.get_auth_header(_args(), cache_expire=300)
        stored = [
            c for c in cache_mock.set.call_args_list if c[0][0].endswith('-session')
        ]
        self.assertEqual(json.loads(stored[0][0][1])['timeout'], 0)

    def _reuse(self, session_entry, timeout=8):
        """Hand out the cached token 'cached-token' at time 2000, with `session_entry`
        as the stored session, and return the header, the cache writes and the
        requests."""

        def _get(key, **kwargs):
            return 'cached-token' if key == TOKEN_KEY else session_entry

        cache_patch = mock.patch.object(redfish, 'cache')
        url_patch = mock.patch.object(redfish, 'url')
        time_patch = mock.patch.object(redfish, 'time')
        with cache_patch as cache_mock, url_patch as url_mock, time_patch as time_mock:
            cache_mock.get.side_effect = _get
            time_mock.now.return_value = 2000
            header = redfish.get_auth_header(_args(TIMEOUT=timeout), cache_expire=300)
            writes = [c[0] for c in cache_mock.set.call_args_list]
            return header, writes, url_mock.method_calls

    @staticmethod
    def _session(**over):
        entry = {
            'uri': 'https://203.0.113.10/redfish/v1/SessionService/Sessions/7',
            'token': 'cached-token',
            'timeout': 300,
        }
        entry.update(over)
        return json.dumps(entry)

    def test_a_reused_token_is_kept_alive(self):
        # the controller restarts its inactivity timeout with every request the token
        # carries, so both cache entries start over (#350)
        session = self._session()
        header, writes, requests = self._reuse(session)
        self.assertEqual(header, {'X-Auth-Token': 'cached-token'})
        self.assertEqual(
            writes,
            [
                (TOKEN_KEY, 'cached-token', 2000 + 300 - 8),
                (SESSION_KEY, session, 2000 + 300),
            ],
        )
        self.assertEqual(requests, [])

    def test_the_margin_never_drops_below_one_second(self):
        _, writes, _ = self._reuse(self._session(timeout=5), timeout=8)
        self.assertEqual(writes[0], (TOKEN_KEY, 'cached-token', 2000 + 1))

    def test_a_timeout_stored_as_text_still_counts(self):
        _, writes, _ = self._reuse(self._session(timeout='300'))
        self.assertEqual(writes[0], (TOKEN_KEY, 'cached-token', 2000 + 292))

    def test_an_absurd_stored_timeout_is_capped_at_the_schema_maximum(self):
        _, writes, _ = self._reuse(self._session(timeout=10**20))
        self.assertEqual(writes[0], (TOKEN_KEY, 'cached-token', 2000 + 86400 - 8))
        self.assertEqual(writes[1][2], 2000 + 86400)

    @mock.patch.object(redfish, 'time')
    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_re_arming_uses_the_caller_s_cache_file(
        self, url_mock, cache_mock, time_mock
    ):
        session = self._session()
        cache_mock.get.side_effect = lambda key, **kwargs: (
            'cached-token' if key == TOKEN_KEY else session
        )
        time_mock.now.return_value = 2000
        redfish.get_auth_header(_args(), cache_expire=300, cache_filename='other.db')
        for call in cache_mock.get.call_args_list + cache_mock.set.call_args_list:
            self.assertEqual(call[1], {'filename': 'other.db'})
        self.assertEqual(cache_mock.set.call_count, 2)

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_without_caching_nothing_is_read_or_re_armed(self, url_mock, cache_mock):
        url_mock.fetch_json.side_effect = [SESSION_CREATED]
        redfish.get_auth_header(_args())
        self.assertEqual(cache_mock.method_calls, [])

    def test_nothing_is_re_armed_without_a_matching_session(self):
        # another session's token, no known timeout, an entry written before the timeout
        # was stored, no entry at all, and whatever else the cache might hold: the token
        # keeps the lifetime it got at login
        cases = {
            'another token': self._session(token='other-token'),
            'timeout zero': self._session(timeout=0),
            'negative timeout': self._session(timeout=-5),
            'timeout not a number': self._session(timeout='abc'),
            'timeout a boolean': self._session(timeout=True),
            'timeout infinite': self._session(timeout='inf'),
            'entry without timeout': json.dumps({'uri': 'u', 'token': 'cached-token'}),
            'no entry': False,
            'no JSON': 'x{',
            'a JSON list': '[]',
            'a JSON string': '"cached-token"',
        }
        for label, entry in cases.items():
            with self.subTest(label):
                header, writes, requests = self._reuse(entry)
                self.assertEqual(header, {'X-Auth-Token': 'cached-token'})
                self.assertEqual(writes, [])
                self.assertEqual(requests, [])

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_previous_session_is_handed_back_before_a_new_login(
        self, url_mock, cache_mock
    ):
        # A stored session note makes the next login delete its predecessor first.
        def _get(key, **kwargs):
            if key.endswith('-session'):
                return json.dumps(
                    {
                        'uri': 'https://203.0.113.10/redfish/v1/SessionService/Sessions/1',
                        'token': 'old-token',
                    }
                )
            return False

        cache_mock.get.side_effect = _get
        url_mock.fetch.return_value = (True, '')
        url_mock.fetch_json.side_effect = [SESSION_CREATED, (True, {})]
        redfish.get_auth_header(_args(), cache_expire=300)
        url_mock.fetch.assert_called_once()
        self.assertEqual(
            url_mock.fetch.call_args[0][0],
            'https://203.0.113.10/redfish/v1/SessionService/Sessions/1',
        )
        self.assertEqual(url_mock.fetch.call_args[1]['method'], 'DELETE')
        self.assertEqual(
            url_mock.fetch.call_args[1]['header']['X-Auth-Token'], 'old-token'
        )

    @mock.patch.object(redfish, 'url')
    def test_session_url_is_pinned_to_the_operator_supplied_host(self, url_mock):
        # A controller naming another host in Location must not receive the token.
        result = {
            'response_header': {
                'location': 'https://evil.example.com/redfish/v1/SessionService/Sessions/1'
            }
        }
        self.assertEqual(
            redfish._session_url('https://203.0.113.10', result),
            'https://203.0.113.10/redfish/v1/SessionService/Sessions/1',
        )

    @mock.patch.object(redfish, 'url')
    def test_login_retries_are_capped(self, url_mock):
        # A controller creates the session before it answers, so an abandoned attempt
        # leaves one behind. A caller's read budget must not be spent on logins.
        url_mock.fetch_json.side_effect = [(False, 'boom')]
        redfish.get_auth_header(_args(RETRIES=10), cache_expire=0)
        self.assertEqual(
            url_mock.fetch_json.call_args[1]['retries'], redfish.MAX_LOGIN_RETRIES
        )


class TestUnauthorizedDetection(unittest.TestCase):
    """`_is_unauthorized()` reads an error string produced by `lib.url`, so pin the format."""

    def test_recognises_a_real_401_from_lib_url(self):
        # Built the way url.fetch() builds it, so a change to its wording fails here
        # instead of silently disabling token renewal.
        message = (
            'HTTP error "401 Unauthorized" while fetching '
            'https://203.0.113.10/redfish/v1/Chassis'
        )
        self.assertTrue(redfish._is_unauthorized(message))

    def test_ignores_every_other_failure(self):
        for message in (
            'HTTP error "500 Internal Server Error" while fetching https://203.0.113.10/x',
            'HTTP error "403 Forbidden" while fetching https://203.0.113.10/x',
            'URL error "The read operation timed out" for https://203.0.113.10/x',
            '',
            None,
        ):
            self.assertFalse(redfish._is_unauthorized(message), message)


class TestAuthRenewal(unittest.TestCase):
    """A 401 on a read means the session died, not that the credentials are wrong."""

    def setUp(self):
        redfish._AUTH.update(
            {
                'args': _args(),
                'cache_expire': 300,
                'cache_filename': redfish.CACHE_FILENAME,
                'token_key': TOKEN_KEY,
                'renewable': True,
            }
        )

    def tearDown(self):
        redfish._AUTH['args'] = None
        redfish._AUTH['renewable'] = True

    def test_only_a_401_on_a_read_triggers_a_renewal(self):
        self.assertTrue(redfish._should_renew('collection', (False, UNAUTHORIZED)))
        # not on the requests that are themselves the login
        self.assertFalse(redfish._should_renew('login', (False, UNAUTHORIZED)))
        self.assertFalse(redfish._should_renew('sessionsvc', (False, UNAUTHORIZED)))
        # not on a success, and not on another failure
        self.assertFalse(redfish._should_renew('collection', (True, {})))
        self.assertFalse(redfish._should_renew('collection', (False, 'timed out')))

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_renewal_replaces_the_token_in_the_caller_s_header(self, url_mock, cache_mock):
        # The header dict is the one the caller passes to every fetch, so updating it in
        # place is what makes the requests after the retry carry the new token too.
        cache_mock.get.return_value = False
        url_mock.fetch_json.side_effect = [SESSION_CREATED, (True, {})]
        header = {'Accept': 'application/json', 'X-Auth-Token': 'stale-token'}
        self.assertTrue(redfish._renew_auth(header))
        self.assertEqual(header['X-Auth-Token'], 'new-token')

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_a_basic_auth_renewal_drops_the_dead_token(self, url_mock, cache_mock):
        # Falling back to Basic must not leave the rejected token beside it.
        cache_mock.get.return_value = False
        url_mock.fetch_json.side_effect = [(False, 'no session service')]
        header = {'X-Auth-Token': 'stale-token'}
        self.assertTrue(redfish._renew_auth(header))
        self.assertNotIn('X-Auth-Token', header)
        self.assertIn('Authorization', header)

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_renews_at_most_once_per_run(self, url_mock, cache_mock):
        # With wrong credentials every request comes back 401; renewing on each of them
        # would flood the controller with logins instead of failing quickly.
        cache_mock.get.return_value = False
        url_mock.fetch_json.side_effect = [SESSION_CREATED, (True, {})]
        header = {'X-Auth-Token': 'stale-token'}
        self.assertTrue(redfish._renew_auth(header))
        self.assertFalse(redfish._renew_auth(header))

    @mock.patch.object(redfish, 'cache')
    @mock.patch.object(redfish, 'url')
    def test_a_refused_login_disables_renewal(self, url_mock, cache_mock):
        # The controller rejected the credentials themselves, so a later 401 on a read is
        # not a stale token and logging in again would only repeat the refusal.
        cache_mock.get.return_value = False
        url_mock.fetch_json.side_effect = [(False, UNAUTHORIZED)]
        redfish.get_auth_header(_args(), cache_expire=300)
        self.assertFalse(redfish._AUTH['renewable'])
        self.assertFalse(redfish._should_renew('collection', (False, UNAUTHORIZED)))


class TestGetChassis(unittest.TestCase):
    def test_full_payload(self):
        out = redfish.get_chassis(load(CHASSIS_BODY))
        self.assertEqual(
            out,
            {
                'AssetTag': 'LF-ASSET-001',
                'ChassisType': 'RackMount',
                'Id': '1',
                'IndicatorLED': 'Off',
                'Manufacturer': 'Dell Inc.',
                'Model': 'PowerEdge R750',
                'PartNumber': '0ABCDE',
                'PowerState': 'On',
                'SerialNumber': 'SN1234567',
                'SKU': 'SKU-9000',
                'Sensors_@odata.id': '/redfish/v1/Chassis/1/Sensors',
                'Status_State': 'Enabled',
                'Status_Health': 'OK',
                'Status_HealthRollup': 'OK',
            },
        )

    def test_empty_dict_all_blank(self):
        out = redfish.get_chassis({})
        # every flat key present and '' ...
        for key in redfish.CHASSIS_KEYS:
            self.assertEqual(out[key], '')
        # ... and every nested key present and ''
        for key in redfish.CHASSIS_NESTED_KEYS:
            self.assertEqual(out[key], '')

    def test_missing_status_subtree(self):
        out = redfish.get_chassis({'Id': '7'})
        self.assertEqual(out['Id'], '7')
        self.assertEqual(out['Status_State'], '')
        self.assertEqual(out['Status_Health'], '')
        self.assertEqual(out['Status_HealthRollup'], '')
        self.assertEqual(out['Sensors_@odata.id'], '')

    def test_partial_nested_status(self):
        out = redfish.get_chassis({'Status': {'Health': 'Warning'}})
        self.assertEqual(out['Status_Health'], 'Warning')
        self.assertEqual(out['Status_State'], '')

    def test_output_key_set_is_exact(self):
        out = redfish.get_chassis({})
        expected = set(redfish.CHASSIS_KEYS) | set(redfish.CHASSIS_NESTED_KEYS)
        self.assertEqual(set(out), expected)


