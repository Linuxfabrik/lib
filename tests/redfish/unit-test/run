        self.assertEqual(
            set(redfish.get_updateservice_firmwareinventory({})), expected
        )


# ---------------------------------------------------------------------------
# start_trace: writes the trace file the --verbose switch produces. Everything
# here runs against a temporary directory, never the real per-user one.
# ---------------------------------------------------------------------------
class TestStartTrace(unittest.TestCase):
    def setUp(self):
        self.tmpdir = tempfile.mkdtemp()
        self.addCleanup(shutil.rmtree, self.tmpdir, True)
        self._trace_before = dict(redfish._TRACE)

        def restore():
            redfish._TRACE.clear()
            redfish._TRACE.update(self._trace_before)

        self.addCleanup(restore)

    def _read_trace(self, path):
        with open(path, 'rb') as file_handle:
            return file_handle.read().decode('utf-8', 'replace')

    def test_creates_file_and_writes_header(self):
        success, path = redfish.start_trace(self.tmpdir, filename='trace.log')
        self.assertTrue(success)
        self.assertTrue(path.startswith(self.tmpdir))
        self.assertIn('lib/redfish.py v', self._read_trace(path))

    def test_trace_line_is_appended(self):
        _, path = redfish.start_trace(self.tmpdir, filename='trace.log')
        redfish._trace('request', 'GET /redfish/v1/')
        self.assertIn('GET /redfish/v1/', self._read_trace(path))

    def test_credentials_are_redacted(self):
        _, path = redfish.start_trace(self.tmpdir, filename='trace.log')
        redfish._trace('request', 'token=supersecret')
        content = self._read_trace(path)
        self.assertNotIn('supersecret', content)
        self.assertIn('token=******', content)

    def test_lone_surrogate_does_not_raise(self):
        # An argument the host handed over as undecodable bytes arrives as a lone
        # surrogate. Writing it must not turn a working check into an UNKNOWN.
        _, path = redfish.start_trace(self.tmpdir, filename='trace.log')
        redfish._trace('request', 'GET /redfish/v1/\udcff and \ud800')
        self.assertIn('GET /redfish/v1/', self._read_trace(path))

    def test_trace_off_writes_nothing(self):
        path = os.path.join(self.tmpdir, 'untouched.log')
        redfish._TRACE['fd'] = None
        redfish._trace('request', 'GET /redfish/v1/')
        self.assertFalse(os.path.exists(path))


if __name__ == '__main__':
    unittest.main()
