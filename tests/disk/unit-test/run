"""Unit tests for lib.disk, driven by throwaway temp files and mocks.

The host-inspecting helpers (get_real_disks, bd2dmd, udevadm) are driven
through a mocked read_file()/shell_exec(), so the parsing they do is covered
without real block devices. get_block_devices() reads sysfs directly and is
checked only for its return shape here.
"""

import os
import shutil
import sys
import tempfile
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.disk as disk

# Content to hash, and its digests as `md5sum` and `sha256sum` report them.
PROBE = 'linuxfabrik'
PROBE_MD5 = 'c7eba1f83b2e7424c8be2f0ad939ec2f'
PROBE_SHA256 = '7cc11c2c04d52bf5e867affd66a2ba02a3dde8292f6800d10a72641538bb14fc'


class TestFileHelpers(unittest.TestCase):
    def setUp(self):
        self.dir = tempfile.mkdtemp(prefix='lftest-disk-')
        self.file = os.path.join(self.dir, 'x.txt')

    def test_write_read_roundtrip(self):
        self.assertEqual(disk.write_file(self.file, 'hello'), (True, None))
        self.assertEqual(disk.read_file(self.file), (True, 'hello'))

    def test_read_file_binary(self):
        disk.write_file(self.file, 'héllo')
        self.assertEqual(
            disk.read_file(self.file, binary=True), (True, 'héllo'.encode())
        )

    def test_write_append(self):
        disk.write_file(self.file, 'a')
        disk.write_file(self.file, 'b', append=True)
        self.assertEqual(disk.read_file(self.file), (True, 'ab'))

    def test_dir_and_file_exists(self):
        disk.write_file(self.file, 'x')
        self.assertTrue(disk.dir_exists(self.dir))
        self.assertTrue(disk.file_exists(self.file))
        self.assertFalse(disk.file_exists(os.path.join(self.dir, 'nope')))

    def test_file_exists_allow_empty_parameter(self):
        empty = os.path.join(self.dir, 'empty')
        disk.write_file(empty, '')
        self.assertFalse(disk.file_exists(empty))
        self.assertTrue(disk.file_exists(empty, allow_empty=True))

    def test_is_symlink(self):
        disk.write_file(self.file, 'x')
        self.assertFalse(disk.is_symlink(self.file))
        link = os.path.join(self.dir, 'link')
        os.symlink(self.file, link)
        self.assertTrue(disk.is_symlink(link))
        # A path that cannot be examined is not a symlink, and does not raise.
        self.assertFalse(disk.is_symlink(os.path.join(self.dir, 'nope')))

    def test_read_file_allowed_roots_rejects_escape(self):
        # A symlink inside the root that points outside it is refused, because
        # is_within() resolves the real path before comparing.
        outside = os.path.join(self.dir, 'outside')
        disk.write_file(outside, 'SECRET')
        root = os.path.join(self.dir, 'root')
        disk.mkdir(root)
        escape = os.path.join(root, 'escape')
        os.symlink(outside, escape)
        success, result = disk.read_file(escape, allowed_roots=[root])
        self.assertFalse(success)
        self.assertIn('outside the allowed roots', result)
        # A real file inside the root is read normally.
        inside = os.path.join(root, 'inside')
        disk.write_file(inside, 'ok')
        self.assertEqual(disk.read_file(inside, allowed_roots=[root]), (True, 'ok'))

    def test_read_file_nofollow_refuses_symlink(self):
        # nofollow refuses even a symlink whose target is inside the root, which
        # closes the check-then-open race that allowed_roots alone leaves.
        disk.write_file(self.file, 'target')
        link = os.path.join(self.dir, 'link')
        os.symlink(self.file, link)
        success, result = disk.read_file(link, nofollow=True)
        self.assertFalse(success)
        self.assertIn('while opening or reading', result)
        # Without nofollow the same symlink reads its target.
        self.assertEqual(disk.read_file(link), (True, 'target'))

    def test_read_env_allowed_roots_and_nofollow(self):
        root = os.path.join(self.dir, 'root')
        disk.mkdir(root)
        conf = os.path.join(root, 'account.conf')
        disk.write_file(conf, 'KEY=value\n')
        self.assertEqual(
            disk.read_env(conf, allowed_roots=[root], nofollow=True),
            (True, {'KEY': 'value'}),
        )
        # A symlinked conf pointing out of the root is refused before it is read.
        secret = os.path.join(self.dir, 'secret.env')
        disk.write_file(secret, 'TOKEN=linuxfabrik\n')
        planted = os.path.join(root, 'planted.conf')
        os.symlink(secret, planted)
        success, result = disk.read_env(planted, allowed_roots=[root], nofollow=True)
        self.assertFalse(success)
        self.assertIn('outside the allowed roots', result)

    def test_get_fingerprint_hashes_the_head_only(self):
        disk.write_file(self.file, 'head' + 'tail')
        success, (fingerprint, hashed) = disk.get_fingerprint(self.file, length=4)
        self.assertTrue(success)
        self.assertEqual(hashed, 4)
        # Appending must not change a fingerprint taken over the same length.
        disk.write_file(self.file, 'more', append=True)
        self.assertEqual(
            disk.get_fingerprint(self.file, length=4),
            (True, (fingerprint, 4)),
        )

    def test_get_fingerprint_differs_on_rewritten_content(self):
        disk.write_file(self.file, 'before')
        success, (before, _) = disk.get_fingerprint(self.file)
        self.assertTrue(success)
        # Same length, different content: only the hash tells them apart.
        disk.write_file(self.file, 'beforf')
        success, (after, _) = disk.get_fingerprint(self.file)
        self.assertTrue(success)
        self.assertNotEqual(before, after)

    def test_get_fingerprint_tail_ignores_the_head(self):
        disk.write_file(self.file, 'head' + 'tail')
        success, (fingerprint, hashed) = disk.get_fingerprint(self.file, length=-4)
        self.assertTrue(success)
        self.assertEqual(hashed, 4)
        # Rewriting the head leaves the tail fingerprint alone ...
        disk.write_file(self.file, 'HEAD' + 'tail')
        self.assertEqual(
            disk.get_fingerprint(self.file, length=-4),
            (True, (fingerprint, 4)),
        )
        # ... while appending changes it.
        disk.write_file(self.file, 'more', append=True)
        self.assertNotEqual(
            disk.get_fingerprint(self.file, length=-4)[1][0], fingerprint
        )

    def test_get_fingerprint_head_and_tail_differ(self):
        disk.write_file(self.file, 'head' + 'tail')
        self.assertNotEqual(
            disk.get_fingerprint(self.file, length=4)[1][0],
            disk.get_fingerprint(self.file, length=-4)[1][0],
        )

    def test_get_fingerprint_whole_file_covers_a_change_in_the_middle(self):
        # Neither head nor tail sees this change, only the whole-file mode does.
        disk.write_file(self.file, 'head' + 'middle' + 'tail')
        success, (whole_before, hashed) = disk.get_fingerprint(self.file, length=0)
        self.assertTrue(success)
        self.assertEqual(hashed, 14)
        head_before = disk.get_fingerprint(self.file, length=4)
        tail_before = disk.get_fingerprint(self.file, length=-4)
        disk.write_file(self.file, 'head' + 'MIDDLE' + 'tail')
        self.assertEqual(disk.get_fingerprint(self.file, length=4), head_before)
        self.assertEqual(disk.get_fingerprint(self.file, length=-4), tail_before)
        self.assertNotEqual(
            disk.get_fingerprint(self.file, length=0)[1][0], whole_before
        )

    def test_get_fingerprint_reports_short_reads(self):
        disk.write_file(self.file, 'abc')
        self.assertEqual(disk.get_fingerprint(self.file, length=256)[1][1], 3)
        self.assertEqual(disk.get_fingerprint(self.file, length=-256)[1][1], 3)

    def test_get_fingerprint_of_a_short_file_is_side_independent(self):
        # A file shorter than the requested slice is hashed as a whole either way.
        disk.write_file(self.file, 'abc')
        self.assertEqual(
            disk.get_fingerprint(self.file, length=256),
            disk.get_fingerprint(self.file, length=-256),
        )
        self.assertEqual(
            disk.get_fingerprint(self.file, length=256),
            disk.get_fingerprint(self.file, length=0),
        )

    def test_get_fingerprint_of_an_empty_file_hashes_nothing(self):
        disk.write_file(self.file, '')
        for length in (256, -256, 0):
            self.assertEqual(disk.get_fingerprint(self.file, length=length)[1][1], 0)

    def test_get_fingerprint_on_missing_file_is_an_error(self):
        success, result = disk.get_fingerprint(os.path.join(self.dir, 'nope'))
        self.assertFalse(success)
        self.assertIn('I/O error', result)

    # Checked against coreutils rather than against the function itself, so a digest that
    # is reproducible but wrong would still fail here.
    def test_get_fingerprint_reproduces_known_digests(self):
        disk.write_file(self.file, PROBE)
        self.assertEqual(
            disk.get_fingerprint(self.file, length=0),
            (True, (PROBE_SHA256, len(PROBE))),
        )
        self.assertEqual(
            disk.get_fingerprint(self.file, length=0, algorithm='md5'),
            (True, (PROBE_MD5, len(PROBE))),
        )

    def test_get_fingerprint_algorithm_applies_to_a_slice_too(self):
        disk.write_file(self.file, PROBE)
        self.assertEqual(
            disk.get_fingerprint(self.file, length=256, algorithm='md5')[1][0],
            PROBE_MD5,
        )

    def test_get_fingerprint_rejects_an_unknown_algorithm(self):
        disk.write_file(self.file, PROBE)
        success, result = disk.get_fingerprint(self.file, algorithm='rot13')
        self.assertFalse(success)
        self.assertIn('Unsupported hash algorithm', result)

    def test_grep_file_returns_first_group(self):
        disk.write_file(self.file, 'hello')
        self.assertEqual(disk.grep_file(self.file, 'he(l+)o'), (True, 'll'))

    def test_is_within_containment_and_escape(self):
        self.assertTrue(
            disk.is_within(os.path.join(self.dir, 'sub', 'a.log'), [self.dir])
        )
        self.assertTrue(disk.is_within(self.dir, [self.dir]))
        # `..` cannot climb out of the root
        self.assertFalse(disk.is_within(os.path.join(self.dir, '..', 'x'), [self.dir]))
        # a sibling sharing the name prefix must not match
        self.assertFalse(disk.is_within(self.dir + 'x', [self.dir]))
        # first matching root of several wins
        self.assertTrue(
            disk.is_within('/var/lib/mysql/h.err', ['/var/log', '/var/lib/mysql'])
        )

    def test_is_within_the_filesystem_root(self):
        self.assertTrue(disk.is_within(self.file, [os.sep]))
        self.assertTrue(disk.is_within(os.sep, [os.sep]))

    def test_is_within_resolves_symlink_out_of_root(self):
        # A symlink inside the root pointing outside is rejected: this is why an
        # operator must bind-mount (not symlink) an external location to include it.
        outside = tempfile.mkdtemp(prefix='lftest-disk-out-')
        try:
            link = os.path.join(self.dir, 'link')
            os.symlink(outside, link)
            self.assertFalse(disk.is_within(os.path.join(link, 'secret'), [self.dir]))
        finally:
            shutil.rmtree(outside, ignore_errors=True)

    def test_stat(self):
        disk.write_file(self.file, 'hello')
        st = disk.stat(self.file)
        self.assertEqual(st.st_size, 5)
        self.assertGreater(st.st_mtime, 0)
        self.assertIsNone(disk.stat(os.path.join(self.dir, 'nope')))

    def test_glob(self):
        disk.write_file(os.path.join(self.dir, 'a.log'), 'x')
        disk.mkdir(os.path.join(self.dir, 'sub'))
        disk.write_file(os.path.join(self.dir, 'sub', 'b.log'), 'y')
        flat = disk.glob(os.path.join(self.dir, '*.log'))
        self.assertEqual([os.path.basename(p) for p in flat], ['a.log'])
        deep = disk.glob(os.path.join(self.dir, '**', '*.log'))
        self.assertEqual([os.path.basename(p) for p in deep], ['a.log', 'b.log'])
        self.assertEqual(disk.glob(os.path.join(self.dir, 'nope*')), [])

    def test_read_env(self):
        envfile = os.path.join(self.dir, 'env')
        disk.write_file(envfile, 'FOO=bar\nBAZ=qux\n')
        self.assertEqual(disk.read_env(envfile), (True, {'FOO': 'bar', 'BAZ': 'qux'}))

    def test_rm_file(self):
        disk.write_file(self.file, 'x')
        disk.rm_file(self.file)
        self.assertFalse(disk.file_exists(self.file))

    def test_walk_directory_finds_file(self):
        disk.write_file(self.file, 'x')
        found = disk.walk_directory(self.dir)
        self.assertTrue(any('x.txt' in f for f in found))

    def test_walk_directory_relative_paths_keep_their_subdirectory(self):
        disk.mkdir(os.path.join(self.dir, 'sub'))
        disk.write_file(os.path.join(self.dir, 'sub', 'y.txt'), 'y')
        self.assertEqual(disk.walk_directory(os.path.join(self.dir, 'sub')), ['y.txt'])
        self.assertEqual(disk.walk_directory(self.dir), [os.path.join('sub', 'y.txt')])

    def test_walk_directory_relative_paths_tolerate_a_trailing_separator(self):
        disk.write_file(self.file, 'x')
        self.assertEqual(disk.walk_directory(self.dir + os.sep), ['x.txt'])

    # The root name occurring again further down the tree must not be stripped a second
    # time, which is what removing it as a plain substring used to do.
    def test_walk_directory_handles_a_repeated_root_name(self):
        root = os.path.join(self.dir, 'wp')
        disk.mkdir(os.path.join(root, 'a', 'wp'))
        disk.write_file(os.path.join(root, 'a', 'wp', 'b.txt'), 'b')
        self.assertEqual(disk.walk_directory(root), [os.path.join('a', 'wp', 'b.txt')])

    def test_walk_directory_absolute_paths(self):
        disk.write_file(self.file, 'x')
        self.assertEqual(disk.walk_directory(self.dir, relative=False), [self.file])

    @unittest.skipUnless(hasattr(os, 'geteuid'), 'POSIX-only ownership')
    def test_get_owner(self):
        disk.write_file(self.file, 'x')
        self.assertEqual(disk.get_owner(self.file), os.geteuid())


class TestMkdir(unittest.TestCase):
    def setUp(self):
        self.dir = tempfile.mkdtemp(prefix='lftest-disk-mkdir-')

    def test_creates_nested(self):
        target = os.path.join(self.dir, 'a', 'b', 'c')
        self.assertEqual(disk.mkdir(target), (True, None))
        self.assertTrue(os.path.isdir(target))

    def test_idempotent_with_exist_ok(self):
        target = os.path.join(self.dir, 'sub')
        disk.mkdir(target)
        self.assertEqual(disk.mkdir(target), (True, None))

    def test_exist_ok_false_on_existing_is_error(self):
        ok, err = disk.mkdir(self.dir, exist_ok=False)
        self.assertFalse(ok)
        self.assertIsInstance(err, str)


class TestTreeOps(unittest.TestCase):
    def setUp(self):
        self.base = tempfile.mkdtemp(prefix='lftest-disk-tree-')

    def test_make_temp_dir(self):
        ok, path = disk.make_temp_dir(prefix='lftest-mtd-')
        self.assertTrue(ok)
        self.assertTrue(os.path.isdir(path))
        disk.rm_dir(path)

    def test_copy_file_copy_dir_rm_dir_roundtrip(self):
        src = os.path.join(self.base, 'src')
        os.makedirs(src)
        disk.write_file(os.path.join(src, 'a.txt'), 'x')

        dst_file = os.path.join(self.base, 'a-copy.txt')
        self.assertEqual(
            disk.copy_file(os.path.join(src, 'a.txt'), dst_file), (True, None)
        )
        self.assertTrue(os.path.isfile(dst_file))

        dst_dir = os.path.join(self.base, 'dst')
        self.assertEqual(disk.copy_dir(src, dst_dir), (True, None))
        self.assertTrue(os.path.isfile(os.path.join(dst_dir, 'a.txt')))

        self.assertEqual(disk.rm_dir(dst_dir), (True, None))
        self.assertFalse(os.path.isdir(dst_dir))

    def test_copy_dir_existing_dst_is_error(self):
        ok, err = disk.copy_dir(self.base, self.base)
        self.assertFalse(ok)
        self.assertIsInstance(err, str)

    def test_rm_dir_missing_is_error(self):
        ok, err = disk.rm_dir(os.path.join(self.base, 'does-not-exist'))
        self.assertFalse(ok)
        self.assertIsInstance(err, str)


class TestHostHelpers(unittest.TestCase):
    def test_get_tmpdir_absolute_without_trailing_slash(self):
        tmp = disk.get_tmpdir()
        self.assertTrue(os.path.isabs(tmp))
        self.assertFalse(tmp.endswith('/'))

    def test_get_block_devices_returns_list(self):
        self.assertIsInstance(disk.get_block_devices(), list)


class TestReadCsv(unittest.TestCase):
    def setUp(self):
        self.base = tempfile.mkdtemp(prefix='lftest-csv-')
        self.addCleanup(shutil.rmtree, self.base, True)

    def _write(self, content, name='x.csv'):
        path = os.path.join(self.base, name)
        with open(path, 'w', encoding='utf-8') as file_handle:
            file_handle.write(content)
        return path

    def test_reads_rows_as_lists(self):
        path = self._write('name,value\na,1\n\nb,2\n')
        self.assertEqual(
            disk.read_csv(path),
            (True, [['name', 'value'], ['a', '1'], [], ['b', '2']]),
        )

    def test_as_dict_uses_the_header(self):
        path = self._write('name,value\na,1\n\nb,2\n')
        self.assertEqual(
            disk.read_csv(path, as_dict=True),
            (True, [{'name': 'a', 'value': '1'}, {'name': 'b', 'value': '2'}]),
        )

    def test_skip_empty_rows_drops_the_blank_line(self):
        path = self._write('name,value\na,1\n\nb,2\n')
        self.assertEqual(
            disk.read_csv(path, skip_empty_rows=True),
            (True, [['name', 'value'], ['a', '1'], ['b', '2']]),
        )

    def test_another_delimiter(self):
        path = self._write('a;b\n1;2\n', name='semi.csv')
        self.assertEqual(
            disk.read_csv(path, delimiter=';'), (True, [['a', 'b'], ['1', '2']])
        )

    def test_a_quoted_field_keeps_its_delimiter(self):
        path = self._write('a,b\n"x,y",2\n', name='quoted.csv')
        self.assertEqual(disk.read_csv(path)[1][1], ['x,y', '2'])

    def test_a_missing_file_is_reported(self):
        success, message = disk.read_csv(os.path.join(self.base, 'missing.csv'))
        self.assertFalse(success)
        self.assertIn('missing.csv', message)

    def test_an_empty_file_yields_no_rows(self):
        self.assertEqual(disk.read_csv(self._write('', name='empty.csv')), (True, []))


class TestUdevadm(unittest.TestCase):
    PROPERTIES = 'DEVNAME=/dev/dm-0\nDM_NAME=rl-root\nID_FS_TYPE=xfs\n'

    def _udevadm(self, device, prop, stdout=PROPERTIES, success=True):
        with mock.patch.object(
            disk.shell, 'shell_exec', return_value=(success, (stdout, '', 0))
        ) as exec_mock:
            result = disk.udevadm(device, prop)
        return result, exec_mock

    def test_reads_the_requested_property(self):
        result, exec_mock = self._udevadm('/dev/mapper/rl-root', 'DEVNAME')
        self.assertEqual(result, '/dev/dm-0')
        # no --property=, so the option works on older systems too
        argv = exec_mock.call_args[0][0]
        self.assertEqual(argv[:3], ['udevadm', 'info', '--query=property'])

    def test_an_unknown_property_is_empty(self):
        self.assertEqual(self._udevadm('/dev/dm-0', 'NOSUCH')[0], '')

    def test_a_path_outside_dev_is_refused(self):
        # a crafted path must not reach udevadm
        with mock.patch.object(disk.shell, 'shell_exec') as exec_mock:
            self.assertEqual(disk.udevadm('/etc/passwd', 'DEVNAME'), '')
        exec_mock.assert_not_called()

    def test_a_failed_call_is_empty(self):
        self.assertEqual(self._udevadm('/dev/dm-0', 'DEVNAME', success=False)[0], '')


class TestBd2Dmd(unittest.TestCase):
    def test_maps_a_device_mapper_device(self):
        with (
            mock.patch.object(
                disk, 'read_file', return_value=(True, 'rl_rocky8-root\n')
            ),
            mock.patch('os.path.islink', return_value=True),
        ):
            self.assertEqual(disk.bd2dmd('dm-0'), '/dev/mapper/rl_rocky8-root')
            # a full path works the same, only the basename is used
            self.assertEqual(disk.bd2dmd('/dev/dm-0'), '/dev/mapper/rl_rocky8-root')

    def test_a_plain_disk_has_no_mapped_name(self):
        with mock.patch.object(disk, 'read_file', return_value=(False, 'no such file')):
            self.assertEqual(disk.bd2dmd('sda'), '')

    def test_a_name_without_a_mapper_link_is_empty(self):
        with (
            mock.patch.object(disk, 'read_file', return_value=(True, 'gone\n')),
            mock.patch('os.path.islink', return_value=False),
        ):
            self.assertEqual(disk.bd2dmd('dm-9'), '')


class TestGetRealDisks(unittest.TestCase):
    MOUNTS = (
        '/dev/mapper/rl-root / xfs rw 0 0\n'
        '/dev/sda1 /boot xfs rw 0 0\n'
        '/dev/loop0 /snap/core squashfs ro 0 0\n'
        'proc /proc proc rw 0 0\n'
        '/dev/mapper/rl-root /home xfs rw 0 0\n'
    )

    def _disks(self):
        def fake_udevadm(_device, prop):
            return {'DEVNAME': '/dev/dm-0', 'DM_NAME': ''}[prop]

        with (
            mock.patch.object(disk, 'read_file', return_value=(True, self.MOUNTS)),
            mock.patch.object(disk, 'udevadm', side_effect=fake_udevadm),
        ):
            return disk.get_real_disks()

    def test_resolves_the_mapper_name_to_its_block_device(self):
        entry = next(d for d in self._disks() if d['bd'] == '/dev/dm-0')
        self.assertEqual(entry['dmd'], '/dev/mapper/rl-root')

    def test_several_mount_points_of_one_device_are_joined(self):
        entry = next(d for d in self._disks() if d['bd'] == '/dev/dm-0')
        self.assertEqual(entry['mp'], '/ /home')

    def test_loop_devices_and_pseudo_filesystems_are_left_out(self):
        devices = [d['bd'] for d in self._disks()]
        self.assertNotIn('/dev/loop0', devices)
        self.assertNotIn('proc', devices)

    def test_a_plain_partition_carries_no_mapper_name(self):
        entry = next(d for d in self._disks() if d['bd'] == '/dev/sda1')
        self.assertEqual(entry['dmd'], '')


class TestGetOwningPackage(unittest.TestCase):
    def test_rpm_answer_is_the_package_name(self):
        answer = (True, ('icinga-director-php-1.11.9-1.fc43.noarch\n', '', 0))
        with (
            mock.patch.object(disk.shell, 'which', side_effect=lambda n: n == 'rpm'),
            mock.patch.object(disk.shell, 'shell_exec', return_value=answer) as m,
        ):
            self.assertEqual(
                disk.get_package('/usr/share/icingaweb2/modules/director'),
                'icinga-director-php-1.11.9-1.fc43.noarch',
            )
        self.assertEqual(
            m.call_args[0][0],
            ['rpm', '--query', '--file', '/usr/share/icingaweb2/modules/director'],
        )

    def test_dpkg_answer_is_split_off_its_path(self):
        answer = (
            True,
            ('icinga-director: /usr/share/icingaweb2/modules/director\n', '', 0),
        )
        with (
            mock.patch.object(disk.shell, 'which', side_effect=lambda n: n == 'dpkg'),
            mock.patch.object(disk.shell, 'shell_exec', return_value=answer),
        ):
            self.assertEqual(
                disk.get_package('/usr/share/icingaweb2/modules/director'),
                'icinga-director',
            )

    def test_unowned_path_yields_no_package(self):
        # both package managers answer an unowned path with a non-zero return code
        answer = (True, ('file /opt/thing is not owned by any package\n', '', 1))
        with (
            mock.patch.object(disk.shell, 'which', side_effect=lambda n: n == 'rpm'),
            mock.patch.object(disk.shell, 'shell_exec', return_value=answer),
        ):
            self.assertEqual(disk.get_package('/opt/thing'), '')

    def test_host_without_a_package_manager_yields_no_package(self):
        with mock.patch.object(disk.shell, 'which', return_value=None):
            self.assertEqual(disk.get_package('/opt/thing'), '')

    def test_empty_path_is_not_asked_about(self):
        with mock.patch.object(disk.shell, 'shell_exec') as m:
            self.assertEqual(disk.get_package(''), '')
        m.assert_not_called()

    def test_a_path_that_reads_as_an_option_is_refused(self):
        # `rpm --query --file --version` prints the rpm version and exits 0, so an
        # unguarded lookup would report that as the package name.
        with mock.patch.object(disk.shell, 'shell_exec') as m:
            self.assertEqual(disk.get_package('--version'), '')
            self.assertEqual(disk.get_package('-rf'), '')
        m.assert_not_called()


class TestInodeUsage(unittest.TestCase):
    def test_readable_mount_reports_usage_or_no_inodes(self):
        # os.statvfs() works on any existing path; the filesystem type decides
        # whether inodes are reported (a dict) or not (None, e.g. btrfs/FAT).
        tmp = tempfile.mkdtemp(prefix='lftest-inode-')
        try:
            success, result = disk.get_inode_usage(tmp)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
        self.assertTrue(success)
        if result is not None:
            self.assertEqual(set(result), {'total', 'free', 'used', 'percent'})
            self.assertEqual(result['used'], result['total'] - result['free'])
            self.assertGreaterEqual(result['percent'], 0)
            self.assertLessEqual(result['percent'], 100)

    def test_missing_mount_is_an_error(self):
        success, result = disk.get_inode_usage('/nonexistent-lftest-mount-xyz')
        self.assertFalse(success)
        self.assertIsInstance(result, str)


class TestShortenPath(unittest.TestCase):
    def test_abbreviates_parents_keeps_basename(self):
        self.assertEqual(
            disk.shorten_path('/etc/pki/tls/certs/002c0b4f.0'),
            '/e/p/t/c/002c0b4f.0',
        )
        self.assertEqual(
            disk.shorten_path('/usr/share/icingaweb2/public/index.php'),
            '/u/s/i/p/index.php',
        )

    def test_two_segment_path(self):
        self.assertEqual(disk.shorten_path('/srv/index.php'), '/s/index.php')

    def test_top_level_file_stays(self):
        self.assertEqual(disk.shorten_path('/index.php'), '/index.php')

    def test_relative_path(self):
        self.assertEqual(disk.shorten_path('relative/path/file'), 'r/p/file')

    def test_max_len_truncates_the_middle(self):
        self.assertEqual(
            disk.shorten_path('/var/log/messages/very/long/path', max_len=12),
            '/v/l.../path',
        )

    def test_without_truncate_the_path_only_abbreviates(self):
        # the result may exceed max_len; the caller asked for no ellipsis
        self.assertEqual(
            disk.shorten_path(
                '/var/log/messages/very/long/path', max_len=12, truncate=False
            ),
            '/v/l/m/v/l/path',
        )

    def test_no_slash_passthrough(self):
        self.assertEqual(disk.shorten_path('index.php'), 'index.php')
        self.assertEqual(disk.shorten_path('-'), '-')
        self.assertEqual(disk.shorten_path(''), '')

    def test_root_stays(self):
        self.assertEqual(disk.shorten_path('/'), '/')

    def test_max_len_leaves_short_path_untouched(self):
        self.assertEqual(
            disk.shorten_path('/var/log/audit', max_len=40), '/var/log/audit'
        )

    def test_max_len_abbreviates_when_over_limit(self):
        # abbreviating the parents is enough; no truncation needed.
        self.assertEqual(
            disk.shorten_path('/usr/share/icingaweb2/public/index.php', max_len=20),
            '/u/s/i/p/index.php',
        )

    def test_max_len_middle_truncates_long_basename(self):
        # a very long final component (e.g. a CSI volume handle) is
        # middle-truncated so the result fits within max_len.
        path = (
            '/var/lib/kubelet/plugins/kubernetes.io/csi/rook-ceph.rbd.csi.ceph.com/'
            '6f75297b4f41d9dc95027a8d7d09ea1edfd84d051b54455bad245b40ee4a1eb7/globalmount/'
            '0001-0009-rook-ceph-000000000000000b-ef18f2fa-2957-4c50-8d44-56c3c866ac25'
        )
        short = disk.shorten_path(path, max_len=40)
        self.assertLessEqual(len(short), 40)
        self.assertIn('...', short)

    def test_max_len_keeps_distinct_paths_distinct(self):
        # two CSI mounts that differ only in their handles must not collapse
        # to the same shortened string.
        base = (
            '/var/lib/kubelet/plugins/kubernetes.io/csi/rook-ceph.rbd.csi.ceph.com/'
            '{h}/globalmount/0001-0009-rook-ceph-{s}'
        )
        a = base.format(
            h='6f75297b4f41d9dc95027a8d7d09ea1edfd84d05', s='000000000000000b-ef18f2fa'
        )
        b = base.format(
            h='79eba44fbcb484b29e9911328f58aba5e936f8b4', s='000000000000000c-1bf231b1'
        )
        self.assertNotEqual(
            disk.shorten_path(a, max_len=40),
            disk.shorten_path(b, max_len=40),
        )


class TestUnderRoot(unittest.TestCase):
    ROOT = os.path.join(os.sep, 'fixtures', 'rhel')

    def test_an_absolute_path_loses_its_anchor(self):
        self.assertEqual(
            disk.under_root(self.ROOT, '/etc/os-release'),
            os.path.join(self.ROOT, 'etc', 'os-release'),
        )

    def test_a_relative_path_is_taken_as_it_is(self):
        self.assertEqual(
            disk.under_root(self.ROOT, 'etc/os-release'),
            os.path.join(self.ROOT, 'etc', 'os-release'),
        )

    def test_a_dot_dot_cannot_walk_out_of_the_root(self):
        self.assertEqual(
            disk.under_root(self.ROOT, '/../etc/shadow'),
            os.path.join(self.ROOT, 'etc', 'shadow'),
        )

    def test_a_dot_dot_in_the_middle_is_dropped_rather_than_followed(self):
        # Dropping rather than resolving is what keeps the result inside the root
        # even where the segments before it would have been climbed back out of.
        self.assertEqual(
            disk.under_root(self.ROOT, 'a/../../b'),
            os.path.join(self.ROOT, 'a', 'b'),
        )

    def test_a_single_dot_is_dropped(self):
        self.assertEqual(
            disk.under_root(self.ROOT, './etc/./hosts'),
            os.path.join(self.ROOT, 'etc', 'hosts'),
        )

    def test_repeated_separators_collapse(self):
        self.assertEqual(
            disk.under_root(self.ROOT, '/etc//double///slash'),
            os.path.join(self.ROOT, 'etc', 'double', 'slash'),
        )

    def test_the_root_itself_comes_back_for_a_path_of_separators(self):
        self.assertEqual(disk.under_root(self.ROOT, '/'), self.ROOT)

    def test_an_empty_path_returns_the_root(self):
        self.assertEqual(disk.under_root(self.ROOT, ''), self.ROOT)

    def test_a_backslash_separates_too(self):
        # A path handed over on Windows uses the backslash, and it must not survive
        # as part of a single segment.
        self.assertEqual(
            disk.under_root(self.ROOT, r'etc\hosts'),
            os.path.join(self.ROOT, 'etc', 'hosts'),
        )

    def test_a_number_is_rendered_rather_than_raising(self):
        self.assertEqual(disk.under_root(self.ROOT, 42), os.path.join(self.ROOT, '42'))

    def test_the_result_stays_inside_the_root(self):
        for path in ('/../..', '..', '../../etc/shadow', '/etc/../../..'):
            with self.subTest(path=path):
                self.assertTrue(
                    disk.is_within(disk.under_root(self.ROOT, path), [self.ROOT])
                )


class TestConfinedOpen(unittest.TestCase):
    """A confined read reads a regular file inside the roots, and nothing else.

    Every channel through which the file that is read can differ from the file that
    was checked gets its own test: a symlink as the last component, a directory
    swapped for a symlink between the check and the open, a FIFO that would block the
    reader, and a device.
    """

    def setUp(self):
        self.base = tempfile.mkdtemp(prefix='lftest-disk-confined-')
        self.root = os.path.join(self.base, 'root')
        self.outside = os.path.join(self.base, 'outside')
        os.makedirs(os.path.join(self.root, 'd'))
        os.makedirs(self.outside)
        self.inside_file = os.path.join(self.root, 'd', 'f')
        disk.write_file(self.inside_file, 'inside')
        disk.write_file(os.path.join(self.outside, 'f'), 'linuxfabrik')

    def tearDown(self):
        shutil.rmtree(self.base, ignore_errors=True)

    def swap_directory_after_the_check(self):
        """Replace `root/d` by a symlink to the outside directory as soon as the
        first containment check has passed, the way a second process racing the
        reader would.
        """
        real_is_within = disk.is_within
        directory = os.path.join(self.root, 'd')

        def racing_is_within(path, roots):
            result = real_is_within(path, roots)
            if not os.path.islink(directory):
                shutil.rmtree(directory)
                os.symlink(self.outside, directory)
            return result

        return mock.patch.object(disk, 'is_within', side_effect=racing_is_within)

    def test_regular_file_inside_the_roots_is_read(self):
        success, handle = disk.open_file(
            self.inside_file, allowed_roots=[self.root], nofollow=True
        )
        self.assertTrue(success)
        with handle:
            self.assertEqual(handle.read(), 'inside')

    def test_binary_handle(self):
        success, handle = disk.open_file(
            self.inside_file, binary=True, allowed_roots=[self.root]
        )
        self.assertTrue(success)
        with handle:
            self.assertEqual(handle.read(), b'inside')

    def test_unconfined_open_still_works(self):
        success, handle = disk.open_file(self.inside_file)
        self.assertTrue(success)
        with handle:
            self.assertEqual(handle.read(), 'inside')

    def test_directory_swapped_after_the_check_is_not_read(self):
        # O_NOFOLLOW guards only the last component. A directory higher up that is
        # swapped for a symlink between the check and the open is still followed,
        # so the file that was opened has to be compared with the one that was
        # checked.
        with self.swap_directory_after_the_check():
            success, result = disk.read_file(
                self.inside_file, allowed_roots=[self.root], nofollow=True
            )
        self.assertFalse(success)
        self.assertNotIn('linuxfabrik', result)

    def test_directory_swapped_after_the_check_is_not_read_without_nofollow(self):
        with self.swap_directory_after_the_check():
            success, result = disk.read_file(
                self.inside_file, allowed_roots=[self.root]
            )
        self.assertFalse(success)
        self.assertNotIn('linuxfabrik', result)

    def test_directory_swapped_after_the_check_is_not_read_by_read_env(self):
        with self.swap_directory_after_the_check():
            success, result = disk.read_env(
                self.inside_file, allowed_roots=[self.root], nofollow=True
            )
        self.assertFalse(success)
        self.assertIsInstance(result, str)

    @unittest.skipUnless(hasattr(os, 'mkfifo'), 'no FIFOs on this platform')
    def test_fifo_is_refused_without_blocking(self):
        # Opening a FIFO for reading blocks until a writer appears, so a planted
        # FIFO would hang the reader. The open must neither block nor succeed.
        fifo = os.path.join(self.root, 'fifo')
        os.mkfifo(fifo)
        import signal

        def give_up(signum, frame):
            raise TimeoutError('open_file() blocked on a FIFO')

        previous = signal.signal(signal.SIGALRM, give_up)
        signal.alarm(5)
        try:
            success, result = disk.read_file(fifo, allowed_roots=[self.root])
        finally:
            signal.alarm(0)
            signal.signal(signal.SIGALRM, previous)
        self.assertFalse(success)
        self.assertIn('not a regular file', result)

    @unittest.skipUnless(os.path.exists('/dev/null'), 'no /dev/null')
    def test_device_is_refused(self):
        success, result = disk.read_file('/dev/null', allowed_roots=['/dev'])
        self.assertFalse(success)
        self.assertIn('not a regular file', result)

    def test_outside_the_roots_is_refused(self):
        success, result = disk.open_file(
            os.path.join(self.outside, 'f'), allowed_roots=[self.root]
        )
        self.assertFalse(success)
        self.assertIn('outside the allowed roots', result)

    def test_missing_file(self):
        success, result = disk.open_file(
            os.path.join(self.root, 'nope'), allowed_roots=[self.root]
        )
        self.assertFalse(success)
        self.assertIn('while opening or reading', result)


def _trusted_base():
    """Return a fresh directory whose whole path nobody but root and the current
    user can change, or None where the test host offers none.

    The default temp directory does not qualify: /tmp is writable by everyone.
    """
    home = os.path.expanduser('~')
    if (
        not hasattr(os, 'getuid')
        or not disk.resolve_trusted_path(home, owners=[os.getuid()])[0]
    ):
        return None
    return tempfile.mkdtemp(prefix='.lftest-disk-trusted-', dir=home)


@unittest.skipUnless(os.name == 'posix', 'ownership is a POSIX concept here')
class TestResolveTrustedPath(unittest.TestCase):
    """Nobody but the given owners can change what a trusted path resolves to.

    One test per way the resolution can be changed: a symlink, a directory or file
    somebody else owns, and a directory or file writable by others.
    """

    def setUp(self):
        self.uid = os.getuid()
        self.base = _trusted_base()
        if self.base is None:
            self.skipTest('no directory on this host is trusted for the test user')
        self.file = os.path.join(self.base, 'bin')
        disk.write_file(self.file, 'x')
        os.chmod(self.file, 0o755)

    def tearDown(self):
        shutil.rmtree(self.base, ignore_errors=True)

    def test_owned_path_resolves(self):
        self.assertEqual(
            disk.resolve_trusted_path(self.file, owners=[self.uid]),
            (True, os.path.realpath(self.file)),
        )

    def test_root_is_always_a_trusted_owner(self):
        success, result = disk.resolve_trusted_path('/')
        self.assertEqual((success, result), (True, '/'))

    def test_path_of_another_owner_is_refused(self):
        if self.uid == 0:
            self.skipTest('the test user is root')
        success, result = disk.resolve_trusted_path(self.file)
        self.assertFalse(success)
        self.assertIn('belongs to uid', result)

    def test_symlink_resolves_to_its_trusted_target(self):
        # The caller gets the resolved path back and uses that, so a symlink that
        # is swapped afterwards changes nothing. A symlink in a directory anybody
        # can write to is therefore fine, as long as its target is trusted.
        link_dir = tempfile.mkdtemp(prefix='lftest-disk-link-')
        try:
            link = os.path.join(link_dir, 'link')
            os.symlink(self.file, link)
            self.assertEqual(
                disk.resolve_trusted_path(link, owners=[self.uid]),
                (True, os.path.realpath(self.file)),
            )
        finally:
            shutil.rmtree(link_dir, ignore_errors=True)

    def test_directory_writable_by_everyone_is_refused(self):
        # /tmp is the everyday case: sticky, but anybody can create the name.
        work = tempfile.mkdtemp(prefix='lftest-disk-untrusted-')
        try:
            planted = os.path.join(work, 'bin')
            disk.write_file(planted, 'x')
            success, result = disk.resolve_trusted_path(planted, owners=[self.uid])
            self.assertFalse(success)
            self.assertIn('writable by everyone', result)
        finally:
            shutil.rmtree(work, ignore_errors=True)

    def test_file_writable_by_everyone_is_refused(self):
        os.chmod(self.file, 0o757)
        success, result = disk.resolve_trusted_path(self.file, owners=[self.uid])
        self.assertFalse(success)
        self.assertIn('writable by everyone', result)

    def test_directory_writable_by_a_foreign_group_is_refused(self):
        foreign = [gid for gid in os.getgroups() if gid not in (0, os.getgid())]
        if not foreign:
            self.skipTest('the test user has no supplementary group')
        sub = os.path.join(self.base, 'sub')
        os.mkdir(sub)
        os.chown(sub, -1, foreign[0])
        os.chmod(sub, 0o775)
        target = os.path.join(sub, 'bin')
        disk.write_file(target, 'x')
        success, result = disk.resolve_trusted_path(target, owners=[self.uid])
        self.assertFalse(success)
        self.assertIn('writable by group', result)

    def test_directory_writable_by_the_owners_group_is_accepted(self):
        os.chmod(self.base, 0o775)
        self.assertTrue(disk.resolve_trusted_path(self.file, owners=[self.uid])[0])

    def test_socket_permissions_do_not_count_as_replaceable(self):
        # The mode of a socket decides who may connect, not who may replace it;
        # replacing it takes write access to its directory.
        import socket

        path = os.path.join(self.base, 's')
        server = socket.socket(socket.AF_UNIX)
        try:
            server.bind(path)
            os.chmod(path, 0o777)
            self.assertEqual(
                disk.resolve_trusted_path(path, owners=[self.uid]),
                (True, os.path.realpath(path)),
            )
        finally:
            server.close()

    def test_missing_path_is_refused(self):
        success, result = disk.resolve_trusted_path(
            os.path.join(self.base, 'nope'), owners=[self.uid]
        )
        self.assertFalse(success)
        self.assertIn('nope', result)

    def test_wrong_types_are_refused(self):
        for value in (None, '', 42, b'/usr/bin/env'):
            with self.subTest(value=value):
                self.assertFalse(disk.resolve_trusted_path(value)[0])


class TestFingerprintFromHandle(unittest.TestCase):
    """get_fingerprint() hashes an already opened file the same way as a path."""

    def setUp(self):
        self.dir = tempfile.mkdtemp(prefix='lftest-disk-fp-')
        self.file = os.path.join(self.dir, 'x')
        disk.write_file(self.file, PROBE)

    def tearDown(self):
        shutil.rmtree(self.dir, ignore_errors=True)

    def test_handle_and_path_agree(self):
        for length in (0, 4, -4, 256):
            with self.subTest(length=length), open(self.file, 'rb') as handle:
                handle.seek(3)
                self.assertEqual(
                    disk.get_fingerprint(handle, length=length),
                    disk.get_fingerprint(self.file, length=length),
                )


if __name__ == '__main__':
    unittest.main()
