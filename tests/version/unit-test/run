"""Unit tests for lib.version.

`check_eol()` normally reads the live endoflife.date API, which makes any
assertion about it drift: upstream re-dates its cycles, and a state derived from
the distance between today and an EOL date flips as time passes. The tests here
seed the lookup with synthetic cycles instead, so they neither reach the network
nor age (see `TestCheckEol`).
"""

import contextlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

sys.path.insert(0, '..')

import lib.base as base
import lib.cache as cache
import lib.db_sqlite as db_sqlite
import lib.time as lib_time
import lib.version as version
from lib.globals import STATE_OK, STATE_UNKNOWN, STATE_WARN

# A product that does not exist. A cache miss therefore fails the fetch, and the bundled
# offline snapshot has no entry either, so `TestCheckEol` reports "product ... unknown"
# instead of silently grading itself against live endoflife.date data.
EOL_PRODUCT = 'https://endoflife.date/api/linuxfabrik-unit-test.json'

# Newest first, the order the API itself uses. `check_eol()` walks the list to find an
# available upgrade and stops at the first hit, so the order is part of what is tested.
EOL_CYCLES = [
    {'cycle': '999', 'eol': '2100-01-01', 'support': '2099-01-01', 'latest': '999.0.0'},
    {
        'cycle': '2',
        'eol': '2000-01-01',
        'extendedSupport': '2100-06-01',
        'support': '1999-01-01',
        'latest': '2.0.0',
    },
    {'cycle': '3', 'eol': True, 'support': None, 'latest': '3.0.0'},
    {'cycle': '1', 'eol': False, 'support': True, 'latest': '1.0.0'},
]

# A second made-up product whose cycles are named after an edition, the way Windows names
# them, so no prefix of a version string finds them. Every cycle carries the same
# `latest`, which is exactly why `check_eol()` must not compare it.
EOL_NAMED_PRODUCT = 'https://endoflife.date/api/linuxfabrik-unit-test-named.json'
EOL_NAMED_CYCLES = [
    {
        'cycle': '9-99h2-e',
        'eol': '2100-01-01',
        'support': '2100-01-01',
        'latest': '9.0.9',
    },
    {
        'cycle': '9-99h2-w',
        'eol': '2000-01-01',
        'support': '2000-01-01',
        'latest': '9.0.9',
    },
    {
        'cycle': '9-98h2',
        'eol': '2000-01-01',
        'extendedSupport': '2100-06-01',
        'support': '2000-01-01',
        'latest': '9.0.8',
    },
]


class TestImportWeight(unittest.TestCase):
    """`version()` and `version2float()` are pure parsers that other lib
    modules (notably `db_mysql`) import. Only `check_eol()` needs cache,
    db_sqlite and url, and it imports them locally. Pin that, so a future
    edit cannot quietly move those back to module level and drag sqlite3
    and urllib into every consumer.
    """

    def test_importing_lib_version_stays_lightweight(self):
        # A fresh interpreter, so modules already imported by this test file
        # do not mask an eager import.
        code = (
            'import sys; import lib.version; '
            "print(','.join(sorted(m for m in sys.modules "
            "if m in ('sqlite3', 'lib.cache', 'lib.db_sqlite', 'lib.url', 'lib.shell'))))"
        )
        out = subprocess.run(
            [sys.executable, '-c', code],
            cwd='..',
            capture_output=True,
            text=True,
            check=True,
        )
        self.assertEqual(out.stdout.strip(), '')


class TestCheckEol(unittest.TestCase):
    """`check_eol()` against a seeded cache, so nothing here reaches the network or drifts.

    The cycles are synthetic and pinned far enough out on both sides that no expected state
    can change with the calendar: `999` goes end of life in 2100, `2` did so in 2000, and `1`
    has no announced date at all. Real endoflife.date data is unusable for this, as MariaDB
    12.2 showed when upstream moved its EOL by two weeks and every assertion that named the
    date broke.
    """

    def setUp(self):
        # `check_eol()` resolves its cache through `disk.get_tmpdir()`, which honours
        # `tempfile.tempdir`. Pointing that at a throwaway directory keeps the seeded data out
        # of the shared per-user cache that every plugin on this machine reads.
        self.tmpdir = tempfile.mkdtemp(prefix='lftest-eol-')
        self.saved_tempdir = tempfile.tempdir
        tempfile.tempdir = self.tmpdir
        ok = cache.set(
            EOL_PRODUCT,
            json.dumps(EOL_CYCLES),
            expire=lib_time.now() + 3600,
            filename='linuxfabrik-lib-version.db',
        )
        self.assertTrue(ok, 'seeding the EOL cache failed')

    def tearDown(self):
        tempfile.tempdir = self.saved_tempdir
        shutil.rmtree(self.tmpdir, ignore_errors=True)

    def check(self, version_string, **kwargs):
        return version.check_eol(EOL_PRODUCT, version_string, timeout=1, **kwargs)

    def test_seeded_cache_is_isolated(self):
        # Guards the mechanism itself: if `tempfile.tempdir` ever stops steering the cache, the
        # seeded file lands in the shared directory and every other assertion here silently
        # starts grading against live data.
        self.assertTrue(
            os.path.isfile(
                os.path.join(
                    # the per-user subdirectory on POSIX, `self.tmpdir` itself on Windows
                    base.coe(db_sqlite.get_db_dir(self.tmpdir)),
                    'linuxfabrik-lib-version.db',
                )
            )
        )

    def test_eol_far_in_the_future_is_ok(self):
        state, msg = self.check('999.0.0')
        self.assertEqual(state, STATE_OK)
        self.assertIn('EOL 2100-01-01 -30d', msg)
        self.assertNotIn('[WARNING]', msg)

    def test_support_still_running_adds_no_note(self):
        _, msg = self.check('999.0.0')
        self.assertNotIn('full support ended', msg)

    def test_eol_in_the_past_warns(self):
        state, msg = self.check('2.0.0')
        self.assertEqual(state, STATE_WARN)
        self.assertIn('EOL 2000-01-01 -30d', msg)
        self.assertIn('[WARNING]', msg)

    def test_ended_support_is_reported(self):
        _, msg = self.check('2.0.0')
        self.assertIn('full support ended on 1999-01-01', msg)

    def test_eol_false_means_no_end_announced(self):
        # `eol: false` is upstream saying the cycle has no announced end, the healthiest
        # answer the API gives. Reporting it as a gap in our data read the opposite way.
        state, msg = self.check('1.0.0')
        self.assertEqual(state, STATE_OK)
        self.assertIn('no EOL announced', msg)

    def test_eol_true_warns_without_a_date(self):
        # `eol: true` is the other boolean and the other meaning: end of life reached,
        # no date given. Feeding it to strptime() raised a TypeError and the plugin
        # answered UNKNOWN with a stack trace instead of warning about old software.
        state, msg = self.check('3.0.0')
        self.assertEqual(state, STATE_WARN)
        self.assertIn('EOL, no date announced', msg)
        self.assertIn('[WARNING]', msg)

    def test_offset_shifts_the_warning_window(self):
        # Same cycle as test_eol_far_in_the_future_is_ok(), only the window moves: warning
        # 30000 days before 2100-01-01 puts the threshold in 2018, which is past for good.
        state, _ = self.check('999.0.0', offset_eol=-30000)
        self.assertEqual(state, STATE_WARN)

    def test_extended_support_date_wins_when_asked_for(self):
        state, msg = self.check('2.0.0', extended_support=True)
        self.assertEqual(state, STATE_OK)
        self.assertIn('EOL 2100-06-01', msg)

    def test_newer_major_is_reported_but_stays_ok(self):
        state, msg = self.check('1.0.0')
        self.assertEqual(state, STATE_OK)
        self.assertIn('major 999.0.0 available', msg)

    def test_check_major_turns_the_upgrade_into_a_warning(self):
        state, _ = self.check('1.0.0', check_major=True)
        self.assertEqual(state, STATE_WARN)

    def test_unknown_version_between_listed_cycles_is_unknown(self):
        state, msg = self.check('42.0.0')
        self.assertEqual(state, STATE_UNKNOWN)
        self.assertIn('version 42.0.0 unknown', msg)

    def test_version_above_every_listed_cycle_is_ok(self):
        # The host runs a release endoflife.date has not catalogued yet. Nobody can act
        # on that, and alerting on it punishes exactly the admin who stays current.
        state, msg = self.check('1000.0.0')
        self.assertEqual(state, STATE_OK)
        self.assertIn('newer than anything endoflife.date lists', msg)

    def test_version_below_every_listed_cycle_warns(self):
        # Older than the oldest cycle upstream still records, so out of support for
        # certain even though no date says so.
        state, msg = self.check('0.9.0')
        self.assertEqual(state, STATE_WARN)
        self.assertIn('older than anything endoflife.date lists', msg)

    def test_an_unlisted_version_still_reports_the_upgrade(self):
        # The early return used to drop the "newer release available" part along with
        # the EOL verdict, so the admin lost both at once.
        _, msg = self.check('0.9.0')
        self.assertIn('available', msg)


class TestCheckEolFallback(unittest.TestCase):
    """What `check_eol()` says when it falls back to the bundled data: an unreachable
    endoflife.date, and a Python without httpx that cannot ask it at all, are fixed in
    different places and must not read the same."""

    PRODUCT = 'https://endoflife.date/api/composer.json'

    def setUp(self):
        # an empty cache, so check_eol() has to ask, and a fetch that fails
        self.tmpdir = tempfile.mkdtemp(prefix='lftest-eol-')
        self.saved_tempdir = tempfile.tempdir
        tempfile.tempdir = self.tmpdir
        import lib.url as url

        self.url = url
        self.saved = (url.fetch_json, url.httpx)
        url.fetch_json = lambda *args, **kwargs: (False, 'failed')

    def tearDown(self):
        self.url.fetch_json, self.url.httpx = self.saved
        tempfile.tempdir = self.saved_tempdir
        shutil.rmtree(self.tmpdir, ignore_errors=True)

    def test_unreachable(self):
        self.url.httpx = object()
        _, msg = version.check_eol(self.PRODUCT, '2.8.0', timeout=1)
        self.assertIn('endoflife.date unreachable, using bundled data', msg)

    def test_missing_httpx_is_named(self):
        # a plugin started with the system Python instead of its venv's
        self.url.httpx = None
        _, msg = version.check_eol(self.PRODUCT, '2.8.0', timeout=1)
        self.assertIn('Python module "httpx" is not installed, using bundled data', msg)
        self.assertNotIn('unreachable', msg)


class TestCheckEolNamedCycle(unittest.TestCase):
    """`check_eol(cycle=...)` for products whose cycles are not version numbers.

    Seeded like `TestCheckEol`, with cycles named the way Windows names them.
    """

    def setUp(self):
        self.tmpdir = tempfile.mkdtemp(prefix='lftest-eol-')
        self.saved_tempdir = tempfile.tempdir
        tempfile.tempdir = self.tmpdir
        ok = cache.set(
            EOL_NAMED_PRODUCT,
            json.dumps(EOL_NAMED_CYCLES),
            expire=lib_time.now() + 3600,
            filename='linuxfabrik-lib-version.db',
        )
        self.assertTrue(ok, 'seeding the EOL cache failed')

    def tearDown(self):
        tempfile.tempdir = self.saved_tempdir
        shutil.rmtree(self.tmpdir, ignore_errors=True)

    def check(self, cycle, **kwargs):
        return version.check_eol(
            EOL_NAMED_PRODUCT, '9.0.1234', timeout=1, cycle=cycle, **kwargs
        )

    def test_the_version_string_alone_finds_no_named_cycle(self):
        # The reason the parameter exists: without it the lookup goes by version
        # prefix, "9" or "9.0" are no cycles here, and `cycle_bounds()` reads
        # "9-99h2-e" as (9, 992, 0), so a current build is graded as ancient.
        state, msg = version.check_eol(EOL_NAMED_PRODUCT, '9.0.1234', timeout=1)
        self.assertEqual(state, STATE_WARN)
        self.assertIn('older than anything endoflife.date lists', msg)

    def test_named_cycle_far_from_eol_is_ok(self):
        state, msg = self.check('9-99h2-e')
        self.assertEqual(state, STATE_OK)
        self.assertEqual(msg, 'EOL 2100-01-01 -30d')

    def test_named_cycle_past_eol_warns(self):
        state, msg = self.check('9-99h2-w')
        self.assertEqual(state, STATE_WARN)
        # full support ended on the day of the end of life, so the date is named once
        self.assertNotIn('full support ended', msg)
        self.assertIn('EOL 2000-01-01 -30d [WARNING]', msg)

    def test_first_listed_candidate_wins(self):
        state, msg = self.check(['9-99h2-e-lts', '9-99h2-e', '9-99h2'])
        self.assertEqual(state, STATE_OK)
        self.assertIn('EOL 2100-01-01', msg)

    def test_candidate_order_is_respected(self):
        # Both candidates exist, the first one decides.
        state, _ = self.check(['9-99h2-w', '9-99h2-e'])
        self.assertEqual(state, STATE_WARN)

    def test_tuple_of_candidates(self):
        state, _ = self.check(('9-99h2-x', '9-99h2-e'))
        self.assertEqual(state, STATE_OK)

    def test_less_specific_fallback(self):
        state, msg = self.check(['9-98h2-e', '9-98h2'])
        self.assertEqual(state, STATE_WARN)
        self.assertIn('EOL 2000-01-01', msg)

    def test_extended_support_applies_to_named_cycles(self):
        state, msg = self.check('9-98h2', extended_support=True)
        self.assertEqual(state, STATE_OK)
        self.assertIn('EOL 2100-06-01', msg)

    def test_unlisted_named_cycle_is_unknown(self):
        # A named cycle has no order, so it cannot be placed above or below the listed
        # ones the way a version number can.
        state, msg = self.check('9-100h2-e')
        self.assertEqual(state, STATE_UNKNOWN)
        self.assertEqual(msg, 'version 9.0.1234 unknown')

    def test_empty_candidate_list_is_unknown(self):
        state, _ = self.check([])
        self.assertEqual(state, STATE_UNKNOWN)

    def test_no_newer_release_is_reported(self):
        # `latest` is the same build for every edition, so comparing it says nothing.
        _, msg = self.check('9-98h2')
        self.assertNotIn('available', msg)

    def test_check_flags_are_ignored(self):
        state, _ = self.check(
            '9-99h2-e', check_major=True, check_minor=True, check_patch=True
        )
        self.assertEqual(state, STATE_OK)


# Synthetic, so the tests neither depend on the generated data nor age with it.
APP_STREAMS = {
    9: {
        'eol': '2100-05-31',
        'modules': {'nginx:1.22': ('NGINX 1.22', '2000-11-30')},
        'packages': {
            'make': ('GNU Make (Latest Version)', None),
            'python3': ('Python 3.9', '2100-05-31'),
            'python3.11': ('Python 3.11', '2000-05-31'),
        },
    },
}
OS_RELEASE_ROCKY = 'NAME="Rocky Linux"\nID="rocky"\nID_LIKE="rhel centos fedora"\n'


def rpm(name, vendor='Rocky', ver='9.4', modularity='(none)'):
    """What `rpm --query --file` answers with `_RPM_QUERY_FORMAT`."""
    return True, (f'{name}\t{vendor}\t{ver}\t{modularity}\n', '', 0)


class TestRhelLifeCycle(unittest.TestCase):
    """`_rhel_life_cycle()` against recorded `rpm` answers and synthetic stream data."""

    def life_cycle(self, *answers, os_release=OS_RELEASE_ROCKY):
        # An ExitStack rather than one parenthesized `with`, which needs Python 3.10.
        with contextlib.ExitStack() as stack:
            stack.enter_context(
                patch('lib.disk.read_file', return_value=(True, os_release))
            )
            stack.enter_context(
                patch('lib.shell.shell_exec', side_effect=list(answers))
            )
            stack.enter_context(
                patch('lib.rhelappstreams.RHEL_APP_STREAMS', APP_STREAMS)
            )
            return version._vendor_life_cycle(
                '/usr/bin/python3.9', 1, lambda product: None
            )

    def test_application_stream_with_its_own_end(self):
        self.assertEqual(
            self.life_cycle(rpm('rocky-release'), rpm('python3.11')),
            ('RHEL 9 Application Stream Python 3.11', '2000-05-31'),
        )

    def test_full_life_application_stream(self):
        self.assertEqual(
            self.life_cycle(rpm('rocky-release'), rpm('python3')),
            ('RHEL 9 Application Stream Python 3.9', '2100-05-31'),
        )

    def test_module_stream_wins_over_the_package_name(self):
        # Captured on Rocky 8: the package of a module stream names it in MODULARITYLABEL.
        self.assertEqual(
            self.life_cycle(
                rpm('rocky-release'),
                rpm('nginx', modularity='nginx:1.22:9010020221111:ffd4a1b1'),
            ),
            ('RHEL 9 Application Stream NGINX 1.22', '2000-11-30'),
        )

    def test_unlisted_module_stream_falls_back_to_upstream(self):
        self.assertIsNone(
            self.life_cycle(
                rpm('rocky-release'),
                rpm('nginx', modularity='nginx:9.99:9010020221111:ffd4a1b1'),
            )
        )

    def test_rolling_stream_follows_the_release(self):
        self.assertEqual(
            self.life_cycle(rpm('rocky-release'), rpm('make')),
            ('RHEL 9 package make', '2100-05-31'),
        )

    def test_baseos_package_follows_the_release(self):
        self.assertEqual(
            self.life_cycle(rpm('rocky-release'), rpm('postfix')),
            ('RHEL 9 package postfix', '2100-05-31'),
        )

    def test_epel_package_is_not_the_vendors(self):
        self.assertIsNone(
            self.life_cycle(rpm('rocky-release'), rpm('openvpn', 'Fedora Project'))
        )

    def test_file_no_package_owns(self):
        not_owned = (True, ('file /opt/x is not owned by any package\n', '', 1))
        self.assertIsNone(self.life_cycle(rpm('rocky-release'), not_owned))

    def test_unknown_major_release(self):
        self.assertIsNone(
            self.life_cycle(rpm('rocky-release', ver='42'), rpm('python3'))
        )

    def test_no_rpm(self):
        self.assertIsNone(self.life_cycle((False, 'Command "rpm" not found')))

    def test_fedora_is_not_a_rebuild(self):
        self.assertIsNone(self.life_cycle(os_release='ID=fedora\nVERSION_ID=44\n'))

    def test_centos_stream_has_its_own_life(self):
        self.assertIsNone(
            self.life_cycle(os_release='ID="centos"\nID_LIKE="rhel fedora"\n')
        )


OS_RELEASE_UBUNTU = 'NAME="Ubuntu"\nVERSION_ID="22.04"\nVERSION_CODENAME=jammy\nID=ubuntu\nID_LIKE=debian\n'
OS_RELEASE_DEBIAN = 'VERSION_ID="12"\nVERSION_CODENAME=bookworm\nID=debian\n'
DISTRO_CYCLES = {
    'https://endoflife.date/api/debian.json': [
        {'cycle': '12', 'eol': '2100-06-30', 'support': '2026-07-11'},
    ],
    'https://endoflife.date/api/ubuntu.json': [
        {'cycle': '22.04', 'eol': '2100-06-01', 'extendedSupport': '2032-04-09'},
    ],
}

# Captured from `apt-cache policy postfix` in the ubuntu:22.04 container.
APT_POLICY_UBUNTU = """postfix:
  Installed: 3.6.4-1ubuntu1.4
  Candidate: 3.6.4-1ubuntu1.4
  Version table:
 *** 3.6.4-1ubuntu1.4 500
        500 http://archive.ubuntu.com/ubuntu jammy-updates/main amd64 Packages
        500 http://security.ubuntu.com/ubuntu jammy-security/main amd64 Packages
        100 /var/lib/dpkg/status
     3.6.4-1ubuntu1 500
        500 http://archive.ubuntu.com/ubuntu jammy/main amd64 Packages
"""
# Captured from `apt-cache policy postfix` in the debian:12 container.
APT_POLICY_DEBIAN = """postfix:
  Installed: 3.7.11-0+deb12u1
  Candidate: 3.7.11-0+deb12u1
  Version table:
 *** 3.7.11-0+deb12u1 500
        500 http://deb.debian.org/debian bookworm/main amd64 Packages
        100 /var/lib/dpkg/status
"""


def shell(stdout, retc=0):
    return True, (stdout, '', retc)


class TestDebianLifeCycle(unittest.TestCase):
    """`_vendor_life_cycle()` on Debian and Ubuntu, against recorded answers."""

    def life_cycle(self, *answers, os_release=OS_RELEASE_UBUNTU):
        with contextlib.ExitStack() as stack:
            stack.enter_context(
                patch('lib.disk.read_file', return_value=(True, os_release))
            )
            stack.enter_context(
                patch('lib.shell.shell_exec', side_effect=list(answers))
            )
            return version._vendor_life_cycle(
                '/usr/sbin/postconf', 1, DISTRO_CYCLES.get
            )

    def test_ubuntu_main(self):
        self.assertEqual(
            self.life_cycle(
                shell('postfix: /usr/sbin/postconf\n'), shell(APT_POLICY_UBUNTU)
            ),
            ('Ubuntu 22.04 package postfix', '2100-06-01'),
        )

    def test_debian_main(self):
        self.assertEqual(
            self.life_cycle(
                shell('postfix: /usr/sbin/postconf\n'),
                shell(APT_POLICY_DEBIAN),
                os_release=OS_RELEASE_DEBIAN,
            ),
            ('Debian 12 package postfix', '2100-06-30'),
        )

    def test_ubuntu_universe_keeps_upstream(self):
        policy = APT_POLICY_UBUNTU.replace('/main', '/universe')
        self.assertIsNone(
            self.life_cycle(shell('postfix: /usr/sbin/postconf\n'), shell(policy))
        )

    def test_third_party_repository_keeps_upstream(self):
        policy = (
            'icinga2-bin:\n  Installed: 2.16.5-1+ubuntu22.04\n  Version table:\n'
            ' *** 2.16.5-1+ubuntu22.04 500\n'
            '        500 https://packages.icinga.com/ubuntu icinga-jammy/main amd64'
            ' Packages\n        100 /var/lib/dpkg/status\n'
        )
        self.assertIsNone(
            self.life_cycle(shell('icinga2-bin: /usr/sbin/postconf\n'), shell(policy))
        )

    def test_backports_keep_upstream(self):
        policy = APT_POLICY_DEBIAN.replace('bookworm/main', 'bookworm-backports/main')
        self.assertIsNone(
            self.life_cycle(
                shell('postfix: /usr/sbin/postconf\n'),
                shell(policy),
                os_release=OS_RELEASE_DEBIAN,
            )
        )

    def test_only_the_installed_version_counts(self):
        # The installed version came from elsewhere, an older one is in the archive.
        policy = (
            'postfix:\n  Version table:\n *** 9.9.9-1 100\n'
            '        100 /var/lib/dpkg/status\n     3.6.4-1ubuntu1 500\n'
            '        500 http://archive.ubuntu.com/ubuntu jammy/main amd64 Packages\n'
        )
        self.assertIsNone(
            self.life_cycle(shell('postfix: /usr/sbin/postconf\n'), shell(policy))
        )

    def test_package_with_architecture_and_shared_path(self):
        self.assertEqual(
            self.life_cycle(
                shell('postfix:amd64, other: /usr/sbin/postconf\n'),
                shell(APT_POLICY_UBUNTU),
            ),
            ('Ubuntu 22.04 package postfix', '2100-06-01'),
        )

    def test_file_no_package_owns(self):
        self.assertIsNone(
            self.life_cycle(shell('dpkg-query: no path found matching pattern\n', 1))
        )

    def test_release_endoflife_does_not_list(self):
        self.assertIsNone(
            self.life_cycle(
                shell('postfix: /usr/sbin/postconf\n'),
                shell(APT_POLICY_UBUNTU.replace('jammy', 'noble')),
                os_release=OS_RELEASE_UBUNTU.replace('22.04', '24.04').replace(
                    'jammy', 'noble'
                ),
            )
        )


class TestCheckEolVendorLifeCycle(TestCheckEol):
    """`check_eol(package_path=...)`: the vendor's date replaces the upstream one."""

    def check_vendor(self, version_string, life_cycle):
        with patch('lib.version._vendor_life_cycle', return_value=life_cycle):
            return self.check(version_string, package_path='/usr/bin/x')

    def test_vendor_date_overrides_an_upstream_end_of_life(self):
        state, msg = self.check_vendor('2.0.0', ('RHEL 9 package x', '2100-05-31'))
        self.assertEqual(state, STATE_OK)
        self.assertIn('RHEL 9 package x, EOL 2100-05-31 -30d', msg)
        self.assertNotIn('2000-01-01', msg)
        self.assertNotIn('full support ended', msg)

    def test_vendor_end_of_life_warns(self):
        state, msg = self.check_vendor(
            '999.0.0', ('RHEL 9 Application Stream X 9', '2000-05-31')
        )
        self.assertEqual(state, STATE_WARN)
        self.assertIn('EOL 2000-05-31 -30d [WARNING]', msg)

    def test_newer_upstream_release_is_still_named(self):
        _, msg = self.check_vendor('2.0.0', ('RHEL 9 package x', '2100-05-31'))
        self.assertIn('major 999.0.0 available', msg)

    def test_unlisted_upstream_cycle_is_no_longer_unknown(self):
        state, _ = self.check_vendor('5.0.0', ('RHEL 9 package x', '2100-05-31'))
        self.assertEqual(state, STATE_OK)

    def test_without_vendor_life_cycle_upstream_applies(self):
        state, msg = self.check_vendor('2.0.0', None)
        self.assertEqual(state, STATE_WARN)
        self.assertIn('EOL 2000-01-01 -30d', msg)


class TestCycleBounds(unittest.TestCase):
    """`cycle_bounds()` places a version that has no cycle of its own, so every shape
    endoflife.date puts in a `cycle` has to come out as a bound or be skipped.
    """

    def test_lowest_and_highest(self):
        self.assertEqual(
            version.cycle_bounds(
                [{'cycle': '8.4'}, {'cycle': '5.7'}, {'cycle': '9.7'}]
            ),
            ((5, 7, 0), (9, 7, 0)),
        )

    def test_single_cycle_is_both_bounds(self):
        self.assertEqual(
            version.cycle_bounds([{'cycle': '8.0'}]), ((8, 0, 0), (8, 0, 0))
        )

    def test_empty_list(self):
        self.assertEqual(version.cycle_bounds([]), (None, None))

    def test_cycle_without_a_digit_is_skipped(self):
        # 166 of the API's 8444 cycles are named "current", "provided", "subscription"
        # and the like. `version()` turns those into (0, 0, 0) rather than raising,
        # which would drag the lower bound to zero and disable the "older than
        # anything listed" verdict for the whole product.
        self.assertEqual(
            version.cycle_bounds(
                [{'cycle': '9.7'}, {'cycle': 'current'}, {'cycle': '8.0'}]
            ),
            ((8, 0, 0), (9, 7, 0)),
        )

    def test_only_cycles_without_digits(self):
        self.assertEqual(
            version.cycle_bounds([{'cycle': 'current'}, {'cycle': 'pro'}]), (None, None)
        )

    def test_cycle_none_is_skipped(self):
        self.assertEqual(
            version.cycle_bounds([{'cycle': None}, {'cycle': '8.0'}]),
            ((8, 0, 0), (8, 0, 0)),
        )

    def test_entry_without_a_cycle_key_is_skipped(self):
        self.assertEqual(
            version.cycle_bounds([{'eol': False}, {'cycle': '8.0'}]),
            ((8, 0, 0), (8, 0, 0)),
        )

    def test_non_dict_entry_is_skipped(self):
        self.assertEqual(
            version.cycle_bounds(['8.0', None, 42, {'cycle': '8.0'}]),
            ((8, 0, 0), (8, 0, 0)),
        )

    def test_numeric_cycle_is_accepted(self):
        # The API answers `cycle` as a string, but a hand-built list may hold a number.
        self.assertEqual(
            version.cycle_bounds([{'cycle': 8}, {'cycle': 9}]), ((8, 0, 0), (9, 0, 0))
        )

    def test_four_part_cycle_truncates_like_version(self):
        self.assertEqual(
            version.cycle_bounds([{'cycle': '1.2.3.4'}]), ((1, 2, 3), (1, 2, 3))
        )


class TestVersion(unittest.TestCase):
    def test_splits_to_tuple(self):
        self.assertEqual(version.version('1.2.3'), (1, 2, 3))

    def test_pads_to_maxlen(self):
        self.assertEqual(version.version('1.2'), (1, 2, 0))

    def test_truncates_to_maxlen(self):
        self.assertEqual(version.version('1.2.3', maxlen=2), (1, 2))

    def test_empty_is_zeros(self):
        self.assertEqual(version.version(''), (0, 0, 0))

    def test_none_raises(self):
        with self.assertRaises(TypeError):
            version.version(None)


class TestVersion2Float(unittest.TestCase):
    def test_first_dot_kept(self):
        self.assertEqual(version.version2float('1.2.3'), 1.23)
        self.assertEqual(version.version2float('10.0.1'), 10.01)

    def test_non_numeric_raises(self):
        with self.assertRaises(ValueError):
            version.version2float('abc')


if __name__ == '__main__':
    unittest.main()
