"""Unit tests for lib.icinga.

All public functions are covered hermetically. The module only talks to
the outside world through lib.url.fetch_json (HTTP) and time.sleep (throttle),
so both are mocked. No network call and no real sleep ever happens.

Public functions under test:

- api_post()         -> low-level POST, builds auth header + method override
- get_service()      -> GET-override query on /v1/objects/services

Each higher-level function is asserted both end-to-end (URL + payload as seen
by fetch_json) and via the api_post seam, so a refactor of either layer keeps
the contract pinned.
"""

import base64
import sys
import unittest
from unittest import mock

sys.path.insert(0, '..')

import lib.icinga as icinga

URI = 'https://icinga-server:5665'
USER = 'linuxfabrik'
PASSWORD = 'linuxfabrik'

# Auth header that api_post must produce for the credentials above.
EXPECTED_AUTH = 'Basic ' + base64.b64encode(b'linuxfabrik:linuxfabrik').decode()


def make_fetch_json(return_value=(True, {'ok': True})):
    """Return a MagicMock standing in for url.fetch_json with a canned result."""
    return mock.MagicMock(name='fetch_json', return_value=return_value)


class IcingaTestBase(unittest.TestCase):
    """Patches url.fetch_json and time.sleep for every test.

    self.fetch_json is the mock; self.last_call() returns its kwargs so the
    request crafted by the module can be asserted on.
    """

    def setUp(self):
        self.fetch_json = make_fetch_json()
        self._p_fetch = mock.patch.object(icinga.url, 'fetch_json', self.fetch_json)
        # Patch the time.sleep that the module imported, so the throttle is a
        # no-op and the suite stays fast.
        self._p_sleep = mock.patch.object(icinga.time, 'sleep')
        self._p_fetch.start()
        self.sleep = self._p_sleep.start()
        self.addCleanup(self._p_fetch.stop)
        self.addCleanup(self._p_sleep.stop)

    def last_call(self):
        """Return (args, kwargs) of the most recent fetch_json call."""
        self.assertTrue(self.fetch_json.called, 'fetch_json was never called')
        return self.fetch_json.call_args

    def sent_uri(self):
        """First positional arg passed to fetch_json (the URI)."""
        return self.last_call().args[0]

    def sent_kwargs(self):
        return self.last_call().kwargs


# ---------------------------------------------------------------------------
# api_post()
# ---------------------------------------------------------------------------


class TestApiPost(IcingaTestBase):
    # urlsplit() raises ValueError for a host in brackets that is no IP address
    # (since gh-103848: CPython 3.9.21, 3.10.16, 3.11.4, 3.12.0) and for a missing
    # `]` (every version). Neither may
    # escape a function that promises (success, result).
    def test_an_unreadable_bracketed_host_is_a_failure(self):
        success, message = icinga.api_post('https://[::1/v1/x', USER, PASSWORD)
        self.assertFalse(success)
        self.assertIn('Cannot read the URL', message)
        self.fetch_json.assert_not_called()

    def test_returns_fetch_json_result_unchanged(self):
        sentinel = (True, {'results': [{'code': 200}]})
        self.fetch_json.return_value = sentinel
        result = icinga.api_post(f'{URI}/v1/objects/services', USER, PASSWORD)
        self.assertIs(result, sentinel)

    def test_failure_result_passed_through(self):
        self.fetch_json.return_value = (False, 'connection refused')
        success, body = icinga.api_post(f'{URI}/v1/x', USER, PASSWORD)
        self.assertFalse(success)
        self.assertEqual(body, 'connection refused')

    def test_auth_header_is_base64_basic(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD)
        headers = self.sent_kwargs()['header']
        self.assertEqual(headers['Authorization'], EXPECTED_AUTH)

    def test_auth_header_decodes_to_user_colon_password(self):
        icinga.api_post(f'{URI}/v1/x', 'alice', 's3cret')
        token = self.sent_kwargs()['header']['Authorization'].split(' ', 1)[1]
        self.assertEqual(base64.b64decode(token).decode(), 'alice:s3cret')

    def test_repeated_slashes_in_the_path_are_collapsed(self):
        icinga.api_post(
            'https://icinga.example.com:5665//v1/objects/services', 'u', 'p'
        )
        self.assertEqual(
            self.sent_uri(), 'https://icinga.example.com:5665/v1/objects/services'
        )

    def test_host_starting_with_v1_is_left_alone(self):
        # replacing `//v1` in the whole URI turned this into `https:/v1.icinga...`
        for host in ('v1.icinga.example.com', 'v2.icinga.example.com'):
            with self.subTest(host=host):
                icinga.api_post(f'https://{host}:5665/v1/objects/services', 'u', 'p')
                self.assertEqual(
                    self.sent_uri(), f'https://{host}:5665/v1/objects/services'
                )

    def test_accept_header_is_json(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD)
        self.assertEqual(self.sent_kwargs()['header']['Accept'], 'application/json')

    def test_method_override_header_set_when_given(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD, method_override='GET')
        self.assertEqual(self.sent_kwargs()['header']['X-HTTP-Method-Override'], 'GET')

    def test_method_override_header_absent_by_default(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD)
        self.assertNotIn('X-HTTP-Method-Override', self.sent_kwargs()['header'])

    def test_empty_method_override_does_not_add_header(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD, method_override='')
        self.assertNotIn('X-HTTP-Method-Override', self.sent_kwargs()['header'])

    def test_double_slash_v1_is_normalised(self):
        icinga.api_post(f'{URI}//v1/objects/services', USER, PASSWORD)
        self.assertEqual(self.sent_uri(), f'{URI}/v1/objects/services')

    def test_double_slash_v2_is_normalised(self):
        icinga.api_post(f'{URI}//v2/foo', USER, PASSWORD)
        self.assertEqual(self.sent_uri(), f'{URI}/v2/foo')

    def test_single_slash_uri_left_intact(self):
        icinga.api_post(f'{URI}/v1/objects/services', USER, PASSWORD)
        self.assertEqual(self.sent_uri(), f'{URI}/v1/objects/services')

    def test_data_none_becomes_empty_dict(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD, data=None)
        self.assertEqual(self.sent_kwargs()['data'], {})

    def test_data_passed_through(self):
        payload = {'filter': 'x', 'attrs': ['name', 'state']}
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD, data=payload)
        self.assertEqual(self.sent_kwargs()['data'], payload)

    def test_encoding_is_serialized_json(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD)
        self.assertEqual(self.sent_kwargs()['encoding'], 'serialized-json')

    def test_insecure_forwarded(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD, insecure=True)
        self.assertTrue(self.sent_kwargs()['insecure'])

    def test_insecure_default_false(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD)
        self.assertFalse(self.sent_kwargs()['insecure'])

    def test_no_proxy_forwarded(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD, no_proxy=True)
        self.assertTrue(self.sent_kwargs()['no_proxy'])

    def test_timeout_forwarded(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD, timeout=42)
        self.assertEqual(self.sent_kwargs()['timeout'], 42)

    def test_timeout_default_is_three(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD)
        self.assertEqual(self.sent_kwargs()['timeout'], 3)

    def test_sleeps_default_amount_after_call(self):
        icinga.api_post(f'{URI}/v1/x', USER, PASSWORD)
        self.sleep.assert_called_once_with(icinga.DEFAULT_SLEEP)

    def test_default_sleep_constant_value(self):
        self.assertEqual(icinga.DEFAULT_SLEEP, 1.0)


# ---------------------------------------------------------------------------
# get_service()
# ---------------------------------------------------------------------------


class TestGetService(IcingaTestBase):
    def test_uri_targets_services_endpoint(self):
        icinga.get_service(URI, USER, PASSWORD, 'host!svc')
        self.assertEqual(self.sent_uri(), f'{URI}/v1/objects/services')

    def test_trailing_slash_in_base_uri_stripped(self):
        icinga.get_service(URI + '/', USER, PASSWORD, 'host!svc')
        self.assertEqual(self.sent_uri(), f'{URI}/v1/objects/services')

    def test_uses_get_method_override(self):
        icinga.get_service(URI, USER, PASSWORD, 'host!svc')
        self.assertEqual(self.sent_kwargs()['header']['X-HTTP-Method-Override'], 'GET')

    def test_filter_matches_service_name(self):
        icinga.get_service(URI, USER, PASSWORD, 'host!special-service')
        data = self.sent_kwargs()['data']
        self.assertEqual(data['filter'], 'service.__name == lf_service')
        self.assertEqual(data['filter_vars'], {'lf_service': 'host!special-service'})

    # The name is a value in filter_vars, never part of the expression. Spliced into
    # it, a `"` added a filter of its own (every service matched, verified against
    # Icinga 2.15), a trailing backslash broke the parse, and match() read `*` as a
    # glob.
    def test_service_name_never_reaches_the_filter_expression(self):
        for name in (
            'h1!C:\\Temp\\',
            'h1!say "hi"',
            'h1!web-*',
            'h1!nope", service.__name) || match("*',
        ):
            with self.subTest(name=name):
                icinga.get_service(URI, USER, PASSWORD, name)
                data = self.sent_kwargs()['data']
                self.assertEqual(data['filter'], 'service.__name == lf_service')
                self.assertEqual(data['filter_vars'], {'lf_service': name})

    def test_default_attrs_is_name_plus_state(self):
        icinga.get_service(URI, USER, PASSWORD, 'host!svc')
        self.assertEqual(self.sent_kwargs()['data']['attrs'], ['name', 'state'])

    def test_custom_attrs_are_split_and_prefixed_with_name(self):
        icinga.get_service(
            URI, USER, PASSWORD, 'host!svc', attrs='state,acknowledgement'
        )
        self.assertEqual(
            self.sent_kwargs()['data']['attrs'],
            ['name', 'state', 'acknowledgement'],
        )

    def test_returns_api_post_result(self):
        sentinel = (True, {'result': [{'attrs': {'state': 2}}]})
        self.fetch_json.return_value = sentinel
        self.assertIs(icinga.get_service(URI, USER, PASSWORD, 'host!svc'), sentinel)

    def test_forwards_insecure_no_proxy_timeout(self):
        icinga.get_service(
            URI,
            USER,
            PASSWORD,
            'host!svc',
            insecure=True,
            no_proxy=True,
            timeout=9,
        )
        kw = self.sent_kwargs()
        self.assertTrue(kw['insecure'])
        self.assertTrue(kw['no_proxy'])
        self.assertEqual(kw['timeout'], 9)


class TestBuildIcingaweb2Url(unittest.TestCase):
    """Assert host/service URL composition and untrusted-input handling."""

    def test_an_unreadable_base_url_is_none(self):
        self.assertIsNone(icinga.build_icingaweb2_url('https://[::1/icingaweb2', 'h'))

    BASE = 'https://example.com/icingaweb2'

    def test_host_url(self):
        self.assertEqual(
            icinga.build_icingaweb2_url(self.BASE, 'web01'),
            'https://example.com/icingaweb2/icingadb/host?name=web01',
        )

    def test_service_url(self):
        self.assertEqual(
            icinga.build_icingaweb2_url(self.BASE, 'web01', 'http'),
            'https://example.com/icingaweb2/icingadb/service?name=http&host.name=web01',
        )

    def test_empty_servicename_builds_host_url(self):
        self.assertEqual(
            icinga.build_icingaweb2_url(self.BASE, 'web01', ''),
            'https://example.com/icingaweb2/icingadb/host?name=web01',
        )

    def test_names_are_url_encoded(self):
        result = icinga.build_icingaweb2_url(self.BASE, 'web 01', 'disk io')
        self.assertIn('name=disk%20io', result)
        self.assertIn('host.name=web%2001', result)
        self.assertNotIn(' ', result)

    def test_name_cannot_inject_query_parameter(self):
        # A hostname carrying '&admin=1' must not become a second query parameter.
        result = icinga.build_icingaweb2_url(self.BASE, 'web01&admin=1')
        self.assertNotIn('&admin=1', result)
        self.assertIn('%26admin%3D1', result)

    def test_missing_base_url_returns_none(self):
        self.assertIsNone(icinga.build_icingaweb2_url('', 'web01'))

    def test_missing_hostname_returns_none(self):
        self.assertIsNone(icinga.build_icingaweb2_url(self.BASE, ''))

    def test_non_string_inputs_return_none(self):
        self.assertIsNone(icinga.build_icingaweb2_url(None, 'web01'))
        self.assertIsNone(icinga.build_icingaweb2_url(self.BASE, None))

    def test_non_http_scheme_returns_none(self):
        self.assertIsNone(icinga.build_icingaweb2_url('javascript:alert(1)', 'web01'))
        self.assertIsNone(icinga.build_icingaweb2_url('file:///etc/passwd', 'web01'))
        self.assertIsNone(icinga.build_icingaweb2_url('ftp://example.com', 'web01'))

    def test_scheme_less_base_url_returns_none(self):
        self.assertIsNone(
            icinga.build_icingaweb2_url('example.com/icingaweb2', 'web01')
        )


class TestGetLogo(unittest.TestCase):
    """Assert the bundled Icinga logo decodes to a valid PNG."""

    def test_returns_bytes(self):
        self.assertIsInstance(icinga.get_logo(), bytes)

    def test_is_png(self):
        # PNG magic number.
        self.assertTrue(icinga.get_logo().startswith(b'\x89PNG\r\n\x1a\n'))

    def test_dimensions_100x35(self):
        # Width and height live in the IHDR chunk at bytes 16..24.
        data = icinga.get_logo()
        width = int.from_bytes(data[16:20], 'big')
        height = int.from_bytes(data[20:24], 'big')
        self.assertEqual((width, height), (100, 35))


class TestRenderNotificationMail(unittest.TestCase):
    """Assert notification-mail rendering, escaping and table structure."""

    CID = '<178.199@linuxfabrik>'

    def render(self, rows, hostname='monitor01'):
        return icinga.render_notification_mail(rows, self.CID, hostname)

    def test_returns_plain_and_html(self):
        plain, html_body = self.render(
            [{'left_column': 'Host:', 'right_column': 'web01'}]
        )
        self.assertIn('Host: web01', plain)
        self.assertIn('<html>', html_body)

    def test_no_rows_yields_an_empty_body(self):
        plain, html_body = self.render([])
        self.assertEqual(plain, '')
        self.assertIn('<html>', html_body)

    def test_a_row_without_a_value_still_renders_its_label(self):
        plain, _ = self.render([{'left_column': 'Host:'}])
        self.assertEqual(plain, 'Host: \n')

    def test_value_is_html_escaped(self):
        _, html_body = self.render(
            [{'left_column': 'Output:', 'right_column': '<script>alert(1)</script>'}]
        )
        self.assertNotIn('<script>alert(1)', html_body)
        self.assertIn('&lt;script&gt;alert(1)&lt;/script&gt;', html_body)

    def test_label_is_html_escaped(self):
        _, html_body = self.render([{'left_column': '<b>L</b>', 'right_column': 'v'}])
        self.assertNotIn('<b>L</b>', html_body)
        self.assertIn('&lt;b&gt;L&lt;/b&gt;', html_body)

    def test_newline_becomes_br(self):
        _, html_body = self.render([{'left_column': 'Out:', 'right_column': 'a\nb'}])
        self.assertIn('a<br>b', html_body)

    def test_url_value_becomes_escaped_link(self):
        url = 'https://example.com/x?a=1&b=2'
        _, html_body = self.render([{'left_column': 'Link:', 'right_column': url}])
        self.assertIn('<a href="https://example.com/x?a=1&amp;b=2">', html_body)
        # the raw ampersand must not survive in the attribute
        self.assertNotIn('a=1&b=2', html_body)

    def test_even_odd_alternation(self):
        rows = [{'left_column': f'L{i}', 'right_column': f'v{i}'} for i in range(3)]
        _, html_body = self.render(rows)
        self.assertEqual(
            html_body.count('class="even"'), 4
        )  # rows 0 and 2 (th+td each)
        self.assertEqual(html_body.count('class="odd"'), 2)  # row 1 (th+td)

    def test_attributes_inserted_verbatim(self):
        _, html_body = self.render(
            [
                {
                    'left_column': 'State:',
                    'right_column': 'DOWN',
                    'right_column_attributes': 'style="background-color: #FFAA60"',
                }
            ]
        )
        self.assertIn('style="background-color: #FFAA60"', html_body)

    def test_logo_cid_brackets_stripped(self):
        _, html_body = self.render([{'left_column': 'L', 'right_column': 'v'}])
        self.assertIn('src="cid:178.199@linuxfabrik"', html_body)

    def test_footer_contains_escaped_hostname(self):
        _, html_body = self.render(
            [{'left_column': 'L', 'right_column': 'v'}], hostname='mon<x>'
        )
        self.assertIn('Generated by Icinga2 on mon&lt;x&gt;', html_body)


# ---------------------------------------------------------------------------
# director_*()
# ---------------------------------------------------------------------------


class DirectorCliBase(unittest.TestCase):
    """Patches shell.shell_exec, so no icingacli ever runs."""

    def setUp(self):
        self.shell_exec = mock.MagicMock(name='shell_exec')
        self.shell_exec.return_value = (True, ('{"a": 1}', '', 0))
        patcher = mock.patch.object(icinga.shell, 'shell_exec', self.shell_exec)
        patcher.start()
        self.addCleanup(patcher.stop)


class TestDirectorCli(DirectorCliBase):
    def test_returns_parsed_json(self):
        self.assertEqual(
            icinga.director_cli(['hosts', 'fetch', '--json']), (True, {'a': 1})
        )

    def test_builds_argv_and_passes_the_timeout(self):
        icinga.director_cli(['hosts', 'fetch'], timeout=3)
        self.shell_exec.assert_called_once_with(
            ['icingacli', 'director', 'hosts', 'fetch'], timeout=3
        )

    def test_rejects_an_empty_or_wrong_argv(self):
        for argv in ([], None, 'hosts fetch', ['hosts', 1], ['hosts', 'a\0b']):
            with self.subTest(argv=argv):
                success, _ = icinga.director_cli(argv)
                self.assertFalse(success)
        self.shell_exec.assert_not_called()

    def test_shell_failure_is_passed_on(self):
        self.shell_exec.return_value = (False, 'Timeout after 8 seconds.')
        self.assertEqual(
            icinga.director_cli(['hosts', 'fetch']),
            (
                False,
                '`icingacli director hosts fetch` failed: Timeout after 8 seconds.',
            ),
        )

    def test_permission_problem_explains_the_fix(self):
        self.shell_exec.return_value = (
            True,
            (
                '',
                'ERROR: Cannot read enabled modules. Config directory '
                '"/etc/icingaweb2" is not readable\n',
                1,
            ),
        )
        success, msg = icinga.director_cli(['hosts', 'fetch'])
        self.assertFalse(success)
        self.assertIn('failed with exit code 1: ERROR: Cannot read enabled', msg)
        self.assertIn('member of the group `icingaweb2`', msg)

    def test_other_error_has_no_permission_hint(self):
        self.shell_exec.return_value = (True, ('', 'ERROR: Failed to load host\n', 1))
        success, msg = icinga.director_cli(['host', 'show', 'x'])
        self.assertFalse(success)
        self.assertNotIn('icingaweb2', msg)

    def test_error_never_shows_stdout_and_masks_stderr(self):
        self.shell_exec.return_value = (
            True,
            ('{"password": "linuxfabrik"}', 'error password=linuxfabrik\n', 2),
        )
        success, msg = icinga.director_cli(['hosts', 'fetch'])
        self.assertFalse(success)
        self.assertNotIn('linuxfabrik', msg)

    def test_invalid_json(self):
        self.shell_exec.return_value = (True, ('PHP Warning: ...', '', 0))
        self.assertEqual(
            icinga.director_cli(['hosts', 'fetch']),
            (False, '`icingacli director hosts fetch` did not return valid JSON.'),
        )


class TestDirectorHostServices(DirectorCliBase):
    def test_returns_the_services(self):
        self.shell_exec.return_value = (
            True,
            ('{"object_name": "web01", "services": [{"object_name": "Load"}]}', '', 0),
        )
        self.assertEqual(
            icinga.director_host_services('web01'),
            (True, [{'object_name': 'Load'}]),
        )
        argv = self.shell_exec.call_args.args[0]
        self.assertEqual(argv[:5], ['icingacli', 'director', 'host', 'show', 'web01'])
        self.assertIn('--all-services', argv)
        self.assertIn('--resolved', argv)

    def test_passes_the_timeout(self):
        self.shell_exec.return_value = (True, ('{"services": []}', '', 0))
        self.assertEqual(icinga.director_host_services('web01', timeout=3), (True, []))
        self.assertEqual(self.shell_exec.call_args.kwargs, {'timeout': 3})

    def test_option_like_host_name_is_refused(self):
        success, _ = icinga.director_host_services('--help')
        self.assertFalse(success)
        self.shell_exec.assert_not_called()

    def test_empty_or_wrong_host_name_is_refused(self):
        for host in ('', None, 42):
            with self.subTest(host=host):
                success, _ = icinga.director_host_services(host)
                self.assertFalse(success)
        self.shell_exec.assert_not_called()

    def test_missing_services(self):
        self.shell_exec.return_value = (True, ('{"object_name": "web01"}', '', 0))
        self.assertEqual(
            icinga.director_host_services('web01'),
            (False, 'The Icinga Director returned no services for host "web01".'),
        )


COMMANDS = {
    'cmd-base': {
        'arguments': {
            '--critical': '$x_critical$',
            '--ignore': {'repeat_key': True, 'value': '$x_ignore$'},
            '--quiet': {'set_if': '$x_quiet$'},
            '--host': '$host.address$',
            '--name': '$service.name$',
            '--pw': '$service.vars.x_password$',
            '--disk': '$disks.root$',
            '--regex': '^foo$$',
        },
        'command': '/usr/lib64/nagios/plugins/x',
    },
    'cmd-sudo': {'command': '/usr/bin/sudo x', 'imports': ['cmd-base']},
    'cmd-loop-a': {'arguments': {'-a': '$a$'}, 'imports': ['cmd-loop-b']},
    'cmd-loop-b': {'arguments': {'-b': '$b$'}, 'imports': ['cmd-loop-a']},
}


class TestDirectorCommandVars(unittest.TestCase):
    def test_collects_the_macros(self):
        self.assertEqual(
            icinga.director_command_vars(COMMANDS, 'cmd-base'),
            {'disks', 'x_critical', 'x_ignore', 'x_password', 'x_quiet'},
        )

    def test_follows_imports(self):
        self.assertEqual(
            icinga.director_command_vars(COMMANDS, 'cmd-sudo'),
            icinga.director_command_vars(COMMANDS, 'cmd-base'),
        )

    def test_survives_an_import_loop(self):
        self.assertEqual(
            icinga.director_command_vars(COMMANDS, 'cmd-loop-a'), {'a', 'b'}
        )

    def test_unknown_command_is_none(self):
        self.assertIsNone(icinga.director_command_vars(COMMANDS, 'cmd-unknown'))
        self.assertIsNone(icinga.director_command_vars(COMMANDS, None))
        self.assertIsNone(icinga.director_command_vars(None, 'cmd-base'))

    def test_command_without_macros_is_an_empty_set(self):
        self.assertEqual(
            icinga.director_command_vars({'cmd': {'command': '/bin/true'}}, 'cmd'),
            set(),
        )


class TestDirectorUsedVars(unittest.TestCase):
    def test_adds_variables_referred_to_by_used_values(self):
        self.assertEqual(
            icinga.director_used_vars(
                {'url'},
                {'url': 'https://$hostname$:$port$/x', 'hostname': '$fqdn$'},
            ),
            {'fqdn', 'hostname', 'port', 'url'},
        )

    def test_unused_variable_values_are_not_followed(self):
        self.assertEqual(
            icinga.director_used_vars({'a'}, {'a': '1', 'b': '$c$'}), {'a'}
        )

    def test_reference_loop_ends(self):
        self.assertEqual(
            icinga.director_used_vars({'a'}, {'a': '$b$', 'b': '$a$'}), {'a', 'b'}
        )

    def test_empty_and_wrong_input(self):
        self.assertEqual(icinga.director_used_vars(None, None), set())
        self.assertEqual(icinga.director_used_vars({'a'}, 'garbage'), {'a'})


HOSTS = {
    'tpl-a': {'object_type': 'template', 'vars': {'_ov': {'Load': {'w': '1'}}}},
    'tpl-b': {
        'imports': ['tpl-a'],
        'object_type': 'template',
        'vars': {'_ov': {'Load': {'c': '2'}, 'Swap': {'w': '3'}}},
    },
    'tpl-loop': {'imports': ['tpl-loop'], 'object_type': 'template'},
    'web01': {
        'imports': ['tpl-b', 'tpl-missing', 'tpl-loop'],
        'object_type': 'object',
        'vars': {'_ov': {'Load': {'w': '9'}, 'Bad': 'string'}},
    },
}


class TestDirectorOverrides(unittest.TestCase):
    def test_own_overrides(self):
        self.assertEqual(
            icinga.director_own_overrides(HOSTS['web01'], '_ov'), {'Load': {'w': '9'}}
        )

    def test_own_overrides_of_malformed_objects(self):
        for obj in (
            None,
            'x',
            {},
            {'vars': None},
            {'vars': 'x'},
            {'vars': {'_ov': 'x'}},
        ):
            with self.subTest(obj=obj):
                self.assertEqual(icinga.director_own_overrides(obj, '_ov'), {})

    def test_later_template_replaces_an_entry_as_a_whole(self):
        # tpl-b imports tpl-a and has its own entry for "Load", which wins
        self.assertEqual(
            icinga.director_inherited_overrides(HOSTS, 'web01', '_ov'),
            {'Load': {'c': '2'}, 'Swap': {'w': '3'}},
        )

    def test_inherited_overrides_leave_out_the_host_itself(self):
        self.assertEqual(icinga.director_inherited_overrides(HOSTS, 'tpl-a', '_ov'), {})

    def test_inherited_overrides_of_wrong_input(self):
        self.assertEqual(icinga.director_inherited_overrides(None, 'web01', '_ov'), {})
        self.assertEqual(icinga.director_inherited_overrides(HOSTS, 'nope', '_ov'), {})


class TestDirectorSameValue(unittest.TestCase):
    def test_same(self):
        for a, b in (
            (25, '25'),
            ('25.0', 25),
            (None, ''),
            ([], None),
            ({}, ''),
            (True, True),
            (['/tmp', '/boot'], ['/boot', '/tmp']),
            ({'a': '1', 'b': None}, {'a': 1}),
            ([{'a': 1}], [{'a': '1'}]),
        ):
            with self.subTest(a=a, b=b):
                self.assertTrue(icinga.director_same_value(a, b))

    def test_different(self):
        for a, b in (
            (True, 1),
            (False, 0),
            (False, None),
            (True, 'true'),
            ('80', '90'),
            ('abc', 'abd'),
            (['a'], ['a', 'a']),
            (['a', 'b'], ['a']),
            ({'a': 1}, {'a': 2}),
            ([], {'a': 1}),
            ('1', ['1']),
            (-1, 1),
        ):
            with self.subTest(a=a, b=b):
                self.assertFalse(icinga.director_same_value(a, b))


SENSITIVE_DATAFIELDS = [
    {'settings': {'visibility': 'hidden'}, 'varname': 'login'},
    {'settings': {'visibility': 'visible'}, 'varname': 'warning'},
    {'settings': [], 'varname': 'odd'},
    'garbage',
]
SENSITIVE_CUSTOMPROPERTIES = [
    {'key_name': 'plain', 'value_type': 'sensitive'},
    {
        'items': {
            'creds': {
                'items': {'phrase': {'key_name': 'phrase', 'value_type': 'sensitive'}},
                'key_name': 'creds',
                'value_type': 'fixed-dictionary',
            }
        },
        'key_name': 'snmp',
        'value_type': 'fixed-dictionary',
    },
    {'key_name': 'harmless', 'value_type': 'string'},
]


class TestDirectorSensitive(unittest.TestCase):
    def test_sensitive_vars(self):
        self.assertEqual(
            icinga.director_sensitive_vars(
                SENSITIVE_DATAFIELDS, SENSITIVE_CUSTOMPROPERTIES
            ),
            {'login', 'plain', 'snmp'},
        )

    def test_sensitive_vars_of_wrong_input(self):
        self.assertEqual(icinga.director_sensitive_vars(None, 'x'), set())

    def test_is_sensitive_by_name_alone(self):
        self.assertTrue(icinga.director_is_sensitive('db_password'))
        self.assertFalse(icinga.director_is_sensitive('login'))

    def test_is_sensitive(self):
        for name in ('login', 'db_password', 'API_KEY', 'snmp_community', 'x_token'):
            with self.subTest(name=name):
                self.assertTrue(icinga.director_is_sensitive(name, {'login'}))
        for name in ('warning', 'keycloak_url', None, 42):
            with self.subTest(name=name):
                self.assertFalse(icinga.director_is_sensitive(name, {'login'}))


def basket():
    """A small basket in the shape `icingacli director basket dump` returns."""
    data = {
        'Datafield': {
            '1': {'uuid': 'df-warn', 'varname': 'load_warning', 'datatype': 'String'},
        },
        'Command': {
            'cmd-check-load': {
                'uuid': 'cmd-1',
                'object_name': 'cmd-check-load',
                'object_type': 'object',
                'command': '/usr/lib64/nagios/plugins/load',
                'arguments': {'--warning': {'value': '$load_warning$'}},
                'fields': [{'datafield_id': 1, 'is_required': 'n', 'var_filter': None}],
                'timeout': 10,
            },
        },
        'ServiceTemplate': {
            'tpl-service-load': {
                'uuid': 'tpl-1',
                'object_name': 'tpl-service-load',
                'object_type': 'template',
                'check_command': 'cmd-check-load',
                'max_check_attempts': 5,
                'notes': 'Checks the load.',
                'vars': {'load_warning': '80'},
            },
        },
        'ServiceSet': {
            'Linux Set': {
                'uuid': 'set-1',
                'object_name': 'Linux Set',
                'object_type': 'template',
                'services': {
                    'Load': {
                        'uuid': 'svc-1',
                        'object_name': 'Load',
                        'imports': ['tpl-service-load'],
                        'vars': {},
                    },
                },
            },
        },
    }
    return data


class TestDirectorBasketDiff(unittest.TestCase):
    def test_identical_baskets(self):
        self.assertEqual(icinga.director_basket_diff(basket(), basket()), [])

    def test_serialization_noise_is_ignored(self):
        live = basket()
        # renumbered data field, same uuid
        live['Datafield'] = {
            '7': {'uuid': 'df-warn', 'varname': 'load_warning', 'datatype': 'String'}
        }
        live['Command']['cmd-check-load'] = {
            'uuid': 'cmd-1',
            'object_name': 'cmd-check-load',
            'object_type': 'object',
            'command': 'load',  # without the plugin directory
            'arguments': {'--warning': '$load_warning$'},  # the short form
            'disabled': False,
            'fields': [{'datafield_id': 7, 'is_required': 'y', 'var_filter': None}],
            'imports': [],
            'timeout': '10',
            'vars': {},
        }
        live['ServiceTemplate']['tpl-service-load'].update(
            {'max_check_attempts': '5', 'groups': [], 'notes': 'Reworded.'}
        )
        self.assertEqual(icinga.director_basket_diff(live, basket()), [])

    def test_command_compared_without_its_directory(self):
        for live_cmd, shipped_cmd, same in (
            ('/usr/lib/nagios/plugins/load', '/usr/lib64/nagios/plugins/load', True),
            (
                'C:\\Program Files\\icinga2\\sbin\\linuxfabrik\\load.exe',
                'D:\\Plugins\\load.exe',
                True,
            ),
            ('/usr/bin/sudo /opt/plugins/load', 'sudo /usr/lib64/load', True),
            ('/usr/lib64/nagios/plugins/load', '/usr/lib64/nagios/plugins/disk', False),
            ('load --url=/health/a', 'load --url=/health/b', False),
        ):
            with self.subTest(live=live_cmd, shipped=shipped_cmd):
                live, shipped = basket(), basket()
                live['Command']['cmd-check-load']['command'] = live_cmd
                shipped['Command']['cmd-check-load']['command'] = shipped_cmd
                result = icinga.director_basket_diff(live, shipped)
                self.assertEqual(result == [], same)

    def test_missing_object(self):
        live = basket()
        del live['ServiceTemplate']['tpl-service-load']
        self.assertEqual(
            icinga.director_basket_diff(live, basket()),
            [
                {
                    'changes': [],
                    'class': 'Service Template',
                    'missing': True,
                    'name': 'tpl-service-load',
                }
            ],
        )

    def test_changed_variable(self):
        live = basket()
        live['ServiceTemplate']['tpl-service-load']['vars']['load_warning'] = '90'
        self.assertEqual(
            icinga.director_basket_diff(live, basket()),
            [
                {
                    'changes': [
                        {
                            'field': 'vars.load_warning',
                            'live': '90',
                            'service': None,
                            'shipped': '80',
                        }
                    ],
                    'class': 'Service Template',
                    'missing': False,
                    'name': 'tpl-service-load',
                }
            ],
        )

    def test_argument_on_one_side_is_one_change(self):
        shipped = basket()
        shipped['Command']['cmd-check-load']['arguments']['--critical'] = {
            'value': '$load_critical$'
        }
        (entry,) = icinga.director_basket_diff(basket(), shipped)
        self.assertEqual(entry['class'], 'Command')
        self.assertEqual(
            entry['changes'],
            [
                {
                    'field': 'arguments.--critical',
                    'live': None,
                    'service': None,
                    'shipped': {'value': '$load_critical$'},
                }
            ],
        )

    def test_field_binding_is_named_by_its_variable(self):
        live = basket()
        live['Command']['cmd-check-load']['fields'][0]['var_filter'] = 'x'
        (entry,) = icinga.director_basket_diff(live, basket())
        self.assertEqual(entry['changes'][0]['field'], 'fields.load_warning.var_filter')

    def test_changed_service_of_a_set(self):
        live = basket()
        live['ServiceSet']['Linux Set']['services']['Load']['vars'] = {'x': '1'}
        (entry,) = icinga.director_basket_diff(live, basket())
        self.assertEqual(entry['class'], 'Service Set')
        self.assertEqual(
            entry['changes'],
            [{'field': 'vars.x', 'live': '1', 'service': 'Load', 'shipped': None}],
        )

    def test_names_with_dots(self):
        shipped = basket()
        services = shipped['ServiceSet']['Linux Set']['services']
        services['Systemd Unit - sshd.service'] = {
            'uuid': 'svc-2',
            'object_name': 'Systemd Unit - sshd.service',
            'imports': ['tpl-service-systemd-unit'],
        }
        shipped['Command']['cmd-check-load']['arguments']['--a.b'] = {'value': '1'}
        live = basket()
        live['ServiceSet']['Linux Set']['services']['Systemd Unit - sshd.service'] = {
            'uuid': 'svc-2',
            'object_name': 'Systemd Unit - sshd.service',
            'imports': ['tpl-service-systemd-unit-old'],
        }
        changes = {
            e['class']: e['changes'] for e in icinga.director_basket_diff(live, shipped)
        }
        self.assertEqual(
            changes['Service Set'],
            [
                {
                    'field': 'imports',
                    'live': ['tpl-service-systemd-unit-old'],
                    'service': 'Systemd Unit - sshd.service',
                    'shipped': ['tpl-service-systemd-unit'],
                }
            ],
        )
        self.assertEqual(
            changes['Command'],
            [
                {
                    'field': 'arguments.--a.b',
                    'live': None,
                    'service': None,
                    'shipped': {'value': '1'},
                }
            ],
        )

    def test_service_on_one_side_has_an_empty_field(self):
        live = basket()
        del live['ServiceSet']['Linux Set']['services']['Load']
        ((change,),) = [
            e['changes'] for e in icinga.director_basket_diff(live, basket())
        ]
        self.assertEqual((change['service'], change['field']), ('Load', ''))
        self.assertIsNone(change['live'])
        self.assertEqual(change['shipped']['imports'], ['tpl-service-load'])

    def test_objects_only_in_the_director_are_ignored(self):
        live = basket()
        live['Command']['cmd-custom'] = {'uuid': 'c-9', 'object_name': 'cmd-custom'}
        self.assertEqual(icinga.director_basket_diff(live, basket()), [])

    def test_without_datafields_and_wrong_input(self):
        live = basket()
        del live['Datafield']
        result = icinga.director_basket_diff(live, basket())
        self.assertEqual(
            [(e['class'], e['missing']) for e in result],
            [('Datafield', True), ('Command', False)],
        )
        self.assertEqual(icinga.director_basket_diff(None, None), [])
        self.assertEqual(icinga.director_basket_diff({'Command': 'x'}, {}), [])
        broken = basket()
        broken['Command']['cmd-check-load'].update(
            {'arguments': 'x', 'command': 42, 'fields': 'x', 'vars': ['x']}
        )
        broken['ServiceSet']['Linux Set']['services'] = 'x'
        broken['Datafield']['1']['settings'] = 'x'
        for live, shipped in ((broken, basket()), (basket(), broken)):
            self.assertEqual(
                [e['class'] for e in icinga.director_basket_diff(live, shipped)],
                ['Command', 'Service Set'],
            )


class TestDirectorBasketDump(DirectorCliBase):
    def test_returns_the_objects(self):
        self.shell_exec.return_value = (True, ('{"Command": {}}', '', 0))
        self.assertEqual(icinga.director_basket_dump(), (True, {'Command': {}}))
        self.shell_exec.assert_called_once_with(
            ['icingacli', 'director', 'basket', 'dump', '--name', 'export'], timeout=30
        )

    def test_passes_name_and_timeout(self):
        self.shell_exec.return_value = (True, ('{}', '', 0))
        icinga.director_basket_dump('mine', timeout=5)
        self.shell_exec.assert_called_once_with(
            ['icingacli', 'director', 'basket', 'dump', '--name', 'mine'], timeout=5
        )

    def test_refuses_option_like_or_empty_names(self):
        for name in ('--help', '', None):
            with self.subTest(name=name):
                success, _ = icinga.director_basket_dump(name)
                self.assertFalse(success)
        self.shell_exec.assert_not_called()

    def test_no_object(self):
        self.shell_exec.return_value = (True, ('[]', '', 0))
        self.assertEqual(
            icinga.director_basket_dump(),
            (False, 'The Icinga Director returned no objects for basket "export".'),
        )

    def test_failure_is_passed_on(self):
        self.shell_exec.return_value = (True, ('', 'ERROR: no such basket\n', 1))
        success, msg = icinga.director_basket_dump()
        self.assertFalse(success)
        self.assertIn('`icingacli director basket dump` failed with exit code 1', msg)


if __name__ == '__main__':
    unittest.main()
