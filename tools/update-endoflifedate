"""This library stores information from https://endoflife.date/api/ for offline usage
and therefore needs to be updated periodically when version checks don't have access to the
Internet."""

# pylint: disable=C0302

__author__ = 'Linuxfabrik GmbH, Zurich/Switzerland'
__version__ = (
    '{DATA_VERSION}'  # adapt this if something in this script changed fundamentally
)

ENDOFLIFE_DATE = {{
'''


def render(data):
    """
    Render the fetched product data as the source of `endoflifedate.py`.

    The output is already in the layout `ruff format` produces, so this script does not
    have to shell out to `ruff` and cannot be made to write a differently formatted file
    by a host that happens to have no `ruff` installed.

    ### Parameters
    - **data** (`dict`): Maps a product API URL to the list of release cycles the API
      returned for it. Each cycle is a flat `dict` of scalar values.

    ### Returns
    - **str**: The complete file content, ending in a newline.

    ### Notes
    - Every collection is written one element per line and closed with a trailing comma.
      `ruff format` honours that trailing comma (its "magic trailing comma") and keeps the
      collection expanded no matter how short it is, so the layout stays stable even if a
      future product returns a cycle small enough to fit on one line.
    - Keys are sorted because the API does not promise a stable key order, and an unstable
      one would show up as noise in the diff of every refresh.
    - `repr()` quotes the way this repository configures `ruff format` to (`quote-style =
      'single'`): single quotes, switching to double only where that avoids an escape, as
      in the codename "Schrödinger's Cat".
    - Verified byte-for-byte against `ruff format` 0.15.9 on Fedora 44.
    """
    out = [HEADER]
    for url, cycles in data.items():
        out.append(f'    {url!r}: [\n')
        for cycle in cycles:
            out.append('        {\n')
            for key in sorted(cycle):
                out.append(f'            {key!r}: {cycle[key]!r},\n')
            out.append('        },\n')
        out.append('    ],\n')
    out.append('}\n')
    return ''.join(out)


def parse_args():
    """Parse command line arguments using argparse."""
    parser = argparse.ArgumentParser(description=DESCRIPTION)

    parser.add_argument(
        '-V',
        '--version',
        action='version',
        version=f'%(prog)s: v{__version__} by {__author__}',
    )

    parser.add_argument(
        '--file',
        help='Path to endoflifedate.py. Default: %(default)s',
        dest='FILE',
        default=DEFAULT_FILE,
    )

    return parser.parse_args()


def main():
    """The main function. Hier spielt die Musik."""

    # parse the command line, exit with UNKNOWN if it fails
    try:
        args = parse_args()
    except SystemExit:
        sys.exit(lib.globals.STATE_UNKNOWN)

    # fetch data
    data = {product: lib.base.coe(lib.url.fetch_json(product)) for product in PRODUCTS}

    lib.disk.write_file(args.FILE, render(data))


if __name__ == '__main__':
    try:
        main()
    except Exception:  # pylint: disable=W0703
        lib.base.cu()
