import argparse  # pylint: disable=C0413
import ast  # pylint: disable=C0413
import sys  # pylint: disable=C0413

sys.path.append('../..')

import lib.base  # pylint: disable=C0413
import lib.disk  # pylint: disable=C0413
import lib.globals  # pylint: disable=C0413
import lib.url  # pylint: disable=C0413

__author__ = 'Linuxfabrik GmbH, Zurich/Switzerland'
__version__ = '2026100101'

DESCRIPTION = """Creates the file "rhelappstreams.py" from the life cycle data Red Hat
publishes for the Application Streams of Red Hat Enterprise Linux."""

DEFAULT_FILE = 'lib/rhelappstreams.py'

# Red Hat keeps the data behind its Application Streams life cycle API in this public
# repository (Apache License 2.0), as Python modules that build pydantic objects. They
# are read as syntax trees and never executed.
SOURCE = (
    'https://raw.githubusercontent.com/RedHatInsights/digital-roadmap-backend/main/'
    'src/roadmap/data/'
)
SOURCE_FILES = ['modules.py', 'packages.py', 'systems.py']

# A source that parses but yields far fewer entries than it carried when this tool was
# written has most likely changed its layout. Writing that would quietly drop the
# vendor life cycle for most packages, so the tool aborts instead.
MIN_MODULES = 50
MIN_PACKAGES = 1000

DATA_VERSION = '2026100101'  # adapt this if the layout of the generated file changes

# The single brace of `RHEL_APP_STREAMS = {` has to be doubled, this is an f-string.
HEADER = f'''#! /usr/bin/env python3
# -*- coding: utf-8; py-indent-offset: 4 -*-
#
# Author:  Linuxfabrik GmbH, Zurich, Switzerland
# Contact: info (at) linuxfabrik (dot) ch
#          https://www.linuxfabrik.ch/
# License: The Unlicense, see LICENSE file.

# https://github.com/Linuxfabrik/lib/blob/main/CONTRIBUTING.md

"""This library stores the life cycle of the Red Hat Enterprise Linux Application
Streams for offline usage. It is generated by `tools/update-rhel-appstreams` from the
data Red Hat publishes in https://github.com/RedHatInsights/digital-roadmap-backend.

`RHEL_APP_STREAMS` maps a major release to its own end of maintenance (`eol`), to the
module streams (`modules`, keyed `<module>:<stream>` as `rpm` reports it in
`%{{MODULARITYLABEL}}`) and to the packages (`packages`, keyed by package name). Each
stream is a tuple of its name and the date its support ends, `None` where it follows
the major release (rolling streams)."""

# pylint: disable=C0302

__author__ = 'Linuxfabrik GmbH, Zurich/Switzerland'
__version__ = (
    '{DATA_VERSION}'  # adapt this if something in this script changed fundamentally
)

RHEL_APP_STREAMS = {{
'''


def entities(source, callee):
    """
    Return the keyword arguments of every `callee(...)` call in `source`.

    Values are taken from the syntax tree only: constants as they are, `date(y, m, d)`
    as an ISO date string, an enum member as its attribute name. Anything else, a
    computed value for example, is left out, so a change upstream shows up as a
    missing key rather than as code that runs here.
    """
    result = []
    for node in ast.walk(ast.parse(source)):
        if not isinstance(node, ast.Call) or getattr(node.func, 'id', '') != callee:
            continue
        values = {}
        for keyword in node.keywords:
            value = keyword.value
            if isinstance(value, ast.Constant):
                values[keyword.arg] = value.value
            elif (
                isinstance(value, ast.Call)
                and getattr(value.func, 'id', '') == 'date'
                and len(value.args) == 3
                and all(isinstance(arg, ast.Constant) for arg in value.args)
            ):
                year, month, day = (arg.value for arg in value.args)
                values[keyword.arg] = f'{year:04d}-{month:02d}-{day:02d}'
            elif isinstance(value, ast.Attribute):
                values[keyword.arg] = value.attr
        result.append(values)
    return result


def collect(sources):
    """Build `RHEL_APP_STREAMS` from the source files, keyed by file name."""
    data = {}
    for system in entities(sources['systems.py'], 'RHELLifecycle'):
        # Only the major releases, their minor releases carry a `minor` as well.
        if 'minor' in system or not isinstance(system.get('major'), int):
            continue
        release = {'eol': None, 'modules': {}, 'packages': {}}
        release = data.setdefault(system['major'], release)
        release['eol'] = system.get('end_date')
    counts = {}
    for kind, filename in (('modules', 'modules.py'), ('packages', 'packages.py')):
        counts[kind] = 0
        for entity in entities(sources[filename], 'AppStreamEntity'):
            major = entity.get('os_major')
            name = entity.get('name')
            if major not in data or not isinstance(name, str) or not name:
                continue
            if kind == 'modules':
                if not isinstance(entity.get('stream'), str):
                    continue
                name = f'{name}:{entity["stream"]}'
            data[major][kind][name] = (
                entity.get('application_stream_name') or name,
                entity.get('end_date'),
            )
            counts[kind] += 1
    return data, counts


def render(data):
    """
    Render the collected data as the source of `rhelappstreams.py`.

    The output is already in the layout `ruff format` produces (see `render()` in
    `update-endoflifedate`). Keys are sorted, so a refresh only shows real changes.
    """
    out = [HEADER]
    for major in sorted(data):
        out.append(f'    {major!r}: {{\n')
        out.append(f'        {"eol"!r}: {data[major]["eol"]!r},\n')
        for kind in ('modules', 'packages'):
            if not data[major][kind]:
                out.append(f'        {kind!r}: {{}},\n')
                continue
            out.append(f'        {kind!r}: {{\n')
            for name in sorted(data[major][kind]):
                stream, end = data[major][kind][name]
                out.append(f'            {name!r}: ({stream!r}, {end!r}),\n')
            out.append('        },\n')
        out.append('    },\n')
    out.append('}\n')
    return ''.join(out)


def parse_args():
    """Parse command line arguments using argparse."""
    parser = argparse.ArgumentParser(description=DESCRIPTION)

    parser.add_argument(
        '-V',
        '--version',
        action='version',
        version=f'%(prog)s: v{__version__} by {__author__}',
    )

    parser.add_argument(
        '--file',
        help='Path to rhelappstreams.py. Default: %(default)s',
        dest='FILE',
        default=DEFAULT_FILE,
    )

    return parser.parse_args()


def main():
    """The main function. Hier spielt die Musik."""

    # parse the command line, exit with UNKNOWN if it fails
    try:
        args = parse_args()
    except SystemExit:
        sys.exit(lib.globals.STATE_UNKNOWN)

    # fetch data
    sources = {
        filename: lib.base.coe(lib.url.fetch(SOURCE + filename))
        for filename in SOURCE_FILES
    }

    # analyze data
    data, counts = collect(sources)
    if counts['modules'] < MIN_MODULES or counts['packages'] < MIN_PACKAGES:
        lib.base.cu(
            f'Found only {counts["modules"]} module streams and {counts["packages"]} '
            f'packages in {SOURCE}, the layout of the source has probably changed.'
        )
    if not all(release['eol'] for release in data.values()):
        lib.base.cu(f'Found a major release without an end date in {SOURCE}.')

    lib.disk.write_file(args.FILE, render(data))


if __name__ == '__main__':
    try:
        main()
    except Exception:  # pylint: disable=W0703
        lib.base.cu()
